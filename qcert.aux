\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Completeness and minimality results formalized in QCert. A presentation gives generators and relations for a whole group, and a sub-presentation for the subgroup generated by the gate set named in the Object column of the Circuits block. $L_n$ is the group of orthogonal matrices $N/\sqrt  2^{\,j}$, where $N$ is an integer matrix and $j \ge 0$. Mod denotes the number of Agda modules, the units that Agda checks one at a time. Time records their typechecking time in seconds from scratch, measured with Agda\nonbreakingspace 2.8 on an Intel Core i5-14400. Mod and Time consider only each row's own modules, not the shared library or the formalizations it builds on.}}{5}{table.caption.4}\protected@file@percent }
\newlabel{tab:corpus}{{1}{5}{Completeness and minimality results formalized in QCert. A presentation gives generators and relations for a whole group, and a sub-presentation for the subgroup generated by the gate set named in the Object column of the Circuits block. $L_n$ is the group of orthogonal matrices $N/\sqrt 2^{\,j}$, where $N$ is an integer matrix and $j \ge 0$. Mod denotes the number of Agda modules, the units that Agda checks one at a time. Time records their typechecking time in seconds from scratch, measured with Agda~2.8 on an Intel Core i5-14400. Mod and Time consider only each row's own modules, not the shared library or the formalizations it builds on}{table.caption.4}{}}
\newlabel{tab:corpus@cref}{{[table][1][]1}{[1][5][]5}{}{}{}}
