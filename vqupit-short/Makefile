# Makefile — build the five-page version.
#
#   make          # latexmk -pdf main.tex  (no Agda needed: the code
#                 # blocks in agda/ are pre-rendered, see README.md)
#   make png      # render every page to png/pNN.png (needs gs)
#   make qa       # labels, citations, figure files, Unicode coverage
#   make agda     # re-render the three §2 snippets agda/ex-*.tex from
#                 # lagda/ex-*.lagda.tex (needs Agda and the library one
#                 # directory up; the results are committed, so a plain
#                 # `make' never needs this)
#   make clean    # remove latexmk auxiliary files (keeps main.pdf)
#   make cleanall # also remove main.pdf, png/ and the generated latex/
#
# TeX Live on the authors' machine is a user-local install in WSL
# (/home/bonest/texlive); it is added to PATH below if present.

TEXLIVE_BIN := $(wildcard $(HOME)/texlive/bin/x86_64-linux)
ifneq ($(TEXLIVE_BIN),)
  export PATH := $(TEXLIVE_BIN):$(PATH)
endif

MAIN     := main
LATEXMK  := latexmk
LMKFLAGS := -halt-on-error -interaction=nonstopmode
AGDA     := agda
AGDAFLAGS := --latex --only-scope-checking --latex-dir=vqupit-short/latex

DEPS := $(MAIN).tex $(wildcard sections/*.tex) $(wildcard agda/*.tex) \
        $(wildcard figures/*.tikz) refs.bib agda-style.sty agda.sty circuits.tikzstyles

LAGDA    := $(wildcard lagda/*.lagda.tex)
SNIPPETS := $(patsubst lagda/%.lagda.tex,agda/%.tex,$(LAGDA))

.PHONY: all agda png qa clean cleanall

all: $(MAIN).pdf

$(MAIN).pdf: $(DEPS)
	$(LATEXMK) -pdf $(LMKFLAGS) $(MAIN).tex

agda: $(SNIPPETS)

# Agda must run from the repository root, where the .agda-lib file lives
# and relative to which the snippets are named vqupit-short.lagda.<name>.
agda/%.tex: lagda/%.lagda.tex lagda/Prelude.agda
	cd .. && $(AGDA) $(AGDAFLAGS) vqupit-short/$<
	{ echo "%% Generated by make agda from lagda/$*.lagda.tex (agda --latex --only-scope-checking);"; \
	  echo "%% edit that file, not this one.  The hidden block renders nothing."; \
	  cat latex/vqupit-short/lagda/$*.tex; } > $@

png: $(MAIN).pdf
	mkdir -p png
	gs -q -dNOPAUSE -dBATCH -sDEVICE=png16m -r80 -sOutputFile=png/p%02d.png $(MAIN).pdf

qa:
	perl notes/qa.pl

clean:
	$(LATEXMK) -c $(MAIN).tex
	rm -f comment.cut $(MAIN).ptb

cleanall: clean
	rm -rf $(MAIN).pdf png latex
