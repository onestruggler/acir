swW : ℕ → Word (S.Gen 9)
swW 0 = [ S.gate₂ S.σ-gate ]ʷ
swW 1 = [ S.gate₂ S.σ-gate S.↥ ]ʷ
swW 2 = [ S.gate₂ S.σ-gate S.↥ S.↥ ]ʷ
swW 3 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ ]ʷ
swW 4 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ S.↥ ]ʷ
swW 5 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ S.↥ S.↥ ]ʷ
swW 6 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ S.↥ S.↥ S.↥ ]ʷ
swW 7 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ S.↥ S.↥ S.↥ S.↥ ]ʷ
swW _ = ε

nsW : List ℕ → Word (S.Gen 9)
nsW []       = ε
nsW (p ∷ ps) = swW p • nsW ps

swV : ℕ → Word (S.Gen 8)
swV 0 = [ S.gate₂ S.σ-gate ]ʷ
swV 1 = [ S.gate₂ S.σ-gate S.↥ ]ʷ
swV 2 = [ S.gate₂ S.σ-gate S.↥ S.↥ ]ʷ
swV 3 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ ]ʷ
swV 4 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ S.↥ ]ʷ
swV 5 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ S.↥ S.↥ ]ʷ
swV 6 = [ S.gate₂ S.σ-gate S.↥ S.↥ S.↥ S.↥ S.↥ S.↥ ]ʷ
swV _ = ε

nsV : List ℕ → Word (S.Gen 8)
nsV []       = ε
nsV (p ∷ ps) = swV p • nsV ps

PW : Word (S.Gen 9) → Circuit 5 → Circuit 9
PW s u = pl s (u ↓ᵏ 4)

PV : Word (S.Gen 8) → Circuit 5 → Circuit 8
PV s u = pl s (u ↓ᵏ 3)

private
  refl≡ᵧ : ∀ {n} {a b : Circuit n} → a ≡ b → n ⊢ᵧ a ≈ b
  refl≡ᵧ Eq.refl = PB.refl

  frame : (u : Circuit 5) (s s′ : Word (S.Gen 9)) →
          perm s′ ⟨$⟩ʳ (perm (revS s) ⟨$⟩ʳ 0F) ≡ 0F →
          perm s′ ⟨$⟩ʳ (perm (revS s) ⟨$⟩ʳ sF 0F) ≡ sF 0F →
          perm s′ ⟨$⟩ʳ (perm (revS s) ⟨$⟩ʳ sF (sF 0F)) ≡ sF (sF 0F) →
          perm s′ ⟨$⟩ʳ (perm (revS s) ⟨$⟩ʳ sF (sF (sF 0F))) ≡ sF (sF (sF 0F)) →
          perm s′ ⟨$⟩ʳ (perm (revS s) ⟨$⟩ʳ sF (sF (sF (sF 0F)))) ≡ sF (sF (sF (sF 0F))) →
          9 ⊢ᵧ PW s u ≈ PW s′ u
  frame u s s′ e0 e1 e2 e3 e4 = embed (place-eq u s s′ agree)
    where
    agree : ∀ (j : Fin 9) → toℕ j < 5 → perm s′ ⟨$⟩ʳ (perm (revS s) ⟨$⟩ʳ j) ≡ j
    agree 0F                          _ = e0
    agree (sF 0F)                     _ = e1
    agree (sF (sF 0F))                _ = e2
    agree (sF (sF (sF 0F)))           _ = e3
    agree (sF (sF (sF (sF 0F))))      _ = e4
    agree (sF (sF (sF (sF (sF j))))) (s≤s (s≤s (s≤s (s≤s (s≤s ())))))

  win : (t : Word (S.Gen 9)) (Y Y′ : Circuit 8) → ⟦ Y ⟧ ~ ⟦ Y′ ⟧ →
        9 ⊢ᵧ pl t (top Y) ≈ pl t (top Y′)
  win t Y Y′ e = PB.cong PB.refl (PB.cong (top-congᵧ (cV {Y} {Y′} e)) PB.refl)

  switch : (u : Circuit 5) (s t : Word (S.Gen 9)) (ρ ρ′ : List ℕ) (s′ : Word (S.Gen 9)) →
           9 ⊢ᵧ PW s u ≈ PW (t • nsW ρ) u →
           pl (nsW ρ) (u ↓ᵏ 4) ≡ top (PV (nsV ρ) u) →
           ⟦ PV (nsV ρ) u ⟧ ~ ⟦ PV (nsV ρ′) u ⟧ →
           pl (nsW ρ′) (u ↓ᵏ 4) ≡ top (PV (nsV ρ′) u) →
           9 ⊢ᵧ PW (t • nsW ρ′) u ≈ PW s′ u →
           9 ⊢ᵧ PW s u ≈ PW s′ u
  switch u s t ρ ρ′ s′ f₁ n₁ e n₂ f₂ = begin
    PW s u                              ≈⟨ f₁ ⟩
    PW (t • nsW ρ) u                    ≈⟨ sym (embed (pl-pl t (nsW ρ) (u ↓ᵏ 4))) ⟩
    pl t (pl (nsW ρ) (u ↓ᵏ 4))        ≈⟨ refl≡ᵧ (Eq.cong (pl t) n₁) ⟩
    pl t (top (PV (nsV ρ) u))           ≈⟨ win t (PV (nsV ρ) u) (PV (nsV ρ′) u) e ⟩
    pl t (top (PV (nsV ρ′) u))          ≈⟨ refl≡ᵧ (Eq.cong (pl t) (Eq.sym n₂)) ⟩
    pl t (pl (nsW ρ′) (u ↓ᵏ 4))       ≈⟨ embed (pl-pl t (nsW ρ′) (u ↓ᵏ 4)) ⟩
    PW (t • nsW ρ′) u                   ≈⟨ f₂ ⟩
    PW s′ u ∎
    where open Tools (9 YVRel,_===_)

  same : {Y Y′ : Circuit 8} {c : Circuit 7} → ⟦ Y ⟧ ~ ctrl ⟦ c ⟧ → ⟦ Y′ ⟧ ~ ctrl ⟦ c ⟧ → ⟦ Y ⟧ ~ ⟦ Y′ ⟧
  same {Y} {Y′} {c} e e′ = ~-trans {s = ⟦ Y ⟧} {t = ctrl ⟦ c ⟧} {u = ⟦ Y′ ⟧} e (~-sym {s = ⟦ Y′ ⟧} {t = ctrl ⟦ c ⟧} e′)

  -- The controlled CS of the wires 0 1, and of the top two wires of the domain.
  CSa CSb : Circuit 7
  CSa = [ gate₂ CS-gate ]ʷ
  CSb = [ gate₂ CS-gate ↥ ↥ ↥ ↥ ↥ ]ʷ

  ctrl-gen : (g : Gen 7) → ⟦ λ¹ {3} g ⟧ ~ ctrl ⟦ [ g ]ʷ ⟧
  ctrl-gen g = ~-trans {s = ⟦ λ¹ {3} g ⟧} {t = ctrl (1 , ⟦ g ⟧ᵍ)} {u = ctrl ⟦ [ g ]ʷ ⟧}
                 (λ¹-gen g) (ctrl-~ {s = 1 , ⟦ g ⟧ᵍ} {t = ⟦ [ g ]ʷ ⟧} (~-sym {s = ⟦ [ g ]ʷ ⟧} {t = 1 , ⟦ g ⟧ᵍ} (⟦gen⟧ g)))

  ↑≈ : (w : Circuit n) → (₁₊ n) ⊢ w ↑ ≈ σ n • top w • σ⁻¹ n
  ↑≈ {n} w = begin
    w ↑                         ≈⟨ sym right-unit ⟩
    w ↑ • ε                     ≈⟨ back _ (sym (σσ⁻¹ n)) ⟩
    w ↑ • σ n • σ⁻¹ n           ≈⟨ sym assoc ⟩
    (w ↑ • σ n) • σ⁻¹ n         ≈⟨ front _ (nat w) ⟩
    (σ n • top w) • σ⁻¹ n       ≈⟨ assoc ⟩
    σ n • top w • σ⁻¹ n ∎
    where open Tools ((₁₊ n) VRel,_===_)

  up1 : 6 ⊢ Σ₂ ↑ ≈ σ 5 • top (Σ₂) • σ⁻¹ 5
  up1 = ↑≈ Σ₂

  up2 : 7 ⊢ Σ₂ ↑ ↑ ≈ σ 6 • top (σ 5 • top (Σ₂) • σ⁻¹ 5) • σ⁻¹ 6
  up2 = PB.trans (↑≈ (Σ₂ ↑)) (PB.cong PB.refl (PB.cong (top-cong up1) PB.refl))

  up3 : 8 ⊢ Σ₂ ↑ ↑ ↑ ≈ σ 7 • top (σ 6 • top (σ 5 • top (Σ₂) • σ⁻¹ 5) • σ⁻¹ 6) • σ⁻¹ 7
