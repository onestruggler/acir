-- Lemma 7.4

lemma-7-4 : Lemma-7-4
lemma-7-4 I-gen       = TM.inst TM.d∘e-I refl refl
lemma-7-4 (I-gen ↥)   = PB.trans (PB.axiom (ω↑=ω I-gate)) (TM.inst TM.d∘e-I refl refl)
lemma-7-4 (I-gen ↥ ↥) =
  PB.trans (PB.axiom (cong↑ (ω↑=ω I-gate)))
    (PB.trans (PB.axiom (ω↑=ω I-gate)) (TM.inst TM.d∘e-I refl refl))
lemma-7-4 S-gen       = TM.inst TM.d∘e-S refl refl
lemma-7-4 K-gen       = TM.inst TM.d∘e-K refl refl
lemma-7-4 CS-gen      = PB.refl
lemma-7-4 (S-gen ↥)   = TM.inst TM.d∘e-S↑ refl refl
lemma-7-4 (K-gen ↥)   = TM.inst TM.d∘e-K↑ refl refl

