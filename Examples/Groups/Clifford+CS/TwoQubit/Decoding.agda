private

  -- A pair of indices out of order refutes a proof that it is in order.
  bad : {a b : Fin 4} → .(a < b) → T (toℕ a ℕ.<ᵇ toℕ b)
  bad {a} {b} p = ℕP.<⇒<ᵇ (recompute (a FinP.<? b) p)

  bad′ : {a b : Fin 4} → a < b → T (toℕ a ℕ.<ᵇ toℕ b)
  bad′ = ℕP.<⇒<ᵇ

