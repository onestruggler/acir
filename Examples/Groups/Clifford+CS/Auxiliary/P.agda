------------------------------------------------------------------------
-- Presentations of groups
--
-- The generators P′ of the determinant-one subgroup
--
-- On n ≥ 4 qubits the Clifford+CS circuits denote the index-4 subgroup
-- of U_{2ⁿ}(ℤ[½,i]) of determinant 1 (scratchpad/four-wire-notes.md:
-- det i_[a] = det K_[a,b] = i and det X_[a,b] = −1, and every gate
-- embeds with multiplicity at least 4), generated by the products
--
--     i_[a] i_[b]⁻¹,   (−1)_[c] X_[a,b],   X_[a,b] X_[c,d],
--     K_[a,b] i_[s]⁻¹
--
-- the analogue of Clément's P with the phase pair for the sign pair.
-- The last is a K with a phase removed at a sink s, where Clément has
-- a Hadamard pair: his cosets keep the sign parity and the H-parity
-- apart, so each kind of letter can be balanced against its own kind,
-- whereas here i and K both have determinant i and relation (16)
-- (K i³ = i K i K, odd in K) ties them together, so the coset action
-- needs K_[a,b] i_[0]⁻¹ — and the K pair K_[a,b] K_[c,d]⁻¹, the first
-- design, could spell it only as a five-letter word on three fresh
-- indices.  The pair is the product of two such letters.  A word over
-- P′ denotes the product of its letters' matrices in the order
-- written, as a word over the two-level generators does.
--
-- The development is generic in the number N of indices; the circuits
-- enter at N = 2ⁿ.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

module Examples.Groups.Clifford+CS.Auxiliary.P where

open import Data.Fin using (Fin ; _<_)
open import Data.Nat using (ℕ)
open import Word.Base using (Word ; [_]ʷ ; _•_ ; _^_)

import Examples.Groups.Clifford+CS-TwoLevel.Syntactics as TL

private
  variable
    N : ℕ

------------------------------------------------------------------------
-- The generators
--
-- The orderings are irrelevant fields: two letters with the same
-- indices are the same letter.  The phase pair pp carries none, and
-- pp a a is a letter (the rules make it ε); an exchange pair is
-- written in increasing order, matching the two-level alphabet, so
-- there is no analogue of Clément's (33).

data GenP (N : ℕ) : Set where
  pp : (a b : Fin N) → GenP N
  px : (c a b : Fin N) → .(a < b) → GenP N
  dx : (a b c d : Fin N) → .(a < b) → .(c < d) → GenP N
  ki : (a b s : Fin N) → .(a < b) → GenP N

-- A letter of P′ as a word over the two-level generators: the phase
-- pair is i_[a] i_[b]³, and the hybrid K_[a,b] i_[s]³.
asG : GenP N → Word (TL.Gen N)
asG (pp a b)        = TL.i a • TL.i b ^ 3
asG (px c a b p)    = TL.i c • TL.i c • TL.X a b p
asG (dx a b c d p q) = TL.X a b p • TL.X c d q
asG (ki a b s p)    = TL.K a b p • TL.i s ^ 3
