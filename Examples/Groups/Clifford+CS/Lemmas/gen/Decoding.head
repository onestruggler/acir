------------------------------------------------------------------------
-- Presentations of groups
--
-- The decoding inverts the encoding and respects the two-level
-- relations on four indices (the analogues of Clément's Lemmas 7.4
-- and 7.5)
--
-- (Generated by Lemmas/gen.)  Each generator, and each of the 118
-- instances of Bian and Selinger's relations on four indices, is one
-- equation of Lemmas.TwoWireMacro, read back on the circuits by `inst`.
-- What is left here is to name the instance: a relation whose indices
-- are out of order, or not distinct, is refuted from its hypotheses.
-- The scalar shifted up one or two wires is the scalar, by ω↑=ω.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

module Examples.Groups.Clifford+CS.TwoQubit.Decoding where

open import Data.Bool.Base using (T)
open import Data.Empty using (⊥-elim)
open import Data.Fin using (Fin ; _<_ ; toℕ)
import Data.Fin.Properties as FinP
import Data.Nat as ℕ
import Data.Nat.Properties as ℕP
open import Relation.Binary.PropositionalEquality using (refl)
open import Relation.Nullary.Decidable using (recompute)

import Presentation.Base as PB

open import Notations using (₀ ; ₁ ; ₂ ; ₃)

open import Examples.Groups.Clifford+CS.Syntactics
import Examples.Groups.Clifford+CS-TwoLevel.Syntactics as TL
open import Examples.Groups.Clifford+CS.TwoQubit using (Lemma-7-4 ; Lemma-7-5)
import Examples.Groups.Clifford+CS.Lemmas.TwoWireMacro as TM

private

  -- A pair of indices out of order refutes a proof that it is in order.
  bad : {a b : Fin 4} → .(a < b) → T (toℕ a ℕ.<ᵇ toℕ b)
  bad {a} {b} p = ℕP.<⇒<ᵇ (recompute (a FinP.<? b) p)

  bad′ : {a b : Fin 4} → a < b → T (toℕ a ℕ.<ᵇ toℕ b)
  bad′ = ℕP.<⇒<ᵇ

------------------------------------------------------------------------
-- Lemma 7.4

lemma-7-4 : Lemma-7-4
lemma-7-4 I-gen       = TM.inst TM.d∘e-I refl refl
lemma-7-4 (I-gen ↥)   = PB.trans (PB.axiom (ω↑=ω I-gate)) (TM.inst TM.d∘e-I refl refl)
lemma-7-4 (I-gen ↥ ↥) =
  PB.trans (PB.axiom (cong↑ (ω↑=ω I-gate)))
    (PB.trans (PB.axiom (ω↑=ω I-gate)) (TM.inst TM.d∘e-I refl refl))
lemma-7-4 S-gen       = TM.inst TM.d∘e-S refl refl
lemma-7-4 K-gen       = TM.inst TM.d∘e-K refl refl
lemma-7-4 CS-gen      = PB.refl
lemma-7-4 (S-gen ↥)   = TM.inst TM.d∘e-S↑ refl refl
lemma-7-4 (K-gen ↥)   = TM.inst TM.d∘e-K↑ refl refl

------------------------------------------------------------------------
-- Lemma 7.5

lemma-7-5 : Lemma-7-5
