------------------------------------------------------------------------
-- Presentations of groups
--
-- Soundness of the Clifford+CS equational theory: the monoid congruence
-- generated by the rules of Syntactics preserves the matrix denotation
-- ⟦_⟧ : Circuit n → Scaled n.
--
-- As in Real-Clifford+CH.Soundness, in two steps.  axiom-sound handles
-- the RAW relation, one clause per rule: each rule is a computation on
-- Gaussian-integer matrices at the width it is drawn on
-- (Soundness.Relators), carried to every width by
-- Interpretation.by-relator, and the structural rules are the tensor
-- calculus of Semantics.Local — comm₁ and comm₂ are the mixed product
-- law, cong↑ is functoriality of I₂ ⊗ −, and ω↑=ω says I₂ ⊗ c I = c I.
-- sound then closes it under the monoid congruence.
------------------------------------------------------------------------

{-# OPTIONS --cubical-compatible --safe #-}

module Examples.Groups.Clifford+CS.Soundness where

open import Data.Nat using (ℕ)
open import Data.Vec using (_∷_)
open import Relation.Binary.PropositionalEquality as Eq using (_≡_)
open import Word.Base using (Word ; [_]ʷ ; ε ; _•_)

import Presentation.Base as PB

open import Examples.Groups.Clifford+CS.Semantics hiding (_^_)
open import Examples.Groups.Clifford+CS.Syntactics
open import Examples.Groups.Clifford+CS.Interpretation
open import Examples.Groups.Clifford+CS.Soundness.Relators

private
  variable
    n : ℕ

------------------------------------------------------------------------
-- The structural rules

-- The scaled relation _~_ unfolds to an equation of operators in which
-- the powers of γ are not unification patterns, so every lemma about
-- it is given its words explicitly.

private
  -- Two words with as many letters and the same operator denote the
  -- same matrix.
  same : (w v : Circuit n) → len w ≡ len v → ⟦ w ⟧ₒ ≐ ⟦ v ⟧ₒ → ⟦ w ⟧ ~ ⟦ v ⟧
  same w v = ~-reflexive {l = len w} {len v} {M = ⟦ w ⟧ₒ} {⟦ v ⟧ₒ}

  -- The operator of two letters (⟦_⟧ₒ is abstract).
  gen² : (a b : Gen n) → ⟦ [ a ]ʷ • [ b ]ʷ ⟧ₒ ≐ (⟦ a ⟧ᵍ ⊙ ⟦ b ⟧ᵍ)
  gen² a b = ≐-trans (⟦⟧ₒ-• [ a ]ʷ [ b ]ʷ) (⊙-cong (⟦⟧ₒ-gen a) (⟦⟧ₒ-gen b))

  swapᵐ : ∀ (a b c : 𝔽) → a * (b * c) ≡ b * (a * c)
  swapᵐ a b c = Eq.trans (Eq.sym (*-assoc a b c))
    (Eq.trans (Eq.cong (_* c) (*-comm a b)) (*-assoc b a c))

  -- A scalar factor passes through the shift.
  up-· : (c : 𝔽) (M : Op n) → up (c · M) ≐ (c · up M)
  up-· c M (a ∷ x) (b ∷ y) = swapᵐ (δb (a ∷ Data.Vec.[]) (b ∷ Data.Vec.[])) c (M x y)

-- The derivation moves up a wire, and so does its operator.
cong↑-sound : {w v : Circuit n} → ⟦ w ⟧ ~ ⟦ v ⟧ → ⟦ w ↑ ⟧ ~ ⟦ v ↑ ⟧
cong↑-sound {w = w} {v} e =
  ≐-trans (·-cong (Eq.cong γ^_ (len-↑ v)) (up-word w))
    (≐-trans (≐-sym (up-· (γ^ len v) ⟦ w ⟧ₒ))
      (≐-trans (up-cong e)
        (≐-trans (up-· (γ^ len w) ⟦ v ⟧ₒ)
                 (·-cong (Eq.cong γ^_ (Eq.sym (len-↑ w))) (≐-sym (up-word v))))))

-- A one-wire gate and an operator shifted past it are M ⊗ N either way
-- round; a two-wire gate likewise, once two shifts are seen as one.
comm₁-sound : (h : Gate 1) (g : Gen n) →
              ⟦ [ g ↥ ]ʷ • [ gate₁ h ]ʷ ⟧ ~ ⟦ [ gate₁ h ]ʷ • [ g ↥ ]ʷ ⟧
comm₁-sound S-gate g = same ([ g ↥ ]ʷ • S) (S • [ g ↥ ]ʷ) Eq.refl
  (≐-trans (gen² (g ↥) S-gen)
    (≐-trans (≐-sym (emb-up-comm sM ⟦ g ⟧ᵍ)) (≐-sym (gen² S-gen (g ↥)))))
comm₁-sound K-gate g = same ([ g ↥ ]ʷ • K) (K • [ g ↥ ]ʷ) Eq.refl
  (≐-trans (gen² (g ↥) K-gen)
    (≐-trans (≐-sym (emb-up-comm kM ⟦ g ⟧ᵍ)) (≐-sym (gen² K-gen (g ↥)))))

comm₂-sound : (h : Gate 2) (g : Gen n) →
              ⟦ [ g ↥ ↥ ]ʷ • [ gate₂ h ]ʷ ⟧ ~ ⟦ [ gate₂ h ]ʷ • [ g ↥ ↥ ]ʷ ⟧
comm₂-sound CS-gate g = same ([ g ↥ ↥ ]ʷ • CS) (CS • [ g ↥ ↥ ]ʷ) Eq.refl
  (≐-trans (gen² (g ↥ ↥) CS-gen)
    (≐-trans (⊙-cong (up-up ⟦ g ⟧ᵍ) (≐-refl (emb csM)))
      (≐-trans (≐-sym (emb-up-comm csM ⟦ g ⟧ᵍ))
        (≐-trans (⊙-cong (≐-refl (emb csM)) (≐-sym (up-up ⟦ g ⟧ᵍ)))
                 (≐-sym (gen² CS-gen (g ↥ ↥)))))))

-- The scalar, shifted, is the scalar.
ω↑=ω-sound : (h : Gate 0) → ⟦ [ gate₀ {n} h ]ʷ ↑ ⟧ ~ ⟦ [ gate₀ h ]ʷ ⟧
ω↑=ω-sound I-gate = same (iI ↑) iI Eq.refl
  (≐-trans (⟦⟧ₒ-gen (I-gen ↥))
    (≐-trans (up-scal γⅈ) (≐-sym (⟦⟧ₒ-gen I-gen))))

------------------------------------------------------------------------
-- Soundness of the axioms

axiom-sound : {w v : Circuit n} → n VRel, w === v → ⟦ w ⟧ ~ ⟦ v ⟧
axiom-sound (srel order-I)     = by-relator rIˡ  rIʳ  pIˡ  pIʳ  (same-≡ rIˡ  rIʳ  mI)
axiom-sound (srel order-S)     = by-relator rSˡ  rSʳ  pSˡ  p1ʳ  (same-≡ rSˡ  rSʳ  mS)
axiom-sound (srel order-K)     = by-relator rKˡ  rKʳ  pKˡ  pKʳ  (same-≡ rKˡ  rKʳ  mK)
axiom-sound (srel order-SK)    = by-relator rSKˡ rSKʳ pSKˡ pKʳ  (same-≡ rSKˡ rSKʳ mSK)
axiom-sound (srel order-CS)    = by-relator rCSˡ rCSʳ pCSˡ p2ʳ  (same-≡ rCSˡ rCSʳ mCS)
axiom-sound (srel comm-CS-S₀)  = by-relator rS₀ˡ rS₀ʳ pS₀ˡ pS₀ʳ (same-≡ rS₀ˡ rS₀ʳ mS₀)
axiom-sound (srel comm-CS-S₁)  = by-relator rS₁ˡ rS₁ʳ pS₁ˡ pS₁ʳ (same-≡ rS₁ˡ rS₁ʳ mS₁)
axiom-sound (srel X-CS₀)       = by-relator rX₀ˡ rX₀ʳ pX₀ˡ pX₀ʳ (same-≡ rX₀ˡ rX₀ʳ mX₀)
axiom-sound (srel X-CS₁)       = by-relator rX₁ˡ rX₁ʳ pX₁ˡ pX₁ʳ (same-≡ rX₁ˡ rX₁ʳ mX₁)
axiom-sound (srel CS-K₀)       = by-relator rK₀ˡ rK₀ʳ pK₀ˡ pK₀ʳ (same-≡ rK₀ˡ rK₀ʳ mK₀)
axiom-sound (srel CS-K₁)       = by-relator rK₁ˡ rK₁ʳ pK₁ˡ pK₁ʳ (same-≡ rK₁ˡ rK₁ʳ mK₁)
axiom-sound (srel comm-CS↑-CS) = by-relator rCCˡ rCCʳ pCCˡ pCCʳ (same-≡ rCCˡ rCCʳ mCC)
axiom-sound (srel rel-266)     = by-relator r266ˡ r266ʳ p266ˡ p266ʳ (same-≡ r266ˡ r266ʳ m266)
axiom-sound (srel rel-267)     = by-relator r267ˡ r267ʳ p267ˡ p267ʳ (same-≡ r267ˡ r267ʳ m267)
axiom-sound (srel rel-268)     = by-relator r268ˡ r268ʳ p268ˡ p268ʳ (same-≡ r268ˡ r268ʳ m268)
axiom-sound (srel rel-269)     = by-relator r269ˡ r269ʳ p269ˡ p269ʳ (same-≡ r269ˡ r269ʳ m269)
axiom-sound (srel rel-272)     = by-relator r272ˡ r272ʳ p272ˡ p272ʳ (same-≡ r272ˡ r272ʳ m272)
axiom-sound (srel cx-ccz)      = by-relator rΔˡ rΔʳ pΔˡ pΔʳ (same-≡ rΔˡ rΔʳ mΔ)
axiom-sound (srel toff-ccz)    = by-relator rΛˡ rΛʳ pΛˡ pΛʳ (same-≡ rΛˡ rΛʳ mΛ)
axiom-sound (srel ck-tct)      = by-relator rΓˡ rΓʳ pΓˡ pΓʳ (same-≡ rΓˡ rΓʳ mΓ)
axiom-sound (srel lf)          = by-relator rLFˡ rLFʳ pLFˡ pLFʳ (same-≡ rLFˡ rLFʳ mLF)
-- The structural rules.
axiom-sound (cong↑ r)          = cong↑-sound (axiom-sound r)
axiom-sound (comm₁ h g)        = comm₁-sound h g
axiom-sound (comm₂ h g)        = comm₂-sound h g
axiom-sound (ω↑=ω h)           = ω↑=ω-sound h

------------------------------------------------------------------------
-- Soundness of the congruence
--
-- Closing under the monoid congruence is the library's job
-- (StarInterp.Extend.Cong), on the reading built from the monoid, ⟦_⟧ᴱ,
-- which is ⟦_⟧ (Interpretation.⟦⟧ᴱ-def).

axiom-soundᴱ : {w v : Circuit n} → n VRel, w === v →
               Ext.⟦_⟧ᴱ n w ~ Ext.⟦_⟧ᴱ n v
axiom-soundᴱ {w = w} {v} r = ⟦⟧ᴱ-~ {w = w} {v} (axiom-sound r)

soundᴱ : {w v : Circuit n} → n ⊢ w ≈ v → Ext.⟦_⟧ᴱ n w ~ Ext.⟦_⟧ᴱ n v
soundᴱ {n} = Ext.Cong.fʷ-cong n axiom-soundᴱ

sound : {w v : Circuit n} → n ⊢ w ≈ v → ⟦ w ⟧ ~ ⟦ v ⟧
sound {w = w} {v} e = ~-⟦⟧ᴱ {w = w} {v} (soundᴱ e)
