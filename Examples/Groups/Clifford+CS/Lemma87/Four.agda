dec-K3 = ≈ᵈ (chainᵈ ps-K3) lem-L87-K3

pt-K3 : Part
pt-K3 = part (words ps-K3) (blk (xb false false false false) (K3 ∷ [])) dec-K3

ps-iI : List Part
ps-iI = pt-X0 ∷ pt-S0 ∷ pt-X0 ∷ pt-S0 ∷ []

dec-ι : Decodes (words ps-iI) ⟪ ι ∷ [] ⟫ʷ
dec-ι = ≈ᵈ (chainᵈ ps-iI) lem-L87-iI

pt-ι : Part
pt-ι = part (words ps-iI) (blk (xb false false false false) (ι ∷ [])) dec-ι

