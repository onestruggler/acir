-- κ ∘ ι is the identity

κι : ∀ (x : Gen 3) → 3 ⊢ [ x ]ʷ ≈ (κ ʷ) (ι x)
κι X-gen             = PB.refl
κι H-gen             = PB.refl
κι CX-gen            = PB.refl
κι K-gen             = PB.refl
κι CCX-gen           = PB.refl
κι NK-gen            = PB.refl
κι CCZ-gen           = PB.refl
κι (gate₀ ())
κι (X-gen ↥)         = PB.refl
κι (H-gen ↥)         = PB.axiom (srel (fig8 H-place))
κι (CX-gen ↥)        = PB.refl
κι (K-gen ↥)         = PB.refl
κι (gate₀ () ↥)
κι ((X-gen ↥) ↥)     = PB.refl
κι ((H-gen ↥) ↥)     =
  PB.trans (PB.axiom (cong↑ (srel (fig8 H-place))))
           (PB.cong PB.refl (PB.axiom (srel (fig8 H-place))))
κι ((gate₀ () ↥) ↥)
κι (((gate₀ () ↥) ↥) ↥)

------------------------------------------------------------------------
-- So the circuits are a group too, and (ι ʷ) is a group isomorphism

private
  module GP = Group-Lemmas P._===₂⁺_ grouplike₂

  open import Presentation.Morphism P._===₂⁺_ (3 VRel,_===_) using (module Star-Congruence)
  open Star-Congruence κ κ-ax using () renaming (fʷ-cong to κ-cong)

-- A circuit letter's inverse is the reading of its reading's inverse.
grouplike : Grouplike (3 VRel,_===_)
grouplike x = (κ ʷ) (ι x GP.⁻¹) ,
  PB.trans (PB.cong PB.refl (κι x)) (κ-cong (GP.inverseˡ {ι x}))

private
  module GC = Group-Lemmas (3 VRel,_===_) grouplike

open import Presentation.Morphism (3 VRel,_===_) P._===₂⁺_ using (module GroupMorphism)
open GroupMorphism grouplike grouplike₂ using (module StarGroupIsomorphism)

circuits≅paper : GroupMorphisms.IsGroupIsomorphism
                   (Group.rawGroup GC.•-ε-group) (Group.rawGroup GP.•-ε-group) (ι ʷ)
circuits≅paper = StarGroupIsomorphism.isGroupIsomorphism ι κ ι-ax ικ κ-ax κι
