private
  variable
    n : ℕ

-- Equality of Figure-8 words: the congruence generated by the rule set.
infix 4 _≈ᶠ_
_≈ᶠ_ : {n : ℕ} → F8.Circuit n → F8.Circuit n → Set
_≈ᶠ_ {n} = PB._≈_ (n CRel,_===_)

------------------------------------------------------------------------
-- The structural rules
--
-- cong↑: shifting a circuit up one wire leaves the new wire 0 alone and
-- runs the old action on the tail (CliffordGroup.cact-↑), so equal action
-- is preserved.

sound-↑ : {w v : Word (Gen n)} → w ≈ᶜ v → (w ↑) ≈ᶜ (v ↑)
sound-↑ {w = w} {v = v} h (s , q ∷ qs) = begin
  cact (w ↑) (s , q ∷ qs)
    ≡⟨ cact-↑ w s q qs ⟩
  proj₁ (cact w (s , qs)) , q ∷ proj₂ (cact w (s , qs))
    ≡⟨ Eq.cong (λ y → proj₁ y , q ∷ proj₂ y) (h (s , qs)) ⟩
  proj₁ (cact v (s , qs)) , q ∷ proj₂ (cact v (s , qs))
    ≡⟨ Eq.sym (cact-↑ v s q qs) ⟩
  cact (v ↑) (s , q ∷ qs) ∎
  where open Eq.≡-Reasoning

-- comm₁/comm₂: a gate at the bottom and a generator shifted up past it
-- touch disjoint wires.  Their Pauli components therefore commute on the
-- nose, and the two conjugation phases — neither of which sees the other
-- gate's wires — only swap order.

comm₁-sound : (h : SympGate 1) (g : Gen n) →
              ([ g ↥ ]ʷ • [ gate₁ h ]ʷ) ≈ᶜ ([ gate₁ h ]ʷ • [ g ↥ ]ʷ)
comm₁-sound H-gate g (s , (a , b) ∷ ps) =
  Eq.cong₂ _,_ (swap-add s (ι (a * b)) (δ g ps)) Eq.refl
comm₁-sound S-gate g (s , (a , b) ∷ ps) =
  Eq.cong₂ _,_ (swap-add s (incl a) (δ g ps)) Eq.refl

comm₂-sound : (h : SympGate 2) (g : Gen n) →
              ([ g ↥ ↥ ]ʷ • [ gate₂ h ]ʷ) ≈ᶜ ([ gate₂ h ]ʷ • [ g ↥ ↥ ]ʷ)
comm₂-sound CZ-gate g (s , (a , b) ∷ (a' , b') ∷ ps) =
  Eq.cong₂ _,_ (swap-add s (ι (a * a')) (δ g ps)) Eq.refl

-- The same for a shifted WORD, which is what the structural rules need
-- once they are read through D: the translation of a shifted generator
-- is a shifted word, not a letter.  Both are the generator lemma walked
-- across a concatenation, using only that cact of a product is the
-- composite.

comm₁-sound-w : (h : SympGate 1) (w : Word (Gen n)) →
                ((w ↑) • [ gate₁ h ]ʷ) ≈ᶜ ([ gate₁ h ]ʷ • (w ↑))
comm₁-sound-w h [ x ]ʷ  = comm₁-sound h x
comm₁-sound-w h ε       = λ _ → Eq.refl
comm₁-sound-w h (u • v) = λ x →
  Eq.trans (Eq.cong (cact (u ↑)) (comm₁-sound-w h v x))
           (comm₁-sound-w h u (cact (v ↑) x))

comm₂-sound-w : (h : SympGate 2) (w : Word (Gen n)) →
                (((w ↑) ↑) • [ gate₂ h ]ʷ) ≈ᶜ ([ gate₂ h ]ʷ • ((w ↑) ↑))
comm₂-sound-w h [ x ]ʷ  = comm₂-sound h x
comm₂-sound-w h ε       = λ _ → Eq.refl
comm₂-sound-w h (u • v) = λ x →
  Eq.trans (Eq.cong (cact ((u ↑) ↑)) (comm₂-sound-w h v x))
           (comm₂-sound-w h u (cact ((v ↑) ↑) x))

------------------------------------------------------------------------
-- Centrality of the scalar
--
-- cω is sound for a cheaper reason than the numbered relations: ω acts
-- as the identity on P4 (Action.cact-ω), so both sides of ω · g = g · ω
-- act exactly as g does.  No case analysis on the Pauli is needed —
-- cact-ω has already done it.

cω-sound : (g : Gen (₁₊ n)) → (ω • [ g ]ʷ) ≈ᶜ ([ g ]ʷ • ω)
cω-sound g x = Eq.trans (cact-ω (cact [ g ]ʷ x))
                        (Eq.sym (Eq.cong (cact [ g ]ʷ) (cact-ω x)))

-- The same for a whole word.
ω-comm-sound : (w : Word (Gen (₁₊ n))) → (ω • w) ≈ᶜ (w • ω)
ω-comm-sound w x = Eq.trans (cact-ω (cact w x))
                            (Eq.sym (Eq.cong (cact w) (cact-ω x)))

-- ... and so is cω↑, for the same reason one wire up: cact-↑ runs the
-- action of ω on the tail, where cact-ω says it is the identity.
cω↑-sound : ((ω {n}) ↑) ≈ᶜ (ω {₁₊ n})
cω↑-sound (s , q ∷ qs) =
  Eq.trans (cact-↑ ω s q qs)
    (Eq.trans (Eq.cong (λ y → proj₁ y , q ∷ proj₂ y) (cact-ω (s , qs)))
              (Eq.sym (cact-ω (s , q ∷ qs))))

------------------------------------------------------------------------
-- Closing the induction: Figure 8 is sound for the P4 action
--
-- Every axiom has its lemma above (or in Selinger.Action); cong↑ is
-- sound-↑, comm₁ / comm₂ are the two lemmas of the structural section,
-- and C4 is an identity since ω is the derived word (SH)³.  The
-- congruence cases are structural: cact of a concatenation is the
-- composite, so assoc and the two unit laws hold on the nose.
--
-- This is the sound field of Qubit.ExactExtension.ExactData.

axiom-soundᶠ : {n : ℕ} {w v : F8.Circuit n} → (n CRel, w === v) → D w ≈ᶜ D v
-- C1 is stated at every width now that ω is 0-ary; at width 0 its
-- translation is a nest of ε's, which acts as the identity outright.
axiom-soundᶠ {₀}    (srel c1) = λ _ → Eq.refl
axiom-soundᶠ {₁₊ _} (srel c1) = c1-sound'
axiom-soundᶠ (srel c2)      = c2-sound
axiom-soundᶠ (srel c3)      = c3-sound
axiom-soundᶠ (srel c4)      = λ _ → Eq.refl
axiom-soundᶠ (srel c5)      = c5-sound
axiom-soundᶠ (srel c6)      = c6-sound
axiom-soundᶠ (srel c7)      = c7-sound
axiom-soundᶠ (srel c8)      = c8-sound
axiom-soundᶠ (srel c9)      = c9-sound
axiom-soundᶠ (srel c10)     = c10-sound
axiom-soundᶠ (srel c11)     = c11-sound
axiom-soundᶠ (srel c12)     = c12-sound
axiom-soundᶠ (srel c13)     = c13-sound
axiom-soundᶠ (srel c14)     = c14-sound
axiom-soundᶠ (srel c15)     = c15-sound
-- Width-independence is structural now (ω↑=ω); it used to be a Figure-8
-- axiom of its own, cω↑, as was centrality, cω, which is now
-- Circuit.Base's theorem comm₀ and so needs no case here.
-- (ω↑=ω only exists at ₁₊ n: it is about a shift, so there is a wire.
-- At width 1 the wire below is width 0, where the scalar translates to
-- ε, so the two sides read ε ≈ᶜ (SH)³ — which is cact-ω backwards.)
axiom-soundᶠ {₁₊ ₀}      (ω↑=ω ω-gate) = ≈ᶜ-sym {w = ω} {v = ε} cact-ω
axiom-soundᶠ {₁₊ (₁₊ _)} (ω↑=ω ω-gate) = cω↑-sound
-- D commutes with the shift (Relabel.D-↑), so the induction goes
-- through unchanged once the two sides are rewritten.
axiom-soundᶠ (cong↑ {w = w} {v = v} r) =
  Eq.subst₂ _≈ᶜ_ (Eq.sym (D-↑ w)) (Eq.sym (D-↑ v))
            (sound-↑ {w = D w} {v = D v} (axiom-soundᶠ r))
axiom-soundᶠ (comm₁ F8.H-gate g)  = comm₁-sound-w H-gate  (ex→sym g)
axiom-soundᶠ (comm₁ F8.S-gate g)  = comm₁-sound-w S-gate  (ex→sym g)
axiom-soundᶠ (comm₂ F8.CZ-gate g) = comm₂-sound-w CZ-gate (ex→sym g)

-- Read across D, since the two congruences no longer share an alphabet.
-- D is a monoid map, so the structural cases are unchanged: it takes a
-- concatenation to a concatenation and ε to ε, on the nose.
sound : {n : ℕ} {w v : F8.Circuit n} → w ≈ᶠ v → D w ≈ᶜ D v
sound {w = w}          PB.refl         = ≈ᶜ-refl {w = D w}
sound {w = w} {v}      (PB.sym e)      = ≈ᶜ-sym {w = D v} {v = D w} (sound e)
sound {w = w} {v}      (PB.trans {v = u} e f) =
  ≈ᶜ-trans {w = D w} {v = D u} {u = D v} (sound e) (sound f)
sound (PB.cong {w = a} {w' = a'} {v = b} {v' = b'} e f) =
  ∙-congᶜ {w = D a} {D a'} {D b} {D b'} (sound e) (sound f)
sound {w = w}          PB.assoc        = ≈ᶜ-refl {w = D w}
sound {w = w}          PB.left-unit    = ≈ᶜ-refl {w = D w}
sound {w = w}          PB.right-unit   = ≈ᶜ-refl {w = D w}
sound (PB.axiom x)                     = axiom-soundᶠ x
