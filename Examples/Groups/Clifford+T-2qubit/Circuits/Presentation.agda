------------------------------------------------------------------------
-- Presentations of groups
--
-- The 2-qubit Clifford+T group is presented by the circuits of
-- Circuits.Syntactics on two wires
--
-- A circuit denotes the matrix of its reading in the paper's alphabet
-- (Circuits.Iso.ι); the reading is a group isomorphism of the presented
-- groups, and the paper's semantics a group monomorphism into
-- U₄(ℤ[1/√2,i]) (Presentation), so their composite is one too.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

module Examples.Groups.Clifford+T-2qubit.Circuits.Presentation where

import Algebra.Morphism.Construct.Composition as Compose
open import Algebra.Bundles using (Group)
open import Algebra.Morphism.Structures using (module GroupMorphisms)
open import Function using (_∘_)
open import Word.Base using (_ʷ)

open import Presentation.Definitions using (_IsSubPresentationOf_)

open import Examples.Groups.Clifford+T-2qubit.Circuits.Syntactics
open import Examples.Groups.Clifford+T-2qubit.Circuits.Iso using (ι ; circuits≅paper)
import Examples.Groups.Clifford+T-2qubit.Presentation as P
open import Examples.Groups.Clifford+T-2qubit-TwoLevel.Semantics using (UMat ; U)

private
  module PP = _IsSubPresentationOf_ P.presentation

-- The matrix of a two-wire circuit.
⟦_⟧ : Circuit 2 → UMat 4
⟦_⟧ = P.⟦_⟧ ∘ (ι ʷ)

-- The relations present the subgroup of U₄(ℤ[1/√2,i]) generated by
-- the Clifford+T gates.
presentation : (2 VRel,_===_) IsSubPresentationOf U 4
presentation = record
  { gl   = grouplike
  ; ⟦_⟧  = ⟦_⟧
  ; mono = Compose.isGroupMonomorphism {G₃ = Group.rawGroup (U 4)}
             (λ {i} {j} {k} → Group.trans (U 4) {i} {j} {k})
             {f = ι ʷ} {g = P.⟦_⟧}
             (GroupMorphisms.IsGroupIsomorphism.isGroupMonomorphism circuits≅paper) PP.mono
  }
