------------------------------------------------------------------------
-- Presentations of groups
--
-- The derivations, from the rules on 2 wires, that the
-- Reidemeister–Schreier step from Symmetric's presentation needs
--
-- GENERATED by gen/mk_narrow.py from gen/narrow2.json, which
-- gen/narrow.py finds by a proof-producing Knuth–Bendix completion of
-- the rules.  Θ d is the edge Toffoli of the states d and d + 1 along
-- the Gray code, the circuit of their transposition.  The equations
-- order0, …, braid0, … and far0-2, … are the Coxeter relations
-- between the Θ d, and gate-… says which word in the Θ d a gate on
-- its own wires is.  Each is a run of the engine: every step rewrites by an axiom
-- ax-… (a rule of Theory, a law of the swap or a structural rule, at
-- this width) or by a rule R… of the completion, itself derived from
-- earlier ones.  order, braid and far collect them by index, under
-- guards that compute.
------------------------------------------------------------------------

{-# OPTIONS --cubical-compatible --safe #-}

module Examples.Groups.Alt16-RevCir.Width2.Derivations where

open import Data.Bool.Base using (T)
open import Data.List.Base using (List ; [] ; _∷_)
open import Data.Nat.Base using (ℕ ; suc ; _+_ ; _≤ᵇ_)
open import Relation.Binary.PropositionalEquality using (refl)
open import Word.Base using (ε ; _•_)

import Presentation.Base as PB

open import Examples.Groups.Alt16-RevCir.Syntactics
  using ( Gen ; Circuit ; X-gate ; CX-gate ; Ex-gate ; CCX-gate
        ; gate₁ ; gate₂ ; gate₃ ; _↥ ; σ-inv ; σ-nat₁ ; σ-nat₂ )
open import Examples.Groups.Alt16-RevCir.Theory
  using (_TRel,_===_ ; r1 ; r2 ; r3 ; r4 ; r5 ; r6 ; module T)

open import Examples.Groups.Alt16-RevCir.Engine _TRel,_===_ public
  using (Eqn ; ⟪_⟫ ; eqn→)
open import Examples.Groups.Alt16-RevCir.Engine _TRel,_===_
  using (eqnʷ ; sym⁼ ; rw ; derive)

------------------------------------------------------------------------
-- Letters

x0 x1 cx0 ex0 : Gen 2
x0  = gate₁ X-gate
x1  = gate₁ X-gate ↥
cx0 = gate₂ CX-gate
ex0 = gate₂ Ex-gate

------------------------------------------------------------------------
-- The rules at this width

ax-r1 : Eqn 2
ax-r1 = eqnʷ (x0 ∷ x0 ∷ []) []
  (T.pad₁ (PB.axiom (T.srel (T.srel r1))) 1)
  refl refl

ax-r1↑ : Eqn 2
ax-r1↑ = eqnʷ (x1 ∷ x1 ∷ []) []
  (PB.axiom (T.cong↑ (T.srel (T.srel r1))))
  refl refl

ax-comm-ab : Eqn 2
ax-comm-ab = eqnʷ (x1 ∷ x0 ∷ []) (x0 ∷ x1 ∷ [])
  (PB.axiom (T.comm₁ X-gate (gate₁ X-gate)))
  refl refl

ax-r2 : Eqn 2
ax-r2 = eqnʷ (cx0 ∷ x1 ∷ cx0 ∷ x1 ∷ []) (x0 ∷ [])
  (PB.axiom (T.srel (T.srel r2)))
  refl refl

ax-r3 : Eqn 2
ax-r3 = eqnʷ (cx0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ cx0 ∷ []) (ex0 ∷ [])
  (PB.axiom (T.srel (T.srel r3)))
  refl refl

ax-ss : Eqn 2
ax-ss = eqnʷ (ex0 ∷ ex0 ∷ []) []
  (T.sym-rule σ-inv)
  refl refl

ax-nat-a : Eqn 2
ax-nat-a = eqnʷ (x0 ∷ ex0 ∷ []) (ex0 ∷ x1 ∷ [])
  (T.sym-rule (σ-nat₁ X-gate))
  refl refl

------------------------------------------------------------------------
-- The rules of the completion that the derivations use

R0 : Eqn 2
R0 = ax-r1

R1 : Eqn 2
R1 = ax-r1↑

R2 : Eqn 2
R2 = ax-comm-ab

R3 : Eqn 2
R3 = ax-r2

R4 : Eqn 2
R4 = ax-r3

R5 : Eqn 2
R5 = ax-ss

R6 : Eqn 2
R6 = sym⁼ ax-nat-a

R8 : Eqn 2
R8 = derive (ex0 ∷ x0 ∷ ex0 ∷ [])
  (x1 ∷ [])
  (rw 1 (sym⁼ R6) ∷ rw 0 R5 ∷ [])
  refl

R9 : Eqn 2
R9 = derive (ex0 ∷ x0 ∷ [])
  (x1 ∷ ex0 ∷ [])
  (rw 2 (sym⁼ R5) ∷ rw 0 R8 ∷ [])
  refl

R10 : Eqn 2
R10 = derive (cx0 ∷ x1 ∷ cx0 ∷ [])
  (x0 ∷ x1 ∷ [])
  (rw 3 (sym⁼ R1) ∷ rw 0 R3 ∷ [])
  refl

R11 : Eqn 2
R11 = derive (cx0 ∷ x0 ∷ [])
  (x0 ∷ cx0 ∷ [])
  (rw 2 (sym⁼ R1) ∷ rw 1 (sym⁼ R2) ∷ rw 2 (sym⁼ R10) ∷ rw 0 R10 ∷
     rw 1 R1 ∷ [])
  refl

R13 : Eqn 2
R13 = derive (cx0 ∷ x1 ∷ ex0 ∷ cx0 ∷ x1 ∷ ex0 ∷ [])
  (x0 ∷ ex0 ∷ cx0 ∷ [])
  (rw 1 (sym⁼ R9) ∷ rw 2 (sym⁼ R11) ∷ rw 3 (sym⁼ R2) ∷ rw 4 (sym⁼ R6) ∷
     rw 3 (sym⁼ R9) ∷ rw 4 (sym⁼ R10) ∷ rw 0 R4 ∷ rw 0 R6 ∷ [])
  refl

R15 : Eqn 2
R15 = derive (cx0 ∷ x1 ∷ ex0 ∷ cx0 ∷ x1 ∷ [])
  (x0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ [])
  (rw 5 (sym⁼ R5) ∷ rw 0 R13 ∷ [])
  refl

R18 : Eqn 2
R18 = derive (x0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ cx0 ∷ [])
  (x0 ∷ cx0 ∷ ex0 ∷ [])
  (rw 0 (sym⁼ R15) ∷ rw 3 R10 ∷ rw 2 R9 ∷ rw 1 R1 ∷ rw 1 R6 ∷ rw 0 R11 ∷ [])
  refl

R31 : Eqn 2
R31 = derive (ex0 ∷ cx0 ∷ ex0 ∷ cx0 ∷ [])
  (cx0 ∷ ex0 ∷ [])
  (rw 0 (sym⁼ R0) ∷ rw 1 R18 ∷ rw 0 R0 ∷ [])
  refl

R32 : Eqn 2
R32 = derive (cx0 ∷ cx0 ∷ ex0 ∷ [])
  (ex0 ∷ [])
  (rw 1 (sym⁼ R31) ∷ rw 0 R4 ∷ [])
  refl

R33 : Eqn 2
R33 = derive (cx0 ∷ cx0 ∷ [])
  []
  (rw 2 (sym⁼ R5) ∷ rw 0 R32 ∷ rw 0 R5 ∷ [])
  refl

R34 : Eqn 2
R34 = derive (x0 ∷ x1 ∷ cx0 ∷ [])
  (cx0 ∷ x1 ∷ [])
  (rw 0 (sym⁼ R10) ∷ rw 2 R33 ∷ [])
  refl

R35 : Eqn 2
R35 = derive (x0 ∷ cx0 ∷ x1 ∷ [])
  (x1 ∷ cx0 ∷ [])
  (rw 0 (sym⁼ R11) ∷ rw 1 (sym⁼ R10) ∷ rw 0 R33 ∷ [])
  refl

R36 : Eqn 2
R36 = derive (x1 ∷ cx0 ∷ x1 ∷ [])
  (x0 ∷ cx0 ∷ [])
  (rw 1 (sym⁼ R34) ∷ rw 0 R2 ∷ rw 1 R1 ∷ [])
  refl

R39 : Eqn 2
R39 = derive (x0 ∷ ex0 ∷ cx0 ∷ x1 ∷ [])
  (x1 ∷ ex0 ∷ cx0 ∷ [])
  (rw 0 (sym⁼ R6) ∷ rw 1 R36 ∷ rw 0 R9 ∷ [])
  refl

R40 : Eqn 2
R40 = derive (ex0 ∷ cx0 ∷ ex0 ∷ [])
  (cx0 ∷ ex0 ∷ cx0 ∷ [])
  (rw 1 (sym⁼ R31) ∷ rw 0 R5 ∷ [])
  refl

R41 : Eqn 2
R41 = derive (cx0 ∷ ex0 ∷ cx0 ∷ x1 ∷ [])
  (x1 ∷ cx0 ∷ ex0 ∷ cx0 ∷ [])
  (rw 0 (sym⁼ R40) ∷ rw 2 R6 ∷ rw 1 R11 ∷ rw 0 R9 ∷ rw 1 R40 ∷ [])
  refl

------------------------------------------------------------------------
-- The edge Toffolis along the Gray code

θ : ℕ → List (Gen 2)
θ 0 = x1 ∷ cx0 ∷ x1 ∷ []
θ 1 = ex0 ∷ cx0 ∷ ex0 ∷ []
θ 2 = cx0 ∷ []
θ _ = []

Θ : ℕ → Circuit 2
Θ d = ⟪ θ d ⟫

------------------------------------------------------------------------
-- The Coxeter relations and the gates

order0 : Eqn 2
order0 = derive (x1 ∷ cx0 ∷ x1 ∷ x1 ∷ cx0 ∷ x1 ∷ [])
  []
  (rw 0 R36 ∷ rw 0 R35 ∷ rw 1 R33 ∷ rw 0 R1 ∷ [])
  refl

order1 : Eqn 2
order1 = derive (ex0 ∷ cx0 ∷ ex0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ [])
  []
  (rw 0 R40 ∷ rw 1 R40 ∷ rw 0 R33 ∷ rw 1 R33 ∷ rw 0 R5 ∷ [])
  refl

order2 : Eqn 2
order2 = derive (cx0 ∷ cx0 ∷ [])
  []
  (rw 0 R33 ∷ [])
  refl

braid0 : Eqn 2
braid0 = derive (x1 ∷ cx0 ∷ x1 ∷ ex0 ∷ cx0 ∷ ex0 ∷ x1 ∷ cx0 ∷ x1 ∷ [])
  (ex0 ∷ cx0 ∷ ex0 ∷ x1 ∷ cx0 ∷ x1 ∷ ex0 ∷ cx0 ∷ ex0 ∷ [])
  (rw 0 R36 ∷ rw 2 R40 ∷ rw 1 R33 ∷ rw 0 R39 ∷ rw 2 R33 ∷ rw 1 R6 ∷ rw 0 R2 ∷
     rw 0 (sym⁼ R10) ∷ rw 2 (sym⁼ R5) ∷ rw 0 (sym⁼ R34) ∷ rw 0 (sym⁼ R2) ∷
     rw 1 (sym⁼ R11) ∷ rw 2 (sym⁼ R6) ∷ rw 3 (sym⁼ R33) ∷ rw 0 (sym⁼ R41) ∷
     rw 0 (sym⁼ R40) ∷ [])
  refl

braid1 : Eqn 2
braid1 = derive (ex0 ∷ cx0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ [])
  (cx0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ cx0 ∷ [])
  (rw 0 R40 ∷ rw 2 R33 ∷ rw 1 R5 ∷ rw 0 R33 ∷ rw 1 (sym⁼ R33) ∷
     rw 0 (sym⁼ R33) ∷ rw 1 (sym⁼ R40) ∷ [])
  refl

far0-2 : Eqn 2
far0-2 = derive (cx0 ∷ x1 ∷ cx0 ∷ x1 ∷ [])
  (x1 ∷ cx0 ∷ x1 ∷ cx0 ∷ [])
  (rw 0 R10 ∷ rw 1 R1 ∷ rw 1 (sym⁼ R33) ∷ rw 0 (sym⁼ R36) ∷ [])
  refl

gate-X0 : Eqn 2
gate-X0 = derive (x0 ∷ [])
  (x1 ∷ cx0 ∷ x1 ∷ cx0 ∷ [])
  (rw 1 (sym⁼ R33) ∷ rw 0 (sym⁼ R36) ∷ [])
  refl

gate-CX0 : Eqn 2
gate-CX0 = derive (cx0 ∷ [])
  (cx0 ∷ [])
  []
  refl

gate-Ex0 : Eqn 2
gate-Ex0 = derive (ex0 ∷ [])
  (ex0 ∷ cx0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ cx0 ∷ ex0 ∷ [])
  (rw 0 (sym⁼ R33) ∷ rw 1 (sym⁼ R5) ∷ rw 2 (sym⁼ R33) ∷ rw 0 (sym⁼ R40) ∷ [])
  refl

------------------------------------------------------------------------
-- By index

order : ∀ d → T (2 + d ≤ᵇ 4) → 2 T.⊢ Θ d • Θ d ≈ ε
order 0 _ = eqn→ order0 refl refl
order 1 _ = eqn→ order1 refl refl
order 2 _ = eqn→ order2 refl refl
order (suc (suc (suc d))) ()

braid : ∀ d → T (3 + d ≤ᵇ 4) →
        2 T.⊢ Θ d • Θ (suc d) • Θ d ≈ Θ (suc d) • Θ d • Θ (suc d)
braid 0 _ = eqn→ braid0 refl refl
braid 1 _ = eqn→ braid1 refl refl
braid (suc (suc d)) ()

far : ∀ d e → T (2 + d ≤ᵇ e) → T (2 + e ≤ᵇ 4) →
      2 T.⊢ Θ e • Θ d ≈ Θ d • Θ e
far 0 0 () _
far 0 1 () _
far 0 2 _ _ = eqn→ far0-2 refl refl
far 0 (suc (suc (suc e))) _ ()
far (suc d) 0 () _
far (suc d) 1 () _
far (suc d) 2 () _
far (suc d) (suc (suc (suc e))) _ ()
