-- H₂ turns u into u′.
Pushes : Word G₁ → Word G₁ → Set
Pushes u u′ = H2 • ↑ʷ u ≈ ↑ʷ u′ • H2

push• : {u u′ v v′ : Word G₁} → Pushes u u′ → Pushes v v′ → Pushes (u • v) (u′ • v′)
push• {u} {u′} {v} {v′} p q =
  trans (sym assoc) (trans (cong p refl) (trans assoc (trans (cong refl q) (sym assoc))))

pushε : Pushes ε ε
pushε = trans right-unit (sym left-unit)

