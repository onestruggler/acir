  Eq.trans (twist w (proj₁ (tk₀ r))) (Eq.trans (Eq.cong (λ X → R ·*· (X ·*· R)) (lift r₀)) (Eq.sym (twist v (proj₂ (tk₀ r)))))
  where
  r₀ = sound₀ r
  lift : ⟦ w ⟧ ≡ ⟦ v ⟧ → ⟦ w ⟧ₐ ≡ ⟦ v ⟧ₐ
  lift e = Eq.trans (⟦⟧ₐ-def w) (Eq.trans e (Eq.sym (⟦⟧ₐ-def v)))
sound-ax {w} {v} (fig7 r) =
  Eq.trans (fixed w (proj₁ (fix₇ r))) (Eq.trans (Eq.trans (⟦⟧ₐ-def w) (Eq.trans (sound₇ r) (Eq.sym (⟦⟧ₐ-def v))))
