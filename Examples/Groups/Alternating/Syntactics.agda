------------------------------------------------------------------------
-- Presentations of groups
--
-- Alternating groups 𝔄ₙ: gate type, circuit generators, and the
-- relations of Lafont's Theorem 4.
--
-- Y. Lafont, Towards an algebraic theory of Boolean circuits, J. Pure
-- Appl. Algebra 184 (2003) 257–310, Section 2.4.  The even
-- permutations form a monoidal subcategory 𝔄 of the permutations,
-- generated by the cyclic permutation ω : 3 → 3 of three adjacent
-- wires, and Theorem 4 says that ω and three relations present it.
-- Here that is a circuit presentation, as Examples.Groups.Symmetric is
-- for Sₙ: ω is a three-wire gate, the interchange law of the monoidal
-- category is Lift-Relation's structural rules (comm₃ is Lafont's
-- ω_i ω_j = ω_j ω_i for j > i + 2), and at width n the circuits are
-- the words in his generators ω₁, …, ω_{n−2} of 𝔄ₙ.
--
-- Conventions.  Wire 0 is the paper's leftmost wire, a generator g ↥
-- is the paper's id₁ | g, and words are in diagram order: w • v is w
-- then v, which the paper writes v ∘ w and draws with w on top.  So ω
-- sends the wire at position 0 to 1, 1 to 2 and 2 to 0; drawn on p. 267,
-- it is the crossing of the wires 1 2 followed by that of 0 1.
--
-- A Theory is a family of relations at every width, and T ∣ n ⊢ w ≈ v
-- is the congruence that Lift-Relation T generates at width n.  Three
-- theories present 𝔄ₙ here: Theorem 4's relations (this module), the
-- rules of Fig. 10 (Rules) and Theorem 4 with its second relation
-- replaced by (ω↑ ω)² = 1 (Alternative).
------------------------------------------------------------------------

{-# OPTIONS --cubical-compatible --safe #-}

module Examples.Groups.Alternating.Syntactics where

open import Data.Empty using (⊥)
open import Data.Fin using (suc)
open import Data.Nat using (ℕ ; suc)
open import Notations using (₃₊ ; ₄₊)
open import Word.Base using (Word ; WRel ; [_]ʷ ; ε ; _•_)

import Circuit.Base
import Presentation.Base as PB

private
  variable
    n : ℕ


------------------------------------------------------------------------
-- Width patterns

-- One more than Notations' ₄₊, overloaded over ℕ and Fin like it.
pattern ₅₊ k = suc (₄₊ k)

------------------------------------------------------------------------
-- Gate type

-- The one generating gate of 𝔄ₙ: the cyclic permutation of three
-- adjacent wires.
data Gate : ℕ → Set where
  ω-gate : Gate 3

------------------------------------------------------------------------
-- Syntactic framework

private module SC = Circuit.Base Gate

open SC public
  using ( Gen ; gate₀ ; gate₁ ; gate₂ ; gate₃ ; Circuit
        ; _↥ ; _↑ ; _↓ ; _↥ᵏ_ ; _↑ᵏ_ ; module Lift-Relation )

pattern ω-gen = gate₃ ω-gate

-- The cycle as a one-letter circuit, on the bottom three wires.
ω : Word (Gen (₃₊ n))
ω = [ ω-gen ]ʷ

-- Circuits on fewer than three wires have no gate.
no-gen₀ : Gen 0 → ⊥
no-gen₀ (gate₀ ())

no-gen₁ : Gen 1 → ⊥
no-gen₁ (gate₀ ())
no-gen₁ (gate₁ ())
no-gen₁ (g ↥) = no-gen₀ g

no-gen₂ : Gen 2 → ⊥
no-gen₂ (gate₀ ())
no-gen₂ (gate₁ ())
no-gen₂ (gate₂ ())
no-gen₂ (g ↥) = no-gen₁ g

------------------------------------------------------------------------
-- Theories and their congruences

-- Relations on circuits at every width, before the structural rules.
Theory : Set₁
Theory = (n : ℕ) → WRel (Gen n)

-- The congruence that a theory and the structural rules generate.
infix 4 _∣_⊢_≈_
_∣_⊢_≈_ : Theory → (n : ℕ) → Circuit n → Circuit n → Set
T ∣ n ⊢ w ≈ v = PB._≈_ (Lift-Relation._VRel,_===_ T n) w v

------------------------------------------------------------------------
-- Theorem 4's relations
--
-- As drawn on p. 267, read in diagram order.  order is ω³ = 1; near
-- relates two cycles one wire apart, and far two cycles two wires
-- apart; cycles three or more wires apart commute by comm₃.  On p. 268
-- the same relations are written ω_i³ = 1 and ω_i ω_{i+2} ω_i =
-- ω_{i+1} ω_i ω_{i+2} (in composition order), with the second one
-- replaced by (ω_i ω_{i+1})² = 1; see Alternative.

infix 4 _SRel,_===_
data _SRel,_===_ : (n : ℕ) → WRel (Gen n) where
  order : (₃₊ n) SRel, ω • ω • ω === ε
  near  : (₄₊ n) SRel, ω • ω ↑ • ω === ω ↑ • ω ↑
  far   : (₅₊ n) SRel, ω • ω ↑ ↑ • ω === ω ↑ ↑ • ω • ω ↑

------------------------------------------------------------------------
-- Full relation via Lift-Relation (adds the structural rules)

private module LR = Lift-Relation _SRel,_===_

-- comm₁, comm₂ and ω↑=ω are about gates of other arities, of which
-- this gate set has none; they are re-exported so that a client can
-- name them.
open LR public
  using ( srel ; cong↑ ; comm₁ ; comm₂ ; comm₃ ; ω↑=ω ; lemma-cong↑
        ; comm-gate₃-w↑↑↑ ; _VRel,_===_ )
