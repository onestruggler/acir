------------------------------------------------------------------------
-- Presentations of groups
--
-- Circuits generated by X, CX, CCX and H.
--
-- Wire 0 is the least significant basis bit.  The target of CX and
-- CCX is the bottom wire, and the controls are the following wires.
-- A shifted gate has the same ordering on its consecutive wires.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

module Examples.Groups.CCX+H.Syntactics where

open import Data.Nat.Base using (ℕ ; suc)
open import Word.Base using ([_]ʷ)

data Gate : ℕ → Set where
  X-gate H-gate : Gate 1
  CX-gate      : Gate 2
  CCX-gate     : Gate 3

open import Circuit.Base Gate public

private
  variable
    n : ℕ

X H : Circuit (suc n)
X = [ gate₁ X-gate ]ʷ
H = [ gate₁ H-gate ]ʷ

CX : Circuit (suc (suc n))
CX = [ gate₂ CX-gate ]ʷ

CCX : Circuit (suc (suc (suc n)))
CCX = [ gate₃ CCX-gate ]ʷ

------------------------------------------------------------------------
-- A gate's bottom wire, with its gate kind retained

data View : Set where
  at-X at-H at-CX at-CCX : ℕ → View

raise : View → View
raise (at-X p)   = at-X (suc p)
raise (at-H p)   = at-H (suc p)
raise (at-CX p)  = at-CX (suc p)
raise (at-CCX p) = at-CCX (suc p)

view : Gen n → View
view (gate₀ ())
view (gate₁ X-gate)   = at-X 0
view (gate₁ H-gate)   = at-H 0
view (gate₂ CX-gate)  = at-CX 0
view (gate₃ CCX-gate) = at-CCX 0
view (g ↥) = raise (view g)
