------------------------------------------------------------------------
-- Presentations of groups
--
-- The natural CCX+H rules as equations between letter lists
-- (Natural.Engine), at every width, for the derivations generated by
-- CCX+HH/Rules/natproofH.py.  Letters: x i = X on wire i, h i = H on
-- wire i, cx i = CX targeting wire i, ccx i.  Generated by
-- CCX+HH/Rules/gen_axiomsH.py.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

module Examples.Groups.CCX+H.Natural.Axioms where

open import Data.List.Base using (List ; [] ; _∷_)
open import Data.Nat.Base using (ℕ)
import Relation.Binary.PropositionalEquality as Eq
import Presentation.Base as PB
import Presentation.Properties as PP
open import Notations using (₁₊ ; ₂₊ ; ₃₊)

open import Examples.Groups.CCX+H.Natural.Syntactics
open import Examples.Groups.CCX+H.Natural.Engine using (Eqn ; eqn ; ⟪_⟫ ; invol)

private
  variable
    n : ℕ

pattern x₀ = gate₁ X-gate
pattern x₁ = gate₁ X-gate ↥
pattern x₂ = gate₁ X-gate ↥ ↥
pattern h₀ = gate₁ H-gate
pattern h₁ = gate₁ H-gate ↥
pattern h₂ = gate₁ H-gate ↥ ↥
pattern cx₀ = gate₂ CX-gate
pattern cx₁ = gate₂ CX-gate ↥
pattern ccx₀ = gate₃ CCX-gate

private
  ax : ∀ {m} {w v : Circuit m} (l r : List (Gen m)) → m N, w === v →
       m ⊢ ⟪ l ⟫ ≈ w → m ⊢ v ≈ ⟪ r ⟫ → Eqn m
  ax l r a p q = eqn l r (PB.trans p (PB.trans (PB.axiom (srel a)) q))

  as : ∀ {m} {w v : Circuit m} →
       PP.to-list (m VRel,_===_) w Eq.≡ PP.to-list (m VRel,_===_) v → m ⊢ w ≈ v
  as {m} = PP.by-assoc (m VRel,_===_)

-- Every letter is an involution.
inv⁼ : Gen n → Eqn n
inv⁼ y = eqn (y ∷ y ∷ []) [] (PB.trans (as Eq.refl) (invol y))

X²ᵉ : Eqn (₁₊ n)
X²ᵉ = ax (x₀ ∷ x₀ ∷ [])
  ([])
  X² (as Eq.refl) (as Eq.refl)

H²ᵉ : Eqn (₁₊ n)
H²ᵉ = ax (h₀ ∷ h₀ ∷ [])
  ([])
  H² (as Eq.refl) (as Eq.refl)

CX²ᵉ : Eqn (₂₊ n)
CX²ᵉ = ax (cx₀ ∷ cx₀ ∷ [])
  ([])
  CX² (as Eq.refl) (as Eq.refl)

CCX²ᵉ : Eqn (₃₊ n)
CCX²ᵉ = ax (ccx₀ ∷ ccx₀ ∷ [])
  ([])
  CCX² (as Eq.refl) (as Eq.refl)

XH⁸ᵉ : Eqn (₁₊ n)
XH⁸ᵉ = ax (x₀ ∷ h₀ ∷ x₀ ∷ h₀ ∷ x₀ ∷ h₀ ∷ x₀ ∷ h₀ ∷ x₀ ∷ h₀ ∷ x₀ ∷ h₀ ∷ x₀ ∷ h₀ ∷ x₀ ∷ h₀ ∷ [])
  ([])
  XH⁸ (as Eq.refl) (as Eq.refl)

X-controlᵣᵉ : Eqn (₂₊ n)
X-controlᵣᵉ = ax (h₀ ∷ h₁ ∷ cx₀ ∷ h₁ ∷ h₀ ∷ x₀ ∷ h₀ ∷ h₁ ∷ cx₀ ∷ h₁ ∷ h₀ ∷ [])
  (x₀ ∷ x₁ ∷ [])
  X-controlᵣ (as Eq.refl) (as Eq.refl)

H-swapᵉ : Eqn (₂₊ n)
H-swapᵉ = ax (cx₀ ∷ h₀ ∷ h₁ ∷ cx₀ ∷ h₁ ∷ h₀ ∷ cx₀ ∷ h₀ ∷ cx₀ ∷ h₀ ∷ h₁ ∷ cx₀ ∷ h₁ ∷ h₀ ∷ cx₀ ∷ [])
  (h₁ ∷ [])
  H-swap (as Eq.refl) (as Eq.refl)

CZ-XCᵉ : Eqn (₂₊ n)
CZ-XCᵉ = ax (h₀ ∷ cx₀ ∷ h₀ ∷ h₀ ∷ h₁ ∷ cx₀ ∷ h₁ ∷ h₀ ∷ h₀ ∷ cx₀ ∷ h₀ ∷ h₀ ∷ h₁ ∷ cx₀ ∷ h₁ ∷ h₀ ∷ [])
  (h₀ ∷ x₀ ∷ h₀ ∷ [])
  CZ-XC (as Eq.refl) (as Eq.refl)
