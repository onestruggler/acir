------------------------------------------------------------------------
-- Presentations of groups
--
-- Completeness at a fixed width from a proved coset table.
--
-- Given finitely many representatives rep c (letter lists), a table δ,
-- and for every state c and letter y an equation of the natural
-- calculus rep c ++ [y] = rep (δ c y) (generated by
-- CCX+HH/Rules/natproof.py from a coset enumeration), every circuit is
-- derivably equal to the representative its letters lead to.  If the
-- representatives have pairwise distinct matrices, two circuits with
-- the same matrix lead to the same representative (by soundness), so
-- they are derivably equal: the natural rules are complete at the
-- width.  No check that the table respects the relations is needed.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

open import Data.Fin.Base using (Fin)
open import Data.List.Base using (List ; [] ; _∷_ ; _++_)
open import Data.Nat.Base using (ℕ)
open import Relation.Binary.PropositionalEquality as Eq using (_≡_)

open import Examples.Groups.CCX+H.Natural.Syntactics
open import Examples.Groups.CCX+H.Natural.Engine using (Eqn ; lhs ; rhs ; prf ; ⟪_⟫ ; ⟪++⟫)
import Examples.Groups.CCX+H.Presentation as Sem

module Examples.Groups.CCX+H.Natural.Automaton
  (w N : ℕ)
  (rep : Fin N → List (Gen w))
  (δ : Fin N → Gen w → Fin N)
  (start : Fin N)
  (rep-start : rep start ≡ [])
  (fact : Fin N → Gen w → Eqn w)
  (fact-lhs : ∀ c y → lhs (fact c y) ≡ rep c ++ y ∷ [])
  (fact-rhs : ∀ c y → rhs (fact c y) ≡ rep (δ c y))
  (distinct : ∀ c d → Sem.interpret ⟪ rep c ⟫ ≡ Sem.interpret ⟪ rep d ⟫ → c ≡ d)
  where

open import Data.List.Properties using (++-assoc ; ++-identityʳ)
import Presentation.Base as PB
open import Presentation.Tactics.Words using (module Associative)
open import Examples.Groups.CCX+H.Natural.Soundness using (sound)
open PB (w VRel,_===_) using (_≈_ ; refl ; sym ; trans ; cong)
open Associative using (list-of-word ; lemma-list-of-word)

run : Fin N → List (Gen w) → Fin N
run c [] = c
run c (y ∷ ys) = run (δ c y) ys

private
  ⟪≡⟫ : {xs ys : List (Gen w)} → xs ≡ ys → ⟪ xs ⟫ ≈ ⟪ ys ⟫
  ⟪≡⟫ Eq.refl = refl

  -- One table equation, applied to a prefix.
  step : ∀ c y ys → ⟪ rep c ++ y ∷ ys ⟫ ≈ ⟪ rep (δ c y) ++ ys ⟫
  step c y ys = trans (⟪≡⟫ (Eq.sym (++-assoc (rep c) (y ∷ []) ys)))
    (trans (⟪++⟫ (rep c ++ y ∷ []) ys)
      (trans (cong (trans (⟪≡⟫ (Eq.sym (fact-lhs c y)))
                     (trans (prf (fact c y)) (⟪≡⟫ (fact-rhs c y)))) refl)
        (sym (⟪++⟫ (rep (δ c y)) ys))))

run-sound : ∀ c ys → ⟪ rep c ++ ys ⟫ ≈ ⟪ rep (run c ys) ⟫
run-sound c [] = ⟪≡⟫ (++-identityʳ (rep c))
run-sound c (y ∷ ys) = trans (step c y ys) (run-sound (δ c y) ys)

-- The representative a circuit leads to.
nf : Circuit w → Fin N
nf u = run start (list-of-word u)

nf-sound : ∀ u → u ≈ ⟪ rep (nf u) ⟫
nf-sound u = trans (lemma-list-of-word u)
  (trans (⟪≡⟫ (Eq.cong (_++ list-of-word u) (Eq.sym rep-start)))
    (run-sound start (list-of-word u)))

-- Completeness at the width.
complete : ∀ {u v : Circuit w} → Sem.interpret u ≡ Sem.interpret v → u ≈ v
complete {u} {v} e = trans (nf-sound u) (trans (⟪≡⟫ (Eq.cong rep same)) (sym (nf-sound v)))
  where
  same : nf u ≡ nf v
  same = distinct (nf u) (nf v)
    (Eq.trans (Eq.sym (sound (nf-sound u))) (Eq.trans e (sound (nf-sound v))))

