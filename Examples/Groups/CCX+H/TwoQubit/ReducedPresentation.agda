translated-axiom (Old.decoded T.r7a) =
  Calc.derive-equation {selected = []} (R.certificate ([]) 0 false Eq.refl) refl
translated-axiom (Old.decoded (T.r7b {a} {b} {c} {d} p q r _ _ _ _))
  with Table.full4 a b c d (lt p) (lt q) (lt r)
... | Eq.refl , Eq.refl , Eq.refl , Eq.refl =
  Calc.derive-equation {selected = selected r36} (R.certificate ([]) 1 false Eq.refl) (axiom (relator r36))
translated-axiom (Old.decoded (T.r7c {a} {b} p ea eb))
  with FP.toℕ-injective {i = a} {j = ₀} ea | FP.toℕ-injective {i = b} {j = ₁} eb
