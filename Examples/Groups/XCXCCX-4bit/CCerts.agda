-- A symbol with its bounds decided.
sy : Bool → (d : ℕ) → {_ : T (1 ≤ᵇ d)} → {_ : T (2 + d ≤ᵇ 8)} → Sch
sy c d {p} {q} = γ c d (ℕP.≤ᵇ⇒≤ 1 d p) (ℕP.≤ᵇ⇒≤ (2 + d) 8 q)

------------------------------------------------------------------------
-- The symbols as words of labels

Φ : Sch → List L
Φ (γ false 1 _ _) = (# 41 ∷ # 44 ∷ # 87 ∷ # 102 ∷ [])
Φ (γ false 2 _ _) = (# 15 ∷ # 30 ∷ [])
Φ (γ false 3 _ _) = (# 33 ∷ # 48 ∷ [])
Φ (γ false 4 _ _) = (# 51 ∷ # 66 ∷ [])
Φ (γ false 5 _ _) = (# 69 ∷ # 84 ∷ [])
Φ (γ false 6 _ _) = (# 87 ∷ # 102 ∷ [])
Φ (γ true 1 _ _) = (# 87 ∷ # 102 ∷ # 41 ∷ # 44 ∷ [])
Φ (γ true 2 _ _) = (# 15 ∷ # 30 ∷ [])
Φ (γ true 3 _ _) = (# 33 ∷ # 48 ∷ [])
Φ (γ true 4 _ _) = (# 51 ∷ # 66 ∷ [])
Φ (γ true 5 _ _) = (# 69 ∷ # 84 ∷ [])
Φ (γ true 6 _ _) = (# 87 ∷ # 102 ∷ [])
Φ _ = []

-- A word of symbols as a word of labels.
Φ* : Word Sch → List L
Φ* [ x ]ʷ   = Φ x
Φ* ε       = []
Φ* (u • v) = Φ* u ++ Φ* v

------------------------------------------------------------------------
-- The action of each symbol on the upper half

Φ-act-ok : (x : Sch) →
           allFin 8 (λ i → eqV (mF* (Φ x) (enc8 i)) (enc8 (SymI.⟦ f x ⟧ ⟨$⟩ʳ i))) ≡ true
Φ-act-ok (γ c zero () q)
Φ-act-ok (γ false 1 _ _) = Eq.refl
Φ-act-ok (γ false 2 _ _) = Eq.refl
Φ-act-ok (γ false 3 _ _) = Eq.refl
Φ-act-ok (γ false 4 _ _) = Eq.refl
Φ-act-ok (γ false 5 _ _) = Eq.refl
Φ-act-ok (γ false 6 _ _) = Eq.refl
Φ-act-ok (γ true 1 _ _) = Eq.refl
Φ-act-ok (γ true 2 _ _) = Eq.refl
Φ-act-ok (γ true 3 _ _) = Eq.refl
Φ-act-ok (γ true 4 _ _) = Eq.refl
Φ-act-ok (γ true 5 _ _) = Eq.refl
Φ-act-ok (γ true 6 _ _) = Eq.refl
Φ-act-ok (γ c (suc (suc (suc (suc (suc (suc (suc d))))))) p q) = Irr.⊥-elim (ℕP.≤⇒≤ᵇ q)

