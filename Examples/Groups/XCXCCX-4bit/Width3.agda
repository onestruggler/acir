     perm (Xₗ ↥ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 9 (sym⁼ (lift⁼ r1⁼)) ∷
     perm (Xₗ ↥ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 6 (sym⁼ (lift⁼ r1⁼)) ∷
     perm (Xₗ ↥ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 1 (cjSW0-57⁼) ∷
     perm (Xₗ ↥ ∷ CCXₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 3 (cjX1-57⁼) ∷
     perm (Xₗ ↥ ∷ CCXₗ ∷ Xₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 7 (cjSW0-57⁼) ∷ [])
  refl

-- the swap of wires 0, 1
genSW0⁼ : Eqn (₃₊ n)
genSW0⁼ = derive (σₗ ∷ [])
  (Xₗ ↥ ↥ ∷ CCXₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ Xₗ ↥ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ [])
  (perm (σₗ ∷ []) ∷
     rw 0 (by2 (σₗ ∷ []) (CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ []) refl) ∷
     perm (CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ []) ∷
     rw 0 (sym⁼ Wc⁼) ∷
     perm (Xₗ ↥ ↥ ∷ CCXₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ []) ∷
     rw 4 (sym⁼ me⁼) ∷
     perm (Xₗ ↥ ↥ ∷ CCXₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ σₗ ∷ σₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ σₗ ∷ CXₗ ∷ []) ∷
     rw 12 (sym⁼ Wc⁼) ∷
     perm (Xₗ ↥ ↥ ∷ CCXₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ Xₗ ↥ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ Xₗ ↥ ↥ ∷ CCXₗ ∷ []) ∷ [])
  refl

-- the CNOT from wire 2 to wire 1
genCX1⁼ : Eqn (₃₊ n)
genCX1⁼ = derive (CXₗ ↥ ∷ [])
  (σₗ ∷ CCXₗ ∷ Xₗ ↥ ∷ CCXₗ ∷ Xₗ ↥ ∷ σₗ ∷ [])
  (perm (CXₗ ↥ ∷ []) ∷
     rw 0 (sym⁼ σσ⁼) ∷
     perm (σₗ ∷ σₗ ∷ CXₗ ↥ ∷ []) ∷
     rw 1 (sym⁼ (lift⁼ σσ⁼)) ∷
     perm (σₗ ∷ σₗ ↥ ∷ σₗ ↥ ∷ σₗ ∷ CXₗ ↥ ∷ []) ∷
     rw 2 (sym⁼ σCX⁼) ∷
     perm (σₗ ∷ σₗ ↥ ∷ CXₗ ∷ σₗ ↥ ∷ σₗ ∷ []) ∷
     rw 1 (sym⁼ T4T6⁼) ∷ [])
  refl

-- the CNOT from wire 1 to wire 2
genCXd1⁼ : Eqn (₃₊ n)
genCXd1⁼ = derive (σₗ ↥ ∷ CXₗ ↥ ∷ σₗ ↥ ∷ [])
  (Xₗ ∷ σₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ↥ ∷ Xₗ ∷ Xₗ ∷ Xₗ ∷ σₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ↥ ∷ Xₗ ∷ Xₗ ∷ [])
  (perm (σₗ ↥ ∷ CXₗ ↥ ∷ σₗ ↥ ∷ []) ∷
     rw 1 (genCX1⁼) ∷
     perm (σₗ ↥ ∷ σₗ ∷ CCXₗ ∷ Xₗ ↥ ∷ CCXₗ ∷ Xₗ ↥ ∷ σₗ ∷ σₗ ↥ ∷ []) ∷
     rw 2 (T4T6⁼) ∷
     perm (σₗ ↥ ∷ σₗ ∷ σₗ ↥ ∷ CXₗ ∷ σₗ ↥ ∷ σₗ ∷ σₗ ↥ ∷ []) ∷
     rw 2 (sym⁼ T6T4⁼) ∷
     perm (σₗ ↥ ∷ σₗ ∷ Xₗ ↥ ∷ CCXₗ ∷ Xₗ ↥ ∷ CCXₗ ∷ σₗ ∷ σₗ ↥ ∷ []) ∷
     rw 5 (sym⁼ σσ⁼) ∷
     perm (σₗ ↥ ∷ σₗ ∷ Xₗ ↥ ∷ CCXₗ ∷ Xₗ ↥ ∷ σₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ↥ ∷ []) ∷
     rw 1 (cjSW0-45⁼) ∷
     perm (Xₗ ∷ σₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ↥ ∷ []) ∷
     rw 6 (sym⁼ (lift⁼ σσ⁼)) ∷
     perm (Xₗ ∷ σₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ Xₗ ∷ σₗ ↥ ∷ σₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ↥ ∷ []) ∷
     rw 7 (sym⁼ cjX0-26⁼) ∷
     perm (Xₗ ∷ σₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ↥ ∷ Xₗ ∷ Xₗ ∷ Xₗ ∷ σₗ ↥ ∷ σₗ ∷ CCXₗ ∷ σₗ ∷ σₗ ↥ ∷ Xₗ ∷ Xₗ ∷ []) ∷ [])
  refl

-- X on wire 1
genX1⁼ : Eqn (₃₊ n)
genX1⁼ = derive (Xₗ ↥ ∷ [])
  (σₗ ∷ Xₗ ∷ σₗ ∷ [])
  (perm (Xₗ ↥ ∷ []) ∷
     rw 1 (sym⁼ σσ⁼) ∷
     perm (Xₗ ↥ ∷ σₗ ∷ σₗ ∷ []) ∷
     rw 0 (by2 (Xₗ ↥ ∷ σₗ ∷ []) (σₗ ∷ Xₗ ∷ []) refl) ∷ [])
  refl

-- X on wire 2
genX2⁼ : Eqn (₃₊ n)
genX2⁼ = derive (Xₗ ↥ ↥ ∷ [])
  (σₗ ↥ ∷ Xₗ ↥ ∷ σₗ ↥ ∷ [])
  (perm (Xₗ ↥ ↥ ∷ []) ∷
     rw 1 (sym⁼ (lift⁼ σσ⁼)) ∷
     perm (Xₗ ↥ ↥ ∷ σₗ ↥ ∷ σₗ ↥ ∷ []) ∷
     rw 0 (lift⁼ (by2 (Xₗ ↥ ∷ σₗ ∷ []) (σₗ ∷ Xₗ ∷ []) refl)) ∷ [])
  refl

------------------------------------------------------------------------
-- An equation between letter lists, as one between any two words with
-- those letters.

via : ∀ {n} (e : Eqn n) {w v : Circuit n} →
      PP.to-list (n VRel,_===_) ⟪ lhs⁼ e ⟫ ≡ PP.to-list (n VRel,_===_) w →
      PP.to-list (n VRel,_===_) ⟪ rhs⁼ e ⟫ ≡ PP.to-list (n VRel,_===_) v → n ⊢ w ≈ v
via {n} e e₁ e₂ = PB.trans (PP.by-assoc (n VRel,_===_) (Eq.sym e₁))
                    (PB.trans (prf e) (PP.by-assoc (n VRel,_===_) e₂))

------------------------------------------------------------------------
-- The transpositions of consecutive states

T : ℕ → Circuit 3
T 0 = X ↑ ↑ • X ↑ • CCX • X ↑ • X ↑ ↑
T 1 = X ↑ ↑ • σ • CCX • σ • X ↑ ↑
T 2 = X ↑ ↑ • CCX • X ↑ ↑
T 3 = X • σ ↑ • σ • CCX • σ • σ ↑ • X
T 4 = CCX
T 5 = σ • CCX • σ
T 6 = X ↑ • CCX • X ↑
T _ = ε

private
  no : ∀ {m} → 9 + m ≤ 8 → ⊥
  no (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s ()))))))))

cox : Cox.Circuits.Coxeter 8 T (3 VRel,_===_)
cox = record { order = order ; braid = braid ; far = far }
  where
  order : ∀ i → 2 + i ≤ 8 → 3 ⊢ T i • T i ≈ ε
  order 0 _ = via T0²⁼ refl refl
  order 1 _ = via T1²⁼ refl refl
  order 2 _ = via T2²⁼ refl refl
  order 3 _ = via T3²⁼ refl refl
  order 4 _ = via T4²⁼ refl refl
  order 5 _ = via T5²⁼ refl refl
  order 6 _ = via T6²⁼ refl refl
  order (suc (suc (suc (suc (suc (suc (suc i))))))) p = ⊥-elim (no p)
  braid : ∀ i → 3 + i ≤ 8 → 3 ⊢ T i • T (suc i) • T i ≈ T (suc i) • T i • T (suc i)
  braid 0 _ = via braid0⁼ refl refl
  braid 1 _ = via braid1⁼ refl refl
  braid 2 _ = via braid2⁼ refl refl
  braid 3 _ = via braid3⁼ refl refl
  braid 4 _ = via braid4⁼ refl refl
  braid 5 _ = via braid5⁼ refl refl
  braid (suc (suc (suc (suc (suc (suc i)))))) p = ⊥-elim (no p)
  far : ∀ i j → 2 + i ≤ j → 2 + j ≤ 8 → 3 ⊢ T i • T j ≈ T j • T i
  far i (suc (suc (suc (suc (suc (suc (suc j))))))) p q = ⊥-elim (no q)
  far 0 0 () _
  far 0 1 (s≤s ()) _
  far 0 2 _ _ = via far02⁼ refl refl
  far 0 3 _ _ = via far03⁼ refl refl
  far 0 4 _ _ = via far04⁼ refl refl
  far 0 5 _ _ = via far05⁼ refl refl
  far 0 6 _ _ = via far06⁼ refl refl
  far 1 0 () _
  far 1 1 (s≤s ()) _
  far 1 2 (s≤s (s≤s ())) _
  far 1 3 _ _ = via far13⁼ refl refl
  far 1 4 _ _ = via far14⁼ refl refl
  far 1 5 _ _ = via far15⁼ refl refl
  far 1 6 _ _ = via far16⁼ refl refl
  far 2 0 () _
  far 2 1 (s≤s ()) _
  far 2 2 (s≤s (s≤s ())) _
  far 2 3 (s≤s (s≤s (s≤s ()))) _
  far 2 4 _ _ = via far24⁼ refl refl
  far 2 5 _ _ = via far25⁼ refl refl
  far 2 6 _ _ = via far26⁼ refl refl
  far 3 0 () _
  far 3 1 (s≤s ()) _
  far 3 2 (s≤s (s≤s ())) _
  far 3 3 (s≤s (s≤s (s≤s ()))) _
  far 3 4 (s≤s (s≤s (s≤s (s≤s ())))) _
  far 3 5 _ _ = via far35⁼ refl refl
  far 3 6 _ _ = via far36⁼ refl refl
  far 4 0 () _
  far 4 1 (s≤s ()) _
  far 4 2 (s≤s (s≤s ())) _
  far 4 3 (s≤s (s≤s (s≤s ()))) _
  far 4 4 (s≤s (s≤s (s≤s (s≤s ())))) _
  far 4 5 (s≤s (s≤s (s≤s (s≤s (s≤s ()))))) _
  far 4 6 _ _ = via far46⁼ refl refl
  far 5 0 () _
  far 5 1 (s≤s ()) _
  far 5 2 (s≤s (s≤s ())) _
  far 5 3 (s≤s (s≤s (s≤s ()))) _
  far 5 4 (s≤s (s≤s (s≤s (s≤s ())))) _
  far 5 5 (s≤s (s≤s (s≤s (s≤s (s≤s ()))))) _
  far 5 6 (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s ())))))) _
  far 6 0 () _
  far 6 1 (s≤s ()) _
  far 6 2 (s≤s (s≤s ())) _
  far 6 3 (s≤s (s≤s (s≤s ()))) _
  far 6 4 (s≤s (s≤s (s≤s (s≤s ())))) _
  far 6 5 (s≤s (s≤s (s≤s (s≤s (s≤s ()))))) _
  far 6 6 (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s ())))))) _
  far (suc (suc (suc (suc (suc (suc (suc i))))))) j p q =
    ⊥-elim (no (ℕP.≤-trans (ℕP.+-monoʳ-≤ 2 p) q))

------------------------------------------------------------------------
-- The numbering of the states, and the action of the T d

enc : Fin 8 → Bits 3
enc (zero) = (false ∷ false ∷ false ∷ [])
enc (suc zero) = (true ∷ false ∷ false ∷ [])
enc (suc (suc zero)) = (true ∷ true ∷ false ∷ [])
enc (suc (suc (suc zero))) = (false ∷ true ∷ false ∷ [])
enc (suc (suc (suc (suc zero)))) = (false ∷ true ∷ true ∷ [])
enc (suc (suc (suc (suc (suc zero))))) = (true ∷ true ∷ true ∷ [])
enc (suc (suc (suc (suc (suc (suc zero)))))) = (true ∷ false ∷ true ∷ [])
enc (suc (suc (suc (suc (suc (suc (suc zero))))))) = (false ∷ false ∷ true ∷ [])

dec : Bits 3 → Fin 8
dec (false ∷ false ∷ false ∷ []) = zero
dec (true ∷ false ∷ false ∷ []) = suc zero
dec (true ∷ true ∷ false ∷ []) = suc (suc zero)
dec (false ∷ true ∷ false ∷ []) = suc (suc (suc zero))
dec (false ∷ true ∷ true ∷ []) = suc (suc (suc (suc zero)))
dec (true ∷ true ∷ true ∷ []) = suc (suc (suc (suc (suc zero))))
dec (true ∷ false ∷ true ∷ []) = suc (suc (suc (suc (suc (suc zero)))))
dec (false ∷ false ∷ true ∷ []) = suc (suc (suc (suc (suc (suc (suc zero))))))

dec-enc : ∀ i → dec (enc i) ≡ i
dec-enc (zero) = refl
dec-enc (suc zero) = refl
dec-enc (suc (suc zero)) = refl
dec-enc (suc (suc (suc zero))) = refl
dec-enc (suc (suc (suc (suc zero)))) = refl
dec-enc (suc (suc (suc (suc (suc zero))))) = refl
dec-enc (suc (suc (suc (suc (suc (suc zero)))))) = refl
dec-enc (suc (suc (suc (suc (suc (suc (suc zero))))))) = refl

