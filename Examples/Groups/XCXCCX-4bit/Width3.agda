  s 0 = [ Sym.gate₂ Sym.σ-gate ]ʷ
  s 1 = [ Sym.gate₂ Sym.σ-gate Sym.↥ ]ʷ
  s 2 = [ Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥ ]ʷ
  s 3 = [ Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥ Sym.↥ ]ʷ
  s 4 = [ Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥ Sym.↥ Sym.↥ ]ʷ
  s 5 = [ Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥ Sym.↥ Sym.↥ Sym.↥ ]ʷ
  s _ = [ Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥ Sym.↥ Sym.↥ Sym.↥ Sym.↥ ]ʷ

  Pc : Word (Cox.SG 8) → Circuit 3
  Pc = Cox.Circuits.Pc 8 T 0

tw-X0 tw-CX0 tw-SW0 tw-X1 tw-CX1 tw-SW1 tw-X2 : Word (Cox.SG 8)
tw-X0  = s 4 • s 2 • s 6 • s 0
tw-CX0 = s 2 • s 4
tw-SW0 = s 2 • s 4 • s 1 • s 5 • s 2 • s 4
tw-X1  = tw-SW0 • tw-X0 • tw-SW0
tw-CX1 = tw-SW0 • (s 4 • s 6) • tw-SW0
tw-SW1 = tw-CX1 • (s 3 • tw-X0 • s 3 • tw-X0) • tw-CX1
tw-X2  = tw-SW1 • tw-X1 • tw-SW1

ok-X0 : 3 ⊢ X ≈ Pc tw-X0
ok-X0 = via X0b⁼ refl refl

ok-CX0 : 3 ⊢ CX ≈ Pc tw-CX0
ok-CX0 = via (sym⁼ Wc⁼) refl refl

ok-SW0 : 3 ⊢ σ ≈ Pc tw-SW0
ok-SW0 = via genSW0⁼ refl refl

ok-X1 : 3 ⊢ X ↑ ≈ Pc tw-X1
ok-X1 = PB.trans (via genX1⁼ {v = σ • X • σ} refl refl)
          (PB.cong ok-SW0 (PB.cong ok-X0 ok-SW0))

ok-CX1 : 3 ⊢ CX ↑ ≈ Pc tw-CX1
ok-CX1 = PB.trans (via genCX1⁼ {v = σ • (T 4 • T 6) • σ} refl refl)
           (PB.cong ok-SW0 (PB.cong PB.refl ok-SW0))

ok-CXd1 : 3 ⊢ σ ↑ • CX ↑ • σ ↑ ≈ Pc (s 3 • tw-X0 • s 3 • tw-X0)
ok-CXd1 = PB.trans (via genCXd1⁼ {v = T 3 • X • T 3 • X} refl refl)
            (PB.cong PB.refl (PB.cong ok-X0 (PB.cong PB.refl ok-X0)))

ok-SW1 : 3 ⊢ σ ↑ ≈ Pc tw-SW1
ok-SW1 = PB.trans (via (sym⁼ (lift⁼ r3⁼)) {v = CX ↑ • (σ ↑ • CX ↑ • σ ↑) • CX ↑} refl refl)
           (PB.cong ok-CX1 (PB.cong ok-CXd1 ok-CX1))

ok-X2 : 3 ⊢ X ↑ ↑ ≈ Pc tw-X2
ok-X2 = PB.trans (via genX2⁼ {v = σ ↑ • X ↑ • σ ↑} refl refl)
          (PB.cong ok-SW1 (PB.cong ok-X1 ok-SW1))

tw : Gen 3 → Word (Cox.SG 8)
tw (gate₀ ⌈ () ⌉)
tw (gate₁ ⌈ X-gate ⌉)       = tw-X0
tw (gate₂ ⌈ CX-gate ⌉)      = tw-CX0
tw (gate₂ swap)             = tw-SW0
tw (gate₃ ⌈ CCX-gate ⌉)     = s 4
tw (gate₀ ⌈ () ⌉ ↥)
tw (gate₁ ⌈ X-gate ⌉ ↥)     = tw-X1
tw (gate₂ ⌈ CX-gate ⌉ ↥)    = tw-CX1
tw (gate₂ swap ↥)           = tw-SW1
tw (gate₀ ⌈ () ⌉ ↥ ↥)
tw (gate₁ ⌈ X-gate ⌉ ↥ ↥)   = tw-X2
tw (gate₀ ⌈ () ⌉ ↥ ↥ ↥)

tw-ok : ∀ g → 3 ⊢ [ g ]ʷ ≈ Pc (tw g)
tw-ok (gate₀ ⌈ () ⌉)
tw-ok (gate₁ ⌈ X-gate ⌉)     = ok-X0
tw-ok (gate₂ ⌈ CX-gate ⌉)    = ok-CX0
tw-ok (gate₂ swap)           = ok-SW0
tw-ok (gate₃ ⌈ CCX-gate ⌉)   = PB.refl
tw-ok (gate₀ ⌈ () ⌉ ↥)
tw-ok (gate₁ ⌈ X-gate ⌉ ↥)   = ok-X1
tw-ok (gate₂ ⌈ CX-gate ⌉ ↥)  = ok-CX1
tw-ok (gate₂ swap ↥)         = ok-SW1
tw-ok (gate₀ ⌈ () ⌉ ↥ ↥)
tw-ok (gate₁ ⌈ X-gate ⌉ ↥ ↥) = ok-X2
tw-ok (gate₀ ⌈ () ⌉ ↥ ↥ ↥)

------------------------------------------------------------------------
-- Completeness on three wires

open Via 3 8 T cox enc dec dec-enc T-act tw tw-ok public
  using (translate ; translate-ok)
  renaming (complete to complete₃)
