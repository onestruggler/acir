------------------------------------------------------------------------
-- Presentations of groups
--
-- Proposition B.1: the theory is complete on one wire, and G₁ ≅ S₂
--
-- G₁ is generated by X, and X X = ε is rule (1).  So a one-wire circuit
-- is X to the parity of its number of letters (nf-ok), and its function
-- reads the parity back off the state 0 (sem-nf): two circuits with the
-- same function have the same parity, hence the same normal form.
------------------------------------------------------------------------

{-# OPTIONS --cubical-compatible --safe #-}

module Examples.Groups.XCXCCX-4bit.Width1 where

open import Data.Bool.Base using (Bool ; true ; false ; _xor_)
open import Data.Vec.Base using ([] ; _∷_)
open import Relation.Binary.PropositionalEquality as Eq using (_≡_ ; refl)

open import Word.Base using (Word ; [_]ʷ ; ε ; _•_)
import Presentation.Base as PB

open import Examples.Groups.XCXCCX-4bit.Syntactics
open import Examples.Groups.XCXCCX-4bit.Semantics

------------------------------------------------------------------------
-- The normal forms ε and X

nf : Bool → Circuit 1
nf false = ε
nf true  = X

-- The parity of the number of letters.
par : Circuit 1 → Bool
par [ gate₀ ⌈ () ⌉ ]ʷ
par [ gate₁ ⌈ X-gate ⌉ ]ʷ = true
par [ gate₀ ⌈ () ⌉ ↥ ]ʷ
par ε                     = false
par (u • v)               = par u xor par v

nf-• : (a b : Bool) → 1 ⊢ nf a • nf b ≈ nf (a xor b)
nf-• false b     = PB.left-unit
nf-• true  false = PB.right-unit
nf-• true  true  = PB.axiom (srel (srel r1))

-- Every one-wire circuit is its normal form.
nf-ok : (u : Circuit 1) → 1 ⊢ u ≈ nf (par u)
nf-ok [ gate₀ ⌈ () ⌉ ]ʷ
nf-ok [ gate₁ ⌈ X-gate ⌉ ]ʷ = PB.refl
nf-ok [ gate₀ ⌈ () ⌉ ↥ ]ʷ
nf-ok ε                     = PB.refl
nf-ok (u • v)               = PB.trans (PB.cong (nf-ok u) (nf-ok v)) (nf-• (par u) (par v))

-- The normal form's function, at the state 0.
sem-nf : (b : Bool) → ⟦ nf b ⟧ (false ∷ []) ≡ b ∷ []
sem-nf false = refl
sem-nf true  = refl

private
  head-inj : ∀ {a b : Bool} → _≡_ {A = Bits 1} (a ∷ []) (b ∷ []) → a ≡ b
  head-inj refl = refl

-- Completeness on one wire.
complete₁ : {u v : Circuit 1} → ⟦ u ⟧ ≐ ⟦ v ⟧ → 1 ⊢ u ≈ v
complete₁ {u} {v} e =
  PB.trans (nf-ok u)
    (PB.trans (Eq.subst (λ b → 1 ⊢ nf (par u) ≈ nf b) same-par PB.refl) (PB.sym (nf-ok v)))
  where
  at : (w : Circuit 1) → ⟦ w ⟧ (false ∷ []) ≡ par w ∷ []
  at w = Eq.trans (sound (nf-ok w) (false ∷ [])) (sem-nf (par w))
  same-par : par u ≡ par v
  same-par = head-inj (Eq.trans (Eq.sym (at u)) (Eq.trans (e (false ∷ [])) (at v)))
