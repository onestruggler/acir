------------------------------------------------------------------------
-- Presentations of groups
--
-- Reversible circuits over NOT, CNOT and Toffoli: the gates and the
-- theory T of "Block Normal Forms and Certified Equations for Four-Bit
-- Reversible Circuits" (pldi/four-bit-astra), Figure 1
--
-- The gates are X (NOT), CX (CNOT) and CCX (Toffoli), with the swap σ
-- structural (Examples.Independence.Prop): the circuits are the PROP
-- generated by the three gates, and Circuit.Prop's swap rules are the
-- paper's symmetric monoidal laws.
--
-- Wires.  Wire 0 is the bottom wire.  The paper numbers its wires from
-- the top, wire 1 being the most significant bit of a state, so on n
-- wires its wire w is our wire n − w.  CX has its control on wire 1 and
-- its target on wire 0, and CCX its controls on wires 2 and 1 and its
-- target on wire 0, as the paper draws them; a gate whose wires are not
-- in that position is conjugated by swaps.  A white control is the
-- black one conjugated by X on the control wire, as Section 2 defines
-- it.
--
-- Order.  Words are in diagram order: w • v is w followed by v, so each
-- side of a rule reads as its figure, left to right.  (The paper's
-- algebraic words are in composition order, the rightmost factor
-- first.)
--
-- The rules (Figure 1, equations (1)–(7)):
--
--   (1)  X X = id                                          one wire
--   (2)  CX_{1→2} ∘ (white-controlled CX_{1→2}) = X_2       two wires
--   (3)  CX_{1→2} CX_{2→1} CX_{1→2} = swap                  two wires
--   (4)  CCX_{12→3} ∘ (white on 1) CCX_{12→3} = CX_{2→3}    three wires
--   (5)  swap_{12} CCX_{12→3} swap_{12} = CCX_{12→3}        three wires
--   (6)  CX_{3→2} CCX_{12→3} CX_{3→2}
--          = CCX_{13→2} CCX_{12→3} CCX_{13→2}               three wires
--   (7)  CCX_{12→3} CX_{3→4} CCX_{12→3}
--          = CCX_{12→4} CX_{3→4}                            four wires
--
-- in the paper's numbering of wires, read left to right.
------------------------------------------------------------------------

{-# OPTIONS --cubical-compatible --safe #-}

module Examples.Groups.XCXCCX-4bit.Syntactics where

open import Data.Nat using (ℕ)
open import Word.Base using ([_]ʷ ; ε ; _•_)

open import Notations using (₁₊ ; ₂₊ ; ₃₊ ; ₄₊)

private
  variable
    n : ℕ

------------------------------------------------------------------------
-- Gates

data Gate : ℕ → Set where
  X-gate   : Gate 1
  CX-gate  : Gate 2
  CCX-gate : Gate 3

open import Examples.Independence.Prop Gate public

X : Circuit (₁₊ n)
X = [ gate₁ ⌈ X-gate ⌉ ]ʷ

CX : Circuit (₂₊ n)
CX = [ gate₂ ⌈ CX-gate ⌉ ]ʷ

CCX : Circuit (₃₊ n)
CCX = [ gate₃ ⌈ CCX-gate ⌉ ]ʷ

------------------------------------------------------------------------
-- Gates in other positions

-- CNOT with its control on wire 0 and its target on wire 1.
CX↓ : Circuit (₂₊ n)
CX↓ = σ • CX • σ

-- Toffoli with its controls on wires 2 and 0 and its target on wire 1
-- (the paper's CCX_{13→2} on three wires).
CCX↓ : Circuit (₃₊ n)
CCX↓ = σ • CCX • σ

-- Toffoli with its controls on wires 3 and 2 and its target on wire 0
-- (the paper's CCX_{12→4} on four wires).
CCX₃₂₀ : Circuit (₄₊ n)
CCX₃₂₀ = σ • CCX ↑ • σ

------------------------------------------------------------------------
-- The theory T (Figure 1)

infix 4 _SRel,_===_
data _SRel,_===_ : (n : ℕ) → CRel n where
  r1 : 1 SRel, X • X                       === ε
  r2 : 2 SRel, CX • X ↑ • CX • X ↑         === X
  r3 : 2 SRel, CX • CX↓ • CX               === σ
  r4 : 3 SRel, CCX • X ↑ ↑ • CCX • X ↑ ↑   === CX
  r5 : 3 SRel, σ ↑ • CCX • σ ↑             === CCX
  r6 : 3 SRel, CX↓ • CCX • CX↓             === CCX↓ • CCX • CCX↓
  r7 : 4 SRel, CCX ↑ • CX • CCX ↑          === CCX₃₂₀ • CX

open Lift-To-Prop _SRel,_===_ public
