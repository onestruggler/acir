------------------------------------------------------------------------
-- Presentations of groups
--
-- Proposition B.2: the theory is complete on two wires, and G₂ ≅ S₄
--
-- The states, in the paper's order 00, 01, 11, 10 (its x₁x₂, x₁ on our
-- wire 1), are numbered by enc; the transposition of consecutive states
-- is a circuit T d: T 0 the CNOT with a white control (X on wire 1
-- around CX), T 1 the CNOT from wire 0 to wire 1 (CX↓) and T 2 the CNOT
-- CX.  Their Coxeter relations follow from (1)–(3) and Appendix A
-- (T0 T2 = y = T2 T0 by (2); T1 T2 T1 = σ = T2 T1 T2 by (3); the braid
-- of T0 and T1 is that of T1 and T2 conjugated by X on wire 1, which
-- passes T1), every gate is a word in them (X on wire 0 is T2 T0 by
-- (2), the swap T2 T1 T2 by (3)), and ByCoxeter concludes.  The lemmas
-- are generated by gen/width2.py.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

module Examples.Groups.XCXCCX-4bit.Width2 where

open import Data.Bool.Base using (true ; false)
open import Data.Empty using (⊥ ; ⊥-elim)
open import Data.Fin.Base using (Fin ; zero ; suc)
open import Data.List.Base using (List ; [] ; _∷_)
open import Data.Nat.Base using (ℕ ; zero ; suc ; _+_ ; _≤_ ; s≤s)
import Data.Nat.Properties as ℕP
open import Data.Vec.Base using ([] ; _∷_)
open import Relation.Binary.PropositionalEquality as Eq using (_≡_ ; refl)

open import Word.Base using (Word ; [_]ʷ ; ε ; _•_)
import Presentation.Base as PB
import Presentation.Properties as PP

open import Notations using (₁₊ ; ₂₊)

import Examples.Groups.Symmetric.Syntactics as Sym
import Examples.Groups.Symmetric.Interpretation as SymI
open import Data.Fin.Permutation using (_⟨$⟩ʳ_)

open import Examples.Groups.XCXCCX-4bit.Syntactics
open import Examples.Groups.XCXCCX-4bit.Semantics
open import Examples.Groups.XCXCCX-4bit.Kit
open import Examples.Groups.XCXCCX-4bit.Involutions
import Examples.Groups.XCXCCX-4bit.Coxeter as Cox
open import Examples.Groups.XCXCCX-4bit.ByCoxeter

private
  variable
    n : ℕ

------------------------------------------------------------------------
-- The relations, on the bottom two wires of any circuit

-- T0 T0 = ε
T0²⁼ : Eqn (₂₊ n)
T0²⁼ = derive (Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ [])
  []
  (perm (Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 2 (lift⁼ r1⁼) ∷
     perm (Xₗ ↥ ∷ CXₗ ∷ CXₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 1 (CX²⁼) ∷
     perm (Xₗ ↥ ∷ Xₗ ↥ ∷ []) ∷
     rw 0 (lift⁼ r1⁼) ∷ [])
  refl

-- T1 T1 = ε
T1²⁼ : Eqn (₂₊ n)
T1²⁼ = derive (σₗ ∷ CXₗ ∷ σₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ [])
  []
  (perm (σₗ ∷ CXₗ ∷ σₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ []) ∷
     rw 2 (σσ⁼) ∷
     perm (σₗ ∷ CXₗ ∷ CXₗ ∷ σₗ ∷ []) ∷
     rw 1 (CX²⁼) ∷
     perm (σₗ ∷ σₗ ∷ []) ∷
     rw 0 (σσ⁼) ∷ [])
  refl

-- T0 T2 = T2 T0
far02⁼ : Eqn (₂₊ n)
far02⁼ = derive (Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ CXₗ ∷ [])
  (CXₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ [])
  (perm (Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ CXₗ ∷ []) ∷
     rw 0 (xaxa⁼) ∷
     perm (Xₗ ∷ []) ∷
     rw 0 (sym⁼ r2⁼) ∷ [])
  refl

-- T1 T2 T1 = T2 T1 T2: both are the swap
braid12⁼ : Eqn (₂₊ n)
braid12⁼ = derive (σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ [])
  (CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ [])
  (perm (σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ []) ∷
     rw 1 (r3⁼) ∷
     perm (σₗ ∷ σₗ ∷ σₗ ∷ []) ∷
     rw 0 (σσ⁼) ∷
     perm (σₗ ∷ []) ∷
     rw 0 (sym⁼ r3⁼) ∷ [])
  refl

-- b v = x
bv⁼ : Eqn (₂₊ n)
bv⁼ = derive (σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ [])
  (Xₗ ↥ ∷ [])
  (perm (σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ []) ∷
     rw 3 (σX⁼) ∷
     perm (σₗ ∷ CXₗ ∷ σₗ ∷ σₗ ∷ Xₗ ↥ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ []) ∷
     rw 2 (σσ⁼) ∷
     perm (σₗ ∷ CXₗ ∷ Xₗ ↥ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ []) ∷
     rw 4 (sym⁼ xσ⁼) ∷
     perm (σₗ ∷ CXₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ σₗ ∷ []) ∷
     rw 1 (r2⁼) ∷
     perm (σₗ ∷ Xₗ ∷ σₗ ∷ []) ∷
     rw 1 (σX⁼) ∷
     perm (σₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 0 (σσ⁼) ∷ [])
  refl

-- x b = b x: X on wire 1 passes the CNOT that targets it
xb⁼ : Eqn (₂₊ n)
xb⁼ = derive (Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ [])
  (σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ [])
  (perm (Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ []) ∷
     rw 0 (sym⁼ bv⁼) ∷
     perm (σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ []) ∷
     rw 3 (vb⁼) ∷ [])
  refl

-- T0 T1 T0 = T1 T0 T1: the braid of T1 and T2, conjugated by x
braid01⁼ : Eqn (₂₊ n)
braid01⁼ = derive (Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ [])
  (σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ [])
  (perm (Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 2 (xb⁼) ∷
     perm (Xₗ ↥ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 5 (lift⁼ r1⁼) ∷
     perm (Xₗ ↥ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 1 (sym⁼ braid12⁼) ∷
     perm (Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 0 (xb⁼) ∷
     perm (σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 5 (sym⁼ (lift⁼ r1⁼)) ∷
     perm (σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ []) ∷
     rw 6 (xb⁼) ∷
     perm (σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ↥ ∷ Xₗ ↥ ∷ []) ∷
     rw 9 (lift⁼ r1⁼) ∷ [])
  refl

-- x = T2 T0 T1 T2 T0 T1
xT⁼ : Eqn (₂₊ n)
xT⁼ = derive (Xₗ ↥ ∷ [])
  (CXₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ CXₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ [])
  (perm (Xₗ ↥ ∷ []) ∷
     rw 0 (sym⁼ vb⁼) ∷
     perm (Xₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ []) ∷
     rw 0 (sym⁼ r2⁼) ∷
     perm (CXₗ ∷ Xₗ ↥ ∷ CXₗ ∷ Xₗ ↥ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ Xₗ ∷ σₗ ∷ CXₗ ∷ σₗ ∷ []) ∷
     rw 7 (sym⁼ r2⁼) ∷ [])
  refl

------------------------------------------------------------------------
-- An equation between letter lists, as one between any two words with
-- those letters.

via : ∀ {n} (e : Eqn n) {w v : Circuit n} →
      PP.to-list (n VRel,_===_) ⟪ lhs⁼ e ⟫ ≡ PP.to-list (n VRel,_===_) w →
      PP.to-list (n VRel,_===_) ⟪ rhs⁼ e ⟫ ≡ PP.to-list (n VRel,_===_) v → n ⊢ w ≈ v
via {n} e e₁ e₂ = PB.trans (PP.by-assoc (n VRel,_===_) (Eq.sym e₁))
                    (PB.trans (prf e) (PP.by-assoc (n VRel,_===_) e₂))

------------------------------------------------------------------------
-- The transpositions of consecutive states

T : ℕ → Circuit 2
T 0 = X ↑ • CX • X ↑
T 1 = CX↓
T 2 = CX
T _ = ε

private
  no : ∀ {m} → 5 + m ≤ 4 → ⊥
  no (s≤s (s≤s (s≤s (s≤s ()))))

  far-no : ∀ i j → 2 + suc i ≤ j → 2 + j ≤ 4 → ⊥
  far-no i j p q = no (ℕP.≤-trans (ℕP.+-monoʳ-≤ 2 p) q)

cox : Cox.Circuits.Coxeter 4 T (2 VRel,_===_)
cox = record { order = order ; braid = braid ; far = far }
  where
  order : ∀ i → 2 + i ≤ 4 → 2 ⊢ T i • T i ≈ ε
  order 0 _ = via T0²⁼ refl refl
  order 1 _ = via T1²⁼ refl refl
  order 2 _ = via CX²⁼ refl refl
  order (suc (suc (suc i))) p = ⊥-elim (no p)
  braid : ∀ i → 3 + i ≤ 4 → 2 ⊢ T i • T (suc i) • T i ≈ T (suc i) • T i • T (suc i)
  braid 0 _ = via braid01⁼ refl refl
  braid 1 _ = via braid12⁼ refl refl
  braid (suc (suc i)) p = ⊥-elim (no p)
  far : ∀ i j → 2 + i ≤ j → 2 + j ≤ 4 → 2 ⊢ T i • T j ≈ T j • T i
  far 0 0 () _
  far 0 1 (s≤s ()) _
  far 0 2 _ _ = via far02⁼ refl refl
  far 0 (suc (suc (suc j))) _ q = ⊥-elim (no q)
  far (suc i) j p q = ⊥-elim (far-no i j p q)

------------------------------------------------------------------------
-- The numbering of the states, and the action of the T d

enc : Fin 4 → Bits 2
enc zero                   = false ∷ false ∷ []
enc (suc zero)             = true  ∷ false ∷ []
enc (suc (suc zero))       = true  ∷ true  ∷ []
enc (suc (suc (suc zero))) = false ∷ true  ∷ []

dec : Bits 2 → Fin 4
dec (false ∷ false ∷ []) = zero
dec (true  ∷ false ∷ []) = suc zero
dec (true  ∷ true  ∷ []) = suc (suc zero)
dec (false ∷ true  ∷ []) = suc (suc (suc zero))

dec-enc : ∀ i → dec (enc i) ≡ i
dec-enc zero                   = refl
dec-enc (suc zero)             = refl
dec-enc (suc (suc zero))       = refl
dec-enc (suc (suc (suc zero))) = refl


private
  Sym⟦_⟧ : Cox.SG 4 → Fin 4 → Fin 4
  Sym⟦ g ⟧ i = SymI.⟦ [ g ]ʷ ⟧ ⟨$⟩ʳ i

T-act : ∀ (g : Cox.SG 4) (i : Fin 4) → ⟦ T (Cox.tr 0 g) ⟧ (enc i) ≡ enc (Sym⟦ g ⟧ i)
T-act (Sym.gate₂ Sym.σ-gate) (zero) = refl
T-act (Sym.gate₂ Sym.σ-gate) (suc zero) = refl
T-act (Sym.gate₂ Sym.σ-gate) (suc (suc zero)) = refl
T-act (Sym.gate₂ Sym.σ-gate) (suc (suc (suc zero))) = refl
T-act (Sym.gate₂ Sym.σ-gate Sym.↥) (zero) = refl
T-act (Sym.gate₂ Sym.σ-gate Sym.↥) (suc zero) = refl
T-act (Sym.gate₂ Sym.σ-gate Sym.↥) (suc (suc zero)) = refl
T-act (Sym.gate₂ Sym.σ-gate Sym.↥) (suc (suc (suc zero))) = refl
T-act (Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥) (zero) = refl
T-act (Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥) (suc zero) = refl
T-act (Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥) (suc (suc zero)) = refl
T-act (Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥) (suc (suc (suc zero))) = refl
T-act (Sym.gate₀ ()) i
T-act (Sym.gate₁ ()) i
T-act (Sym.gate₀ () Sym.↥) i
T-act (Sym.gate₁ () Sym.↥) i
T-act (Sym.gate₀ () Sym.↥ Sym.↥) i
T-act (Sym.gate₁ () Sym.↥ Sym.↥) i
T-act (Sym.gate₀ () Sym.↥ Sym.↥ Sym.↥) i
T-act (Sym.gate₁ () Sym.↥ Sym.↥ Sym.↥) i
T-act (Sym.gate₀ () Sym.↥ Sym.↥ Sym.↥ Sym.↥) i

------------------------------------------------------------------------
-- Every gate as a word in the T d

private
  s : ℕ → Word (Cox.SG 4)
  s 0 = [ Sym.gate₂ Sym.σ-gate ]ʷ
  s 1 = [ Sym.gate₂ Sym.σ-gate Sym.↥ ]ʷ
  s _ = [ Sym.gate₂ Sym.σ-gate Sym.↥ Sym.↥ ]ʷ

tw : Gen 2 → Word (Cox.SG 4)
tw (gate₀ ⌈ () ⌉)
tw (gate₁ ⌈ X-gate ⌉)     = s 2 • s 0
tw (gate₂ ⌈ CX-gate ⌉)    = s 2
tw (gate₂ swap)           = s 2 • s 1 • s 2
tw (gate₀ ⌈ () ⌉ ↥)
tw (gate₁ ⌈ X-gate ⌉ ↥)   = s 2 • s 0 • s 1 • s 2 • s 0 • s 1
tw (gate₀ ⌈ () ⌉ ↥ ↥)

tw-ok : ∀ g → 2 ⊢ [ g ]ʷ ≈ Cox.Circuits.Pc 4 T 0 (tw g)
tw-ok (gate₀ ⌈ () ⌉)
tw-ok (gate₁ ⌈ X-gate ⌉)   = via (sym⁼ r2⁼) refl refl
tw-ok (gate₂ ⌈ CX-gate ⌉)  = PB.refl
tw-ok (gate₂ swap)         = via (sym⁼ r3⁼) refl refl
tw-ok (gate₀ ⌈ () ⌉ ↥)
tw-ok (gate₁ ⌈ X-gate ⌉ ↥) = via xT⁼ refl refl
tw-ok (gate₀ ⌈ () ⌉ ↥ ↥)

------------------------------------------------------------------------
-- Completeness on two wires

open Via 2 4 T cox enc dec dec-enc T-act tw tw-ok public
  using (translate ; translate-ok)
  renaming (complete to complete₂)
