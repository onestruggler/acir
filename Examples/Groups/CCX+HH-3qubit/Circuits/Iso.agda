------------------------------------------------------------------------
-- Equations the paper does not state, by its completeness

private
  -- The stored reading, unfolded.
  ev : Word PGen → Mat 3
  ev [ g ]ʷ  = gateM g
  ev ε       = idM
  ev (u • t) = mulM (ev u) (ev t)

  readM-ev : (u : Word PGen) → I.readM u ≡ ev u
  readM-ev [ g ]ʷ  = I.readM-gen g
  readM-ev ε       = I.readM-ε
  readM-ev (u • t) = Eq.trans (I.readM-• u t) (Eq.cong₂ mulM (readM-ev u) (readM-ev t))

  decide : Word PGen → Word PGen → Bool
  decide u t = eqM (scaleM (√2^ I.len t) (ev u)) (scaleM (√2^ I.len u) (ev t))

  sem : ∀ (u t : Word PGen) → decide u t ≡ true → u ≈ᴾ t
  sem u t h = RP.completeness {u} {t} (I.by-matrix {u} {t}
    (Eq.trans (Eq.cong (scaleM (√2^ I.len t)) (readM-ev u))
    (Eq.trans (eqM-sound _ _ h)
              (Eq.sym (Eq.cong (scaleM (√2^ I.len u)) (readM-ev t))))))

  -- A structural commutation, by the matrices.
  comm-sem : ∀ (u t : Word PGen) → decide (u • t) (t • u) ≡ true → u • t ≈ᴾ t • u
  comm-sem u t = sem (u • t) (t • u)

