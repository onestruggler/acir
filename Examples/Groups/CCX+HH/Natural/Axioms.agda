------------------------------------------------------------------------
-- Presentations of groups
--
-- The natural rules as equations between letter lists (Natural.Engine),
-- at every width, for the derivations generated by
-- CCX+HH/Rules/natproof.py.  Letters: x i = X on wire i, cx i = CX
-- targeting wire i, ccx i, hh i.  Generated by CCX+HH/Rules/gen_axioms.py.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

module Examples.Groups.CCX+HH.Natural.Axioms where

open import Data.List.Base using (List ; [] ; _∷_)
open import Data.Nat.Base using (ℕ)
import Relation.Binary.PropositionalEquality as Eq
import Presentation.Base as PB
import Presentation.Properties as PP
open import Notations using (₁₊ ; ₂₊ ; ₃₊ ; ₄₊)

open import Examples.Groups.CCX+HH.Natural.Syntactics
open import Examples.Groups.CCX+HH.Natural.Engine using (Eqn ; eqn ; ⟪_⟫ ; invol)

private
  variable
    n : ℕ

pattern x₀ = gate₁ X-gate
pattern x₁ = gate₁ X-gate ↥
pattern x₂ = gate₁ X-gate ↥ ↥
pattern x₃ = gate₁ X-gate ↥ ↥ ↥
pattern cx₀ = gate₂ CX-gate
pattern cx₁ = gate₂ CX-gate ↥
pattern cx₂ = gate₂ CX-gate ↥ ↥
pattern hh₀ = gate₂ HH-gate
pattern hh₁ = gate₂ HH-gate ↥
pattern hh₂ = gate₂ HH-gate ↥ ↥
pattern ccx₀ = gate₃ CCX-gate
pattern ccx₁ = gate₃ CCX-gate ↥

private
  ax : ∀ {m} {w v : Circuit m} (l r : List (Gen m)) → m N, w === v →
       m ⊢ ⟪ l ⟫ ≈ w → m ⊢ v ≈ ⟪ r ⟫ → Eqn m
  ax l r a p q = eqn l r (PB.trans p (PB.trans (PB.axiom (srel a)) q))

  as : ∀ {m} {w v : Circuit m} →
       PP.to-list (m VRel,_===_) w Eq.≡ PP.to-list (m VRel,_===_) v → m ⊢ w ≈ v
  as {m} = PP.by-assoc (m VRel,_===_)

-- Every letter is an involution.
inv⁼ : Gen n → Eqn n
inv⁼ y = eqn (y ∷ y ∷ []) [] (PB.trans (as Eq.refl) (invol y))

X²ᵉ : Eqn (₁₊ n)
X²ᵉ = ax (x₀ ∷ x₀ ∷ [])
  ([])
  X² (as Eq.refl) (as Eq.refl)

CX²ᵉ : Eqn (₂₊ n)
CX²ᵉ = ax (cx₀ ∷ cx₀ ∷ [])
  ([])
  CX² (as Eq.refl) (as Eq.refl)

CCX²ᵉ : Eqn (₃₊ n)
CCX²ᵉ = ax (ccx₀ ∷ ccx₀ ∷ [])
  ([])
  CCX² (as Eq.refl) (as Eq.refl)

HH²ᵉ : Eqn (₂₊ n)
HH²ᵉ = ax (hh₀ ∷ hh₀ ∷ [])
  ([])
  HH² (as Eq.refl) (as Eq.refl)

X-controlᵉ : Eqn (₂₊ n)
X-controlᵉ = ax (x₁ ∷ cx₀ ∷ x₁ ∷ [])
  (cx₀ ∷ x₀ ∷ [])
  X-control (as Eq.refl) (as Eq.refl)

X-controlᵣᵉ : Eqn (₂₊ n)
X-controlᵣᵉ = ax (hh₀ ∷ cx₀ ∷ hh₀ ∷ x₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ [])
  (x₀ ∷ x₁ ∷ [])
  X-controlᵣ (as Eq.refl) (as Eq.refl)

CNOT-S3ᵉ : Eqn (₂₊ n)
CNOT-S3ᵉ = ax (cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ [])
  ([])
  CNOT-S3 (as Eq.refl) (as Eq.refl)

X-Zᵉ : Eqn (₂₊ n)
X-Zᵉ = ax (x₀ ∷ hh₀ ∷ x₁ ∷ hh₀ ∷ [])
  (hh₀ ∷ x₁ ∷ hh₀ ∷ x₀ ∷ [])
  X-Z (as Eq.refl) (as Eq.refl)

braidᵉ : Eqn (₃₊ n)
braidᵉ = ax (cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ [])
  (cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ [])
  braid (as Eq.refl) (as Eq.refl)

CX-upᵉ : Eqn (₃₊ n)
CX-upᵉ = ax (cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ cx₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ [])
  (cx₁ ∷ [])
  CX-up (as Eq.refl) (as Eq.refl)

CCX-symᵉ : Eqn (₃₊ n)
CCX-symᵉ = ax (cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ ccx₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ [])
  (ccx₀ ∷ [])
  CCX-sym (as Eq.refl) (as Eq.refl)

CCX-negᵉ : Eqn (₃₊ n)
CCX-negᵉ = ax (x₁ ∷ ccx₀ ∷ x₁ ∷ [])
  (ccx₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ cx₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ [])
  CCX-neg (as Eq.refl) (as Eq.refl)

CCX-XCᵉ : Eqn (₃₊ n)
CCX-XCᵉ = ax (ccx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ ccx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ [])
  (cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ ccx₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ ccx₀ ∷ [])
  CCX-XC (as Eq.refl) (as Eq.refl)

HH-swap₀ᵉ : Eqn (₃₊ n)
HH-swap₀ᵉ = ax (cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₁ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ [])
  (hh₀ ∷ hh₁ ∷ [])
  HH-swap₀ (as Eq.refl) (as Eq.refl)

HH-swap₁ᵉ : Eqn (₃₊ n)
HH-swap₁ᵉ = ax (cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ [])
  (hh₀ ∷ hh₁ ∷ [])
  HH-swap₁ (as Eq.refl) (as Eq.refl)

CCX-HHᵉ : Eqn (₃₊ n)
CCX-HHᵉ = ax (ccx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ hh₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ [])
  (hh₀ ∷ cx₀ ∷ hh₀ ∷ hh₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ ccx₀ ∷ [])
  CCX-HH (as Eq.refl) (as Eq.refl)

CCX-commᵉ : Eqn (₄₊ n)
CCX-commᵉ = ax (ccx₁ ∷ cx₀ ∷ ccx₁ ∷ cx₀ ∷ [])
  (cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ ccx₁ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ [])
  CCX-comm (as Eq.refl) (as Eq.refl)

CCX-upᵉ : Eqn (₄₊ n)
CCX-upᵉ = ax (cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ cx₂ ∷ hh₂ ∷ cx₂ ∷ hh₂ ∷ cx₂ ∷ ccx₀ ∷ cx₂ ∷ hh₂ ∷ cx₂ ∷ hh₂ ∷ cx₂ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ hh₁ ∷ cx₁ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ hh₀ ∷ cx₀ ∷ [])
  (ccx₁ ∷ [])
  CCX-up (as Eq.refl) (as Eq.refl)
