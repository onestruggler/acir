------------------------------------------------------------------------
-- Presentations of groups
--
-- Circuits generated by X, CX, CCX and HH = H tensor H.
-- Wire 0 is the bottom (least significant) wire.  Controls of CX and
-- CCX are above their target.  Other placements can use the derived
-- swap.  These are gate definitions, not a completeness claim.
------------------------------------------------------------------------

{-# OPTIONS --without-K --safe #-}

module Examples.Groups.CCX+HH.Syntactics where

open import Data.Nat.Base using (ℕ ; suc)
open import Word.Base using ([_]ʷ ; _•_)
import Circuit.Base

data Gate : ℕ → Set where
  X-gate   : Gate 1
  CX-gate  : Gate 2
  CCX-gate : Gate 3
  HH-gate  : Gate 2

private module C = Circuit.Base Gate
open C public using
  ( Gen ; Circuit ; gate₀ ; gate₁ ; gate₂ ; gate₃
  ; _↥ ; _↑ ; _↓ ; _↥ᵏ_ ; _↑ᵏ_ ; _↓ᵏ_ ; _↧ᵏ_ ; _↧ ; _⇓ )

pattern X-gen   = gate₁ X-gate
pattern CX-gen  = gate₂ CX-gate
pattern CCX-gen = gate₃ CCX-gate
pattern HH-gen  = gate₂ HH-gate

private variable n : ℕ

X : Circuit (suc n)
X = [ X-gen ]ʷ

CX HH : Circuit (suc (suc n))
CX = [ CX-gen ]ʷ
HH = [ HH-gen ]ʷ

CCX : Circuit (suc (suc (suc n)))
CCX = [ CCX-gen ]ʷ

-- Simultaneously conjugating both wires reverses CNOT's direction.
XC : Circuit (suc (suc n))
XC = HH • CX • HH

Ex : Circuit (suc (suc n))
Ex = CX • XC • CX

Z : Circuit (suc (suc n))
Z = HH • X • HH

minus-one : Circuit (suc (suc n))
minus-one = X • Z • X • Z
