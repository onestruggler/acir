opp-X0 : ∀ f (g′ : Gen (₄₊ m)) → pos g′ ≤ f → Opp (gate₁ {₃₊ m} X-gate) g′
opp-X0 f (gate₀ ()) _
opp-X0 f (gate₁ {₃₊ j} h′) _ =
  coreO 0 [ gate₁ {3} X-gate ]ʷ [ gate₁ {3} h′ ]ʷ tt j
opp-X0 f (gate₂ {₂₊ j} h′) _ =
  coreO 0 [ gate₁ {3} X-gate ]ʷ [ gate₂ {2} h′ ]ʷ tt j
opp-X0 f (gate₃ {₁₊ j} h′) _ =
  coreO 0 [ gate₁ {3} X-gate ]ʷ [ gate₃ {1} h′ ]ʷ tt j
opp-X0 f (gate₀ () ↥) _
opp-X0 f (gate₁ {₂₊ j} h′ ↥) _ =
  coreO 0 [ gate₁ {3} X-gate ]ʷ [ gate₁ {2} h′ ↥ ]ʷ tt j
opp-X0 f (gate₂ {₁₊ j} h′ ↥) _ =
  coreO 0 [ gate₁ {3} X-gate ]ʷ [ gate₂ {1} h′ ↥ ]ʷ tt j
opp-X0 f (gate₃ {j} h′ ↥) _ =
  coreO 0 [ gate₁ {3} X-gate ]ʷ [ gate₃ {0} h′ ↥ ]ʷ tt j
opp-X0 zero (g ↥ ↥) ()
opp-X0 (suc f) (g ↥ ↥) (s≤s p) =
  PB.trans (PB.cong PB.refl E)
  (PB.trans (PB.sym (conj-pass (apart₂ B₀ (Z g)) (PB.sym IH) (apart₂ B₀ (Z⁻ g))))
    (PB.cong (PB.sym E) PB.refl))
  where
  B₀ = CTRL (gate₁ {0} X-gate)
  Xc = [ gate₁ {1} X-gate ]ʷ
  E = PB.trans (PB.cong PB.refl (PB.cong (emb (move (g))) PB.refl))
        (slide (PB.sym (apart₂ Xc (Z g))) (PB.sym (apart₂ Xc (Z⁻ g))))
  IH = subst-C (CTRL₁-⇓ (g))
         (opp-X0 f ((g ↧) ↥) (Eq.subst (_≤ f) (Eq.sym (pos-↧ (g ↥))) p))

