------------------------------------------------------------------------
-- Tools

private
  -- An idle wire on top preserves derivations.
  top-cong : ∀ {u v : Circuit n} → n ⊢ u ≈ v → (₁₊ n) ⊢ u ⇓ ≈ v ⇓
  top-cong {u = u} {v} e =
    PB.trans (CY.top-is-bottom no-scalar u)
    (PB.trans (PB.cong PB.refl (PB.cong (lemma-cong↑ u v e) PB.refl))
      (PB.sym (CY.top-is-bottom no-scalar v)))

  -- A word passing B passes its conjugate by words passing B.
  conj-pass : ∀ {Y C Y⁻ B : Circuit n} →
    n ⊢ Y • B ≈ B • Y → n ⊢ C • B ≈ B • C → n ⊢ Y⁻ • B ≈ B • Y⁻ →
    n ⊢ (Y • (C • Y⁻)) • B ≈ B • (Y • (C • Y⁻))
  conj-pass YB CB Y⁻B =
    PB.trans PB.assoc
    (PB.trans (PB.cong PB.refl (PB.trans PB.assoc
      (PB.trans (PB.cong PB.refl Y⁻B)
      (PB.trans (PB.sym PB.assoc)
      (PB.trans (PB.cong CB PB.refl) PB.assoc)))))
    (PB.trans (PB.sym PB.assoc)
    (PB.trans (PB.cong YB PB.refl) PB.assoc)))

  -- A word passing Y and Y⁻ moves inside their conjugate.
  slide : ∀ {X Y C Y⁻ : Circuit n} → n ⊢ X • Y ≈ Y • X → n ⊢ X • Y⁻ ≈ Y⁻ • X →
    n ⊢ X • ((Y • (C • Y⁻)) • X) ≈ Y • ((X • (C • X)) • Y⁻)
  slide XY XY⁻ =
    PB.trans (PB.cong PB.refl PB.assoc)
    (PB.trans (PB.sym PB.assoc)
    (PB.trans (PB.cong XY PB.refl)
    (PB.trans PB.assoc
    (PB.trans (PB.cong PB.refl (PB.cong PB.refl PB.assoc))
    (PB.trans (PB.cong PB.refl (PB.cong PB.refl (PB.cong PB.refl (PB.sym XY⁻))))
    (PB.trans (PB.cong PB.refl (PB.cong PB.refl (PB.sym PB.assoc)))
      (PB.cong PB.refl (PB.sym PB.assoc))))))))

  -- Two conjugates by the same word.
  merge : ∀ {Kc A D Kc⁻ : Circuit n} → n ⊢ Kc⁻ • Kc ≈ ε →
    n ⊢ (Kc • (A • Kc⁻)) • (Kc • (D • Kc⁻)) ≈ Kc • ((A • D) • Kc⁻)
  merge e =
    PB.trans PB.assoc
    (PB.trans (PB.cong PB.refl PB.assoc)
    (PB.trans (PB.cong PB.refl (PB.cong PB.refl (PB.sym PB.assoc)))
    (PB.trans (PB.cong PB.refl (PB.cong PB.refl (PB.cong e PB.refl)))
    (PB.trans (PB.cong PB.refl (PB.cong PB.refl PB.left-unit))
      (PB.cong PB.refl (PB.sym PB.assoc))))))

  conj-comm : ∀ {Kc A D Kc⁻ : Circuit n} → n ⊢ Kc⁻ • Kc ≈ ε → n ⊢ A • D ≈ D • A →
    n ⊢ (Kc • (A • Kc⁻)) • (Kc • (D • Kc⁻)) ≈ (Kc • (D • Kc⁻)) • (Kc • (A • Kc⁻))
  conj-comm e AD =
    PB.trans (merge e) (PB.trans (PB.cong PB.refl (PB.cong AD PB.refl)) (PB.sym (merge e)))

  -- Conjugation by an involution.
  module Inv {X : Circuit n} (XX : n ⊢ X • X ≈ ε) where
    cj : Circuit n → Circuit n
    cj U = X • (U • X)

    cj-• : ∀ {U V} → n ⊢ cj (U • V) ≈ cj U • cj V
    cj-• = PB.sym
      (PB.trans PB.assoc
      (PB.trans (PB.cong PB.refl PB.assoc)
      (PB.trans (PB.cong PB.refl (PB.cong PB.refl (PB.sym PB.assoc)))
      (PB.trans (PB.cong PB.refl (PB.cong PB.refl (PB.cong XX PB.refl)))
      (PB.trans (PB.cong PB.refl (PB.cong PB.refl PB.left-unit))
        (PB.cong PB.refl (PB.sym PB.assoc)))))))

    cj-cj : ∀ {U} → n ⊢ cj (cj U) ≈ U
    cj-cj =
      PB.trans (PB.cong PB.refl PB.assoc)
      (PB.trans (PB.sym PB.assoc)
      (PB.trans (PB.cong XX PB.refl)
      (PB.trans PB.left-unit
      (PB.trans PB.assoc
      (PB.trans (PB.cong PB.refl XX) PB.right-unit)))))

    -- B and the conjugate of B′ commute iff B′ and that of B do.
    swap-colour : ∀ {B B′} → n ⊢ B • cj B′ ≈ cj B′ • B → n ⊢ B′ • cj B ≈ cj B • B′
    swap-colour H = PB.sym
      (PB.trans (PB.sym (PB.trans cj-• (PB.cong PB.refl cj-cj)))
      (PB.trans (PB.cong PB.refl (PB.cong H PB.refl))
        (PB.trans cj-• (PB.cong cj-cj PB.refl))))

  ↑ᵏ2 : (Y : Circuit n) → Y ↑ᵏ 2 ≡ Y ↑ ↑
  ↑ᵏ2 Y = PL.↑ᵏ-suc Y 1

  ↑ᵏ3 : (Y : Circuit n) → Y ↑ᵏ 3 ≡ Y ↑ ↑ ↑
  ↑ᵏ3 Y = Eq.trans (PL.↑ᵏ-suc Y 2) (Eq.cong _↑ (↑ᵏ2 Y))

  ↑ᵏ4 : (Y : Circuit n) → Y ↑ᵏ 4 ≡ Y ↑ ↑ ↑ ↑
  ↑ᵏ4 Y = Eq.trans (PL.↑ᵏ-suc Y 3) (Eq.cong _↑ (↑ᵏ3 Y))

  ↑ᵏ5 : (Y : Circuit n) → Y ↑ᵏ 5 ≡ Y ↑ ↑ ↑ ↑ ↑
  ↑ᵏ5 Y = Eq.trans (PL.↑ᵏ-suc Y 4) (Eq.cong _↑ (↑ᵏ4 Y))

  -- A closed word on the bottom k wires passes a word k wires up.
  apart₂ : (B₀ : Circuit 2) (Y : Circuit n) →
    (₂₊ n) ⊢ Y ↑ ↑ • (B₀ ↓ᵏ n) ≈ (B₀ ↓ᵏ n) • Y ↑ ↑
  apart₂ B₀ Y = Eq.subst (λ x → _ ⊢ x • (B₀ ↓ᵏ _) ≈ (B₀ ↓ᵏ _) • x) (↑ᵏ2 Y)
    (PB.sym (PL.apart no-scalar B₀ Y))

  apart₃ : (B₀ : Circuit 3) (Y : Circuit n) →
    (₃₊ n) ⊢ Y ↑ ↑ ↑ • (B₀ ↓ᵏ n) ≈ (B₀ ↓ᵏ n) • Y ↑ ↑ ↑
  apart₃ B₀ Y = Eq.subst (λ x → _ ⊢ x • (B₀ ↓ᵏ _) ≈ (B₀ ↓ᵏ _) • x) (↑ᵏ3 Y)
    (PB.sym (PL.apart no-scalar B₀ Y))

  apart₄ : (B₀ : Circuit 4) (Y : Circuit n) →
    (₄₊ n) ⊢ Y ↑ ↑ ↑ ↑ • (B₀ ↓ᵏ n) ≈ (B₀ ↓ᵏ n) • Y ↑ ↑ ↑ ↑
  apart₄ B₀ Y = Eq.subst (λ x → _ ⊢ x • (B₀ ↓ᵏ _) ≈ (B₀ ↓ᵏ _) • x) (↑ᵏ4 Y)
    (PB.sym (PL.apart no-scalar B₀ Y))

  apart₅ : (B₀ : Circuit 5) (Y : Circuit n) →
    (suc (₄₊ n)) ⊢ Y ↑ ↑ ↑ ↑ ↑ • (B₀ ↓ᵏ n) ≈ (B₀ ↓ᵏ n) • Y ↑ ↑ ↑ ↑ ↑
  apart₅ B₀ Y = Eq.subst (λ x → _ ⊢ x • (B₀ ↓ᵏ _) ≈ (B₀ ↓ᵏ _) • x) (↑ᵏ5 Y)
    (PB.sym (PL.apart no-scalar B₀ Y))

  -- X on wire 0 of two wires.
  X₂ : Circuit 2
  X₂ = [ gate₁ {1} X-gate ]ʷ

  ⇓↑ : (w : Circuit n) → (w ↑) ⇓ ≡ (w ⇓) ↑
  ⇓↑ [ g ]ʷ  = refl
  ⇓↑ ε       = refl
  ⇓↑ (u • v) = Eq.cong₂ _•_ (⇓↑ u) (⇓↑ v)

  CTRL₁-⇓ : (g : Gen n) → CTRL₁ (g ↧) ≡ CTRL₁ g ⇓
  CTRL₁-⇓ (gate₀ ())
  CTRL₁-⇓ (gate₁ X-gate)   = refl
  CTRL₁-⇓ (gate₂ CX-gate)  = refl
  CTRL₁-⇓ (gate₂ HH-gate)  = refl
  CTRL₁-⇓ (gate₂ SW-gate)  = refl
  CTRL₁-⇓ (gate₃ CCX-gate) = refl
  CTRL₁-⇓ (g ↥) = Eq.cong (λ x → (σ ↑ • σ) • x • (σ • σ ↑))
    (Eq.trans (Eq.cong _↑ (CTRL₁-⇓ g)) (Eq.sym (⇓↑ (CTRL₁ g))))

  -- How far up a gate is.
  pos : Gen n → ℕ
  pos (g ↥) = suc (pos g)
  pos _     = 0

  pos-↧ : (g : Gen n) → pos (g ↧) ≡ pos g
  pos-↧ (gate₀ h) = refl
  pos-↧ (gate₁ h) = refl
  pos-↧ (gate₂ h) = refl
  pos-↧ (gate₃ h) = refl
  pos-↧ (g ↥)     = Eq.cong suc (pos-↧ g)

  subst-C : ∀ {B C₀ C₁ : Circuit (₁₊ n)} → C₀ ≡ C₁ →
    (₁₊ n) ⊢ B • (X • (C₀ • X)) ≈ (X • (C₀ • X)) • B →
    (₁₊ n) ⊢ B • (X • (C₁ • X)) ≈ (X • (C₁ • X)) • B
  subst-C {B = B} e d = Eq.subst (λ c → _ ⊢ B • (X • (c • X)) ≈ (X • (c • X)) • B) e d

  ctrl⁻-pad : (B : Circuit (₄₊ n)) (j : ℕ) → ctrl⁻ (B ↓ᵏ j) ≡ ctrl⁻ B ↓ᵏ j
  ctrl⁻-pad B j = Eq.cong (λ x → X • (x • X)) (ctrl-pad B j)

  -- Closed cores, controlled and widened.
  coreO : ∀ c (A B : Circuit (₄₊ c)) → T (suc (₄₊ c) ≤ᵇ 8) → ∀ j →
    (suc (₄₊ c) + j) ⊢ ctrl (A ↓ᵏ j) • ctrl⁻ (B ↓ᵏ j) ≈ ctrl⁻ (B ↓ᵏ j) • ctrl (A ↓ᵏ j)
  coreO c A B le8 j =
    Eq.subst₂ (λ a b → _ ⊢ a • b ≈ b • a) (Eq.sym (ctrl-pad A j)) (Eq.sym (ctrl⁻-pad B j))
      (widen j (complete≤ (le (suc (₄₊ c)) le8) (opposite-sem A B)))

  coreS : ∀ c (A : Circuit (₄₊ c)) → T (suc (₄₊ c) ≤ᵇ 8) → ∀ j →
    (suc (₄₊ c) + j) ⊢ (A ↓ᵏ j) ↑ ≈ ctrl (A ↓ᵏ j) • ctrl⁻ (A ↓ᵏ j)
  coreS c A le8 j =
    Eq.subst₂ (λ a b → _ ⊢ a ≈ b) (Pad.↑↓ A j)
      (Eq.sym (Eq.cong₂ _•_ (ctrl-pad A j) (ctrl⁻-pad A j)))
      (widen j (complete≤ (le (suc (₄₊ c)) le8) (split-sem A)))

------------------------------------------------------------------------
-- Opposite colours commute, for single gates

Opp : Gen (₄₊ m) → Gen (₄₊ m) → Set
Opp {m} g g′ = suc (₄₊ m) ⊢ CTRL g • (X • (CTRL g′ • X)) ≈ (X • (CTRL g′ • X)) • CTRL g

private
  opp-sym : ∀ {g g′ : Gen (₄₊ m)} → Opp g g′ → Opp g′ g
  opp-sym = Inv.swap-colour (emb (PB.axiom (P.srel (P.srel P.X²))))

