-- A gate one wire up is its two controlled versions

split : (g : Gen (₄₊ m)) → suc (₄₊ m) ⊢ [ g ↥ ]ʷ ≈ CTRL g • (X • (CTRL g • X))
split (gate₀ ())
split (gate₁ {₃₊ j} h) = coreS 0 [ gate₁ {3} h ]ʷ tt j
split (gate₂ {₂₊ j} h) = coreS 0 [ gate₂ {2} h ]ʷ tt j
split (gate₃ {₁₊ j} h) = coreS 0 [ gate₃ {1} h ]ʷ tt j
split (gate₀ () ↥)
split (gate₁ {₂₊ j} h ↥) = coreS 0 [ gate₁ {2} h ↥ ]ʷ tt j
split (gate₂ {₁₊ j} h ↥) = coreS 0 [ gate₂ {1} h ↥ ]ʷ tt j
split (gate₃ {j} h ↥)    = coreS 0 [ gate₃ {0} h ↥ ]ʷ tt j
split {zero} (g ↥ ↥) =
  complete≤ (le (suc (₄₊ zero)) tt)
    {u = P._↑ {₄₊ zero} [ g ↥ ↥ ]ʷ}
    {v = ctrl {₄₊ zero} [ g ↥ ↥ ]ʷ • ctrl⁻ {₄₊ zero} [ g ↥ ↥ ]ʷ}
    (split-sem {zero} [ g ↥ ↥ ]ʷ)
split {suc m} (g ↥ ↥) =
  PB.trans (emb (barefull g))
  (PB.trans (PB.cong PB.refl (PB.cong (top-cong (split {m} (g ↥))) PB.refl))
  (PB.trans (PB.sym (merge (emb (K⁻K (₃₊ m)))))
  (PB.trans (PB.cong PB.refl (PB.sym
     (slide (PB.sym (apart₂ X₂ (cy (₃₊ m)))) (PB.sym (apart₂ X₂ (cy⁻ (₃₊ m)))))))
    (PB.sym (PB.cong (emb (fullmove g))
                     (PB.cong PB.refl (PB.cong (emb (fullmove g)) PB.refl)))))))

