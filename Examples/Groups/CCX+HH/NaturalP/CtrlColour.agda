-- Words

private
  XX : (₁₊ n) ⊢ X • X ≈ ε
  XX = emb (PB.axiom (P.srel (P.srel P.X²)))

  -- B passing two words passes their product, on either side.
  pass-• : ∀ {B P₁ P₂ : Circuit n} →
    n ⊢ B • P₁ ≈ P₁ • B → n ⊢ B • P₂ ≈ P₂ • B → n ⊢ B • (P₁ • P₂) ≈ (P₁ • P₂) • B
  pass-• e₁ e₂ =
    PB.trans (PB.sym PB.assoc)
    (PB.trans (PB.cong e₁ PB.refl)
    (PB.trans PB.assoc
    (PB.trans (PB.cong PB.refl e₂) (PB.sym PB.assoc))))

  pass-•ˡ : ∀ {A₁ A₂ P : Circuit n} →
    n ⊢ A₁ • P ≈ P • A₁ → n ⊢ A₂ • P ≈ P • A₂ → n ⊢ (A₁ • A₂) • P ≈ P • (A₁ • A₂)
  pass-•ˡ e₁ e₂ =
    PB.trans PB.assoc
    (PB.trans (PB.cong PB.refl e₂)
    (PB.trans (PB.sym PB.assoc)
    (PB.trans (PB.cong e₁ PB.refl) PB.assoc)))

  pass-ε : ∀ {B : Circuit n} → n ⊢ B • ε ≈ ε • B
  pass-ε = PB.trans PB.right-unit (PB.sym PB.left-unit)

  -- ctrl⁻ ε is ε.
  ctrl⁻-ε : suc (₄₊ m) ⊢ ctrl⁻ {₄₊ m} ε ≈ ε
  ctrl⁻-ε = PB.trans (PB.cong PB.refl PB.left-unit) XX

-- ctrl⁻ is a homomorphism up to X • X = ε.
ctrl⁻-• : (u v : Circuit (₄₊ m)) → suc (₄₊ m) ⊢ ctrl⁻ (u • v) ≈ ctrl⁻ u • ctrl⁻ v
ctrl⁻-• u v = Inv.cj-• XX

-- A gate controlled by wire 0 passes a circuit controlled by its negation.
opp-gw : (g : Gen (₄₊ m)) (v : Circuit (₄₊ m)) →
  suc (₄₊ m) ⊢ CTRL g • ctrl⁻ v ≈ ctrl⁻ v • CTRL g
opp-gw g [ g′ ]ʷ  = opp g g′
opp-gw g ε        =
  PB.trans (PB.cong PB.refl ctrl⁻-ε) (PB.trans pass-ε (PB.cong (PB.sym ctrl⁻-ε) PB.refl))
opp-gw g (u • v)  =
  PB.trans (PB.cong PB.refl (ctrl⁻-• u v))
  (PB.trans (pass-• (opp-gw g u) (opp-gw g v))
    (PB.cong (PB.sym (ctrl⁻-• u v)) PB.refl))

-- Circuits controlled by wire 0 and by its negation commute.
opposite : (u v : Circuit (₄₊ m)) → suc (₄₊ m) ⊢ ctrl u • ctrl⁻ v ≈ ctrl⁻ v • ctrl u
opposite [ g ]ʷ  v = opp-gw g v
opposite ε       v = PB.trans PB.left-unit (PB.sym PB.right-unit)
opposite (u • w) v = pass-•ˡ (opposite u v) (opposite w v)

-- A circuit one wire up is its two controlled versions.
split-w : (w : Circuit (₄₊ m)) → suc (₄₊ m) ⊢ w ↑ ≈ ctrl w • ctrl⁻ w
split-w [ g ]ʷ  = split g
split-w ε       = PB.sym (PB.trans PB.left-unit ctrl⁻-ε)
split-w (u • v) =
  PB.trans (PB.cong (split-w u) (split-w v))
  (PB.trans PB.assoc
  (PB.trans (PB.cong PB.refl (PB.sym PB.assoc))
  (PB.trans (PB.cong PB.refl (PB.cong (PB.sym (opposite v u)) PB.refl))
  (PB.trans (PB.cong PB.refl PB.assoc)
  (PB.trans (PB.sym PB.assoc)
    (PB.cong PB.refl (PB.sym (ctrl⁻-• u v))))))))
