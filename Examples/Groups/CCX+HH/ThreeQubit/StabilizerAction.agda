  permutation-gen ((((((P.gate₂ P.σ-gate) P.↥) P.↥) P.↥) P.↥) P.↥) (a ∷ b ∷ c ∷ d ∷ e ∷ f ∷ g ∷ h ∷ []) = refl
  permutation-gen (((((((P.gate₂ P.σ-gate) P.↥) P.↥) P.↥) P.↥) P.↥) P.↥) (a ∷ b ∷ c ∷ d ∷ e ∷ f ∷ g ∷ h ∷ []) = refl
  permutation-gen ((((((((P.gate₁ ()) P.↥) P.↥) P.↥) P.↥) P.↥) P.↥) P.↥) v
  permutation-gen (((((((((P.gate₀ ()) P.↥) P.↥) P.↥) P.↥) P.↥) P.↥) P.↥) P.↥) v

permutation-action : ∀ (w : P.Circuit 8) v i →
  lookup (S.actVʷ ((b ʷ) (wmap (λ g → exchange (position g)) w)) v) i ≡
  lookup v (PS.⟦ w ⟧ i)
permutation-action [ g ]ʷ v i = Eq.trans
  (Eq.cong (λ z → lookup z i) (permutation-gen g v))
  (VP.lookup∘tabulate (λ j → lookup v (PS.⟦ g ⟧ᵍ j)) i)
permutation-action ε v i = refl
permutation-action (u • w) v i = Eq.trans
  (permutation-action u (S.actVʷ ((b ʷ) (wmap (λ g → exchange (position g)) w)) v) i)
  (permutation-action w v (PS.⟦ u ⟧ i))
