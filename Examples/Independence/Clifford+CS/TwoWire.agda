------------------------------------------------------------------------
-- The decoding, and every relation decoded

d₂ : TL.Gen 4 → Circuit 2
d₂ (TL.i-gen a)     = ⟦ dᵃ a ⟧ᵃ
d₂ (TL.X-gen a b _) = ⟦ xᵃ a b ⟧ᵃ
d₂ (TL.K-gen a b _) = ⟦ kᵃ a b ⟧ᵃ

open Decode d₂ public renaming (Dʷ to D₂ʷ)

data Lt4 : Fin 4 → Fin 4 → Set where
  l01 : Lt4 ₀ ₁
  l02 : Lt4 ₀ ₂
  l03 : Lt4 ₀ ₃
  l12 : Lt4 ₁ ₂
  l13 : Lt4 ₁ ₃
  l23 : Lt4 ₂ ₃

lt4 : (a b : Fin 4) → .(a < b) → Lt4 a b
lt4 ₀ ₁ _ = l01
lt4 ₀ ₂ _ = l02
lt4 ₀ ₃ _ = l03
lt4 ₁ ₂ _ = l12
lt4 ₁ ₃ _ = l13
lt4 ₂ ₃ _ = l23
lt4 ₀ ₀ p = bad {a = ₀} {b = ₀} p
lt4 ₁ ₀ p = bad {a = ₁} {b = ₀} p
lt4 ₁ ₁ p = bad {a = ₁} {b = ₁} p
lt4 ₂ ₀ p = bad {a = ₂} {b = ₀} p
lt4 ₂ ₁ p = bad {a = ₂} {b = ₁} p
lt4 ₂ ₂ p = bad {a = ₂} {b = ₂} p
lt4 ₃ ₀ p = bad {a = ₃} {b = ₀} p
lt4 ₃ ₁ p = bad {a = ₃} {b = ₁} p
lt4 ₃ ₂ p = bad {a = ₃} {b = ₂} p
lt4 ₃ ₃ p = bad {a = ₃} {b = ₃} p

