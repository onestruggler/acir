  (Sₗ ∷ Sₗ ↥ ∷ CSₗ ∷ CSₗ ∷ [])
  (rw 5 (sym⁼ E2⁼)
   ∷ rw 4 E3⁼
   ∷ rw 5 (sym⁼ CXCX↓⁼)
   ∷ rw 0 CXCS⁼
   ∷ rw 4 (sym⁼ A2B⁼)
   ∷ rw 8 CXCX↓⁼
   ∷ perm (CSₗ ∷ CSₗ ∷ CSₗ ∷ Sₗ ↥ ∷ Sₗ ∷ CSₗ ∷ CSₗ ∷ CSₗ ∷ [])
   ∷ rw 4 E4⁼
   ∷ rw 3 E3⁼
   ∷ perm (CSₗ ∷ CSₗ ∷ CSₗ ∷ CSₗ ∷ Sₗ ∷ Sₗ ↥ ∷ CSₗ ∷ CSₗ ∷ [])
   ∷ rw 0 E2⁼ ∷ [])
  refl

