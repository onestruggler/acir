  | .SW₁₂ => K12 * SW12
  | .CX₀₂ => CZ02
  | .SW₀₂ => K01 * K12 * SW02
  | .K₀₁ => K01
  | .CX₁₀ => CX10
  | .SW₀₁ => SW01
  | .CCX₀₂ => K12 * CCZw * K12
  | .X₂ => Z2
  | .CZ₀₁ => CZ01
  | .Z₀ => Z0
  | .Z₂ => X2
  | .Z₁ => Z1
  | .CCX₀₁ => CCZw
