/-! ## The paper's relations hold for circuits -/

/-- A circuit derivation between the readings of two paper words, computed. -/
theorem by_der {u t : Word G₂} {w v : Circuits.C 2 3} (d : Derivable (QCert.Lift Circuits.SRel2 3) w v)
    (hw : κW u = w := by simp only [map_mul, map_one, FreeMonoid.lift_eval_of, κ, κ_T, κ_TR, κ_Xab, κ_m0, κ_m, κ_Kq, κ_Ω] <;> rfl)
    (hv : κW t = v := by simp only [map_mul, map_one, FreeMonoid.lift_eval_of, κ, κ_T, κ_TR, κ_Xab, κ_m0, κ_m, κ_Kq, κ_Ω] <;> rfl) :
    Derivable (QCert.Lift Circuits.SRel2 3) (κW u) (κW t) := by
  subst hw hv; exact d

/-- A definition of Figure 4: the two readings agree. -/
theorem defn {u t : Word G₂} (h : κW u = κW t := by simp only [map_mul, map_one, FreeMonoid.lift_eval_of, κ, κ_T, κ_TR, κ_Xab, κ_m0, κ_m, κ_Kq, κ_Ω] <;> rfl) :
    Derivable (QCert.Lift Circuits.SRel2 3) (κW u) (κW t) := by
  rw [h]

theorem κ_ax {u t : Word G₂} (h : R2plus u t) : Derivable (QCert.Lift Circuits.SRel2 3) (κW u) (κW t) := by
  cases h with
  | fig4 r =>
    cases r with
    | r1 => exact defn
