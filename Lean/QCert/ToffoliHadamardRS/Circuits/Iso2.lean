theorem expand (u : Word G₂) : Derivable R2plus u (ιW (κW u)) := by
  induction u using FreeMonoid.inductionOn' with
  | one => exact Derivable.refl _
  | mul_of x u ih => rw [map_mul, map_mul, FreeMonoid.lift_eval_of]; exact (ικ x).mul ih

/-- A paper rule, read through `κ` and back; `w` and `v` are its words as
circuits, computed (`κW` would otherwise be unfolded on the two sides). -/
theorem via {u t : Word G₂} {w v : Circuits.C 2 3} (r : R2plus u t)
    (hw : κW u = w := by simp only [map_mul, map_one, FreeMonoid.lift_eval_of, κ, κ_T, κ_TR, κ_Xab, κ_m0, κ_m, κ_Kq, κ_Ω] <;> rfl)
    (hv : κW t = v := by simp only [map_mul, map_one, FreeMonoid.lift_eval_of, κ, κ_T, κ_TR, κ_Xab, κ_m0, κ_m, κ_Kq, κ_Ω] <;> rfl) :
    Derivable R2plus (ιW w) (ιW v) := by
  subst hw hv; exact (expand u).symm.trans ((Derivable.of r).trans (expand t))

/-! ## Commutations the paper does not state, by its completeness -/

/-- `u` and `t` commute when their values do. -/
theorem comm (u t : Word G₂) (e : semH (u * t) = semH (t * u)) : Derivable R2plus (u * t) (t * u) :=
  complete2 e

theorem c0 : semH (X0 * X1 : Word G₂) = semH (X1 * X0 : Word G₂) :=
  semH_eq_of_check (by decide +kernel)

