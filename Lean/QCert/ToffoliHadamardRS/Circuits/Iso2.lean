theorem ι₂_ax {w v : Circuits.C 2 2} (h : QCert.Lift Circuits.SRel2 2 w v) : Derivable R2plus (ι₂W w) (ι₂W v) := by
  cases h with
  | rule r =>
    cases r with
    | fig4 r => cases r
    | fig7 r => cases r
    | fig8 r =>
      cases r with
      | H_place => exact Derivable.refl _
    | rK r => cases r
  | shift r =>
    cases r with
    | rule r => cases r <;> rename_i r <;> cases r
    | shift r => cases r with | rule r => cases r <;> rename_i r <;> cases r
    | comm1 h g => cases g; rename_i x; cases x
    | scalar c => cases c
  | comm1 h g =>
    cases h
    · cases g
      · rename_i x; cases x
      · rename_i x; cases x
        · exact comm X0 X1 c0
        · exact comm (K01 * K12 * H2) X1 c5
      · rename_i g; cases g; rename_i x; cases x
    · cases g
      · rename_i x; cases x
      · rename_i x; cases x
        · exact comm X0 (K12 * H2) c6
        · exact comm (K01 * K12 * H2) (K12 * H2) c7
      · rename_i g; cases g; rename_i x; cases x
  | comm2 h g => cases g; rename_i x; cases x
  | scalar c => cases c

