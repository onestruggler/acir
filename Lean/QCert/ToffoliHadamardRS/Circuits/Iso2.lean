/-! ## `κ ∘ ι` is the identity -/

theorem κι : ∀ x : Gen (Circuits.Gate 2) 3, Derivable (QCert.Lift Circuits.SRel2 3) (FreeMonoid.of x) (κW (ι x))
  | .gate1 .X => Derivable.refl _
  | .gate1 .H => Derivable.refl _
  | .gate2 .CX => Derivable.refl _
  | .gate2 .K => Derivable.refl _
  | .gate3 .CCX => Derivable.refl _
  | .gate3 .NK => Derivable.refl _
  | .gate3 .CCZ => Derivable.refl _
  | .gate0 c => nomatch c
  | .up (.gate1 .X) => Derivable.refl _
  | .up (.gate1 .H) => Derivable.of (.rule (.fig8 Circuits.Fig8.H_place))
  | .up (.gate2 .CX) => Derivable.refl _
  | .up (.gate2 .K) => Derivable.refl _
  | .up (.gate0 c) => nomatch c
  | .up (.up (.gate1 .X)) => Derivable.refl _
  | .up (.up (.gate1 .H)) => by
    have h1 : Derivable (QCert.Lift Circuits.SRel2 3)
        (QCert.Circuit.shift (QCert.Circuit.shift Circuits.H))
        (QCert.Circuit.shift (Circuits.K * Circuits.H)) :=
      Derivable.of (QCert.Lift.shift (QCert.Lift.rule
        (Circuits.SRel2.fig8 (Circuits.Fig8.H_place (k := 0) (n := 0)))))
    have h2 : Derivable (QCert.Lift Circuits.SRel2 3) (QCert.Circuit.shift Circuits.H)
        (Circuits.K * Circuits.H) :=
      Derivable.of (QCert.Lift.rule (Circuits.SRel2.fig8 (Circuits.Fig8.H_place (k := 0) (n := 1))))
    rw [map_mul] at h1
    exact h1.trans ((Derivable.refl _).mul h2)
  | .up (.up (.gate0 c)) => nomatch c
  | .up (.up (.up (.gate0 c))) => nomatch c

end QCert.ToffoliHadamardRS.CircuitsIso2
