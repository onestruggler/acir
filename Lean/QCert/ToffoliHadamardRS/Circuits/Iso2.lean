/-! ## The two translations -/

/-- A letter on wire 2 (qubit 0), on wires 1–2 (qubits 1, 0), and on
wires 0–2. -/
def ι₁ : Gen (Circuits.Gate 2) 1 → Word G₂
  | .gate1 .X => X0
  | .gate1 .H => K01 * K12 * H2
  | .gate0 c => nomatch c
  | .up (.gate0 c) => nomatch c

def ι₂ : Gen (Circuits.Gate 2) 2 → Word G₂
  | .gate1 .X => X1
  | .gate1 .H => K12 * H2
  | .gate2 .CX => CX01
  | .gate2 .K => K01
  | .gate0 c => nomatch c
  | .up g => ι₁ g

def ι : Gen (Circuits.Gate 2) 3 → Word G₂
  | .gate1 .X => X2
  | .gate1 .H => H2
  | .gate2 .CX => CX12
  | .gate2 .K => K12
  | .gate3 .CCX => CCX12
  | .gate3 .NK => NKw
  | .gate3 .CCZ => CCZw
  | .gate0 c => nomatch c
  | .up g => ι₂ g

abbrev ιW : Word (Gen (Circuits.Gate 2) 3) →* Word G₂ := FreeMonoid.lift ι
abbrev ι₂W : Word (Gen (Circuits.Gate 2) 2) →* Word G₂ := FreeMonoid.lift ι₂

/-- The paper's letters as the circuits of the same name. -/
def κ : G₂ → Circuits.C 2 3
  | .X₀ => Circuits.X0
  | .X₁ => Circuits.X1
  | .X₂ => Circuits.X2
  | .Z₀ => Circuits.Z0
  | .Z₁ => Circuits.Z1
  | .Z₂ => Circuits.Z2
  | .CX₀₁ => Circuits.CX01
  | .CX₀₂ => Circuits.CX02
  | .CX₁₀ => Circuits.CX10
  | .CX₁₂ => Circuits.CX12
  | .CX₂₀ => Circuits.CX20
  | .CX₂₁ => Circuits.CX21
  | .CZ₀₁ => Circuits.CZ01
  | .CZ₀₂ => Circuits.CZ02
  | .CZ₁₂ => Circuits.CZ12
  | .CCX₀₁ => Circuits.CCX01
  | .CCX₀₂ => Circuits.CCX02
  | .CCX₁₂ => Circuits.CCX12
  | .K₀₁ => Circuits.K01
  | .K₁₂ => Circuits.K12
  | .SW₀₁ => Circuits.SW01
  | .SW₀₂ => Circuits.SW02
  | .SW₁₂ => Circuits.SW12
  | .NK => Circuits.NKw
  | .CCZ => Circuits.CCZw
  | .H₂ => Circuits.H2

abbrev κW : Word G₂ →* Circuits.C 2 3 := FreeMonoid.lift κ

theorem ι_up (u : Circuits.C 2 2) : ιW (QCert.Circuit.shift u) = ι₂W u := by
  induction u using FreeMonoid.inductionOn' with
  | one => rfl
  | mul_of g u ih =>
    rw [map_mul, map_mul, map_mul, ih, QCert.Circuit.shift_of, FreeMonoid.lift_eval_of,
      FreeMonoid.lift_eval_of]; rfl

/-! ## The paper's words of Figure 7 read as the circuits of the same name -/

theorem κ_T (a : ℕ) : κW (T a) = (Circuits.T a : Circuits.C 2 3) := by
  rcases a with _ | _ | _ | _ | _ | _ | a <;>
    simp only [T, Circuits.T, map_mul, FreeMonoid.lift_eval_of, κ]

theorem κ_TR (a d : ℕ) : κW (TR a d) = (Circuits.TR a d : Circuits.C 2 3) := by
  induction d generalizing a with
  | zero => simp only [TR, Circuits.TR, κ_T]
  | succ d ih => simp only [TR, Circuits.TR, map_mul, κ_T, ih]

theorem κ_Xab (a b : ℕ) : κW (Xab a b) = (Circuits.Xab a b : Circuits.C 2 3) := by
  unfold Xab Circuits.Xab
  generalize b - a = e
  cases e with
  | zero => exact map_one _
  | succ d => exact κ_TR a d

theorem κ_m0 : κW m0 = (Circuits.m0 : Circuits.C 2 3) := by
  simp only [m0, Circuits.m0, map_mul, FreeMonoid.lift_eval_of, κ]

theorem κ_m (c : ℕ) : κW (m c) = (Circuits.m c : Circuits.C 2 3) := by
  simp only [m, Circuits.m, map_mul, κ_Xab, κ_m0]

theorem κ_Kq (a b c d : ℕ) : κW (Kq a b c d) = (Circuits.Kq a b c d : Circuits.C 2 3) := by
  simp only [Kq, Circuits.Kq, map_mul, κ_Xab, FreeMonoid.lift_eval_of, κ]

theorem κ_Ω : κW Ω = (Circuits.Ω : Circuits.C 2 3) := by
  simp only [Ω, Circuits.Ω, map_mul, κ_Kq, κ_T, FreeMonoid.lift_eval_of, κ]

