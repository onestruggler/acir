def z0def : Eqn0 := d0
  [K₀₁, X₀, K₀₁]
  [Z₀]
  [rw 1 e_r41.symm, rw 0 e_r25]
  (by decide +kernel)

def z0sq : Eqn0 := d0
  [Z₀, Z₀]
  []
  [rw 0 z0def.symm, rw 2 e_r41, rw 1 e_r21, rw 0 e_r25]
