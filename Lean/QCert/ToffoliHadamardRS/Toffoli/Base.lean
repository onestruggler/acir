def cz02sq : Eqn0 := d0
  [CZ₀₂, CZ₀₂]
  []
  [rw 0 e_r18, rw 3 e_r18, rw 2 sw12sq, rw 1 cz01sq, rw 0 sw12sq]
  (by decide +kernel)

def cz12sq : Eqn0 := d0
  [CZ₁₂, CZ₁₂]
  []
  [rw 0 e_r19, rw 3 e_r19, rw 2 sw01sq, rw 1 cz02sq, rw 0 sw01sq]
  (by decide +kernel)

theorem invol : ∀ x : GD, Derivable Γ0 (FreeMonoid.of x * FreeMonoid.of x) 1
  | X₀ => e_r21.toDer rfl rfl
  | X₁ => x1sq.toDer rfl rfl
  | X₂ => x2sq.toDer rfl rfl
  | Z₀ => z0sq.toDer rfl rfl
  | Z₁ => z1sq.toDer rfl rfl
  | Z₂ => z2sq.toDer rfl rfl
  | CX₀₁ => e_r22.toDer rfl rfl
  | CX₀₂ => cx02sq.toDer rfl rfl
  | CX₁₀ => cx10sq.toDer rfl rfl
  | CX₁₂ => cx12sq.toDer rfl rfl
  | CX₂₀ => cx20sq.toDer rfl rfl
  | CX₂₁ => cx21sq.toDer rfl rfl
  | CZ₀₁ => cz01sq.toDer rfl rfl
  | CZ₀₂ => cz02sq.toDer rfl rfl
  | CZ₁₂ => cz12sq.toDer rfl rfl
  | CCX₀₁ => ccx01sq.toDer rfl rfl
  | CCX₀₂ => ccx02sq.toDer rfl rfl
  | CCX₁₂ => e_r24.toDer rfl rfl
  | K₀₁ => e_r25.toDer rfl rfl
  | K₁₂ => e_r23.toDer rfl rfl
  | SW₀₁ => sw01sq.toDer rfl rfl
  | SW₀₂ => sw02sq.toDer rfl rfl
  | SW₁₂ => sw12sq.toDer rfl rfl

/-- The Agda's `rot⁼` at level 0. -/
abbrev rot (k m : ℕ) (e : Eqn0) : Eqn0 := Engine.rot invol k m e

/-- The Agda's `rev⁼` at level 0. -/
abbrev rev (e : Eqn0) : Eqn0 := Engine.rev invol e

end

