/-! ## Every gate is an involution -/

def cx10sq : Eqn0 := d0
  [CX₁₀, CX₁₀]
  []
  [rw 0 e_r12, rw 3 e_r12, rw 2 e_r25, rw 1 e_r22, rw 0 e_r25]
  (by decide +kernel)

def cz01sq : Eqn0 := d0
  [CZ₀₁, CZ₀₁]
  []
  [rw 0 e_r1, rw 3 e_r1, rw 2 e_r23, rw 1 e_r22, rw 0 e_r23]
  (by decide +kernel)

def ccx02sq : Eqn0 := d0
  [CCX₀₂, CCX₀₂]
  []
  [rw 0 e_r14, rw 2 e_r13, rw 5 e_r14, rw 5 e_r13, rw 4 e_r22, rw 0 e_r13, rw 5 cx10sq,
    rw 4 e_r22, rw 3 e_r24, rw 3 e_r13, rw 2 e_r22, rw 1 cx10sq, rw 0 e_r22]
  (by decide +kernel)

def sw01sq : Eqn0 := d0
  [SW₀₁, SW₀₁]
  []
  [rw 0 e_r13, rw 3 e_r13, rw 2 e_r22, rw 1 cx10sq, rw 0 e_r22]
  (by decide +kernel)

def x1sq : Eqn0 := d0
  [X₁, X₁]
  []
  [rw 0 e_r28, rw 3 e_r28, rw 2 sw01sq, rw 1 e_r21, rw 0 sw01sq]
  (by decide +kernel)

def z1sq : Eqn0 := d0
  [Z₁, Z₁]
  []
  [rw 0 e_r4, rw 3 e_r4, rw 2 e_r23, rw 1 x1sq, rw 0 e_r23]
  (by decide +kernel)

def cx12sq : Eqn0 := d0
  [CX₁₂, CX₁₂]
  []
  [rw 1 e_r7, rw 2 e_r31, rw 3 e_r5, rw 3 e_r28, rw 2 sw01sq, rw 1 e_r27.symm, rw 0 e_r26,
    rw 1 e_r7, rw 0 e_r27, rw 3 e_r23, rw 2 e_r31, rw 4 sw01sq, rw 3 e_r5, rw 6 e_r24,
    rw 3 e_r28, rw 2 sw01sq, rw 1 e_r21, rw 3 x1sq, rw 2 e_r24, rw 1 sw01sq, rw 0 e_r23]
  (by decide +kernel)

def ccx01sq : Eqn0 := d0
  [CCX₀₁, CCX₀₁]
  []
  [rw 0 e_r17, rw 3 e_r17, rw 2 e_r23, rw 1 ccx02sq, rw 0 e_r23]
  (by decide +kernel)

def cx21def : Eqn0 := d0
  [K₁₂, CX₁₂, K₁₂]
  [CX₂₁]
  [rw 1 e_r7, rw 0 e_r23, rw 1 e_r23]
  (by decide +kernel)

def cx21sq : Eqn0 := d0
  [CX₂₁, CX₂₁]
  []
  [rw 0 cx21def.symm, rw 3 cx21def.symm, rw 2 e_r23, rw 1 cx12sq, rw 0 e_r23]
  (by decide +kernel)

def cx20def : Eqn0 := d0
  [SW₀₁, CX₂₁, SW₀₁]
  [CX₂₀]
  [rw 1 e_r31, rw 0 sw01sq, rw 1 sw01sq]
  (by decide +kernel)

def cx20sq : Eqn0 := d0
  [CX₂₀, CX₂₀]
  []
  [rw 0 cx20def.symm, rw 3 cx20def.symm, rw 2 sw01sq, rw 1 cx21sq, rw 0 sw01sq]
