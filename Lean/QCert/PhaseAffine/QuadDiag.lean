# The diagonal group of the quadratic fragment

The diagonal circuits of `QuadPhase_d` (`d` odd), modulo the theory, form
the group `Dg n` generated by the scalar and the atoms of `S` and `Z` on
linear forms.  It is abelian (`QuadAtoms.atomL_commute`), and the pair of a
diagonal element determines it (`dg_inj`): Lemma 13 and Proposition 1 of
Blake (arXiv:2603.06466) for the quadratic fragment.

The coefficients are read off a normal form, by induction on the number of
wires.  `Q u = S(u)² Z(u)` (the phase `(u · x)²`) satisfies the
parallelogram law (rule (28)), so its polar form is biadditive (`JvN`); the
polar form of `e₀` and `(0, c)` is the `CZ` fan `K c` (phase
`2 x₀ (c · x')`), and every element is `↑D' Z₀^a Q(e₀)^b K c` with `D'`
diagonal on the upper wires (`dg_nf`).  Its phase is
`q'(x') + a x₀ + b x₀² + 2 x₀ (c · x')`, which determines `a`, `b`, `c` and
`q'`.
-/
import QCert.PhaseAffine.QuadAtoms
import QCert.PhaseAffine.JvN
import Mathlib.Tactic.Module

namespace QCert.PhaseAffine

open Circuit

variable {d lv : ℕ} [Fact d.Prime]

local notation "𝒢" => gateData d lv

/-! ### The pair of a class -/

/-- The pair `(g, q)` of a class of circuits (soundness, Lemma 9). -/
noncomputable def semQ (hA : Admissible d lv) (n : ℕ) : Q d lv n →* PA d n :=
  (conGen (theory d lv n)).lift ((𝒢).sem n) (Con.conGen_le fun _ _ h =>
    (Con.ker_rel _).2 (pa_sound hA (Derivable.of h)))

theorem semQ_mk (hA : Admissible d lv) {n : ℕ} (w : C d lv n) :
    semQ hA n (mk w) = (𝒢).sem n w := rfl

theorem semQ_shiftQ (hA : Admissible d lv) {n : ℕ} (x : Q d lv n) :
    semQ hA (n + 1) (shiftQ x) = PA.onTop (semQ hA n x) := by
  obtain ⟨w, rfl⟩ := mk_surjective x
  rw [shiftQ_mk, semQ_mk, semQ_mk, GateData.sem_shift]

omit [Fact d.Prime] in
theorem PA.onBottom_diag_f {n : ℕ} (q : Lab d 1 → ZMod d) :
    (PA.onBottom n (PA.diag q)).f = id := by
  funext v i
  refine Fin.cases ?_ (fun j => ?_) i
  · rw [PA.onBottom1_f_zero]; rfl
  · exact PA.onBottom1_f_succ _ _ _

section Diag


/-- The pair of an atom: no relabelling, the phase of the gate at the first
coordinate of `W x`. -/
theorem semQ_atom (hA : Admissible d lv) (g : Gate d lv 1) (q : ZMod d → ZMod d)
    (hq : (𝒢).gate1 g = PA.diag fun v => q (v 0)) {n : ℕ} (W : C d lv (n + 1))
    (hW : IsLinW W) :
    semQ hA (n + 1) (atom g W) = PA.diag fun y => q (((𝒢).sem (n + 1) W).f y 0) := by
  obtain ⟨V, hV, e⟩ := linInv W hW
  have hVi : mk V = (mk W)⁻¹ := by rw [map_mul] at e; exact eq_inv_of_mul_eq_one_left e
  have hVW : (𝒢).sem (n + 1) (V * W) = 1 := by
    rw [← map_one ((𝒢).sem (n + 1))]; exact pa_sound hA (mk_eq_iff.1 (by rw [e, map_one]))
  rw [atom, ← hVi, ← map_mul, ← map_mul, semQ_mk, map_mul, map_mul, GateData.sem_of]
  have hG : (𝒢).gen (Gen.gate1 (n := n) g) = PA.onBottom n ((𝒢).gate1 g) := rfl
  rw [hG, hq]
  refine PA.ext ?_ ?_
  · funext y
    simp only [PA.mul_f, Function.comp_apply, PA.onBottom_diag_f, id, PA.diag_f]
    rw [← sem_f_mul, hVW]; rfl
  · funext y
    simp only [PA.mul_q, PA.diag_q, PA.onBottom1_q, PA.onBottom_diag_f, id,
      (sem_lin W hW).2, (sem_lin V hV).2]
    ring

theorem semQ_atomL_S (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} (u : Lab d (n + 1)) :
    semQ hA (n + 1) (atomL (Gate.S h2) u) = PA.diag fun y => binom2 (∑ j, u j * y j) := by
  rw [atomL]
  split_ifs with hu
  · subst hu
    refine PA.ext rfl (funext fun y => ?_)
    simp [binom2]
  · rw [semQ_atom hA _ binom2 rfl _ (isLinW_rowW _ _)]
    congr 1; funext y; rw [sem_rowW n u hu]

theorem semQ_atomL_Z (hA : Admissible d lv) (h1 : 1 ≤ lv) {n : ℕ} (u : Lab d (n + 1)) :
    semQ hA (n + 1) (atomL (Gate.Z h1) u) = PA.diag fun y => ∑ j, u j * y j := by
  rw [atomL]
  split_ifs with hu
  · subst hu
    refine PA.ext rfl (funext fun y => ?_)
    simp
  · rw [semQ_atom hA _ id rfl _ (isLinW_rowW _ _)]
    congr 1; funext y; rw [sem_rowW n u hu]; rfl

theorem semQ_omega (hA : Admissible d lv) (h1 : 1 ≤ lv) {n : ℕ} :
    semQ hA n (mk (g0 (Gate.omega h1))) = PA.diag fun _ => 1 := rfl

/-! ### The diagonal group -/

theorem one_le_of_two (h2 : 2 ≤ lv) : 1 ≤ lv := by omega

/-- The generators of the diagonal group on `n` wires: the scalar, and the
atoms of `S` and `Z`. -/
def dgens (h2 : 2 ≤ lv) : (n : ℕ) → Set (Q d lv n)
  | 0 => {mk (g0 (Gate.omega (one_le_of_two h2)))}
  | n + 1 => {mk (g0 (Gate.omega (one_le_of_two h2)))} ∪
      Set.range (atomL (n := n) (Gate.S h2)) ∪ Set.range (atomL (n := n) (Gate.Z (one_le_of_two h2)))

theorem dgens_comm (hA : Admissible d lv) (h2 : 2 ≤ lv) :
    ∀ (n : ℕ), ∀ x ∈ dgens (d := d) h2 n, ∀ y ∈ dgens h2 n, x * y = y * x
  | 0, x, hx, y, hy => by
    simp only [dgens, Set.mem_singleton_iff] at hx hy; rw [hx, hy]
  | n + 1, x, hx, y, hy => by
    have hω : ∀ q : Q d lv (n + 1), Commute (mk (g0 (Gate.omega (one_le_of_two h2)))) q :=
      mk_omega_central _
    simp only [dgens, Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hx hy
    rcases hx with (rfl | ⟨u, rfl⟩) | ⟨u, rfl⟩ <;>
      rcases hy with (rfl | ⟨v, rfl⟩) | ⟨v, rfl⟩
    all_goals first
      | rfl
      | exact (hω _).eq
      | exact (hω _).eq.symm
      | exact (atomL_commute hA h2 (phaseGate_S h2) (phaseGate_S h2) u v).eq
      | exact (atomL_commute hA h2 (phaseGate_S h2) (phaseGate_Z h2) u v).eq
      | exact (atomL_commute hA h2 (phaseGate_Z h2) (phaseGate_S h2) u v).eq
      | exact (atomL_commute hA h2 (phaseGate_Z h2) (phaseGate_Z h2) u v).eq

/-- The diagonal group on `n` wires. -/
noncomputable abbrev Dg (h2 : 2 ≤ lv) (n : ℕ) : Subgroup (Q d lv n) := Subgroup.closure (dgens h2 n)

/-- The diagonal group is abelian. -/
@[reducible] noncomputable def dgComm (hA : Admissible d lv) (h2 : 2 ≤ lv) (n : ℕ) :
    CommGroup (Dg (d := d) h2 n) :=
  { (inferInstance : Group (Dg (d := d) h2 n)) with
    mul_comm := (Subgroup.isMulCommutative_closure (dgens_comm hA h2 n)).is_comm.comm }

theorem dg_commute (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} {x y : Q d lv n}
    (hx : x ∈ Dg h2 n) (hy : y ∈ Dg h2 n) : Commute x y := by
  have := @mul_comm _ (dgComm hA h2 n).toCommMagma ⟨x, hx⟩ ⟨y, hy⟩
  exact congrArg Subtype.val this

theorem dg_pow_d (h2 : 2 ≤ lv) (hA : Admissible d lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg h2 n) : x ^ d = 1 := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    cases n with
    | zero =>
      simp only [dgens, Set.mem_singleton_iff] at hx; rw [hx]; exact relωd _
    | succ n =>
      simp only [dgens, Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hx
      rcases hx with (rfl | ⟨u, rfl⟩) | ⟨u, rfl⟩
      · exact relωd _
      · exact atomL_pow_d _ (relSd h2) u
      · exact atomL_pow_d _ (relZd _) u
  | one => exact one_pow _
  | mul x y hx hy ihx ihy => rw [(dg_commute hA h2 hx hy).mul_pow, ihx, ihy, one_mul]
  | inv x hx ih => rw [inv_pow, ih, inv_one]

theorem dg_f (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg h2 n) : (semQ hA n x).f = id := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    cases n with
    | zero =>
      simp only [dgens, Set.mem_singleton_iff] at hx; rw [hx]; rfl
    | succ n =>
      simp only [dgens, Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hx
      rcases hx with (rfl | ⟨u, rfl⟩) | ⟨u, rfl⟩
      · rfl
      · rw [semQ_atomL_S]; rfl
      · rw [semQ_atomL_Z]; rfl
  | one => rw [map_one]; rfl
  | mul x y _ _ ihx ihy => rw [map_mul, PA.mul_f, ihx, ihy]; rfl
  | inv x hx ih =>
    have h1 : semQ hA n x⁻¹ * semQ hA n x = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
    have := congrArg PA.f h1
    rw [PA.mul_f, ih] at this
    exact this

/-- A diagonal element is the diagonal operator of its phase. -/
theorem dg_diag (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg h2 n) : semQ hA n x = PA.diag (semQ hA n x).q :=
  PA.ext (dg_f hA h2 hx) rfl

theorem shiftQ_dg (h2 : 2 ≤ lv) (hA : Admissible d lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg h2 n) : shiftQ x ∈ Dg h2 (n + 1) := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    apply Subgroup.subset_closure
    cases n with
    | zero =>
      simp only [dgens, Set.mem_singleton_iff] at hx; rw [hx]
      refine Or.inl (Or.inl ?_)
      rw [shiftQ_mk]; exact mk_scalar_up _
    | succ n =>
      simp only [dgens, Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hx ⊢
      rcases hx with (rfl | ⟨u, rfl⟩) | ⟨u, rfl⟩
      · left; left; rw [shiftQ_mk]; exact mk_scalar_up _
      · left; right; exact ⟨_, (shiftQ_atomL hA _ (relS1CX h2) u).symm⟩
      · right; exact ⟨_, (shiftQ_atomL hA _ (relZ1CX' _) u).symm⟩
  | one => rw [map_one]; exact one_mem _
  | mul x y _ _ ihx ihy => rw [map_mul]; exact mul_mem ihx ihy
  | inv x _ ih => rw [map_inv]; exact inv_mem ih

theorem atomL_S_mem (h2 : 2 ≤ lv) {n : ℕ} (u : Lab d (n + 1)) :
    atomL (Gate.S h2) u ∈ Dg h2 (n + 1) :=
  Subgroup.subset_closure (Or.inl (Or.inr ⟨u, rfl⟩))

theorem atomL_Z_mem (h2 : 2 ≤ lv) {n : ℕ} (u : Lab d (n + 1)) :
    atomL (Gate.Z (one_le_of_two h2)) u ∈ Dg h2 (n + 1) :=
  Subgroup.subset_closure (Or.inr ⟨u, rfl⟩)

theorem omega_mem (h2 : 2 ≤ lv) (n : ℕ) :
    mk (g0 (Gate.omega (one_le_of_two h2))) ∈ Dg (d := d) h2 n := by
  apply Subgroup.subset_closure
  cases n with
  | zero => rfl
  | succ n => exact Or.inl (Or.inl rfl)

end Diag

/-! ### The quadratic form of the atoms -/

section Form


/-- `S(u)² Z(u)`: the phase `(u · x)²`. -/
noncomputable def qfun (h2 : 2 ≤ lv) {n : ℕ} (u : Lab d (n + 1)) : Q d lv (n + 1) :=
  atomL (Gate.S h2) u ^ 2 * atomL (Gate.Z (one_le_of_two h2)) u

theorem qfun_mem (h2 : 2 ≤ lv) {n : ℕ} (u : Lab d (n + 1)) : qfun h2 u ∈ Dg h2 (n + 1) :=
  mul_mem (pow_mem (atomL_S_mem h2 u) 2) (atomL_Z_mem h2 u)

theorem qfun_zero (h2 : 2 ≤ lv) {n : ℕ} : qfun h2 (0 : Lab d (n + 1)) = 1 := by
  simp [qfun, atomL_zero]

/-- The diagonal group as a module over `𝔽_d`, inside a proof. -/
theorem dg_exp (hA : Admissible d lv) (h2 : 2 ≤ lv) (n : ℕ) :
    letI := dgComm hA h2 n
    ∀ x : Additive (Dg (d := d) h2 n), d • x = 0 := by
  letI := dgComm hA h2 n
  intro x
  apply Additive.toMul.injective
  rw [toMul_nsmul, toMul_zero]
  exact Subtype.ext (dg_pow_d h2 hA (Additive.toMul x).2)

/-- The algebra of the atoms of `S` and `Z`, in the diagonal group read
additively: (22), (27), additivity of `Z`, and the parallelogram law. -/
theorem atom_par (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} (u v : Lab d (n + 1)) :
    atomL (Gate.S h2) (u + v) * atomL (Gate.S h2) (u - v) =
      atomL (Gate.S h2) u ^ 2 * atomL (Gate.S h2) v ^ 2 *
        atomL (Gate.Z (one_le_of_two h2)) v := by
  have hd2 : (2 : ZMod d) ≠ 0 := hA.two h2
  letI := dgComm hA h2 (n + 1)
  letI : Module (ZMod d) (Additive (Dg (d := d) h2 (n + 1))) :=
    AddCommGroup.zmodModule (dg_exp hA h2 (n + 1))
  let P : Lab d (n + 1) → Additive (Dg (d := d) h2 (n + 1)) := fun w =>
    Additive.ofMul ⟨atomL (Gate.S h2) w, atomL_S_mem h2 w⟩
  let Zt : Lab d (n + 1) → Additive (Dg (d := d) h2 (n + 1)) := fun w =>
    Additive.ofMul ⟨atomL (Gate.Z (one_le_of_two h2)) w, atomL_Z_mem h2 w⟩
  have hval : ∀ (k : ZMod d) (x : Additive (Dg (d := d) h2 (n + 1))), k.val • x = k • x := by
    intro k x; rw [← Nat.cast_smul_eq_nsmul (ZMod d), ZMod.natCast_zmod_val]
  have hPs : ∀ (c : ZMod d) w, P (c • w) = binom2 c • Zt w + (c ^ 2) • P w := by
    intro c w
    rw [← hval, ← hval]
    apply Additive.toMul.injective; apply Subtype.ext
    exact atomL_S_smul hA h2 c w
  have hZs : ∀ (c : ZMod d) w, Zt (c • w) = c • Zt w := by
    intro c w
    rw [← hval]
    apply Additive.toMul.injective; apply Subtype.ext
    exact atomL_Z_smul hA _ c w
  have hP0 : P 0 = 0 := by
    apply Additive.toMul.injective; apply Subtype.ext; exact atomL_zero _
  have hneg : ∀ w, P (-w) = P w + Zt w := by
    intro w
    rw [show -w = (-1 : ZMod d) • w by simp, hPs, binom2_neg_one hd2]
    simp only [neg_one_sq, one_smul]; abel
  suffices h : P (u + v) + P (u - v) = 2 • P u + 2 • P v + Zt v by
    have := congrArg (fun z : Additive (Dg (d := d) h2 (n + 1)) =>
      ((Additive.toMul z : Dg (d := d) h2 (n + 1)) : Q d lv (n + 1))) h
    exact this
  by_cases hu : u = 0
  · subst hu; rw [zero_add, zero_sub, hneg, hP0]; abel
  rcases dep_or_indep u v hu with ⟨c, rfl⟩ | h
  · rw [show u + c • u = (1 + c) • u by rw [add_smul, one_smul],
      show u - c • u = (1 - c) • u by rw [sub_smul, one_smul], hPs, hPs, hPs, hZs]
    have e1 : binom2 (1 + c) + binom2 (1 - c) = 2 * binom2 c + c := by
      unfold binom2; field_simp; ring
    have e2 : (1 + c) ^ 2 + (1 - c) ^ 2 = 2 + 2 * c ^ 2 := by ring
    calc binom2 (1 + c) • Zt u + (1 + c) ^ 2 • P u + (binom2 (1 - c) • Zt u + (1 - c) ^ 2 • P u)
        = (binom2 (1 + c) + binom2 (1 - c)) • Zt u + ((1 + c) ^ 2 + (1 - c) ^ 2) • P u := by
          module
      _ = (2 * binom2 c + c) • Zt u + (2 + 2 * c ^ 2) • P u := by rw [e1, e2]
      _ = _ := by module
  · cases n with
    | zero => exact (indep_width_one h).elim
    | succ n =>
      have e := par_raw hA h2 u v h
      have e' : -P u + -P v + P (u + v) = (-1 : ZMod d) • (-P u + -P (-v) + P (u - v)) := by
        rw [← hval]
        apply Additive.toMul.injective; apply Subtype.ext
        exact e
      rw [hneg, neg_one_smul] at e'
      have e'' := sub_eq_zero.mpr e'
      rw [← sub_eq_zero]
      convert e'' using 1
      abel

/-- The parallelogram law for `Q u = S(u)² Z(u)`. -/
theorem qfun_par (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} (u v : Lab d (n + 1)) :
    qfun h2 (u + v) * qfun h2 (u - v) = qfun h2 u ^ 2 * qfun h2 v ^ 2 := by
  letI := dgComm hA h2 (n + 1)
  let P : Lab d (n + 1) → Additive (Dg (d := d) h2 (n + 1)) := fun w =>
    Additive.ofMul ⟨atomL (Gate.S h2) w, atomL_S_mem h2 w⟩
  let Zt : Lab d (n + 1) → Additive (Dg (d := d) h2 (n + 1)) := fun w =>
    Additive.ofMul ⟨atomL (Gate.Z (one_le_of_two h2)) w, atomL_Z_mem h2 w⟩
  have hpar : P (u + v) + P (u - v) = 2 • P u + 2 • P v + Zt v := by
    apply Additive.toMul.injective; apply Subtype.ext; exact atom_par hA h2 u v
  have hZ : ∀ a b, Zt (a + b) = Zt a + Zt b := by
    intro a b
    apply Additive.toMul.injective; apply Subtype.ext; exact atomL_Z_add hA _ a b
  have hZ' : Zt (u - v) = Zt u - Zt v := by
    have := hZ (u - v) v
    rw [sub_add_cancel] at this
    rw [this]; abel
  have : (2 • P (u + v) + Zt (u + v)) + (2 • P (u - v) + Zt (u - v)) =
      2 • (2 • P u + Zt u) + 2 • (2 • P v + Zt v) := by
    rw [hZ, hZ']
    calc 2 • P (u + v) + (Zt u + Zt v) + (2 • P (u - v) + (Zt u - Zt v))
        = 2 • (P (u + v) + P (u - v)) + 2 • Zt u := by abel
      _ = _ := by rw [hpar]; abel
  exact congrArg (fun z : Additive (Dg (d := d) h2 (n + 1)) =>
    ((Additive.toMul z : Dg (d := d) h2 (n + 1)) : Q d lv (n + 1))) this

theorem two_halves {n : ℕ} (hd2 : (2 : ZMod d) ≠ 0) :
    (∀ v : Lab d n, ∃ w, w + w = v) ∧ (∀ v w : Lab d n, v + v = w + w → v = w) := by
  refine ⟨fun v => ⟨(2 : ZMod d)⁻¹ • v, ?_⟩, fun v w h => ?_⟩
  · rw [← two_smul (ZMod d), smul_smul, mul_inv_cancel₀ hd2, one_smul]
  · rw [← two_smul (ZMod d), ← two_smul (ZMod d)] at h
    have := congrArg ((2 : ZMod d)⁻¹ • ·) h
    simpa [smul_smul, inv_mul_cancel₀ hd2] using this

theorem odd_d (hA : Admissible d lv) (h2 : 2 ≤ lv) : Odd d := by
  have hd2 : (2 : ZMod d) ≠ 0 := hA.two h2
  refine (Fact.out : d.Prime).odd_of_ne_two ?_
  rintro rfl; exact hd2 rfl

/-- The `CZ` fan from wire `0` with labels `c`: the polar form of `Q` at
`e₀` and `(0, c)`, phase `2 x₀ (c · x')`. -/
noncomputable def kfan (h2 : 2 ≤ lv) {n : ℕ} (c : Lab d n) : Q d lv (n + 1) :=
  polarM (qfun h2) (Pi.single 0 1) (Fin.cons 0 c)

theorem qfun_commute (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} (u v : Lab d (n + 1)) :
    Commute (qfun h2 u) (qfun h2 v) := dg_commute hA h2 (qfun_mem h2 u) (qfun_mem h2 v)

theorem kfan_mem (h2 : 2 ≤ lv) {n : ℕ} (c : Lab d n) : kfan h2 c ∈ Dg h2 (n + 1) :=
  mul_mem (mul_mem (qfun_mem h2 _) (inv_mem (qfun_mem h2 _))) (inv_mem (qfun_mem h2 _))

theorem kfan_add (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} (c c' : Lab d n) :
    kfan h2 (c + c') = kfan h2 c * kfan h2 c' := by
  have hd2 : (2 : ZMod d) ≠ 0 := hA.two h2
  have hh := two_halves (n := n + 1) hd2
  unfold kfan
  rw [show (Fin.cons 0 (c + c') : Lab d (n + 1)) = Fin.cons 0 c + Fin.cons 0 c' by
    rw [cons_add', add_zero]]
  exact polarM_add_right (qfun h2) (qfun_commute hA h2) d (odd_d hA h2)
    (fun u => dg_pow_d h2 hA (qfun_mem h2 u)) hh.1 hh.2 (qfun_par hA h2) _ _ _

theorem kfan_zero (h2 : 2 ≤ lv) {n : ℕ} : kfan h2 (0 : Lab d n) = 1 := by
  unfold kfan polarM
  rw [show (Fin.cons 0 0 : Lab d (n + 1)) = 0 by
    funext i; refine Fin.cases rfl (fun j => rfl) i, add_zero, qfun_zero, inv_one, mul_one,
    mul_inv_cancel]

end Form

/-! ### The normal form -/

section NF


/-- An atom at any width (`1` at width `0`). -/
noncomputable def atomW (g : Gate d lv 1) : (n : ℕ) → Lab d n → Q d lv n
  | 0, _ => 1
  | _ + 1, u => atomL g u

theorem shiftQ_atomW (hA : Admissible d lv) (g : Gate d lv 1)
    (hg : ∀ m : ℕ, Commute (shiftQ (mk (g1 (n := m) g))) (qa (d := d) (lv := lv) m))
    (n : ℕ) (u : Lab d n) : shiftQ (atomW g n u) = atomL g (Fin.cons 0 u : Lab d (n + 1)) := by
  cases n with
  | zero =>
    rw [atomW, map_one, show (Fin.cons 0 u : Lab d 1) = 0 by
      funext i; rw [Fin.fin_one_eq_zero i]; rfl, atomL_zero]
  | succ n => exact shiftQ_atomL hA g hg u

theorem atomW_S_mem (h2 : 2 ≤ lv) (n : ℕ) (u : Lab d n) :
    atomW (Gate.S h2) n u ∈ Dg h2 n := by
  cases n with
  | zero => exact one_mem _
  | succ n => exact atomL_S_mem h2 u

theorem atomW_Z_mem (h2 : 2 ≤ lv) (n : ℕ) (u : Lab d n) :
    atomW (Gate.Z (one_le_of_two h2)) n u ∈ Dg h2 n := by
  cases n with
  | zero => exact one_mem _
  | succ n => exact atomL_Z_mem h2 u

theorem cons_split {n : ℕ} (u : Lab d (n + 1)) :
    u = (u 0) • (Pi.single 0 1 : Lab d (n + 1)) + Fin.cons 0 (Fin.tail u) := by
  funext i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp
  · simp [Fin.tail, Pi.single_apply, Fin.succ_ne_zero]

end NF

/-- The normal form of a diagonal element on `n + 1` wires:
`↑D' Z₀^a Q(e₀)^b K c` with `D'` diagonal on `n` wires. -/
def IsNF (h2 : 2 ≤ lv) {n : ℕ} (x : Q d lv (n + 1)) : Prop :=
  ∃ D' ∈ Dg h2 n, ∃ (a b : ZMod d) (c : Lab d n),
    x = shiftQ D' * atomL (Gate.Z (one_le_of_two h2)) (Pi.single 0 1) ^ a.val *
      qfun h2 (Pi.single 0 1) ^ b.val * kfan h2 c

section NFAlg

variable (hA : Admissible d lv) (h2 : 2 ≤ lv)

include hA in
/-- Membership of the pieces of a normal form. -/
theorem nf_pieces_mem {n : ℕ} {D' : Q d lv n} (hD : D' ∈ Dg h2 n) (a b : ZMod d)
    (c : Lab d n) :
    shiftQ D' ∈ Dg h2 (n + 1) ∧
      atomL (Gate.Z (one_le_of_two h2)) (Pi.single 0 1 : Lab d (n + 1)) ^ a.val ∈ Dg h2 (n + 1) ∧
      qfun h2 (Pi.single 0 1 : Lab d (n + 1)) ^ b.val ∈ Dg h2 (n + 1) ∧
      kfan h2 c ∈ Dg h2 (n + 1) :=
  ⟨shiftQ_dg h2 hA hD, pow_mem (atomL_Z_mem h2 _) _, pow_mem (qfun_mem h2 _) _, kfan_mem h2 c⟩

include hA in
theorem isNF_mul {n : ℕ} {x y : Q d lv (n + 1)} (hx : IsNF h2 x) (hy : IsNF h2 y) :
    IsNF h2 (x * y) := by
  obtain ⟨D₁, hD₁, a₁, b₁, c₁, rfl⟩ := hx
  obtain ⟨D₂, hD₂, a₂, b₂, c₂, rfl⟩ := hy
  refine ⟨D₁ * D₂, mul_mem hD₁ hD₂, a₁ + a₂, b₁ + b₂, c₁ + c₂, ?_⟩
  have hZd := atomL_pow_d (Gate.Z (one_le_of_two h2)) (relZd _) (Pi.single 0 1 : Lab d (n + 1))
  have hQd := dg_pow_d h2 hA (qfun_mem h2 (Pi.single 0 1 : Lab d (n + 1)))
  rw [map_mul, pow_val_add hZd, pow_val_add hQd, kfan_add hA h2]
  obtain ⟨m₁, z₁, q₁, k₁⟩ := nf_pieces_mem hA h2 hD₁ a₁ b₁ c₁
  obtain ⟨m₂, z₂, q₂, k₂⟩ := nf_pieces_mem hA h2 hD₂ a₂ b₂ c₂
  letI := dgComm hA h2 (n + 1)
  have := congrArg Subtype.val (show
    (⟨_, m₁⟩ * ⟨_, z₁⟩ * ⟨_, q₁⟩ * ⟨_, k₁⟩ * (⟨_, m₂⟩ * ⟨_, z₂⟩ * ⟨_, q₂⟩ * ⟨_, k₂⟩) :
      Dg h2 (n + 1)) =
    ⟨_, m₁⟩ * ⟨_, m₂⟩ * (⟨_, z₁⟩ * ⟨_, z₂⟩) * (⟨_, q₁⟩ * ⟨_, q₂⟩) * (⟨_, k₁⟩ * ⟨_, k₂⟩) by
      ac_rfl)
  exact this

include hA in
theorem isNF_inv {n : ℕ} {x : Q d lv (n + 1)} (hx : IsNF h2 x) : IsNF h2 x⁻¹ := by
  obtain ⟨D, hD, a, b, c, rfl⟩ := hx
  refine ⟨D⁻¹, inv_mem hD, -a, -b, -c, ?_⟩
  have hZd := atomL_pow_d (Gate.Z (one_le_of_two h2)) (relZd _) (Pi.single 0 1 : Lab d (n + 1))
  have hQd := dg_pow_d h2 hA (qfun_mem h2 (Pi.single 0 1 : Lab d (n + 1)))
  have hk : kfan h2 (-c) = (kfan h2 c)⁻¹ := by
    rw [eq_inv_iff_mul_eq_one, ← kfan_add hA h2, neg_add_cancel, kfan_zero]
  rw [map_inv, pow_val_neg hZd, pow_val_neg hQd, hk]
  obtain ⟨m, z, q, k⟩ := nf_pieces_mem hA h2 hD a b c
  letI := dgComm hA h2 (n + 1)
  have := congrArg Subtype.val (show
    ((⟨_, m⟩ * ⟨_, z⟩ * ⟨_, q⟩ * ⟨_, k⟩)⁻¹ : Dg h2 (n + 1)) =
    (⟨_, m⟩)⁻¹ * (⟨_, z⟩)⁻¹ * (⟨_, q⟩)⁻¹ * (⟨_, k⟩)⁻¹ by
      simp only [mul_inv])
  exact this

include hA in
theorem isNF_pow {n : ℕ} {x : Q d lv (n + 1)} (hx : IsNF h2 x) (k : ℕ) : IsNF h2 (x ^ k) := by
  induction k with
  | zero =>
    refine ⟨1, one_mem _, 0, 0, 0, ?_⟩
    simp [kfan_zero]
  | succ k ih => rw [pow_succ]; exact isNF_mul hA h2 ih hx

end NFAlg

section NFGen

variable (hA : Admissible d lv) (h2 : 2 ≤ lv)

include hA in
/-- `Q (c u) = Q u ^ {c²}`. -/
theorem qfun_smul {n : ℕ} (c : ZMod d) (u : Lab d (n + 1)) :
    qfun h2 (c • u) = qfun h2 u ^ (c ^ 2).val := by
  have hd2 : (2 : ZMod d) ≠ 0 := hA.two h2
  letI := dgComm hA h2 (n + 1)
  letI : Module (ZMod d) (Additive (Dg (d := d) h2 (n + 1))) :=
    AddCommGroup.zmodModule (dg_exp hA h2 (n + 1))
  have hval : ∀ (k : ZMod d) (x : Additive (Dg (d := d) h2 (n + 1))), k.val • x = k • x := by
    intro k x; rw [← Nat.cast_smul_eq_nsmul (ZMod d), ZMod.natCast_zmod_val]
  let P : Lab d (n + 1) → Additive (Dg (d := d) h2 (n + 1)) := fun w =>
    Additive.ofMul ⟨atomL (Gate.S h2) w, atomL_S_mem h2 w⟩
  let Zt : Lab d (n + 1) → Additive (Dg (d := d) h2 (n + 1)) := fun w =>
    Additive.ofMul ⟨atomL (Gate.Z (one_le_of_two h2)) w, atomL_Z_mem h2 w⟩
  have hPs : P (c • u) = binom2 c • Zt u + (c ^ 2) • P u := by
    rw [← hval, ← hval]
    apply Additive.toMul.injective; apply Subtype.ext
    exact atomL_S_smul hA h2 c u
  have hZs : Zt (c • u) = c • Zt u := by
    rw [← hval]
    apply Additive.toMul.injective; apply Subtype.ext
    exact atomL_Z_smul hA _ c u
  have e1 : 2 * binom2 c + c = c ^ 2 := by unfold binom2; field_simp; ring
  have : 2 • P (c • u) + Zt (c • u) = (c ^ 2).val • (2 • P u + Zt u) := by
    rw [hPs, hZs, hval]
    calc 2 • (binom2 c • Zt u + c ^ 2 • P u) + c • Zt u
        = (2 * binom2 c + c) • Zt u + (c ^ 2) • (2 • P u) := by module
      _ = _ := by rw [e1]; module
  exact congrArg (fun z : Additive (Dg (d := d) h2 (n + 1)) =>
    ((Additive.toMul z : Dg (d := d) h2 (n + 1)) : Q d lv (n + 1))) this

include hA in
/-- `Q` one wire up. -/
theorem qfun_shift {n : ℕ} (u : Lab d n) :
    qfun h2 (Fin.cons 0 u : Lab d (n + 1)) =
      shiftQ (atomW (Gate.S h2) n u ^ 2 * atomW (Gate.Z (one_le_of_two h2)) n u) := by
  rw [qfun, map_mul, map_pow, shiftQ_atomW hA _ (relS1CX h2), shiftQ_atomW hA _ (relZ1CX' _)]

include hA in
theorem kfan_nsmul {n : ℕ} (k : ℕ) (c : Lab d n) : kfan h2 (k • c) = kfan h2 c ^ k := by
  induction k with
  | zero => rw [zero_smul, kfan_zero, pow_zero]
  | succ k ih => rw [succ_nsmul, kfan_add hA h2, ih, pow_succ]

include hA in
theorem polarM_nsmul {n : ℕ} (k : ℕ) (u v : Lab d (n + 1)) :
    polarM (qfun h2) (k • u) v = polarM (qfun h2) u v ^ k := by
  have hd2 : (2 : ZMod d) ≠ 0 := hA.two h2
  have hh := two_halves (n := n + 1) hd2
  induction k with
  | zero =>
    simp [polarM, qfun_zero]
  | succ k ih =>
    rw [succ_nsmul, polarM_add_left (qfun h2) (qfun_commute hA h2) d (odd_d hA h2)
      (fun u => dg_pow_d h2 hA (qfun_mem h2 u)) hh.1 hh.2 (qfun_par hA h2), ih, pow_succ]

theorem omega_isNF {n : ℕ} :
    IsNF (d := d) h2 (mk (g0 (n := n + 1) (Gate.omega (d := d) (lv := lv) (one_le_of_two h2)))) := by
  refine ⟨mk (g0 (Gate.omega (one_le_of_two h2))), omega_mem h2 n, 0, 0, 0, ?_⟩
  rw [shiftQ_mk, mk_scalar_up, kfan_zero]
  simp

include hA in
theorem atomZ_isNF {n : ℕ} (u : Lab d (n + 1)) :
    IsNF h2 (atomL (Gate.Z (one_le_of_two h2)) u) := by
  refine ⟨atomW (Gate.Z (one_le_of_two h2)) n (Fin.tail u), atomW_Z_mem h2 n _, u 0, 0,
    0, ?_⟩
  conv_lhs => rw [cons_split u]
  rw [atomL_Z_add hA, atomL_Z_smul hA, shiftQ_atomW hA _ (relZ1CX' _), kfan_zero]
  have hc : Commute (atomL (Gate.Z (one_le_of_two h2)) (Pi.single 0 1 : Lab d (n + 1)) ^ (u 0).val)
      (atomL (Gate.Z (one_le_of_two h2)) (Fin.cons 0 (Fin.tail u))) :=
    ((atomL_commute hA h2 (phaseGate_Z h2) (phaseGate_Z h2) _ _).pow_left _)
  rw [hc.eq]
  simp

include hA in
theorem qfun_isNF {n : ℕ} (u : Lab d (n + 1)) : IsNF h2 (qfun h2 u) := by
  have hd2 : (2 : ZMod d) ≠ 0 := hA.two h2
  refine ⟨atomW (Gate.S h2) n (Fin.tail u) ^ 2 * atomW (Gate.Z (one_le_of_two h2)) n (Fin.tail u),
    mul_mem (pow_mem (atomW_S_mem h2 n _) 2) (atomW_Z_mem h2 n _), 0, (u 0) ^ 2,
    (u 0).val • Fin.tail u, ?_⟩
  conv_lhs => rw [cons_split u]
  rw [Q_add_eqM (qfun h2) (qfun_commute hA h2), qfun_smul hA h2, ← qfun_shift hA h2,
    show (u 0) • (Pi.single 0 1 : Lab d (n + 1)) = (u 0).val • Pi.single 0 1 by
      rw [← Nat.cast_smul_eq_nsmul (ZMod d), ZMod.natCast_zmod_val],
    polarM_nsmul hA h2, kfan_nsmul hA h2]
  simp only [pow_zero, ZMod.val_zero, mul_one]
  rw [show polarM (qfun h2) (Pi.single 0 1 : Lab d (n + 1)) (Fin.cons 0 (Fin.tail u)) =
    kfan h2 (Fin.tail u) from rfl]
  have h1 := qfun_mem h2 (Pi.single 0 1 : Lab d (n + 1))
  have h2' := qfun_mem h2 (Fin.cons 0 (Fin.tail u) : Lab d (n + 1))
  have h3 := kfan_mem h2 (Fin.tail u)
  rw [((dg_commute hA h2 (pow_mem h1 _) h2')).eq]

include hA in
theorem atomS_isNF {n : ℕ} (u : Lab d (n + 1)) : IsNF h2 (atomL (Gate.S h2) u) := by
  obtain ⟨k, hk⟩ := odd_d hA h2
  have hS := atomL_pow_d (Gate.S h2) (relSd h2) u
  have e : atomL (Gate.S h2) u = (qfun h2 u * (atomL (Gate.Z (one_le_of_two h2)) u)⁻¹) ^ (k + 1) := by
    rw [qfun, mul_inv_cancel_right, ← pow_mul, show 2 * (k + 1) = d + 1 by omega, pow_succ, hS,
      one_mul]
  rw [e]
  exact isNF_pow hA h2 (isNF_mul hA h2 (qfun_isNF hA h2 u) (isNF_inv hA h2 (atomZ_isNF hA h2 u))) _

include hA in
/-- Every diagonal element on `n + 1` wires has a normal form. -/
theorem dg_nf {n : ℕ} {x : Q d lv (n + 1)} (hx : x ∈ Dg h2 (n + 1)) : IsNF h2 x := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    simp only [dgens, Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hx
    rcases hx with (rfl | ⟨u, rfl⟩) | ⟨u, rfl⟩
    · exact omega_isNF h2
    · exact atomS_isNF hA h2 u
    · exact atomZ_isNF hA h2 u
  | one => exact ⟨1, one_mem _, 0, 0, 0, by simp [kfan_zero]⟩
  | mul x y _ _ hx hy => exact isNF_mul hA h2 hx hy
  | inv x _ hx => exact isNF_inv hA h2 hx

end NFGen

/-! ### The phase of a normal form, and injectivity -/

section Inj

variable (hA : Admissible d lv) (h2 : 2 ≤ lv)

theorem sum_single0 {n : ℕ} (y : Lab d (n + 1)) :
    ∑ j, (Pi.single 0 1 : Lab d (n + 1)) j * y j = y 0 := by
  rw [Finset.sum_eq_single 0 (fun j _ hj => by rw [Pi.single_eq_of_ne hj, zero_mul]) (by simp),
    Pi.single_eq_same, one_mul]

omit [Fact d.Prime] in
theorem PA.onTop_diag {n : ℕ} (q : Lab d n → ZMod d) :
    PA.onTop (PA.diag q) = PA.diag (fun y : Lab d (n + 1) => q (Fin.tail y)) := by
  refine PA.ext ?_ (funext fun y => ?_)
  · funext y i
    refine Fin.cases ?_ (fun j => ?_) i
    · rw [PA.onTop_f_zero']; rfl
    · rw [PA.onTop_f_succ]; rfl
  · rw [PA.onTop_q']; rfl

include hA in
theorem semQ_inv_dg {n : ℕ} {x : Q d lv n} (hx : x ∈ Dg h2 n) :
    semQ hA n x⁻¹ = PA.diag (fun y => -(semQ hA n x).q y) := by
  have h1 : semQ hA n x⁻¹ * semQ hA n x = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
  rw [dg_diag hA h2 (inv_mem hx), dg_diag hA h2 hx, PA.diag_mul] at h1
  refine PA.ext (dg_f hA h2 (inv_mem hx)) (funext fun y => ?_)
  have := congrArg (fun p => p.q y) h1
  simp only [PA.diag_q, Pi.add_apply, PA.one_q] at this
  rw [PA.diag_q]; linear_combination this

theorem semQ_pow_diag {n : ℕ} {x : Q d lv n} (q : Lab d n → ZMod d)
    (hq : semQ hA n x = PA.diag q) (k : ZMod d) :
    semQ hA n (x ^ k.val) = PA.diag (fun y => k * q y) := by
  rw [map_pow, hq, PA.diag_pow]
  congr 1; funext y
  rw [Pi.smul_apply, nsmul_eq_mul, ZMod.natCast_zmod_val]

include hA in
theorem semQ_qfun {n : ℕ} (u : Lab d (n + 1)) :
    semQ hA (n + 1) (qfun h2 u) = PA.diag fun y => (∑ j, u j * y j) ^ 2 := by
  have hd2 : (2 : ZMod d) ≠ 0 := hA.two h2
  rw [qfun, map_mul, map_pow, semQ_atomL_S, semQ_atomL_Z, PA.diag_pow, PA.diag_mul]
  congr 1; funext y
  rw [Pi.add_apply, Pi.smul_apply, nsmul_eq_mul, Nat.cast_ofNat]
  beta_reduce
  unfold binom2
  linear_combination ((∑ j, u j * y j) ^ 2 - ∑ j, u j * y j) * mul_inv_cancel₀ hd2

include hA in
theorem semQ_kfan {n : ℕ} (c : Lab d n) :
    semQ hA (n + 1) (kfan h2 c) =
      PA.diag fun y => 2 * y 0 * ∑ j, c j * Fin.tail y j := by
  have h1 := qfun_mem h2 (Pi.single 0 1 : Lab d (n + 1))
  have h2' := qfun_mem h2 (Fin.cons 0 c : Lab d (n + 1))
  rw [kfan, polarM, map_mul, map_mul, semQ_inv_dg hA h2 h1, semQ_inv_dg hA h2 h2', semQ_qfun hA h2,
    semQ_qfun hA h2, semQ_qfun hA h2, PA.diag_q, PA.diag_q, PA.diag_mul, PA.diag_mul]
  congr 1; funext y
  simp only [Pi.add_apply]
  have hs2 : ∑ j, (Fin.cons 0 c : Lab d (n + 1)) j * y j = ∑ j, c j * Fin.tail y j := by
    rw [sum_cons]; simp only [Fin.cons_zero, zero_mul, zero_add, Fin.tail_cons]
  have hs3 : ∑ j, ((Pi.single 0 1 : Lab d (n + 1)) j + (Fin.cons 0 c : Lab d (n + 1)) j) * y j =
      y 0 + ∑ j, c j * Fin.tail y j := by
    rw [← hs2, ← sum_single0 y, ← Finset.sum_add_distrib]; simp only [add_mul]
  rw [hs3, hs2, sum_single0]; ring

include hA in
/-- The phase of a normal form. -/
theorem semQ_nf {n : ℕ} {D' : Q d lv n} (hD : D' ∈ Dg h2 n) (a b : ZMod d) (c : Lab d n) :
    semQ hA (n + 1) (shiftQ D' * atomL (Gate.Z (one_le_of_two h2)) (Pi.single 0 1) ^ a.val *
      qfun h2 (Pi.single 0 1) ^ b.val * kfan h2 c) =
    PA.diag fun y => (semQ hA n D').q (Fin.tail y) + a * y 0 + b * y 0 ^ 2 +
      2 * y 0 * ∑ j, c j * Fin.tail y j := by
  rw [map_mul, map_mul, map_mul, semQ_shiftQ, dg_diag hA h2 hD, PA.onTop_diag,
    semQ_pow_diag hA _ (semQ_atomL_Z hA _ _), semQ_pow_diag hA _ (semQ_qfun hA h2 _),
    semQ_kfan hA h2, PA.diag_mul, PA.diag_mul, PA.diag_mul]
  congr 1; funext y
  simp only [Pi.add_apply, PA.diag_q, sum_single0]

include hA in
/-- A diagonal element with the trivial pair is trivial: the coefficients of
the normal form are read off the phase (Proposition 1). -/
theorem dg_inj : ∀ (n : ℕ) {x : Q d lv n}, x ∈ Dg h2 n → semQ hA n x = 1 → x = 1
  | 0, x, hx, h => by
    have hω := relωd (d := d) (lv := lv) (n := 0) (one_le_of_two h2)
    have hω' := hω
    rw [← zpow_natCast] at hω'
    obtain ⟨k, rfl⟩ := Subgroup.mem_closure_singleton.1 hx
    rw [zpow_eq_zpow_emod k hω'] at h ⊢
    have hk : 0 ≤ k % (d : ℤ) := Int.emod_nonneg _ (by exact_mod_cast (Fact.out : d.Prime).ne_zero)
    have hk' : k % (d : ℤ) < d := Int.emod_lt_of_pos _ (by exact_mod_cast (Fact.out : d.Prime).pos)
    rw [← Int.toNat_of_nonneg hk, zpow_natCast] at h ⊢
    rw [map_pow, semQ_omega, PA.diag_pow] at h
    have h0 : ((k % (d : ℤ)).toNat : ZMod d) = 0 := by
      have := congrArg (fun p => p.q 0) h
      simpa [PA.diag_q, PA.one_q] using this
    rw [ZMod.natCast_eq_zero_iff] at h0
    have : (k % (d : ℤ)).toNat = 0 := Nat.eq_zero_of_dvd_of_lt h0 (by omega)
    rw [this, pow_zero]
  | n + 1, x, hx, h => by
    have hd2 : (2 : ZMod d) ≠ 0 := hA.two h2
    obtain ⟨D', hD, a, b, c, rfl⟩ := dg_nf hA h2 hx
    rw [semQ_nf hA h2 hD] at h
    have hq : ∀ y : Lab d (n + 1), (semQ hA n D').q (Fin.tail y) + a * y 0 + b * y 0 ^ 2 +
        2 * y 0 * ∑ j, c j * Fin.tail y j = 0 := fun y => congrArg (fun p => p.q y) h
    -- the upper wires
    have hD1 : D' = 1 := by
      apply dg_inj n hD
      rw [dg_diag hA h2 hD]
      refine PA.ext rfl (funext fun y => ?_)
      have := hq (Fin.cons 0 y)
      simpa using this
    have ha : a + b = 0 := by simpa [hD1] using hq (Fin.cons 1 0)
    have hb : -a + b = 0 := by simpa [hD1] using hq (Fin.cons (-1) 0)
    have hb0 : b = 0 := by
      have : 2 * b = 0 := by linear_combination ha + hb
      exact (mul_eq_zero.1 this).resolve_left hd2
    have ha0 : a = 0 := by rw [hb0, add_zero] at ha; exact ha
    have hc : c = 0 := by
      funext j
      have := hq (Fin.cons 1 (Pi.single j 1))
      simp [hD1, ha0, hb0, Pi.single_apply] at this
      exact this.resolve_left hd2
    rw [hD1, ha0, hb0, hc, map_one, ZMod.val_zero, pow_zero, pow_zero, kfan_zero]
    simp

end Inj

end QCert.PhaseAffine
