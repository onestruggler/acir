# The diagonal group of the cubic fragment

The diagonal circuits of `CubicPhase_d` (`d > 3`), modulo the theory: the
group `Dg3 n` generated by the scalar and the atoms of `S`, `Z` and `T` on
linear forms. It is abelian, of exponent `d`, contains the diagonal group
`Dg` of the quadratic fragment, and a linear circuit conjugates it into
itself, acting on the forms by its rows (`atomL_conj`, `pb`).
-/
import QCert.PhaseAffine.CubeAtoms

namespace QCert.PhaseAffine

open Circuit

variable {d lv : ℕ} [Fact d.Prime]

local notation "𝒢" => gateData d lv

/-! ### The rows of a linear circuit -/

/-- Row `j` of a linear circuit. -/
def rowj {n : ℕ} (w : C d lv n) (j : Fin n) : Lab d n :=
  fun k => ((𝒢).sem n w).f (Pi.single k 1) j

theorem sem_rowj {n : ℕ} (w : C d lv n) (hw : IsLinW w) (y : Lab d n) (j : Fin n) :
    ((𝒢).sem n w).f y j = ∑ k, rowj w j k * y k := by
  conv_lhs => rw [show y = ∑ k, y k • Pi.single k (1 : ZMod d) by
    funext i; simp [Finset.sum_apply, Pi.single_apply]]
  have hsum : ∀ s : Finset (Fin n), ((𝒢).sem n w).f (∑ k ∈ s, y k • Pi.single k 1) =
      ∑ k ∈ s, y k • ((𝒢).sem n w).f (Pi.single k 1) := by
    intro s
    induction s using Finset.induction_on with
    | empty => simpa using (sem_lin w hw).1
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, sem_add w hw, sem_smul w hw, ih]
  rw [hsum, Finset.sum_apply]
  simp only [Pi.smul_apply, smul_eq_mul, rowj]
  exact Finset.sum_congr rfl fun k _ => mul_comm _ _

/-- The form `u` pulled back along a linear circuit: `u · (w x)`. -/
def pb {n : ℕ} (u : Lab d n) (w : C d lv n) : Lab d n := ∑ j, u j • rowj w j

theorem sem_pb_apply {n : ℕ} (w : C d lv n) (hw : IsLinW w) (u y : Lab d n) :
    ∑ j, u j * ((𝒢).sem n w).f y j = ∑ k, pb u w k * y k := by
  simp only [sem_rowj w hw, pb, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.mul_sum,
    Finset.sum_mul]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring

/-- A form is determined by its values. -/
theorem form_ext {n : ℕ} {u v : Lab d n} (h : ∀ y : Lab d n, ∑ k, u k * y k = ∑ k, v k * y k) :
    u = v := by
  funext k
  have := h (Pi.single k 1)
  simpa [Pi.single_apply] using this

theorem pb_eq_of {n : ℕ} (w : C d lv n) (hw : IsLinW w) (u v : Lab d n)
    (h : ∀ y, ∑ j, u j * ((𝒢).sem n w).f y j = ∑ k, v k * y k) : pb u w = v :=
  form_ext fun y => by rw [← sem_pb_apply w hw, h]

theorem pb_mul {n : ℕ} (u : Lab d n) (W P : C d lv n) (hW : IsLinW W) (hP : IsLinW P) :
    pb u (W * P) = pb (pb u W) P := by
  refine pb_eq_of _ (hW.mul hP) _ _ fun y => ?_
  rw [← sem_pb_apply P hP, ← sem_pb_apply W hW]
  simp only [sem_f_mul]

theorem pb_add {n : ℕ} (u v : Lab d n) (w : C d lv n) : pb (u + v) w = pb u w + pb v w := by
  simp only [pb, Pi.add_apply, add_smul, Finset.sum_add_distrib]

theorem pb_smul {n : ℕ} (c : ZMod d) (u : Lab d n) (w : C d lv n) :
    pb (c • u) w = c • pb u w := by
  simp only [pb, Pi.smul_apply, smul_eq_mul, Finset.smul_sum, smul_smul]

theorem pb_neg {n : ℕ} (u : Lab d n) (w : C d lv n) : pb (-u) w = -pb u w := by
  rw [show -u = (-1 : ZMod d) • u by simp, pb_smul]; simp

theorem pb_sub {n : ℕ} (u v : Lab d n) (w : C d lv n) : pb (u - v) w = pb u w - pb v w := by
  rw [sub_eq_add_neg, pb_add, pb_neg, ← sub_eq_add_neg]

theorem pb_zero {n : ℕ} (w : C d lv n) : pb (0 : Lab d n) w = 0 := by
  simp [pb]

theorem atomL_conj (hA : Admissible d lv) (g : Gate d lv 1)
    (hg : ∀ m : ℕ, Commute (shiftQ (mk (g1 (n := m) g))) (qa (d := d) (lv := lv) m))
    {n : ℕ} (u : Lab d (n + 1)) (P : C d lv (n + 1)) (hP : IsLinW P) :
    (mk P)⁻¹ * atomL g u * mk P = atomL g (pb u P) := by
  by_cases hu : u = 0
  · subst hu; rw [atomL_zero, pb_zero, atomL_zero]; group
  rw [atomL, if_neg hu, atom_conj]
  refine atom_eq_atomL hA g hg _ ((isLinW_rowW _ _).mul hP) _ fun y => ?_
  rw [sem_f_mul, sem_rowW n u hu, sem_pb_apply P hP]

/-! ### The diagonal group -/

/-- The generators: the scalar and the atoms of `S`, `Z`, `T`. -/
def dgens3 (h3 : 3 ≤ lv) : (n : ℕ) → Set (Q d lv n)
  | 0 => dgens (two_le_of_three h3) 0
  | n + 1 => dgens (two_le_of_three h3) (n + 1) ∪ Set.range (atomL (n := n) (Gate.T h3))

theorem dgens3_comm (hA : Admissible d lv) (h3 : 3 ≤ lv) :
    ∀ (n : ℕ), ∀ x ∈ dgens3 (d := d) h3 n, ∀ y ∈ dgens3 h3 n, x * y = y * x
  | 0, x, hx, y, hy => dgens_comm hA (two_le_of_three h3) 0 x hx y hy
  | n + 1, x, hx, y, hy => by
    have hω : ∀ q : Q d lv (n + 1),
        Commute (mk (g0 (Gate.omega (one_le_of_two (two_le_of_three h3))))) q :=
      mk_omega_central _
    have key : ∀ g g' : Gate d lv 1,
        (g = Gate.S (two_le_of_three h3) ∨ g = Gate.Z (by omega) ∨ g = Gate.T h3) →
        (g' = Gate.S (two_le_of_three h3) ∨ g' = Gate.Z (by omega) ∨ g' = Gate.T h3) →
        ∀ u v : Lab d (n + 1), atomL g u * atomL g' v = atomL g' v * atomL g u :=
      fun g g' hg hg' u v => (atomL_commute hA (cubeSet h3) hg hg' u v).eq
    simp only [dgens3, dgens, Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hx hy
    rcases hx with ((rfl | ⟨u, rfl⟩) | ⟨u, rfl⟩) | ⟨u, rfl⟩ <;>
      rcases hy with ((rfl | ⟨v, rfl⟩) | ⟨v, rfl⟩) | ⟨v, rfl⟩
    all_goals first
      | rfl
      | exact (hω _).eq
      | exact (hω _).eq.symm
      | exact key _ _ (by first | exact Or.inl rfl | exact Or.inr (Or.inl rfl) |
          exact Or.inr (Or.inr rfl)) (by first | exact Or.inl rfl | exact Or.inr (Or.inl rfl) |
          exact Or.inr (Or.inr rfl)) u v

/-- The diagonal group of the cubic fragment on `n` wires. -/
noncomputable abbrev Dg3 (h3 : 3 ≤ lv) (n : ℕ) : Subgroup (Q d lv n) :=
  Subgroup.closure (dgens3 h3 n)

theorem dg3_commute (hA : Admissible d lv) (h3 : 3 ≤ lv) {n : ℕ} {x y : Q d lv n}
    (hx : x ∈ Dg3 h3 n) (hy : y ∈ Dg3 h3 n) : Commute x y := by
  have hc := Subgroup.isMulCommutative_closure (dgens3_comm hA h3 n)
  exact congrArg Subtype.val (hc.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩)

theorem dg_le_dg3 (h3 : 3 ≤ lv) (n : ℕ) : Dg (d := d) (two_le_of_three h3) n ≤ Dg3 h3 n := by
  apply Subgroup.closure_mono
  cases n with
  | zero => exact le_rfl
  | succ n => exact Set.subset_union_left

theorem atomL_T_mem3 (h3 : 3 ≤ lv) {n : ℕ} (u : Lab d (n + 1)) :
    atomL (Gate.T h3) u ∈ Dg3 h3 (n + 1) :=
  Subgroup.subset_closure (Or.inr ⟨u, rfl⟩)

theorem dg_mem3 (h3 : 3 ≤ lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg (two_le_of_three h3) n) : x ∈ Dg3 h3 n :=
  dg_le_dg3 h3 n hx

theorem dg3_pow_d (hA : Admissible d lv) (h3 : 3 ≤ lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg3 h3 n) : x ^ d = 1 := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    cases n with
    | zero => exact dg_pow_d (two_le_of_three h3) hA (Subgroup.subset_closure hx)
    | succ n =>
      rcases hx with hx | ⟨u, rfl⟩
      · exact dg_pow_d (two_le_of_three h3) hA (Subgroup.subset_closure hx)
      · exact atomL_pow_d _ (relTd h3) u
  | one => exact one_pow _
  | mul x y hx hy ihx ihy => rw [(dg3_commute hA h3 hx hy).mul_pow, ihx, ihy, one_mul]
  | inv x hx ih => rw [inv_pow, ih, inv_one]

theorem semQ_atomL_T (hA : Admissible d lv) (h3 : 3 ≤ lv) {n : ℕ} (u : Lab d (n + 1)) :
    semQ hA (n + 1) (atomL (Gate.T h3) u) = PA.diag fun y => binom3 (∑ j, u j * y j) := by
  rw [atomL]
  split_ifs with hu
  · subst hu
    refine PA.ext rfl (funext fun y => ?_)
    simp [binom3]
  · rw [semQ_atom hA _ binom3 rfl _ (isLinW_rowW _ _)]
    congr 1; funext y; rw [sem_rowW n u hu]

theorem dg3_f (hA : Admissible d lv) (h3 : 3 ≤ lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg3 h3 n) : (semQ hA n x).f = id := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    cases n with
    | zero => exact dg_f hA (two_le_of_three h3) (Subgroup.subset_closure hx)
    | succ n =>
      rcases hx with hx | ⟨u, rfl⟩
      · exact dg_f hA (two_le_of_three h3) (Subgroup.subset_closure hx)
      · rw [semQ_atomL_T]; rfl
  | one => rw [map_one]; rfl
  | mul x y _ _ ihx ihy => rw [map_mul, PA.mul_f, ihx, ihy]; rfl
  | inv x hx ih =>
    have h1 : semQ hA n x⁻¹ * semQ hA n x = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
    have := congrArg PA.f h1
    rw [PA.mul_f, ih] at this
    exact this

theorem dg3_diag (hA : Admissible d lv) (h3 : 3 ≤ lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg3 h3 n) : semQ hA n x = PA.diag (semQ hA n x).q :=
  PA.ext (dg3_f hA h3 hx) rfl

theorem shiftQ_dg3 (hA : Admissible d lv) (h3 : 3 ≤ lv) {n : ℕ} {x : Q d lv n}
    (hx : x ∈ Dg3 h3 n) : shiftQ x ∈ Dg3 h3 (n + 1) := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    cases n with
    | zero => exact dg_mem3 h3 (shiftQ_dg (two_le_of_three h3) hA (Subgroup.subset_closure hx))
    | succ n =>
      rcases hx with hx | ⟨u, rfl⟩
      · exact dg_mem3 h3 (shiftQ_dg (two_le_of_three h3) hA (Subgroup.subset_closure hx))
      · rw [shiftQ_atomL hA _ (relT1CX h3) u]; exact atomL_T_mem3 h3 _
  | one => rw [map_one]; exact one_mem _
  | mul x y _ _ ihx ihy => rw [map_mul]; exact mul_mem ihx ihy
  | inv x _ ih => rw [map_inv]; exact inv_mem ih

/-- A linear circuit conjugates the diagonal group of the quadratic fragment
into itself. -/
theorem conj_lin_dg (hA : Admissible d lv) (h2 : 2 ≤ lv) {n : ℕ} (P : C d lv (n + 1))
    (hP : IsLinW P) : ∀ x ∈ Dg h2 (n + 1), (mk P)⁻¹ * x * mk P ∈ Dg h2 (n + 1) := by
  apply conj_into
  intro y hy
  simp only [dgens, Set.mem_union, Set.mem_singleton_iff, Set.mem_range] at hy
  rcases hy with (rfl | ⟨u, rfl⟩) | ⟨u, rfl⟩
  · rw [omega_conj]; exact omega_mem h2 _
  · rw [atomL_conj hA _ (relS1CX h2) u P hP]; exact atomL_S_mem h2 _
  · rw [atomL_conj hA _ (relZ1CX' _) u P hP]; exact atomL_Z_mem h2 _

/-- A linear circuit conjugates the diagonal group into itself. -/
theorem conj_lin_dg3 (hA : Admissible d lv) (h3 : 3 ≤ lv) {n : ℕ} (P : C d lv (n + 1))
    (hP : IsLinW P) : ∀ x ∈ Dg3 h3 (n + 1), (mk P)⁻¹ * x * mk P ∈ Dg3 h3 (n + 1) := by
  apply conj_into
  intro y hy
  rcases hy with hy | ⟨u, rfl⟩
  · exact dg_mem3 h3 (conj_lin_dg hA (two_le_of_three h3) P hP y (Subgroup.subset_closure hy))
  · rw [atomL_conj hA _ (relT1CX h3) u P hP]; exact atomL_T_mem3 h3 _

end QCert.PhaseAffine
