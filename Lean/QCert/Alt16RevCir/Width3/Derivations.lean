theorem order : ∀ d, 2 + d ≤ 8 → 3 ⊢ᵀ Θ d * Θ d ≈ 1
  | 0, _ => order0.to rfl rfl
  | 1, _ => order1.to rfl rfl
  | 2, _ => order2.to rfl rfl
  | 3, _ => order3.to rfl rfl
  | 4, _ => order4.to rfl rfl
  | 5, _ => order5.to rfl rfl
  | 6, _ => order6.to rfl rfl
  | _ + 7, _ => by omega

theorem braid : ∀ d, 3 + d ≤ 8 →
    3 ⊢ᵀ Θ d * Θ (d + 1) * Θ d ≈ Θ (d + 1) * Θ d * Θ (d + 1)
  | 0, _ => braid0.to rfl rfl
  | 1, _ => braid1.to rfl rfl
  | 2, _ => braid2.to rfl rfl
  | 3, _ => braid3.to rfl rfl
  | 4, _ => braid4.to rfl rfl
  | 5, _ => braid5.to rfl rfl
  | _ + 6, _ => by omega

