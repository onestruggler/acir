# The derivations, from the rules on 2 wires, that the Reidemeister–Schreier step from Symmetric's presentation needs

Translation of `Width2/Derivations.agda`.

GENERATED by `gen/mk_narrow.py` (the port of the Agda's `gen/mk_narrow.py`)
from the Agda's `gen/narrow2.json`, which its `gen/narrow.py` finds by a
proof-producing Knuth–Bendix completion of the rules.  `Θ d` is the edge
Toffoli of the states `d` and `d + 1` along the Gray code, the circuit of
their transposition.  The equations `order0`, …, `braid0`, … and `far0_2`,
… are the Coxeter relations between the `Θ d`, and `gate_…` says which word
in the `Θ d` a gate on its own wires is.  Each is a run of the engine: every
step rewrites by an axiom `ax_…` (a rule of `Theory`, a law of the swap or a
structural rule, at this width) or by a rule `R…` of the completion, itself
derived from earlier ones.  `order`, `braid` and `far` collect them by
index.

The letters are the alphabet `L2` of `Engine` (the Agda defines them here,
as generators).  The Agda's guards `T (2 + d ≤ᵇ N)` are the inequalities
themselves, and an index out of range is absurd by `omega`.
-/
import QCert.Alt16RevCir.Theory
import QCert.Alt16RevCir.Engine

namespace QCert.Alt16RevCir.Width2.Derivations

open QCert QCert.Circuit CircuitProp Engine

/-! ## The rules at this width -/

def ax_r1 : Eqn TRel L2 := eqnW [.x0, .x0]
  []
  (pad₁ (srel_rule TRel.r1) 1)
  rfl rfl

def ax_r1_up : Eqn TRel L2 := eqnW [.x1, .x1]
  []
  (lemma_cong_up (srel_rule TRel.r1))
  rfl rfl

def ax_comm_ab : Eqn TRel L2 := eqnW [.x1, .x0]
  [.x0, .x1]
  (Derivable.of (Lift.comm1 Gate.X_gate (Gen.gate1 Gate.X_gate)))
  rfl rfl

def ax_r2 : Eqn TRel L2 := eqnW [.cx0, .x1, .cx0, .x1]
  [.x0]
  (srel_rule TRel.r2)
  rfl rfl

def ax_r3 : Eqn TRel L2 := eqnW [.cx0, .ex0, .cx0, .ex0, .cx0]
  [.ex0]
  (srel_rule TRel.r3)
  rfl rfl

def ax_ss : Eqn TRel L2 := eqnW [.ex0, .ex0]
  []
  (sym_rule Sym.σ_inv)
  rfl rfl

def ax_nat_a : Eqn TRel L2 := eqnW [.x0, .ex0]
  [.ex0, .x1]
  (sym_rule (Sym.σ_nat₁ Gate.X_gate))
  rfl rfl

/-! ## The rules of the completion that the derivations use -/

def R0 : Eqn TRel L2 := ax_r1

def R1 : Eqn TRel L2 := ax_r1_up

def R2 : Eqn TRel L2 := ax_comm_ab

def R3 : Eqn TRel L2 := ax_r2

def R4 : Eqn TRel L2 := ax_r3

def R5 : Eqn TRel L2 := ax_ss

def R6 : Eqn TRel L2 := symE ax_nat_a

def R8 : Eqn TRel L2 := derive [.ex0, .x0, .ex0]
  [.x1]
  [Step.rw 1 (symE R6), Step.rw 0 R5]
  (by decide +kernel)

def R9 : Eqn TRel L2 := derive [.ex0, .x0]
  [.x1, .ex0]
  [Step.rw 2 (symE R5), Step.rw 0 R8]
  (by decide +kernel)

def R10 : Eqn TRel L2 := derive [.cx0, .x1, .cx0]
  [.x0, .x1]
  [Step.rw 3 (symE R1), Step.rw 0 R3]
  (by decide +kernel)

def R11 : Eqn TRel L2 := derive [.cx0, .x0]
  [.x0, .cx0]
  [Step.rw 2 (symE R1), Step.rw 1 (symE R2), Step.rw 2 (symE R10), Step.rw 0 R10, Step.rw 1 R1]
  (by decide +kernel)

def R13 : Eqn TRel L2 := derive [.cx0, .x1, .ex0, .cx0, .x1, .ex0]
  [.x0, .ex0, .cx0]
  [Step.rw 1 (symE R9), Step.rw 2 (symE R11), Step.rw 3 (symE R2), Step.rw 4 (symE R6),
   Step.rw 3 (symE R9), Step.rw 4 (symE R10), Step.rw 0 R4, Step.rw 0 R6]
  (by decide +kernel)

def R15 : Eqn TRel L2 := derive [.cx0, .x1, .ex0, .cx0, .x1]
  [.x0, .ex0, .cx0, .ex0]
  [Step.rw 5 (symE R5), Step.rw 0 R13]
  (by decide +kernel)

def R18 : Eqn TRel L2 := derive [.x0, .ex0, .cx0, .ex0, .cx0]
  [.x0, .cx0, .ex0]
  [Step.rw 0 (symE R15), Step.rw 3 R10, Step.rw 2 R9, Step.rw 1 R1, Step.rw 1 R6, Step.rw 0 R11]
  (by decide +kernel)

def R31 : Eqn TRel L2 := derive [.ex0, .cx0, .ex0, .cx0]
  [.cx0, .ex0]
  [Step.rw 0 (symE R0), Step.rw 1 R18, Step.rw 0 R0]
  (by decide +kernel)

def R32 : Eqn TRel L2 := derive [.cx0, .cx0, .ex0]
  [.ex0]
  [Step.rw 1 (symE R31), Step.rw 0 R4]
  (by decide +kernel)

def R33 : Eqn TRel L2 := derive [.cx0, .cx0]
  []
  [Step.rw 2 (symE R5), Step.rw 0 R32, Step.rw 0 R5]
  (by decide +kernel)

def R34 : Eqn TRel L2 := derive [.x0, .x1, .cx0]
  [.cx0, .x1]
  [Step.rw 0 (symE R10), Step.rw 2 R33]
  (by decide +kernel)

def R35 : Eqn TRel L2 := derive [.x0, .cx0, .x1]
  [.x1, .cx0]
  [Step.rw 0 (symE R11), Step.rw 1 (symE R10), Step.rw 0 R33]
  (by decide +kernel)

def R36 : Eqn TRel L2 := derive [.x1, .cx0, .x1]
  [.x0, .cx0]
  [Step.rw 1 (symE R34), Step.rw 0 R2, Step.rw 1 R1]
  (by decide +kernel)

def R39 : Eqn TRel L2 := derive [.x0, .ex0, .cx0, .x1]
  [.x1, .ex0, .cx0]
  [Step.rw 0 (symE R6), Step.rw 1 R36, Step.rw 0 R9]
  (by decide +kernel)

def R40 : Eqn TRel L2 := derive [.ex0, .cx0, .ex0]
  [.cx0, .ex0, .cx0]
  [Step.rw 1 (symE R31), Step.rw 0 R5]
  (by decide +kernel)

def R41 : Eqn TRel L2 := derive [.cx0, .ex0, .cx0, .x1]
  [.x1, .cx0, .ex0, .cx0]
  [Step.rw 0 (symE R40), Step.rw 2 R6, Step.rw 1 R11, Step.rw 0 R9, Step.rw 1 R40]
  (by decide +kernel)

/-! ## The edge Toffolis along the Gray code -/

def θ : ℕ → List L2
  | 0 => [.x1, .cx0, .x1]
  | 1 => [.ex0, .cx0, .ex0]
  | 2 => [.cx0]
  | _ => []

def Θ (d : ℕ) : Circ 2 := word (θ d)

/-! ## The Coxeter relations and the gates -/

def order0 : Eqn TRel L2 := derive [.x1, .cx0, .x1, .x1, .cx0, .x1]
  []
  [Step.rw 0 R36, Step.rw 0 R35, Step.rw 1 R33, Step.rw 0 R1]
  (by decide +kernel)

def order1 : Eqn TRel L2 := derive [.ex0, .cx0, .ex0, .ex0, .cx0, .ex0]
  []
  [Step.rw 0 R40, Step.rw 1 R40, Step.rw 0 R33, Step.rw 1 R33, Step.rw 0 R5]
  (by decide +kernel)

def order2 : Eqn TRel L2 := derive [.cx0, .cx0]
  []
  [Step.rw 0 R33]
  (by decide +kernel)

def braid0 : Eqn TRel L2 := derive [.x1, .cx0, .x1, .ex0, .cx0, .ex0, .x1, .cx0, .x1]
  [.ex0, .cx0, .ex0, .x1, .cx0, .x1, .ex0, .cx0, .ex0]
  [Step.rw 0 R36, Step.rw 2 R40, Step.rw 1 R33, Step.rw 0 R39, Step.rw 2 R33, Step.rw 1 R6,
   Step.rw 0 R2, Step.rw 0 (symE R10), Step.rw 2 (symE R5), Step.rw 0 (symE R34),
   Step.rw 0 (symE R2), Step.rw 1 (symE R11), Step.rw 2 (symE R6), Step.rw 3 (symE R33),
   Step.rw 0 (symE R41), Step.rw 0 (symE R40)]
  (by decide +kernel)

def braid1 : Eqn TRel L2 := derive [.ex0, .cx0, .ex0, .cx0, .ex0, .cx0, .ex0]
  [.cx0, .ex0, .cx0, .ex0, .cx0]
  [Step.rw 0 R40, Step.rw 2 R33, Step.rw 1 R5, Step.rw 0 R33, Step.rw 1 (symE R33),
   Step.rw 0 (symE R33), Step.rw 1 (symE R40)]
  (by decide +kernel)

def far0_2 : Eqn TRel L2 := derive [.cx0, .x1, .cx0, .x1]
  [.x1, .cx0, .x1, .cx0]
  [Step.rw 0 R10, Step.rw 1 R1, Step.rw 1 (symE R33), Step.rw 0 (symE R36)]
  (by decide +kernel)

def gate_X0 : Eqn TRel L2 := derive [.x0]
  [.x1, .cx0, .x1, .cx0]
  [Step.rw 1 (symE R33), Step.rw 0 (symE R36)]
  (by decide +kernel)

def gate_CX0 : Eqn TRel L2 := derive [.cx0]
  [.cx0]
  []
  (by decide +kernel)

def gate_Ex0 : Eqn TRel L2 := derive [.ex0]
  [.ex0, .cx0, .ex0, .cx0, .ex0, .cx0, .ex0]
  [Step.rw 0 (symE R33), Step.rw 1 (symE R5), Step.rw 2 (symE R33), Step.rw 0 (symE R40)]
  (by decide +kernel)

/-! ## By index -/

theorem order : ∀ d, 2 + d ≤ 4 → 2 ⊢ᵀ Θ d * Θ d ≈ 1
  | 0, _ => order0.to rfl rfl
  | 1, _ => order1.to rfl rfl
  | 2, _ => order2.to rfl rfl
  | _ + 3, _ => by omega

theorem braid : ∀ d, 3 + d ≤ 4 →
    2 ⊢ᵀ Θ d * Θ (d + 1) * Θ d ≈ Θ (d + 1) * Θ d * Θ (d + 1)
  | 0, _ => braid0.to rfl rfl
  | 1, _ => braid1.to rfl rfl
  | _ + 2, _ => by omega

theorem far : ∀ d e, 2 + d ≤ e → 2 + e ≤ 4 → 2 ⊢ᵀ Θ e * Θ d ≈ Θ d * Θ e
  | 0, 0, _, _ => by omega
  | 0, 1, _, _ => by omega
  | 0, 2, _, _ => far0_2.to rfl rfl
  | 0, _ + 3, _, _ => by omega
  | _ + 1, _, _, _ => by omega

end QCert.Alt16RevCir.Width2.Derivations
