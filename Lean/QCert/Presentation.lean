# Group presentations by words and relations

An equational theory over an alphabet `X` is a relation `Γ` on words, its
*axioms*.  Two words are *derivably equal*, `Derivable Γ w v`, when one
rewrites into the other by axioms used in either direction inside any
context: the monoid congruence that `Γ` generates (`conGen Γ`).

A semantics is a map `⟦·⟧ : X → G` into a group, extended to words
multiplicatively (`FreeMonoid.lift`).  Every completeness theorem of the
corpus is stated as one of two predicates:

* `IsSubPresentationOf Γ ⟦·⟧`: the axioms are sound, words with the same
  value are derivably equal, and every generator has an inverse modulo the
  theory.  Then `Γ` presents the subgroup of `G` the generators generate
  (`IsSubPresentationOf.quotientEquiv`).
* `IsPresentationOf Γ ⟦·⟧`: in addition every element of `G` is the value
  of a word, so `Γ` presents `G` itself (`IsPresentationOf.quotientEquiv`).
-/
import Mathlib.Algebra.FreeMonoid.Basic
import Mathlib.GroupTheory.Congruence.Basic
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.Group.Submonoid.Membership

namespace QCert

universe u v

variable {X : Type u}

/-- Words over the alphabet `X`: the free monoid. -/
abbrev Word (X : Type u) := FreeMonoid X

/-- A relation on words, read as a set of axioms. -/
abbrev WRel (X : Type u) := Word X → Word X → Prop

/-- `Derivable Γ w v`: `w` and `v` are equal in the theory with axioms `Γ`,
the monoid congruence generated by `Γ`. -/
def Derivable (Γ : WRel X) (w w' : Word X) : Prop := conGen Γ w w'

/-- Every generator has a left inverse modulo the theory. -/
def Grouplike (Γ : WRel X) : Prop :=
  ∀ x : X, ∃ w : Word X, Derivable Γ (w * FreeMonoid.of x) 1

/-- `Γ` presents the subgroup of `G` generated by the values `sem x` of the
generators: every axiom holds in `G` (soundness), words with the same value
are derivably equal (completeness), and each generator is invertible in the
theory. -/
structure IsSubPresentationOf (Γ : WRel X) {G : Type v} [Group G] (sem : X → G) :
    Prop where
  grouplike : Grouplike Γ
  sound : ∀ ⦃w w' : Word X⦄, Γ w w' → FreeMonoid.lift sem w = FreeMonoid.lift sem w'
  complete : ∀ ⦃w w' : Word X⦄,
    FreeMonoid.lift sem w = FreeMonoid.lift sem w' → Derivable Γ w w'

/-- `Γ` presents the group `G`: a sub-presentation whose words reach every
element of `G`. -/
structure IsPresentationOf (Γ : WRel X) {G : Type v} [Group G] (sem : X → G) : Prop
    extends IsSubPresentationOf Γ sem where
  surjective : Function.Surjective (FreeMonoid.lift sem)

section Basic

variable {Γ : WRel X}

theorem Derivable.of {w w' : Word X} (h : Γ w w') : Derivable Γ w w' :=
  ConGen.Rel.of _ _ h

@[refl] theorem Derivable.refl (w : Word X) : Derivable Γ w w := (conGen Γ).refl w

@[symm] theorem Derivable.symm {w w' : Word X} (h : Derivable Γ w w') :
    Derivable Γ w' w := (conGen Γ).symm h

@[trans] theorem Derivable.trans {w w' w'' : Word X} (h : Derivable Γ w w')
    (h' : Derivable Γ w' w'') : Derivable Γ w w'' := (conGen Γ).trans h h'

theorem Derivable.mul {w w' u u' : Word X} (h : Derivable Γ w w')
    (h' : Derivable Γ u u') : Derivable Γ (w * u) (w' * u') := (conGen Γ).mul h h'

/-- Soundness of the axioms gives soundness of every derivation. -/
theorem derivable_sound {G : Type v} [Monoid G] {sem : X → G}
    (h : ∀ ⦃w w' : Word X⦄, Γ w w' → FreeMonoid.lift sem w = FreeMonoid.lift sem w')
    {w w' : Word X} (d : Derivable Γ w w') :
    FreeMonoid.lift sem w = FreeMonoid.lift sem w' := by
  have : conGen Γ ≤ Con.ker (FreeMonoid.lift sem) :=
    Con.conGen_le fun x y hxy => (Con.ker_rel _).2 (h hxy)
  exact (Con.ker_rel _).1 (this d)

end Basic

namespace IsSubPresentationOf

variable {Γ : WRel X} {G : Type v} [Group G] {sem : X → G}

/-- Two words are derivably equal exactly when they have the same value. -/
theorem derivable_iff (P : IsSubPresentationOf Γ sem) {w w' : Word X} :
    Derivable Γ w w' ↔ FreeMonoid.lift sem w = FreeMonoid.lift sem w' :=
  ⟨derivable_sound P.sound, fun h => P.complete h⟩

/-- The congruence of the theory is the kernel of the semantics. -/
theorem conGen_eq_ker (P : IsSubPresentationOf Γ sem) :
    conGen Γ = Con.ker (FreeMonoid.lift sem) := by
  ext w w'
  exact (P.derivable_iff).trans (Con.ker_rel _).symm

/-- The values of words form the subgroup generated by the generators. -/
theorem mrange_eq_closure (P : IsSubPresentationOf Γ sem) :
    MonoidHom.mrange (FreeMonoid.lift sem) = (Subgroup.closure (Set.range sem)).toSubmonoid := by
  apply le_antisymm
  · rintro _ ⟨w, rfl⟩
    induction w using FreeMonoid.inductionOn' with
    | one => exact (Subgroup.closure (Set.range sem)).one_mem
    | mul_of x w ih =>
      rw [map_mul, FreeMonoid.lift_eval_of]
      exact (Subgroup.closure _).mul_mem (Subgroup.subset_closure ⟨x, rfl⟩) ih
  · intro g hg
    -- the values of words form a subgroup, since every generator is invertible
    let H : Subgroup G :=
      { MonoidHom.mrange (FreeMonoid.lift sem) with
        inv_mem' := by
          rintro _ ⟨w, rfl⟩
          induction w using FreeMonoid.inductionOn' with
          | one => exact ⟨1, by simp⟩
          | mul_of x w ih =>
            obtain ⟨u, hu⟩ := ih
            obtain ⟨wx, hwx⟩ := P.grouplike x
            have hx : FreeMonoid.lift sem wx * sem x = 1 := by
              simpa using derivable_sound P.sound hwx
            refine ⟨u * wx, ?_⟩
            rw [map_mul, hu, map_mul, FreeMonoid.lift_eval_of, mul_inv_rev,
              eq_inv_of_mul_eq_one_left hx] }
    have : Subgroup.closure (Set.range sem) ≤ H :=
      (Subgroup.closure_le H).2 (by rintro _ ⟨x, rfl⟩; exact ⟨FreeMonoid.of x, by simp⟩)
    exact this hg

/-- `Γ` presents the subgroup generated by the generators: the monoid of
words modulo the theory is isomorphic to it. -/
noncomputable def quotientEquiv (P : IsSubPresentationOf Γ sem) :
    (conGen Γ).Quotient ≃* Subgroup.closure (Set.range sem) :=
  (Con.congr P.conGen_eq_ker).trans
    ((Con.quotientKerEquivRange (FreeMonoid.lift sem)).trans
      (MulEquiv.submonoidCongr P.mrange_eq_closure))

end IsSubPresentationOf

namespace IsPresentationOf

variable {Γ : WRel X} {G : Type v} [Group G] {sem : X → G}

/-- `Γ` presents `G`: the monoid of words modulo the theory is isomorphic to
`G`. -/
noncomputable def quotientEquiv (P : IsPresentationOf Γ sem) : (conGen Γ).Quotient ≃* G :=
  (Con.congr P.conGen_eq_ker).trans
    (Con.quotientKerEquivOfSurjective (FreeMonoid.lift sem) P.surjective)

/-- A sub-presentation whose generators generate the whole group is a
presentation. -/
theorem of_closure (P : IsSubPresentationOf Γ sem)
    (h : Subgroup.closure (Set.range sem) = ⊤) : IsPresentationOf Γ sem where
  toIsSubPresentationOf := P
  surjective g := by
    have : g ∈ MonoidHom.mrange (FreeMonoid.lift sem) := by
      rw [P.mrange_eq_closure, Subgroup.mem_toSubmonoid, h]; trivial
    exact this

end IsPresentationOf

end QCert
