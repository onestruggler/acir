# Proposition B.1: the theory is complete on one wire, and G₁ ≅ S₂

Translation of `Width1.agda`.  `G₁` is generated by `X`, and `X X = ε` is
rule (1).  So a one-wire circuit is `X` to the parity of its number of
letters (`nf_ok`), and its function reads the parity back off the state 0
(`sem_nf`): two circuits with the same function have the same parity, hence
the same normal form.
-/
import QCert.XCXCCX4bit.Semantics

namespace QCert.XCXCCX4bit.Width1

open QCert QCert.Circuit CircuitProp IndepProp

/-! ## The normal forms `ε` and `X` -/

def nf : Bool → Circ 1
  | false => 1
  | true => X

/-- The parity of a letter: every letter of a one-wire circuit is `X`. -/
def parG : Gn 1 → Bool
  | .gate0 (.gate g) => nomatch g
  | .gate1 (.gate .X_gate) => true
  | .up (.gate0 (.gate g)) => nomatch g

/-- The parity of the number of letters. -/
def par (u : Circ 1) : Bool := (FreeMonoid.toList u).foldr (fun g b => parG g ^^ b) false

theorem nf_mul : ∀ a b : Bool, 1 ⊢ nf a * nf b ≈ nf (a ^^ b)
  | false, false => Derivable.refl _
  | false, true => Derivable.refl _
  | true, false => Derivable.refl _
  | true, true => srel_rule SRel.r1

theorem nf_letter : ∀ g : Gn 1, 1 ⊢ FreeMonoid.of g ≈ nf (parG g)
  | .gate0 (.gate g) => nomatch g
  | .gate1 (.gate .X_gate) => Derivable.refl _
  | .up (.gate0 (.gate g)) => nomatch g

/-- Every one-wire circuit is its normal form. -/
theorem nf_ok (u : Circ 1) : 1 ⊢ u ≈ nf (par u) := by
  induction u using FreeMonoid.inductionOn' with
  | one => exact Derivable.refl _
  | mul_of g u ih =>
    exact ((nf_letter g).mul ih).trans (nf_mul (parG g) (par u))

/-- The normal form's function, at the state 0. -/
theorem sem_nf : ∀ b : Bool, sem (nf b) (false ∷ .nil) = b ∷ .nil
  | false => rfl
  | true => rfl

/-- Completeness on one wire. -/
theorem complete₁ {u v : Circ 1} (e : sem u ≐ sem v) : 1 ⊢ u ≈ v := by
  have at_ : ∀ w : Circ 1, sem w (false ∷ .nil) = par w ∷ .nil := fun w =>
    (sound (nf_ok w) (false ∷ .nil)).trans (sem_nf (par w))
  have same_par : par u = par v := by
    have h := (at_ u).symm.trans ((e _).trans (at_ v))
    injection h
  exact (nf_ok u).trans (same_par ▸ (nf_ok v).symm)

end QCert.XCXCCX4bit.Width1
