# Tables for the block normal form

Translation of `NFTables.agda`.  The state of half `b` (wire 3) at Gray
position `p` of the lower wires (`st`), `Four`'s numbering of the sixteen
states (lower half first in Gray order, upper half in reflected Gray order:
`idx`), and the reversal of the eight positions (`rev8`), with their
case-by-case laws.

Generated by `gen/mk_nftables.py` (the port of the Agda's).

Names.  The Agda's `enc′`, `isHi′`, `pos4′`, `enc′-idx` are `enc'`, `isHi'`,
`pos4'`, `enc'_idx`; hyphens are underscores.

**Deviation from the Agda.**  Each table of `refl` proofs over `Fin`s and
`Bool`s is one `decide`; `st_eta`, over the states, is written case by case
as in the Agda.  `rev8` is an `Equiv.Perm (Fin 8)` (the Agda's
`Permutation′ 8`), and `hi_lift` reads the Agda's eight `suc`s as
`Fin.natAdd 8`, the form of `Coxeter.liftN_natAdd`; `isHi_lt` reads
`toℕ i <ᵇ 8` as `Nat.blt i.1 8`.
-/
import QCert.XCXCCX4bit.CSem
import QCert.XCXCCX4bit.Width3

namespace QCert.XCXCCX4bit.NFTables

open CSem (enc8 pos)

/-- Wire 3 of a state. -/
def w3 : Bits 4 → Bool
  | _ ∷ _ ∷ _ ∷ b ∷ .nil => b

/-- The state of half `b` at Gray position `p`. -/
def st (b : Bool) (p : Fin 8) : Bits 4 := Width3.enc p ++ (b ∷ .nil)

theorem w3_st : ∀ (b : Bool) (p : Fin 8), w3 (st b p) = b := by decide

theorem pos_st : ∀ (b : Bool) (p : Fin 8), pos (st b p) = p := by decide

theorem st_eta : ∀ x : Bits 4, st (w3 x) (pos x) = x
  | false ∷ false ∷ false ∷ false ∷ .nil => rfl
  | true ∷ false ∷ false ∷ false ∷ .nil => rfl
  | false ∷ true ∷ false ∷ false ∷ .nil => rfl
  | true ∷ true ∷ false ∷ false ∷ .nil => rfl
  | false ∷ false ∷ true ∷ false ∷ .nil => rfl
  | true ∷ false ∷ true ∷ false ∷ .nil => rfl
  | false ∷ true ∷ true ∷ false ∷ .nil => rfl
  | true ∷ true ∷ true ∷ false ∷ .nil => rfl
  | false ∷ false ∷ false ∷ true ∷ .nil => rfl
  | true ∷ false ∷ false ∷ true ∷ .nil => rfl
  | false ∷ true ∷ false ∷ true ∷ .nil => rfl
  | true ∷ true ∷ false ∷ true ∷ .nil => rfl
  | false ∷ false ∷ true ∷ true ∷ .nil => rfl
  | true ∷ false ∷ true ∷ true ∷ .nil => rfl
  | false ∷ true ∷ true ∷ true ∷ .nil => rfl
  | true ∷ true ∷ true ∷ true ∷ .nil => rfl

theorem enc8_st : ∀ p : Fin 8, enc8 p = st true p := by decide

/-- `Four`'s index of the state of half `b` at position `p`. -/
def idx : Bool → Fin 8 → Fin 16
  | false, 0 => 0
  | false, 1 => 1
  | false, 2 => 2
  | false, 3 => 3
  | false, 4 => 4
  | false, 5 => 5
  | false, 6 => 6
  | false, 7 => 7
  | true, 0 => 15
  | true, 1 => 14
  | true, 2 => 13
  | true, 3 => 12
  | true, 4 => 11
  | true, 5 => 10
  | true, 6 => 9
  | true, 7 => 8
  | _, ⟨k + 8, h⟩ => absurd h (by omega)

/-- `Four`'s numbering, as a table (equal to `Four.enc`, checked there). -/
def enc' : Fin 16 → Bits 4
  | 0 => false ∷ false ∷ false ∷ false ∷ .nil
  | 1 => true ∷ false ∷ false ∷ false ∷ .nil
  | 2 => true ∷ true ∷ false ∷ false ∷ .nil
  | 3 => false ∷ true ∷ false ∷ false ∷ .nil
  | 4 => false ∷ true ∷ true ∷ false ∷ .nil
  | 5 => true ∷ true ∷ true ∷ false ∷ .nil
  | 6 => true ∷ false ∷ true ∷ false ∷ .nil
  | 7 => false ∷ false ∷ true ∷ false ∷ .nil
  | 8 => false ∷ false ∷ true ∷ true ∷ .nil
  | 9 => true ∷ false ∷ true ∷ true ∷ .nil
  | 10 => true ∷ true ∷ true ∷ true ∷ .nil
  | 11 => false ∷ true ∷ true ∷ true ∷ .nil
  | 12 => false ∷ true ∷ false ∷ true ∷ .nil
  | 13 => true ∷ true ∷ false ∷ true ∷ .nil
  | 14 => true ∷ false ∷ false ∷ true ∷ .nil
  | 15 => false ∷ false ∷ false ∷ true ∷ .nil
  | ⟨k + 16, h⟩ => absurd h (by omega)

theorem enc'_idx : ∀ (b : Bool) (p : Fin 8), enc' (idx b p) = st b p := by decide

def isHi' (i : Fin 16) : Bool := w3 (enc' i)

def pos4' (i : Fin 16) : Fin 8 := pos (enc' i)

theorem idx_eta : ∀ i : Fin 16, idx (isHi' i) (pos4' i) = i := by decide

theorem isHi_lt : ∀ i : Fin 16, isHi' i = !Nat.blt i.1 8 := by decide

/-- The reversal of the eight positions. -/
def rv : Fin 8 → Fin 8
  | 0 => 7
  | 1 => 6
  | 2 => 5
  | 3 => 4
  | 4 => 3
  | 5 => 2
  | 6 => 1
  | 7 => 0
  | ⟨k + 8, h⟩ => absurd h (by omega)

theorem rv_rv : ∀ p : Fin 8, rv (rv p) = p := by decide

def rev8 : Equiv.Perm (Fin 8) := ⟨rv, rv, rv_rv, rv_rv⟩

/-- The upper index of a position: eight above its reversal. -/
theorem hi_lift : ∀ y : Fin 8, idx true y = Fin.natAdd 8 (rev8 y) := by decide

end QCert.XCXCCX4bit.NFTables
