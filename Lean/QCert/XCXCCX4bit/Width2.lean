# Proposition B.2: the theory is complete on two wires, and G₂ ≅ S₄

Translation of `Width2.agda`.  The states, in the paper's order 00, 01, 11,
10 (its `x₁x₂`, `x₁` on our wire 1), are numbered by `enc`; the
transposition of consecutive states is a circuit `T d`: `T 0` the CNOT with a
white control (X on wire 1 around CX), `T 1` the CNOT from wire 0 to wire 1
(`CXd`) and `T 2` the CNOT `CX`.  Their Coxeter relations follow from
(1)–(3) and Appendix A (`T0 T2 = y = T2 T0` by (2); `T1 T2 T1 = σ = T2 T1 T2`
by (3); the braid of `T0` and `T1` is that of `T1` and `T2` conjugated by X
on wire 1, which passes `T1`), every gate is a word in them (X on wire 0 is
`T2 T0` by (2), the swap `T2 T1 T2` by (3)), and `ByCoxeter` concludes.

The lemmas are derived at width 2 and padded (`Engine.Eqn.pad`, see
`Lib/Engine`); the Agda's `T0²⁼` is `T0sqE`, and so on.  `T_act` is decided
for each letter of `S₄` over the four states, where the Agda has one `refl`
per letter and state.

Generated by `gen/mk_width2.py` (the port of the Agda's `gen/width2.py`,
running its search).
-/
import QCert.XCXCCX4bit.Involutions
import QCert.XCXCCX4bit.ByCoxeter

namespace QCert.XCXCCX4bit.Width2

open QCert QCert.Circuit CircuitProp IndepProp Engine
open Coxeter (SG tr)
open Coxeter.Circuits (Pc)

variable {n : ℕ}

/-! ## The relations, on the bottom two wires of any circuit -/

/-- T0 T0 = ε -/
def T0sqE : Eqn (n + 2) := Eqn.pad n <| derive
  [Xₗ.up, CXₗ, Xₗ.up, Xₗ.up, CXₗ, Xₗ.up]
  []
  [perm [Xₗ.up, CXₗ, Xₗ.up, Xₗ.up, CXₗ, Xₗ.up],
   rw 2 (liftE r1E),
   perm [Xₗ.up, CXₗ, CXₗ, Xₗ.up],
   rw 1 CXsqE,
   perm [Xₗ.up, Xₗ.up],
   rw 0 (liftE r1E)]
  (by decide +kernel)

/-- T1 T1 = ε -/
def T1sqE : Eqn (n + 2) := Eqn.pad n <| derive
  [σₗ, CXₗ, σₗ, σₗ, CXₗ, σₗ]
  []
  [perm [σₗ, CXₗ, σₗ, σₗ, CXₗ, σₗ],
   rw 2 σσE,
   perm [σₗ, CXₗ, CXₗ, σₗ],
   rw 1 CXsqE,
   perm [σₗ, σₗ],
   rw 0 σσE]
  (by decide +kernel)

/-- T0 T2 = T2 T0 -/
def far02E : Eqn (n + 2) := Eqn.pad n <| derive
  [Xₗ.up, CXₗ, Xₗ.up, CXₗ]
  [CXₗ, Xₗ.up, CXₗ, Xₗ.up]
  [perm [Xₗ.up, CXₗ, Xₗ.up, CXₗ],
   rw 0 xaxaE,
   perm [Xₗ],
   rw 0 (symE r2E)]
  (by decide +kernel)

/-- T1 T2 T1 = T2 T1 T2: both are the swap -/
def braid12E : Eqn (n + 2) := Eqn.pad n <| derive
  [σₗ, CXₗ, σₗ, CXₗ, σₗ, CXₗ, σₗ]
  [CXₗ, σₗ, CXₗ, σₗ, CXₗ]
  [perm [σₗ, CXₗ, σₗ, CXₗ, σₗ, CXₗ, σₗ],
   rw 1 r3E,
   perm [σₗ, σₗ, σₗ],
   rw 0 σσE,
   perm [σₗ],
   rw 0 (symE r3E)]
  (by decide +kernel)

/-- b v = x -/
def bvE : Eqn (n + 2) := Eqn.pad n <| derive
  [σₗ, CXₗ, σₗ, Xₗ, σₗ, CXₗ, σₗ, Xₗ]
  [Xₗ.up]
  [perm [σₗ, CXₗ, σₗ, Xₗ, σₗ, CXₗ, σₗ, Xₗ],
   rw 3 σXE,
   perm [σₗ, CXₗ, σₗ, σₗ, Xₗ.up, CXₗ, σₗ, Xₗ],
   rw 2 σσE,
   perm [σₗ, CXₗ, Xₗ.up, CXₗ, σₗ, Xₗ],
   rw 4 (symE xσE),
   perm [σₗ, CXₗ, Xₗ.up, CXₗ, Xₗ.up, σₗ],
   rw 1 r2E,
   perm [σₗ, Xₗ, σₗ],
   rw 1 σXE,
   perm [σₗ, σₗ, Xₗ.up],
   rw 0 σσE]
  (by decide +kernel)

/-- x b = b x: X on wire 1 passes the CNOT that targets it -/
def xbE : Eqn (n + 2) := Eqn.pad n <| derive
  [Xₗ.up, σₗ, CXₗ, σₗ]
  [σₗ, CXₗ, σₗ, Xₗ.up]
  [perm [Xₗ.up, σₗ, CXₗ, σₗ],
   rw 0 (symE bvE),
   perm [σₗ, CXₗ, σₗ, Xₗ, σₗ, CXₗ, σₗ, Xₗ, σₗ, CXₗ, σₗ],
   rw 3 vbE]
  (by decide +kernel)

/-- T0 T1 T0 = T1 T0 T1: the braid of T1 and T2, conjugated by x -/
def braid01E : Eqn (n + 2) := Eqn.pad n <| derive
  [Xₗ.up, CXₗ, Xₗ.up, σₗ, CXₗ, σₗ, Xₗ.up, CXₗ, Xₗ.up]
  [σₗ, CXₗ, σₗ, Xₗ.up, CXₗ, Xₗ.up, σₗ, CXₗ, σₗ]
  [perm [Xₗ.up, CXₗ, Xₗ.up, σₗ, CXₗ, σₗ, Xₗ.up, CXₗ, Xₗ.up],
   rw 2 xbE,
   perm [Xₗ.up, CXₗ, σₗ, CXₗ, σₗ, Xₗ.up, Xₗ.up, CXₗ, Xₗ.up],
   rw 5 (liftE r1E),
   perm [Xₗ.up, CXₗ, σₗ, CXₗ, σₗ, CXₗ, Xₗ.up],
   rw 1 (symE braid12E),
   perm [Xₗ.up, σₗ, CXₗ, σₗ, CXₗ, σₗ, CXₗ, σₗ, Xₗ.up],
   rw 0 xbE,
   perm [σₗ, CXₗ, σₗ, Xₗ.up, CXₗ, σₗ, CXₗ, σₗ, Xₗ.up],
   rw 5 (symE (liftE r1E)),
   perm [σₗ, CXₗ, σₗ, Xₗ.up, CXₗ, Xₗ.up, Xₗ.up, σₗ, CXₗ, σₗ, Xₗ.up],
   rw 6 xbE,
   perm [σₗ, CXₗ, σₗ, Xₗ.up, CXₗ, Xₗ.up, σₗ, CXₗ, σₗ, Xₗ.up, Xₗ.up],
   rw 9 (liftE r1E)]
  (by decide +kernel)

/-- x = T2 T0 T1 T2 T0 T1 -/
def xTE : Eqn (n + 2) := Eqn.pad n <| derive
  [Xₗ.up]
  [CXₗ, Xₗ.up, CXₗ, Xₗ.up, σₗ, CXₗ, σₗ, CXₗ, Xₗ.up, CXₗ, Xₗ.up, σₗ, CXₗ, σₗ]
  [perm [Xₗ.up],
   rw 0 (symE vbE),
   perm [Xₗ, σₗ, CXₗ, σₗ, Xₗ, σₗ, CXₗ, σₗ],
   rw 0 (symE r2E),
   perm [CXₗ, Xₗ.up, CXₗ, Xₗ.up, σₗ, CXₗ, σₗ, Xₗ, σₗ, CXₗ, σₗ],
   rw 7 (symE r2E)]
  (by decide +kernel)

/-! ## An equation between letter lists, as one between any two words with
those letters -/

/-- The Agda's `via`: the words being lists, both side conditions are
`rfl`. -/
theorem via {n : ℕ} (e : Eqn n) {w v : Circ n} (e₁ : FreeMonoid.ofList e.lhs = w)
    (e₂ : FreeMonoid.ofList e.rhs = v) : n ⊢ w ≈ v :=
  e₁ ▸ e₂ ▸ e.prf

/-! ## The transpositions of consecutive states -/

def T : ℕ → Circ 2
  | 0 => shift X * CX * shift X
  | 1 => CXd
  | 2 => CX
  | _ => 1

theorem cox : Coxeter.Circuits.Coxeter 4 T (VRel SRel 2) where
  order
    | 0, _ => via T0sqE rfl rfl
    | 1, _ => via T1sqE rfl rfl
    | 2, _ => via CXsqE rfl rfl
    | _ + 3, _ => by omega
  braid
    | 0, _ => via braid01E rfl rfl
    | 1, _ => via braid12E rfl rfl
    | _ + 2, _ => by omega
  far
    | 0, 0, _, _ => by omega
    | 0, 1, _, _ => by omega
    | 0, 2, _, _ => via far02E rfl rfl
    | 0, _ + 3, _, _ => by omega
    | _ + 1, _, _, _ => by omega

/-! ## The numbering of the states, and the action of the `T d` -/

def enc : Fin 4 → Bits 2
  | ⟨0, _⟩ => false ∷ false ∷ .nil
  | ⟨1, _⟩ => true ∷ false ∷ .nil
  | ⟨2, _⟩ => true ∷ true ∷ .nil
  | ⟨3, _⟩ => false ∷ true ∷ .nil
  | ⟨_ + 4, h⟩ => absurd h (by omega)

def dec : Bits 2 → Fin 4
  | false ∷ false ∷ .nil => 0
  | true ∷ false ∷ .nil => 1
  | true ∷ true ∷ .nil => 2
  | false ∷ true ∷ .nil => 3

theorem dec_enc : ∀ i, dec (enc i) = i := by decide

private theorem T_act0 : ∀ i : Fin 4,
    sem (T 0) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨0, by decide⟩ : SG 4)) i) := by
  decide +kernel

private theorem T_act1 : ∀ i : Fin 4,
    sem (T 1) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨1, by decide⟩ : SG 4)) i) := by
  decide +kernel

private theorem T_act2 : ∀ i : Fin 4,
    sem (T 2) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨2, by decide⟩ : SG 4)) i) := by
  decide +kernel

theorem T_act : ∀ (g : SG 4) (i : Fin 4),
    sem (T (tr 0 g)) (enc i) = enc (Coxeter.perm (FreeMonoid.of g) i)
  | ⟨0, _⟩, i => T_act0 i
  | ⟨1, _⟩, i => T_act1 i
  | ⟨2, _⟩, i => T_act2 i
  | ⟨_ + 3, h⟩, _ => absurd h (by omega)

/-! ## Every gate as a word in the `T d` -/

private def s : ℕ → Word (SG 4)
  | 0 => FreeMonoid.of ⟨0, by decide⟩
  | 1 => FreeMonoid.of ⟨1, by decide⟩
  | _ => FreeMonoid.of ⟨2, by decide⟩

def tw : Gn 2 → Word (SG 4)
  | .gate0 (.gate g) => nomatch g
  | .gate1 (.gate .X_gate) => s 2 * s 0
  | .gate2 (.gate .CX_gate) => s 2
  | .gate2 .swap => s 2 * s 1 * s 2
  | .up (.gate0 (.gate g)) => nomatch g
  | .up (.gate1 (.gate .X_gate)) => s 2 * s 0 * s 1 * s 2 * s 0 * s 1
  | .up (.up (.gate0 (.gate g))) => nomatch g

theorem tw_ok : ∀ g : Gn 2, 2 ⊢ FreeMonoid.of g ≈ Pc T 0 (tw g)
  | .gate0 (.gate g) => nomatch g
  | .gate1 (.gate .X_gate) => via (symE r2E) rfl rfl
  | .gate2 (.gate .CX_gate) => Derivable.refl _
  | .gate2 .swap => via (symE r3E) rfl rfl
  | .up (.gate0 (.gate g)) => nomatch g
  | .up (.gate1 (.gate .X_gate)) => via xTE rfl rfl
  | .up (.up (.gate0 (.gate g))) => nomatch g

/-! ## Completeness on two wires -/

def translate : Circ 2 →* Word (SG 4) := ByCoxeter.Via.translate tw

theorem translate_ok (u : Circ 2) : 2 ⊢ u ≈ Pc T 0 (translate u) :=
  ByCoxeter.Via.translate_ok T tw tw_ok u

theorem complete₂ {u v : Circ 2} (e : sem u ≐ sem v) : 2 ⊢ u ≈ v :=
  ByCoxeter.Via.complete 2 4 T enc cox dec dec_enc T_act tw tw_ok e

end QCert.XCXCCX4bit.Width2
