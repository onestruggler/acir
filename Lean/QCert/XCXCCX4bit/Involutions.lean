/-! ## The CNOT -/

/-- (i) w a = y -/
def xaxaE : Eqn (n + 2) := Eqn.pad n <| derive
  [Xₗ.up, CXₗ, Xₗ.up, CXₗ]
  [Xₗ]
  [perm [Xₗ.up, CXₗ, Xₗ.up, CXₗ],
   rw 4 (symE (liftE r1E)),
   perm [Xₗ.up, CXₗ, Xₗ.up, CXₗ, Xₗ.up, Xₗ.up],
   rw 1 r2E,
   perm [Xₗ, Xₗ.up, Xₗ.up],
   rw 1 (liftE r1E)]
  (by decide +kernel)

/-- (ii) a y = y a -/
