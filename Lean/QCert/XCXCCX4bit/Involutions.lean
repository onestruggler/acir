  [Xₗ, CXₗ]
  [perm [CXₗ, Xₗ],
   rw 1 (symE xaxaE),
   perm [CXₗ, Xₗ.up, CXₗ, Xₗ.up, CXₗ],
   rw 0 r2E]
  (by decide +kernel)

