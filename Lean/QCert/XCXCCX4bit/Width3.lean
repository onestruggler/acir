   perm [Xₗ.up, CCXₗ, Xₗ.up, Xₗ.up, σₗ, CCXₗ, σₗ, Xₗ.up, Xₗ.up, σₗ, σₗ, CCXₗ, σₗ, σₗ, Xₗ.up],
   rw 3 cjX1_57E,
   perm [Xₗ.up, CCXₗ, Xₗ.up, σₗ, CCXₗ, σₗ, Xₗ.up, σₗ, σₗ, CCXₗ, σₗ, σₗ, Xₗ.up],
   rw 7 cjSW0_57E]
  (by decide +kernel)

/-- the swap of wires 0, 1 -/
def genSW0E : Eqn (n + 3) := Eqn.pad n <| derive
  [σₗ]
  [Xₗ.up.up, CCXₗ, Xₗ.up.up, CCXₗ, Xₗ.up.up, σₗ, CCXₗ, σₗ, Xₗ.up.up, σₗ, CCXₗ, σₗ, Xₗ.up.up, CCXₗ, Xₗ.up.up, CCXₗ]
  [perm [σₗ],
   rw 0 (by2 [σₗ] [CXₗ, σₗ, CXₗ, σₗ, CXₗ] (by decide +kernel)),
   perm [CXₗ, σₗ, CXₗ, σₗ, CXₗ],
   rw 0 (symE WcE),
   perm [Xₗ.up.up, CCXₗ, Xₗ.up.up, CCXₗ, σₗ, CXₗ, σₗ, CXₗ],
   rw 4 (symE meE),
   perm [Xₗ.up.up, CCXₗ, Xₗ.up.up, CCXₗ, σₗ, Xₗ.up.up, CCXₗ, σₗ, σₗ, Xₗ.up.up, CCXₗ, σₗ, CXₗ],
   rw 12 (symE WcE),
   perm [Xₗ.up.up, CCXₗ, Xₗ.up.up, CCXₗ, Xₗ.up.up, σₗ, CCXₗ, σₗ, Xₗ.up.up, σₗ, CCXₗ, σₗ, Xₗ.up.up, CCXₗ, Xₗ.up.up, CCXₗ]]
  (by decide +kernel)

/-- the CNOT from wire 2 to wire 1 -/
def genCX1E : Eqn (n + 3) := Eqn.pad n <| derive
  [CXₗ.up]
  [σₗ, CCXₗ, Xₗ.up, CCXₗ, Xₗ.up, σₗ]
  [perm [CXₗ.up],
   rw 0 (symE σσE),
   perm [σₗ, σₗ, CXₗ.up],
   rw 1 (symE (liftE σσE)),
   perm [σₗ, σₗ.up, σₗ.up, σₗ, CXₗ.up],
   rw 2 (symE σCXE),
   perm [σₗ, σₗ.up, CXₗ, σₗ.up, σₗ],
   rw 1 (symE T4T6E)]
  (by decide +kernel)

/-- the CNOT from wire 1 to wire 2 -/
def genCXd1E : Eqn (n + 3) := Eqn.pad n <| derive
  [σₗ.up, CXₗ.up, σₗ.up]
  [Xₗ, σₗ.up, σₗ, CCXₗ, σₗ, σₗ.up, Xₗ, Xₗ, Xₗ, σₗ.up, σₗ, CCXₗ, σₗ, σₗ.up, Xₗ, Xₗ]
  [perm [σₗ.up, CXₗ.up, σₗ.up],
   rw 1 genCX1E,
   perm [σₗ.up, σₗ, CCXₗ, Xₗ.up, CCXₗ, Xₗ.up, σₗ, σₗ.up],
   rw 2 T4T6E,
   perm [σₗ.up, σₗ, σₗ.up, CXₗ, σₗ.up, σₗ, σₗ.up],
   rw 2 (symE T6T4E),
   perm [σₗ.up, σₗ, Xₗ.up, CCXₗ, Xₗ.up, CCXₗ, σₗ, σₗ.up],
   rw 5 (symE σσE),
   perm [σₗ.up, σₗ, Xₗ.up, CCXₗ, Xₗ.up, σₗ, σₗ, CCXₗ, σₗ, σₗ.up],
   rw 1 cjSW0_45E,
   perm [Xₗ, σₗ.up, σₗ, CCXₗ, σₗ, Xₗ, σₗ, CCXₗ, σₗ, σₗ.up],
   rw 6 (symE (liftE σσE)),
   perm [Xₗ, σₗ.up, σₗ, CCXₗ, σₗ, Xₗ, σₗ.up, σₗ.up, σₗ, CCXₗ, σₗ, σₗ.up],
   rw 7 (symE cjX0_26E),
   perm [Xₗ, σₗ.up, σₗ, CCXₗ, σₗ, σₗ.up, Xₗ, Xₗ, Xₗ, σₗ.up, σₗ, CCXₗ, σₗ, σₗ.up, Xₗ, Xₗ]]
  (by decide +kernel)

/-- X on wire 1 -/
def genX1E : Eqn (n + 3) := Eqn.pad n <| derive
  [Xₗ.up]
  [σₗ, Xₗ, σₗ]
  [perm [Xₗ.up],
   rw 1 (symE σσE),
   perm [Xₗ.up, σₗ, σₗ],
   rw 0 (by2 [Xₗ.up, σₗ] [σₗ, Xₗ] (by decide +kernel))]
  (by decide +kernel)

/-- X on wire 2 -/
def genX2E : Eqn (n + 3) := Eqn.pad n <| derive
  [Xₗ.up.up]
  [σₗ.up, Xₗ.up, σₗ.up]
  [perm [Xₗ.up.up],
   rw 1 (symE (liftE σσE)),
   perm [Xₗ.up.up, σₗ.up, σₗ.up],
   rw 0 (liftE (by2 [Xₗ.up, σₗ] [σₗ, Xₗ] (by decide +kernel)))]
  (by decide +kernel)

/-! ## An equation between letter lists, as one between any two words with
those letters -/

/-- The Agda's `via`: the words being lists, both side conditions are
`rfl`. -/
theorem via {n : ℕ} (e : Eqn n) {w v : Circ n} (e₁ : FreeMonoid.ofList e.lhs = w)
    (e₂ : FreeMonoid.ofList e.rhs = v) : n ⊢ w ≈ v :=
  e₁ ▸ e₂ ▸ e.prf

/-! ## The transpositions of consecutive states -/

def T : ℕ → Circ 3
  | 0 => shift (shift X) * shift X * CCX * shift X * shift (shift X)
  | 1 => shift (shift X) * σ * CCX * σ * shift (shift X)
  | 2 => shift (shift X) * CCX * shift (shift X)
  | 3 => X * shift σ * σ * CCX * σ * shift σ * X
  | 4 => CCX
  | 5 => σ * CCX * σ
  | 6 => shift X * CCX * shift X
  | _ => 1

theorem cox : Coxeter.Circuits.Coxeter 8 T (VRel SRel 3) where
  order
    | 0, _ => via T0sqE rfl rfl
    | 1, _ => via T1sqE rfl rfl
    | 2, _ => via T2sqE rfl rfl
    | 3, _ => via T3sqE rfl rfl
    | 4, _ => via T4sqE rfl rfl
    | 5, _ => via T5sqE rfl rfl
    | 6, _ => via T6sqE rfl rfl
    | _ + 7, _ => by omega
  braid
    | 0, _ => via braid0E rfl rfl
    | 1, _ => via braid1E rfl rfl
    | 2, _ => via braid2E rfl rfl
    | 3, _ => via braid3E rfl rfl
    | 4, _ => via braid4E rfl rfl
    | 5, _ => via braid5E rfl rfl
    | _ + 6, _ => by omega
  far
    | 0, 0, _, _ => by omega
    | 0, 1, _, _ => by omega
    | 0, 2, _, _ => via far02E rfl rfl
    | 0, 3, _, _ => via far03E rfl rfl
    | 0, 4, _, _ => via far04E rfl rfl
    | 0, 5, _, _ => via far05E rfl rfl
    | 0, 6, _, _ => via far06E rfl rfl
    | 1, 0, _, _ => by omega
    | 1, 1, _, _ => by omega
    | 1, 2, _, _ => by omega
    | 1, 3, _, _ => via far13E rfl rfl
    | 1, 4, _, _ => via far14E rfl rfl
    | 1, 5, _, _ => via far15E rfl rfl
    | 1, 6, _, _ => via far16E rfl rfl
    | 2, 0, _, _ => by omega
    | 2, 1, _, _ => by omega
    | 2, 2, _, _ => by omega
    | 2, 3, _, _ => by omega
    | 2, 4, _, _ => via far24E rfl rfl
    | 2, 5, _, _ => via far25E rfl rfl
    | 2, 6, _, _ => via far26E rfl rfl
    | 3, 0, _, _ => by omega
    | 3, 1, _, _ => by omega
    | 3, 2, _, _ => by omega
    | 3, 3, _, _ => by omega
    | 3, 4, _, _ => by omega
    | 3, 5, _, _ => via far35E rfl rfl
    | 3, 6, _, _ => via far36E rfl rfl
    | 4, 0, _, _ => by omega
    | 4, 1, _, _ => by omega
    | 4, 2, _, _ => by omega
    | 4, 3, _, _ => by omega
    | 4, 4, _, _ => by omega
    | 4, 5, _, _ => by omega
    | 4, 6, _, _ => via far46E rfl rfl
    | 5, 0, _, _ => by omega
    | 5, 1, _, _ => by omega
    | 5, 2, _, _ => by omega
    | 5, 3, _, _ => by omega
    | 5, 4, _, _ => by omega
    | 5, 5, _, _ => by omega
    | 5, 6, _, _ => by omega
    | 6, 0, _, _ => by omega
    | 6, 1, _, _ => by omega
    | 6, 2, _, _ => by omega
    | 6, 3, _, _ => by omega
    | 6, 4, _, _ => by omega
    | 6, 5, _, _ => by omega
    | 6, 6, _, _ => by omega
    | _ + 7, _, _, _ => by omega
    | _, _ + 7, _, _ => by omega

/-! ## The numbering of the states, and the action of the `T d` -/

def enc : Fin 8 → Bits 3
  | ⟨0, _⟩ => false ∷ false ∷ false ∷ .nil
  | ⟨1, _⟩ => true ∷ false ∷ false ∷ .nil
  | ⟨2, _⟩ => true ∷ true ∷ false ∷ .nil
  | ⟨3, _⟩ => false ∷ true ∷ false ∷ .nil
  | ⟨4, _⟩ => false ∷ true ∷ true ∷ .nil
  | ⟨5, _⟩ => true ∷ true ∷ true ∷ .nil
  | ⟨6, _⟩ => true ∷ false ∷ true ∷ .nil
  | ⟨7, _⟩ => false ∷ false ∷ true ∷ .nil
  | ⟨_ + 8, h⟩ => absurd h (by omega)

def dec : Bits 3 → Fin 8
  | false ∷ false ∷ false ∷ .nil => 0
  | true ∷ false ∷ false ∷ .nil => 1
  | true ∷ true ∷ false ∷ .nil => 2
  | false ∷ true ∷ false ∷ .nil => 3
  | false ∷ true ∷ true ∷ .nil => 4
  | true ∷ true ∷ true ∷ .nil => 5
  | true ∷ false ∷ true ∷ .nil => 6
  | false ∷ false ∷ true ∷ .nil => 7

theorem dec_enc : ∀ i, dec (enc i) = i := by decide

private theorem T_act0 : ∀ i : Fin 8,
    sem (T 0) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨0, by decide⟩ : SG 8)) i) := by
  decide +kernel

private theorem T_act1 : ∀ i : Fin 8,
    sem (T 1) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨1, by decide⟩ : SG 8)) i) := by
  decide +kernel

private theorem T_act2 : ∀ i : Fin 8,
    sem (T 2) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨2, by decide⟩ : SG 8)) i) := by
  decide +kernel

private theorem T_act3 : ∀ i : Fin 8,
    sem (T 3) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨3, by decide⟩ : SG 8)) i) := by
  decide +kernel

private theorem T_act4 : ∀ i : Fin 8,
    sem (T 4) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨4, by decide⟩ : SG 8)) i) := by
  decide +kernel

private theorem T_act5 : ∀ i : Fin 8,
    sem (T 5) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨5, by decide⟩ : SG 8)) i) := by
  decide +kernel

private theorem T_act6 : ∀ i : Fin 8,
    sem (T 6) (enc i) = enc (Coxeter.perm (FreeMonoid.of (⟨6, by decide⟩ : SG 8)) i) := by
  decide +kernel

theorem T_act : ∀ (g : SG 8) (i : Fin 8),
    sem (T (tr 0 g)) (enc i) = enc (Coxeter.perm (FreeMonoid.of g) i)
  | ⟨0, _⟩, i => T_act0 i
  | ⟨1, _⟩, i => T_act1 i
  | ⟨2, _⟩, i => T_act2 i
  | ⟨3, _⟩, i => T_act3 i
  | ⟨4, _⟩, i => T_act4 i
  | ⟨5, _⟩, i => T_act5 i
  | ⟨6, _⟩, i => T_act6 i
  | ⟨_ + 7, h⟩, _ => absurd h (by omega)

/-! ## Every gate as a word in the `T d` -/

private def s : ℕ → Word (SG 8)
  | 0 => FreeMonoid.of ⟨0, by decide⟩
  | 1 => FreeMonoid.of ⟨1, by decide⟩
  | 2 => FreeMonoid.of ⟨2, by decide⟩
  | 3 => FreeMonoid.of ⟨3, by decide⟩
  | 4 => FreeMonoid.of ⟨4, by decide⟩
  | 5 => FreeMonoid.of ⟨5, by decide⟩
  | _ => FreeMonoid.of ⟨6, by decide⟩

def tw_X0 : Word (SG 8) := s 4 * s 2 * s 6 * s 0
def tw_CX0 : Word (SG 8) := s 2 * s 4
def tw_SW0 : Word (SG 8) := s 2 * s 4 * s 1 * s 5 * s 2 * s 4
def tw_X1 : Word (SG 8) := tw_SW0 * tw_X0 * tw_SW0
def tw_CX1 : Word (SG 8) := tw_SW0 * (s 4 * s 6) * tw_SW0
def tw_SW1 : Word (SG 8) := tw_CX1 * (s 3 * tw_X0 * s 3 * tw_X0) * tw_CX1
def tw_X2 : Word (SG 8) := tw_SW1 * tw_X1 * tw_SW1

theorem ok_X0 : 3 ⊢ X ≈ Pc T 0 tw_X0 := via X0bE rfl rfl

theorem ok_CX0 : 3 ⊢ CX ≈ Pc T 0 tw_CX0 := via (symE WcE) rfl rfl

theorem ok_SW0 : 3 ⊢ σ ≈ Pc T 0 tw_SW0 := via genSW0E rfl rfl

theorem ok_X1 : 3 ⊢ shift X ≈ Pc T 0 tw_X1 := by
  refine (via genX1E (v := σ * X * σ) rfl rfl).trans ?_
  rw [tw_X1, map_mul, map_mul]
  exact (ok_SW0.mul ok_X0).mul ok_SW0

theorem ok_CX1 : 3 ⊢ shift CX ≈ Pc T 0 tw_CX1 := by
  refine (via genCX1E (v := σ * (T 4 * T 6) * σ) rfl rfl).trans ?_
  rw [tw_CX1, map_mul, map_mul]
  exact (ok_SW0.mul (Derivable.refl _)).mul ok_SW0

theorem ok_CXd1 : 3 ⊢ shift σ * shift CX * shift σ ≈ Pc T 0 (s 3 * tw_X0 * s 3 * tw_X0) := by
  refine (via genCXd1E (v := T 3 * X * T 3 * X) rfl rfl).trans ?_
  rw [map_mul, map_mul, map_mul]
  exact (((Derivable.refl _).mul ok_X0).mul (Derivable.refl _)).mul ok_X0

theorem ok_SW1 : 3 ⊢ shift σ ≈ Pc T 0 tw_SW1 := by
  refine (via (symE (liftE r3E)) (v := shift CX * (shift σ * shift CX * shift σ) * shift CX)
    rfl rfl).trans ?_
  rw [tw_SW1, map_mul, map_mul]
  exact (ok_CX1.mul ok_CXd1).mul ok_CX1

theorem ok_X2 : 3 ⊢ shift (shift X) ≈ Pc T 0 tw_X2 := by
  refine (via genX2E (v := shift σ * shift X * shift σ) rfl rfl).trans ?_
  rw [tw_X2, map_mul, map_mul]
  exact (ok_SW1.mul ok_X1).mul ok_SW1

def tw : Gn 3 → Word (SG 8)
  | .gate0 (.gate g) => nomatch g
  | .gate1 (.gate .X_gate) => tw_X0
  | .gate2 (.gate .CX_gate) => tw_CX0
  | .gate2 .swap => tw_SW0
  | .gate3 (.gate .CCX_gate) => s 4
  | .up (.gate0 (.gate g)) => nomatch g
  | .up (.gate1 (.gate .X_gate)) => tw_X1
  | .up (.gate2 (.gate .CX_gate)) => tw_CX1
  | .up (.gate2 .swap) => tw_SW1
  | .up (.up (.gate0 (.gate g))) => nomatch g
  | .up (.up (.gate1 (.gate .X_gate))) => tw_X2
  | .up (.up (.up (.gate0 (.gate g)))) => nomatch g

theorem tw_ok : ∀ g : Gn 3, 3 ⊢ FreeMonoid.of g ≈ Pc T 0 (tw g)
  | .gate0 (.gate g) => nomatch g
  | .gate1 (.gate .X_gate) => ok_X0
  | .gate2 (.gate .CX_gate) => ok_CX0
  | .gate2 .swap => ok_SW0
  | .gate3 (.gate .CCX_gate) => Derivable.refl _
  | .up (.gate0 (.gate g)) => nomatch g
  | .up (.gate1 (.gate .X_gate)) => ok_X1
  | .up (.gate2 (.gate .CX_gate)) => ok_CX1
  | .up (.gate2 .swap) => ok_SW1
  | .up (.up (.gate0 (.gate g))) => nomatch g
  | .up (.up (.gate1 (.gate .X_gate))) => ok_X2
  | .up (.up (.up (.gate0 (.gate g)))) => nomatch g

/-! ## Completeness on three wires -/

def translate : Circ 3 →* Word (SG 8) := ByCoxeter.Via.translate tw

theorem translate_ok (u : Circ 3) : 3 ⊢ u ≈ Pc T 0 (translate u) :=
  ByCoxeter.Via.translate_ok T tw tw_ok u

theorem complete₃ {u v : Circ 3} (e : sem u ≐ sem v) : 3 ⊢ u ≈ v :=
  ByCoxeter.Via.complete 3 8 T enc cox dec dec_enc T_act tw tw_ok e

end QCert.XCXCCX4bit.Width3
