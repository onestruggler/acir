# Clifford circuits (Selinger): the presentation

Selinger, *Generators and relations for n-qubit Clifford operators*: the
relations C1–C15 of Figure 8, with the structural rules (bifunctorial and
spatial laws, §2), present the `n`-qubit Clifford group, the subgroup of
`U(2ⁿ)` generated by `ω`, `H`, `S` and `Z_c` on adjacent qubits, for every
`n` (Proposition 7.1).
-/
import QCert.SelingerClifford.Soundness
import QCert.SelingerClifford.Derivation

namespace QCert.SelingerClifford

open Circuit

/-- Every generator has a left inverse modulo the theory. -/
theorem grouplike (n : ℕ) : Grouplike (Theory n) := by
  intro x
  induction x with
  | @gate0 k c =>
    cases c
    refine ⟨om ^ 7, ?_⟩
    have h := Eqv.rule k Rel.C1
    simp only [Circuit.pad, map_pow, map_one, FreeMonoid.map_of, Gen.pad] at h
    rw [← pow_succ]
    exact h
  | @gate1 k c =>
    cases c
    · exact ⟨FreeMonoid.of (Gen.gate1 Gate.H), Eqv.rule k Rel.C2⟩
    · exact ⟨S₀ * S₀ * S₀, Eqv.rule k Rel.C3⟩
  | @gate2 k c =>
    cases c
    exact ⟨FreeMonoid.of (Gen.gate2 Gate.CZ), Eqv.rule k Rel.C5⟩
  | gate3 c => exact nomatch c
  | up g ih =>
    obtain ⟨u, hu⟩ := ih
    refine ⟨Circuit.shift u, ?_⟩
    have := Eqv.shift hu
    simpa [map_mul] using this

/-- **The presentation** (Proposition 7.1): on every number of wires, the
relations of Figure 8 present the group generated by the Clifford gates. -/
theorem presentation (n : ℕ) : IsSubPresentationOf (Theory n) (S.gen (n := n)) where
  grouplike := grouplike n
  sound := fun w v h => theory_sound n w v h
  complete := by
    sorry

end QCert.SelingerClifford
