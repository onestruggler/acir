# Clifford circuits (Selinger): the presentation

Selinger, *Generators and relations for n-qubit Clifford operators*: the
relations C1–C15 of Figure 8, with the structural rules (bifunctorial and
spatial laws, §2), present the `n`-qubit Clifford group, the subgroup of
`U(2ⁿ)` generated by `ω`, `H`, `S` and `Z_c` on adjacent qubits, for every
`n` (Proposition 7.1).
-/
import QCert.SelingerClifford.Soundness
import QCert.SelingerClifford.Push
import QCert.SelingerClifford.Unique

namespace QCert.SelingerClifford

open Circuit

/-- Every generator has a left inverse modulo the theory. -/
theorem grouplike (n : ℕ) : Grouplike (Theory n) := by
  intro x
  induction x with
  | @gate0 k c =>
    cases c
    refine ⟨om ^ 7, ?_⟩
    have h := Eqv.rule k Rel.C1
    simp only [Circuit.pad, map_pow, map_one, FreeMonoid.map_of, Gen.pad] at h
    rw [← pow_succ]
    exact h
  | @gate1 k c =>
    cases c
    · exact ⟨FreeMonoid.of (Gen.gate1 Gate.H), Eqv.rule k Rel.C2⟩
    · exact ⟨S₀ * S₀ * S₀, Eqv.rule k Rel.C3⟩
  | @gate2 k c =>
    cases c
    exact ⟨FreeMonoid.of (Gen.gate2 Gate.CZ), Eqv.rule k Rel.C5⟩
  | gate3 c => exact nomatch c
  | up g ih =>
    obtain ⟨u, hu⟩ := ih
    refine ⟨Circuit.shift u, ?_⟩
    have := Eqv.shift hu
    simpa [map_mul] using this

/-- Proposition 6.3 (with Lemma 6.2): every circuit is equal, by the relations
of Figure 8, to a normal circuit: the circuit, followed by the normal form of
the identity, is rewritten with the rules of Figures 3–7 (equations 3.1–3.101
of the supplement, all derived from Figure 8 in `Rules1`–`Rules5`), `Push`. -/
theorem exists_normal (n : ℕ) (w : Circ n) : ∃ N : NF n, Eqv n w N.circ :=
  exists_normal' w

/-- Proposition 5.5 (with Lemmas 5.1–5.4): distinct normal circuits denote
distinct operators.  The matrix fixes the action on Pauli operators, the
action fixes the normal form up to its scalar (`Unique`), and the matrix
fixes the scalar. -/
theorem normal_unique {n : ℕ} (N N' : NF n) (h : S.sem n N.circ = S.sem n N'.circ) :
    N = N' :=
  normal_unique' N N' h

/-- Completeness: circuits with the same matrix are equal by the relations. -/
theorem complete (n : ℕ) {w w' : Circ n} (h : S.sem n w = S.sem n w') : Eqv n w w' := by
  obtain ⟨N, hN⟩ := exists_normal n w
  obtain ⟨N', hN'⟩ := exists_normal n w'
  have e : S.sem n w = S.sem n N.circ := derivable_sound (theory_sound n) hN
  have e' : S.sem n w' = S.sem n N'.circ := derivable_sound (theory_sound n) hN'
  have : N = N' := normal_unique N N' (by rw [← e, ← e', h])
  subst this
  exact hN.trans hN'.symm

/-- **The presentation** (Proposition 7.1): on every number of wires, the
relations of Figure 8 present the group generated by the Clifford gates. -/
theorem presentation (n : ℕ) : IsSubPresentationOf (Theory n) (S.gen (n := n)) where
  grouplike := grouplike n
  sound := fun w v h => theory_sound n w v h
  complete := fun _ _ h => complete n h

end QCert.SelingerClifford
