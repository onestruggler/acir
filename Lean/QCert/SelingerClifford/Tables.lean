/-- CZ with `A_i` on its upper wire: equations 3.9–3.11.  Either `A_i`
stays, or the ladder grows down by one wire (`A_{i'}` below `B_j`). -/
theorem tAZ : ∀ i : Fin 3,
    (∃ (i' : Fin 3) (out : List Dg),
      Holds 2 ([.CZ 0] ++ bA (i.val + 1) 1) (bA (i'.val + 1) 1 ++ dw out) ∧
        OkL (okB 1) 2 out) ∨
    (∃ (i' : Fin 3) (j : Fin 4) (out : List Dg),
      Holds 2 ([.CZ 0] ++ bA (i.val + 1) 1) (bA (i'.val + 1) 0 ++ bB (j.val + 1) 0 ++ dw out) ∧
        OkL (okB 1) 2 out)
  | 0 => Or.inl ⟨0, [.CZ 0], rule_3_9, by decide⟩
  | 1 => Or.inr ⟨0, 1, [.CZ 0, .H 0], rule_3_10, by decide⟩
  | 2 => Or.inr ⟨0, 2, [.H 0, .S 0, .H 0, .CZ 0, .S 1, .S 1, .S 1, .H 0], rule_3_11, by decide⟩

