  | .X0 => .perm [4, 5, 6, 7, 0, 1, 2, 3]
  | .X1 => .perm [2, 3, 0, 1, 6, 7, 4, 5]
  | .X2 => .perm [1, 0, 3, 2, 5, 4, 7, 6]
  | .CX01 => .perm [0, 1, 2, 3, 6, 7, 4, 5]
  | .CX02 => .perm [0, 1, 2, 3, 5, 4, 7, 6]
  | .CX10 => .perm [0, 1, 6, 7, 4, 5, 2, 3]
  | .CX12 => .perm [0, 1, 3, 2, 4, 5, 7, 6]
  | .CX20 => .perm [0, 5, 2, 7, 4, 1, 6, 3]
  | .CX21 => .perm [0, 3, 2, 1, 4, 7, 6, 5]
  | .CCX01 => .perm [0, 1, 2, 3, 4, 5, 7, 6]
  | .CCX02 => .perm [0, 1, 2, 3, 4, 7, 6, 5]
  | .CCX12 => .perm [0, 1, 2, 7, 4, 5, 6, 3]
  | .Z0 => .signs [false, false, false, false, true, true, true, true]
  | .Z1 => .signs [false, false, true, true, false, false, true, true]
  | .Z2 => .signs [false, true, false, true, false, true, false, true]
  | .CZ01 => .signs [false, false, false, false, false, false, true, true]
  | .CZ02 => .signs [false, false, false, false, false, true, false, true]
  | .CZ12 => .signs [false, false, false, true, false, false, false, true]
  | .K01 => .dense [[⟨1/2, 0⟩, ⟨0, 0⟩, ⟨1/2, 0⟩, ⟨0, 0⟩, ⟨1/2, 0⟩, ⟨0, 0⟩, ⟨1/2, 0⟩, ⟨0, 0⟩],
