# Amy, Ross, Wesley (2024): evaluating words

The gate matrices over any ring are the images of those over `ℚ(√2)`
(`gateMat_map`).  Over `ℚ(√2)` each gate is given as a row operation
(`actOf`: a row permutation, row signs, or a dense matrix; checked against
`gateMat` by `decide`), so the matrix of a word is computed by the kernel
quickly (`evalW`), and an identity of words decided there holds over `ℝ`
(`prod_gateMat_eq`).  The literal row operations are generated by
`gen/acts.py` (scratch) from the gate definitions.
-/
import QCert.ToffoliHadamard.Matrices
import QCert.LiRossSelinger.ListMat
import QCert.LiRossSelinger.LevelLemmas
import QCert.Exact.Roots

namespace QCert.ToffoliHadamard

open Matrix QCert.ListMat

/-! ## Gate matrices through ring homomorphisms -/

section Map

variable {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)

theorem toMat8_map (A : Matrix State State R) : (toMat8 A).map φ = toMat8 (A.map φ) := rfl

theorem matX_map : (matX : Matrix (Fin 2) (Fin 2) R).map φ = matX := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [matX]

theorem matZ_map : (matZ : Matrix (Fin 2) (Fin 2) R).map φ = matZ := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [matZ]

theorem matH_map (s : R) : (matH s).map φ = matH (φ s) := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [matH]

theorem matK_map (s : R) : (matK s).map φ = matK (φ s) := by
  ext i j; simp only [matK, map_apply]; split_ifs <;> simp

theorem onQ_map (j : Fin 3) (M : Matrix (Fin 2) (Fin 2) R) : (onQ j M).map φ = onQ j (M.map φ) := by
  ext y x; simp only [onQ, map_apply]; split_ifs <;> simp

theorem ctrl_map (j k : Fin 3) (M : Matrix (Fin 2) (Fin 2) R) :
    (ctrl j k M).map φ = ctrl j k (M.map φ) := by
  ext y x; simp only [ctrl, map_apply, ← onQ_map]; split_ifs <;> simp

theorem ctrl2_map (j k l : Fin 3) (M : Matrix (Fin 2) (Fin 2) R) :
    (ctrl2 j k l M).map φ = ctrl2 j k l (M.map φ) := by
  ext y x; simp only [ctrl2, map_apply, ← onQ_map]; split_ifs <;> simp

theorem swapQ_map (j k : Fin 3) : (swapQ j k : Matrix State State R).map φ = swapQ j k := by
  ext y x; simp only [swapQ, map_apply]; split_ifs <;> simp

theorem kQ_map (j k : Fin 3) (s : R) : (kQ j k s).map φ = kQ j k (φ s) := by
  ext y x; simp only [kQ, map_apply, ← matH_map]; split_ifs <;> simp

theorem gateMat_map (s : R) (g : Sym1) : (gateMat s g).map φ = gateMat (φ s) g := by
  cases g <;> simp only [gateMat, toMat8_map, onQ_map, ctrl_map, ctrl2_map, swapQ_map, kQ_map,
    matX_map, matZ_map, levelMat_map, matK_map]

theorem matH2_map (s : R) : (matH2 s).map φ = matH2 (φ s) := by
  simp only [matH2, toMat8_map, onQ_map, matH_map]

end Map

/-! ## Row operations over `ℚ(√2)` -/

/-- The gates of `Σ₁` as row operations over `ℚ(√2)`. -/
