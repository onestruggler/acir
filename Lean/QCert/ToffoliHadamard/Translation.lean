# Amy, Ross, Wesley (2024): Theorem 5.2 through Li–Ross–Selinger

The completeness half of Theorem 5.2 is a translation argument (the paper
reaches its presentation by Tietze transformations from Li–Ross–Selinger's
presentation of `O₈(ℤ[1/2])`).  Each letter of `Σ₁` decodes to a word of
level matrices with the same matrix (`dec`, checked by the kernel), and
each generator of `𝒢₈` encodes to a circuit (`enc`, `Encode.lean`).  Then
completeness of `R₁` follows from Li–Ross–Selinger's Theorem 4.10 at
`n = 8` together with two families of derivations in `R₁`
(`complete1_of`):

* `EncodesTable1`: the encoding of every relation of Table 1 at `n = 8` is
  derivable from `R₁` (the `Rel(−)` steps of Sections 5.2–5.6 and of the
  supplement);
* `RoundTrip`: every letter of `Σ₁` is derivably equal to the encoding of
  its decoding.

Both are true (the relations are sound and Theorem 5.2 holds), but their
derivations are not formalized: they are the remaining obligations of
Theorem 5.2 (see the README).  The decodings are generated by
`gen/dec.py` (scratch).
-/
import QCert.ToffoliHadamard.Encode

namespace QCert.ToffoliHadamard

open Matrix QCert.ListMat

/-- `(−1)_[a]` in `𝒢₈`. -/
abbrev N' (a : Fin 8) : LiRossSelinger.Gen 8 := .neg a
/-- `X_[a,b]` in `𝒢₈`. -/
abbrev X' (a b : Fin 8) (h : a < b := by decide) : LiRossSelinger.Gen 8 := .x a b h
/-- `K_[a,b,c,d]` in `𝒢₈`. -/
abbrev K' (a b c d : Fin 8) (h₁ : a < b := by decide) (h₂ : b < c := by decide)
    (h₃ : c < d := by decide) : LiRossSelinger.Gen 8 := .k a b c d h₁ h₂ h₃

/-- A letter of `Σ₁` as a word of level matrices with the same matrix. -/
def dec : Sym1 → List (LiRossSelinger.Gen 8)
  | .X0 => [X' 3 7, X' 2 6, X' 1 5, X' 0 4]
  | .X1 => [X' 5 7, X' 4 6, X' 1 3, X' 0 2]
  | .X2 => [X' 6 7, X' 4 5, X' 2 3, X' 0 1]
  | .CX01 => [X' 5 7, X' 4 6]
  | .CX02 => [X' 6 7, X' 4 5]
  | .CX10 => [X' 3 7, X' 2 6]
  | .CX12 => [X' 6 7, X' 2 3]
  | .CX20 => [X' 3 7, X' 1 5]
  | .CX21 => [X' 5 7, X' 1 3]
  | .CCX01 => [X' 6 7]
  | .CCX02 => [X' 5 7]
  | .CCX12 => [X' 3 7]
  | .Z0 => [N' 4, N' 5, N' 6, N' 7]
  | .Z1 => [N' 2, N' 3, N' 6, N' 7]
  | .Z2 => [N' 1, N' 3, N' 5, N' 7]
  | .CZ01 => [N' 6, N' 7]
  | .CZ02 => [N' 5, N' 7]
  | .CZ12 => [N' 3, N' 7]
  | .K01 => [K' 0 2 4 6, K' 1 3 5 7]
  | .K12 => [K' 0 1 2 3, K' 4 5 6 7]
  | .S01 => [X' 3 5, X' 2 4]
  | .S02 => [X' 3 6, X' 1 4]
  | .S12 => [X' 5 6, X' 1 2]
  | .Kc => [K' 0 1 2 3]
  | .CCZ => [N' 7]

set_option maxHeartbeats 0 in
theorem dec_eval : ∀ x : Sym1,
    ListMat.prod 8 ((dec x).map (fun g => ListMat.map ratToQ2 (locL g))) = evalW [x] := by
  intro x; cases x <;> decide +kernel

theorem dec_mat (x : Sym1) : ((dec x).map LiRossSelinger.genMat).prod = semMat x := by
  have e1 : ((dec x).map LiRossSelinger.genMat).prod =
      (ListMat.toMat 8 (ListMat.prod 8 ((dec x).map (fun g => ListMat.map ratToQ2 (locL g))))).map
        QSqrt2.toR := by
    rw [toMat_prod, List.map_map]
    induction dec x with
    | nil => exact (Matrix.map_one _ (map_zero _) (map_one _)).symm
    | cons g l ih =>
      rw [List.map_cons, List.prod_cons, ih, List.map_cons, List.prod_cons, Matrix.map_mul,
        Function.comp_apply, toMat_map, Matrix.map_map, genMat_eq_locL]
      congr 2
      exact (congrArg DFunLike.coe toR_comp_ratToQ2).symm
  rw [e1, dec_eval, toMat_evalW, semMat_eq]
  simp

/-- Words over `Σ₁` as words over `𝒢₈`. -/
def decW : Word Sym1 →* Word (LiRossSelinger.Gen 8) := FreeMonoid.lift fun x => FreeMonoid.ofList (dec x)

theorem sem_decW (u : Word Sym1) :
    FreeMonoid.lift (LiRossSelinger.sem 8) (decW u) = FreeMonoid.lift sem1 u := by
  induction u using FreeMonoid.inductionOn' with
  | one => simp
  | mul_of x u ih =>
    rw [map_mul, map_mul, ih, map_mul, decW, FreeMonoid.lift_eval_of, FreeMonoid.lift_eval_of]
    congr 1
    apply Subtype.ext; apply Subtype.ext
    rw [LiRossSelinger.sem_word, FreeMonoid.toList_ofList, dec_mat]; rfl

/-- The encoding of every relation of Table 1 at `n = 8` is derivable from `R₁`. -/
def EncodesTable1 : Prop :=
  ∀ ⦃u v : Word (LiRossSelinger.Gen 8)⦄, LiRossSelinger.Table1 8 u v → Derivable R1 (encW u) (encW v)

/-- Every letter of `Σ₁` is derivably equal to the encoding of its decoding. -/
def RoundTrip : Prop := ∀ x : Sym1, Derivable R1 (FreeMonoid.of x) (encW (decW (FreeMonoid.of x)))

/-- Completeness of `R₁` from Li–Ross–Selinger's completeness at `n = 8` and
the two families of derivations. -/
theorem complete1_of
    (hc : ∀ ⦃u v : Word (LiRossSelinger.Gen 8)⦄, FreeMonoid.lift (LiRossSelinger.sem 8) u =
      FreeMonoid.lift (LiRossSelinger.sem 8) v → Derivable (LiRossSelinger.Table1 8) u v)
    (henc : EncodesTable1) (hrt : RoundTrip) :
    ∀ ⦃u v : Word Sym1⦄, FreeMonoid.lift sem1 u = FreeMonoid.lift sem1 v → Derivable R1 u v := by
  have hw : ∀ u : Word Sym1, Derivable R1 u (encW (decW u)) := by
    intro u
    induction u using FreeMonoid.inductionOn' with
    | one => simpa using Derivable.refl (1 : Word Sym1)
    | mul_of x u ih => rw [map_mul, map_mul]; exact (hrt x).mul ih
  intro u v huv
  have h8 : Derivable (LiRossSelinger.Table1 8) (decW u) (decW v) :=
    hc (by rw [sem_decW, sem_decW, huv])
  exact (hw u).trans ((derivable_map encW henc h8).trans (hw v).symm)

end QCert.ToffoliHadamard
