/-- The encoding of every relation of Li–Ross–Selinger's Table 1 at `n = 8`
is derivable over `ML`. -/
theorem table1_macro {u v : Word (Gen 8)} (h : Table1 8 u v) :
    Derivable MRel (encMW u) (encMW v) := by
  cases h with
  | r1a a b hab =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x a b hab, .x a b hab]))
      (encMW (FreeMonoid.ofList []))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL, toAG, AG.enc] using fam1a hab b.2
  | r2a a b c d hab hcd hn =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x a b hab, .x c d hcd]))
      (encMW (FreeMonoid.ofList [.x c d hcd, .x a b hab]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal hab b.2
      (imp_spec (imp_spec (allBelow_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam2a_all a.isLt) b.isLt) hab) c.isLt) d.isLt) hcd) (nodup_val hn))
  | r2b a b c hab hn =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x a b hab, .neg c]))
      (encMW (FreeMonoid.ofList [.neg c, .x a b hab]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal hab b.2
      (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam2b_all a.isLt) b.isLt) hab) c.isLt) (nodup_val hn))
  | r2c a b c d e f hab hcd hde hef hn =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x a b hab, .k c d e f hcd hde hef]))
      (encMW (FreeMonoid.ofList [.k c d e f hcd hde hef, .x a b hab]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal hab b.2
      (imp_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam2c_all a.isLt) b.isLt) hab) c.isLt) d.isLt) hcd) e.isLt) hde) f.isLt) hef) (nodup_val hn))
  | r3a a a' b h₁ h₂ =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x a a' h₁, .x a b (h₁.trans h₂)]))
      (encMW (FreeMonoid.ofList [.x a' b h₂, .x a a' h₁]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal h₁ a'.2
      (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam3a_all a.isLt) a'.isLt) h₁) b.isLt) h₂)
  | r3b a b b' h₁ h₂ =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x b b' h₂, .x a b h₁]))
      (encMW (FreeMonoid.ofList [.x a b' (h₁.trans h₂), .x b b' h₂]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal h₂ b'.2
      (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam3b_all a.isLt) b.isLt) h₁) b'.isLt) h₂)
  | r3c a b hab =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x a b hab, .neg b]))
      (encMW (FreeMonoid.ofList [.neg a, .x a b hab]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal hab b.2
      (imp_spec (allBelow_spec (allBelow_spec fam3c_all a.isLt) b.isLt) hab)
  | r3d a a' b c d h₁ h₂ hbc hcd =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x a a' h₁, .k a b c d (h₁.trans h₂) hbc hcd]))
      (encMW (FreeMonoid.ofList [.k a' b c d h₂ hbc hcd, .x a a' h₁]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal h₁ a'.2
      (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam3d_all a.isLt) a'.isLt) h₁) b.isLt) h₂) c.isLt) hbc) d.isLt) hcd)
  | r3e a b b' c d hab h₁ h₂ hcd =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x b b' h₁, .k a b c d hab (h₁.trans h₂) hcd]))
      (encMW (FreeMonoid.ofList [.k a b' c d (hab.trans h₁) h₂ hcd, .x b b' h₁]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal h₁ b'.2
      (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam3e_all a.isLt) b.isLt) hab) b'.isLt) h₁) c.isLt) h₂) d.isLt) hcd)
  | r3f a b c c' d hab hbc h₁ h₂ =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x c c' h₁, .k a b c d hab hbc (h₁.trans h₂)]))
      (encMW (FreeMonoid.ofList [.k a b c' d hab (hbc.trans h₁) h₂, .x c c' h₁]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal h₁ c'.2
      (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam3f_all a.isLt) b.isLt) hab) c.isLt) hbc) c'.isLt) h₁) d.isLt) h₂)
  | r3g a b c d d' hab hbc hcd h₁ =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x d d' h₁, .k a b c d hab hbc hcd]))
      (encMW (FreeMonoid.ofList [.k a b c d' hab hbc (hcd.trans h₁), .x d d' h₁]))
    rw [encMW_ofList, encMW_ofList]
    simpa [encL_two, toAG, AG.enc] using of_okPal h₁ d'.2
      (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam3g_all a.isLt) b.isLt) hab) c.isLt) hbc) d.isLt) hcd) d'.isLt) h₁)
  | r1b a =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.neg a, .neg a]))
      (encMW (FreeMonoid.ofList []))
    rw [encMW_ofList, encMW_ofList]
    exact of_ok (allBelow_spec fam1b_all a.isLt) (std (by decide))
  | r1c a b c d hab hbc hcd =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.k a b c d hab hbc hcd, .k a b c d hab hbc hcd]))
      (encMW (FreeMonoid.ofList []))
    rw [encMW_ofList, encMW_ofList]
    exact of_ok (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam1c_all a.isLt) b.isLt) hab) c.isLt) hbc) d.isLt) hcd) (std (by decide))
  | r2d a b hn =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.neg a, .neg b]))
      (encMW (FreeMonoid.ofList [.neg b, .neg a]))
    rw [encMW_ofList, encMW_ofList]
    exact of_ok (imp_spec (allBelow_spec (allBelow_spec fam2d_all a.isLt) b.isLt) (fun e => hn (Fin.ext e))) (std (by decide))
  | r2e a b c d e hbc hcd hde hn =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.neg a, .k b c d e hbc hcd hde]))
      (encMW (FreeMonoid.ofList [.k b c d e hbc hcd hde, .neg a]))
    rw [encMW_ofList, encMW_ofList]
    exact of_ok (imp_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec (allBelow_spec fam2e_all a.isLt) b.isLt) c.isLt) hbc) d.isLt) hcd) e.isLt) hde) (nodup_val hn)) (std (by decide))
  | r2f a b c d e f g h hab hbc hcd hef hfg hgh hn =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.k a b c d hab hbc hcd, .k e f g h hef hfg hgh]))
      (encMW (FreeMonoid.ofList [.k e f g h hef hfg hgh, .k a b c d hab hbc hcd]))
    rw [encMW_ofList, encMW_ofList]
    exact of_ok (imp_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam2f_all a.isLt) b.isLt) hab) c.isLt) hbc) d.isLt) hcd) e.isLt) f.isLt) hef) g.isLt) hfg) h.isLt) hgh) (nodup_val hn)) (std (by decide))
  | r4a a b c d hab hbc hcd =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x a b hab, .k a b c d hab hbc hcd]))
      (encMW (FreeMonoid.ofList [.k a b c d hab hbc hcd, .x b d (hbc.trans hcd), .neg b, .neg d]))
    rw [encMW_ofList, encMW_ofList]
    exact of_ok (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam4a_all a.isLt) b.isLt) hab) c.isLt) hbc) d.isLt) hcd) (std (by decide))
  | r4b a b c d hab hbc hcd =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x b c hbc, .k a b c d hab hbc hcd]))
      (encMW (FreeMonoid.ofList [.neg a, .k a b c d hab hbc hcd, .neg a, .k a b c d hab hbc hcd, .neg a]))
    rw [encMW_ofList, encMW_ofList]
    exact of_ok (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam4b_all a.isLt) b.isLt) hab) c.isLt) hbc) d.isLt) hcd) (std (by decide))
  | r4c a b c d hab hbc hcd =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.x c d hcd, .k a b c d hab hbc hcd]))
      (encMW (FreeMonoid.ofList [.k a b c d hab hbc hcd, .x b d (hbc.trans hcd)]))
    rw [encMW_ofList, encMW_ofList]
    exact of_ok (imp_spec (allBelow_spec (imp_spec (allBelow_spec (imp_spec (allBelow_spec (allBelow_spec fam4c_all a.isLt) b.isLt) hab) c.isLt) hbc) d.isLt) hcd) (std (by decide))
  | r5a a b c d e f hab hbc hcd hde hef =>
    show Derivable MRel (encMW (FreeMonoid.ofList [.k a b c d hab hbc hcd, .k b d e f (hbc.trans hcd) hde hef]))
      (encMW (FreeMonoid.ofList [.k c d e f hcd hde hef, .k a b c e hab hbc (hcd.trans hde)]))
    rw [encMW_ofList, encMW_ofList]
