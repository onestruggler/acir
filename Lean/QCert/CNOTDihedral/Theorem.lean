# CNOT-dihedral circuits: the presentation

Amy, Chen and Ross, *A finite presentation of CNOT-dihedral operators*:
the relations `R₁`–`R₁₃` of Figure 1, with the laws of the symmetry (§2)
and the structural rules, present the group of `n`-qubit CNOT-dihedral
operators, the subgroup of `U(2ⁿ)` generated by `ω`, `X`, `T`, `CNOT` (and
`SWAP`), for every `n` (Propositions 3.6, 5.5 and 6.4).
-/
import QCert.CNOTDihedral.Soundness
import QCert.CNOTDihedral.Derivation

namespace QCert.CNOTDihedral

open Circuit

/-- Every generator has a left inverse modulo the theory. -/
theorem grouplike (n : ℕ) : Grouplike (Theory n) := by
  intro x
  induction x with
  | @gate0 k c =>
    cases c
    refine ⟨om ^ 7, ?_⟩
    have h := Eqv.rule k Rel.R10
    simp only [Circuit.pad, map_pow, map_one, FreeMonoid.map_of, Gen.pad] at h
    rw [← pow_succ]
    exact h
  | @gate1 k c =>
    cases c
    · exact ⟨FreeMonoid.of (Gen.gate1 Gate.X), Eqv.rule _ Rel.R1⟩
    · refine ⟨T₀ ^ 7, ?_⟩
      have h := Eqv.rule k Rel.R7
      simp only [Circuit.pad, map_pow, map_one, FreeMonoid.map_of, Gen.pad] at h
      rw [← pow_succ]
      exact h
  | gate2 c =>
    cases c
    · exact ⟨FreeMonoid.of (Gen.gate2 Gate.CX), Eqv.rule _ Rel.R4⟩
    · exact ⟨FreeMonoid.of (Gen.gate2 Gate.SW), Eqv.rule _ Rel.swap_swap⟩
  | gate3 c => exact nomatch c
  | up g ih =>
    obtain ⟨u, hu⟩ := ih
    refine ⟨Circuit.shift u, ?_⟩
    have := Eqv.shift hu
    simpa [map_mul] using this

/-- **The presentation** (Propositions 3.6, 5.5 and 6.4): on every number
of wires, the relations of Figure 1 with the laws of the symmetry present
the group generated by the CNOT-dihedral gates. -/
theorem presentation (n : ℕ) : IsSubPresentationOf (Theory n) (S.gen (n := n)) where
  grouplike := grouplike n
  sound := fun w v h => theory_sound n w v h
  complete := by
    sorry

end QCert.CNOTDihedral
