# Completeness for diagonal circuits

The diagonal elements are generated by `ω` and the gadgets `PU U` of the
parities `x_U = ⊕_{i ∈ U} x_i`, for `|U| ≤ 3` (`A`, the paper's diagonal
normal forms of Lemmas 5.2, 5.3).  They commute (`P_comm`), so they form an
abelian group, written additively (`D`).

**Monomials.**  The phase function of an element is a polynomial in the
bits, and the natural basis of its group of values is the monomials
`x_S = ∏_{i ∈ S} x_i`.  The gadget products
`m S = ∑_{W ⊆ S} (-1)^{|S|-|W|} PU W` (Möbius inversion, `mob`) have phase
`(-2)^{|S|-1} x_S` (`phase_mob`).  Since `ω⁸ = 1`, the coefficient of a
monomial of degree `k` matters only modulo `8 / 2^{k-1}`: degree `≥ 4`
terms vanish, which is what `R₁₃` says (it is used as: the gadget of four
wires is a product of smaller ones), and `R₈`, `R₉` say that `m S` has order
dividing `4`, `2` for `|S| = 2, 3` (`four_mon_two`, `two_mon_three`).

**Uniqueness.**  Every element of `A` is `k • ω + ∑_{1 ≤ |S| ≤ 3} κ_S • m S`
(`canon`), since each `PU U` is `∑_{S ⊆ U} m S` (Möbius inversion,
`sum_mob`).  Its phase at the indicator of `V` is
`k + ∑_{S ⊆ V} κ_S (-2)^{|S|-1}`, triangular in `V`; so the phase
determines `k mod 8` and each `κ_S` modulo the order of `m S`, and hence the
element (`diag_complete`).
-/
import QCert.CNOTDihedral.Gadget

namespace QCert.CNOTDihedral

open Circuit

/-! ### Möbius inversion on the Boolean lattice -/

section Mobius

variable {α : Type*} [DecidableEq α] {M : Type*} [AddCommGroup M]

/-- `mob f S = ∑_{W ⊆ S} (-1)^{|S|-|W|} f W`. -/
def mob (f : Finset α → M) (S : Finset α) : M :=
  ∑ W ∈ S.powerset, ((-1 : ℤ) ^ (S.card - W.card)) • f W

theorem mob_empty (f : Finset α → M) : mob f ∅ = f ∅ := by simp [mob]

theorem mob_insert (f : Finset α → M) {a : α} {S : Finset α} (ha : a ∉ S) :
    mob f (insert a S) = - mob f S + mob (fun W => f (insert a W)) S := by
  unfold mob
  rw [Finset.sum_powerset_insert ha, Finset.card_insert_of_notMem ha, ← Finset.sum_neg_distrib]
  congr 1
  · refine Finset.sum_congr rfl (fun W hW => ?_)
    have hW := Finset.card_le_card (Finset.mem_powerset.1 hW)
    rw [show S.card + 1 - W.card = (S.card - W.card) + 1 by omega, pow_succ, mul_neg_one,
      neg_smul]
  · refine Finset.sum_congr rfl (fun W hW => ?_)
    have haW : a ∉ W := fun h => ha (Finset.mem_powerset.1 hW h)
    rw [Finset.card_insert_of_notMem haW, show S.card + 1 - (W.card + 1) = S.card - W.card by omega]

/-- Möbius inversion: `∑_{S ⊆ U} mob f S = f U`. -/
theorem sum_mob : ∀ (f : Finset α → M) (U : Finset α), ∑ S ∈ U.powerset, mob f S = f U := by
  intro f U
  induction U using Finset.induction_on generalizing f with
  | empty => simp [mob_empty]
  | insert a U ha ih =>
    rw [Finset.sum_powerset_insert ha, ih f]
    have h2 : ∀ S ∈ U.powerset, mob f (insert a S) = - mob f S + mob (fun W => f (insert a W)) S :=
      fun S hS => mob_insert f (fun h => ha (Finset.mem_powerset.1 hS h))
    rw [Finset.sum_congr rfl h2, Finset.sum_add_distrib, Finset.sum_neg_distrib, ih f,
      ih (fun W => f (insert a W))]
    abel

theorem mob_const (c : M) (S : Finset α) : mob (fun _ => c) S = if S = ∅ then c else 0 := by
  by_cases hS : S = ∅
  · subst hS; simp [mob_empty]
  · obtain ⟨a, ha⟩ := Finset.nonempty_iff_ne_empty.2 hS
    rw [if_neg hS, ← Finset.insert_erase ha, mob_insert _ (Finset.notMem_erase a S)]
    simp

theorem mob_add (f g : Finset α → M) (S : Finset α) :
    mob (fun W => f W + g W) S = mob f S + mob g S := by
  simp [mob, smul_add, Finset.sum_add_distrib]

theorem mob_neg (f : Finset α → M) (S : Finset α) : mob (fun W => - f W) S = - mob f S := by
  simp [mob, Finset.sum_neg_distrib]

end Mobius

theorem mob_mul_left {α : Type*} [DecidableEq α] {R : Type*} [CommRing R] (c : R)
    (f : Finset α → R) (S : Finset α) : mob (fun W => c * f W) S = c * mob f S := by
  simp only [mob, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun W _ => ?_)
  rw [zsmul_eq_mul, zsmul_eq_mul]; ring

theorem mob_congr {α : Type*} [DecidableEq α] {M : Type*} [AddCommGroup M] {f g : Finset α → M}
    {S : Finset α} (h : ∀ W ⊆ S, f W = g W) : mob f S = mob g S := by
  unfold mob
  exact Finset.sum_congr rfl (fun W hW => by rw [h W (Finset.mem_powerset.1 hW)])

/-- The phase of the Möbius product of parity gadgets: `(-2)^{|S|-1} x_S`. -/
theorem phase_mob {N : ℕ} (s : State 2 N) :
    ∀ S : Finset (Fin N), S ≠ ∅ →
      mob (fun W => toZ8 (∑ i ∈ W, s i)) S = (-2) ^ (S.card - 1) * ∏ i ∈ S, toZ8 (s i) := by
  intro S
  induction S using Finset.induction_on with
  | empty => intro h; exact absurd rfl h
  | insert a S ha ih =>
    intro _
    rw [mob_insert _ ha]
    have e : mob (fun W => toZ8 (∑ i ∈ insert a W, s i)) S =
        mob (fun _ => toZ8 (s a)) S +
          (1 - 2 * toZ8 (s a)) * mob (fun W => toZ8 (∑ i ∈ W, s i)) S := by
      rw [← mob_mul_left, ← mob_add]
      refine mob_congr (fun W hW => ?_)
      have haW : a ∉ W := fun h => ha (hW h)
      rw [Finset.sum_insert haW, toZ8_add_of]
      ring
    rw [e, mob_const, Finset.card_insert_of_notMem ha, Finset.prod_insert ha]
    by_cases hS : S = ∅
    · subst hS
      simp [mob_empty, toZ8]
    · rw [if_neg hS, ih hS]
      have hc : S.card ≠ 0 := fun h => hS (Finset.card_eq_zero.1 h)
      obtain ⟨k, hk⟩ : ∃ k, S.card = k + 1 := ⟨S.card - 1, by omega⟩
      rw [hk, show k + 1 + 1 - 1 = k + 1 by omega, show k + 1 - 1 = k by omega, pow_succ]
      ring

/-! ### Gadgets of sets of wires -/

section Sets

variable {n : ℕ}

/-- The indicator state of a set of wires. -/
def ind (U : Finset (Fin (n + 1))) : State 2 (n + 1) := fun j => if j ∈ U then 1 else 0

theorem dot_ind (U : Finset (Fin (n + 1))) (s : State 2 (n + 1)) :
    dot (ind U) s = ∑ i ∈ U, s i := by
  simp only [dot, ind, ite_mul, one_mul, zero_mul]
  rw [Finset.sum_ite_mem, Finset.univ_inter]

theorem ind_empty : (ind ∅ : State 2 (n + 1)) = 0 := by funext j; simp [ind]

theorem ind_insert {a : Fin (n + 1)} {U : Finset (Fin (n + 1))} (ha : a ∉ U) :
    ind (insert a U) = ei a.val + ind U := by
  funext j
  by_cases hj : j = a
  · subst hj; simp [ind, ei, ha]
  · simp [ind, ei, hj, Fin.val_inj]

theorem ind_ne_zero {U : Finset (Fin (n + 1))} (hU : U ≠ ∅) : ind U ≠ 0 := by
  obtain ⟨a, ha⟩ := Finset.nonempty_iff_ne_empty.2 hU
  intro h; have := congrFun h a; simp [ind, ha] at this

/-- The gadget of a set of wires (`1` for the empty set). -/
noncomputable def PU (U : Finset (Fin (n + 1))) : Q (n + 1) :=
  if U = ∅ then 1 else P (ind U)

theorem PU_of_ne {U : Finset (Fin (n + 1))} (hU : U ≠ ∅) : PU U = P (ind U) := if_neg hU

theorem PU_empty : (PU ∅ : Q (n + 1)) = 1 := if_pos rfl

theorem paQ_PU (U : Finset (Fin (n + 1))) :
    paQ (PU U) = ⟨id, fun s => toZ8 (∑ i ∈ U, s i)⟩ := by
  by_cases hU : U = ∅
  · subst hU; rw [PU_empty, map_one]
    refine PA.ext' (fun s => rfl) (fun s => ?_); simp [toZ8]
  · rw [PU_of_ne hU, paQ_P (ind_ne_zero hU)]
    refine PA.ext' (fun s => rfl) (fun s => ?_)
    simp only [dot_ind]

theorem PU_comm (U V : Finset (Fin (n + 1))) : Commute (PU U) (PU V) := by
  by_cases hU : U = ∅
  · subst hU; rw [PU_empty]; exact Commute.one_left _
  by_cases hV : V = ∅
  · subst hV; rw [PU_empty]; exact Commute.one_right _
  rw [PU_of_ne hU, PU_of_ne hV]
  exact P_comm (ind_ne_zero hU) (ind_ne_zero hV)

theorem PU_pow_eight (U : Finset (Fin (n + 1))) : PU U ^ 8 = 1 := by
  by_cases hU : U = ∅
  · subst hU; rw [PU_empty, one_pow]
  · rw [PU_of_ne hU, P_pow_eight]

theorem PU_singleton {a : ℕ} (ha : a < n + 1) : (PU {⟨a, ha⟩} : Q (n + 1)) = qT a := by
  rw [PU_of_ne (Finset.singleton_ne_empty _), qT_eq_P ha]
  congr 1
  rw [← Finset.insert_empty, ind_insert (Finset.notMem_empty _), ind_empty, add_zero]

end Sets

/-! ### Placing the gadget relations on any wires -/

theorem place_P {n : ℕ} {p : Q (n + 1)} (hp : p ∈ Lin (n + 1)) {ℓ ℓ' : State 2 (n + 1)}
    (hℓ : ℓ ≠ 0) (h : ∀ s, dot ℓ ((paQ p).f s) = dot ℓ' s) : p⁻¹ * P ℓ * p = P ℓ' := by
  have := conj_P ((Lin _).inv_mem hp) hℓ (ℓ' := ℓ') (by simpa using h)
  simpa using this

theorem place_L {n : ℕ} (xs : List ℕ) {ℓ ℓ' : State 2 (n + 1)} (hℓ : ℓ ≠ 0)
    (h : ∀ s, dot ℓ ((paQ (swp (bringL xs) : Q (n + 1))).f s) = dot ℓ' s) :
    (swp (bringL xs) : Q (n + 1))⁻¹ * P ℓ * swp (bringL xs) = P ℓ' :=
  place_P (swp_mem_Lin _) hℓ h

theorem conj_pow_inv {G : Type*} [Group G] (a b : G) (k : ℕ) :
    a⁻¹ * b ^ k * a = (a⁻¹ * b * a) ^ k := (conj_pow' a b k).symm

/-- The swap word bringing four distinct wires down, and what it reads. -/
theorem bring_bits {N : ℕ} {xs : List ℕ} (hnd : xs.Nodup) (hlt : ∀ w ∈ xs, w < N) {i x : ℕ}
    (hi : xs[i]? = some x) (s : State 2 N) :
    bit ((paQ (swp (bringL xs) : Q N)).f s) i = bit s x :=
  bit_bringL xs hnd hlt s i x hi

/-- `R₈` on any two wires. -/
theorem placed_R8 {n : ℕ} {a b : ℕ} (hab : a ≠ b) (ha : a < n + 1) (hb : b < n + 1) :
    (P (ei a + ei b) : Q (n + 1)) ^ 4 = P (ei b) ^ 4 * P (ei a) ^ 4 := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  have hnd : [a, b].Nodup := by simp [hab]
  have hlt : ∀ w ∈ [a, b], w < m + 2 := by simp [ha, hb]
  have h0 := bring_bits (N := m + 2) hnd hlt (i := 0) (x := a) rfl
  have h1 := bring_bits (N := m + 2) hnd hlt (i := 1) (x := b) rfl
  have h := congrArg (fun z => (swp (bringL [a, b]) : Q (m + 2))⁻¹ * z * swp (bringL [a, b])) (base_R8 (n := m))
  simp only [conj_mul, conj_pow_inv] at h
  rwa [place_L [a, b] (ℓ := ei 0 + ei 1) (ℓ' := ei a + ei b) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h1]),
    place_L [a, b] (ℓ := ei 1) (ℓ' := ei b) (ne_zero_of_bit (i := 1) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h1]),
    place_L [a, b] (ℓ := ei 0) (ℓ' := ei a) (ne_zero_of_bit (i := 0) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h0])] at h

/-- `R₉` on any three wires. -/
theorem placed_R9 {n : ℕ} {a b c : ℕ} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (ha : a < n + 1) (hb : b < n + 1) (hc : c < n + 1) :
    (P (ei a + ei b + ei c) : Q (n + 1)) ^ 2 =
      P (ei a + ei b) ^ 2 * P (ei a + ei c) ^ 2 * P (ei b + ei c) ^ 2 *
        P (ei c) ^ 6 * P (ei b) ^ 6 * P (ei a) ^ 6 := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩
  have hnd : [a, b, c].Nodup := by simp [hab, hac, hbc]
  have hlt : ∀ w ∈ [a, b, c], w < m + 3 := by simp [ha, hb, hc]
  have h0 := bring_bits (N := m + 3) hnd hlt (i := 0) (x := a) rfl
  have h1 := bring_bits (N := m + 3) hnd hlt (i := 1) (x := b) rfl
  have h2 := bring_bits (N := m + 3) hnd hlt (i := 2) (x := c) rfl
  have h := congrArg (fun z => (swp (bringL [a, b, c]) : Q (m + 3))⁻¹ * z * swp (bringL [a, b, c])) (base_R9 (n := m))
  simp only [conj_mul, conj_pow_inv] at h
  rwa [place_L [a, b, c] (ℓ := ei 0 + ei 1 + ei 2) (ℓ' := ei a + ei b + ei c)
      (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h1, h2]),
    place_L [a, b, c] (ℓ := ei 0 + ei 1) (ℓ' := ei a + ei b) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h1]),
    place_L [a, b, c] (ℓ := ei 0 + ei 2) (ℓ' := ei a + ei c) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h2]),
    place_L [a, b, c] (ℓ := ei 1 + ei 2) (ℓ' := ei b + ei c) (ne_zero_of_bit (i := 1) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h1, h2]),
    place_L [a, b, c] (ℓ := ei 2) (ℓ' := ei c) (ne_zero_of_bit (i := 2) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h2]),
    place_L [a, b, c] (ℓ := ei 1) (ℓ' := ei b) (ne_zero_of_bit (i := 1) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h1]),
    place_L [a, b, c] (ℓ := ei 0) (ℓ' := ei a) (ne_zero_of_bit (i := 0) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h0])] at h

/-- `R₁₃` on any four wires. -/
theorem placed_R13 {n : ℕ} {a b c d : ℕ} (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (ha : a < n + 1) (hb : b < n + 1) (hc : c < n + 1) (hd : d < n + 1) :
    (P (ei a + ei b + ei c + ei d) : Q (n + 1)) =
      P (ei a + ei b + ei c) * P (ei a + ei b + ei d) * P (ei a + ei c + ei d) *
        P (ei b + ei c + ei d) * P (ei a + ei b) ^ 3 * P (ei a + ei c) ^ 3 *
        P (ei b + ei c) ^ 3 * P (ei a + ei d) ^ 3 * P (ei b + ei d) ^ 3 * P (ei c + ei d) ^ 3 *
        P (ei d) ^ 5 * P (ei c) ^ 5 * P (ei b) ^ 5 * P (ei a) ^ 5 := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
  have hnd : [a, b, c, d].Nodup := by simp [hab, hac, had, hbc, hbd, hcd]
  have hlt : ∀ w ∈ [a, b, c, d], w < m + 4 := by simp [ha, hb, hc, hd]
  have h0 := bring_bits (N := m + 4) hnd hlt (i := 0) (x := a) rfl
  have h1 := bring_bits (N := m + 4) hnd hlt (i := 1) (x := b) rfl
  have h2 := bring_bits (N := m + 4) hnd hlt (i := 2) (x := c) rfl
  have h3 := bring_bits (N := m + 4) hnd hlt (i := 3) (x := d) rfl
  have h := congrArg (fun z => (swp (bringL [a, b, c, d]) : Q (m + 4))⁻¹ * z * swp (bringL [a, b, c, d])) (base_R13 (n := m))
  simp only [conj_mul, conj_pow_inv] at h
  rwa [place_L [a, b, c, d] (ℓ := ei 0 + ei 1 + ei 2 + ei 3) (ℓ' := ei a + ei b + ei c + ei d)
      (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h1, h2, h3]),
    place_L [a, b, c, d] (ℓ := ei 0 + ei 1 + ei 2) (ℓ' := ei a + ei b + ei c) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h1, h2]),
    place_L [a, b, c, d] (ℓ := ei 0 + ei 1 + ei 3) (ℓ' := ei a + ei b + ei d) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h1, h3]),
    place_L [a, b, c, d] (ℓ := ei 0 + ei 2 + ei 3) (ℓ' := ei a + ei c + ei d) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h2, h3]),
    place_L [a, b, c, d] (ℓ := ei 1 + ei 2 + ei 3) (ℓ' := ei b + ei c + ei d) (ne_zero_of_bit (i := 1) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h1, h2, h3]),
    place_L [a, b, c, d] (ℓ := ei 0 + ei 1) (ℓ' := ei a + ei b) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h1]),
    place_L [a, b, c, d] (ℓ := ei 0 + ei 2) (ℓ' := ei a + ei c) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h2]),
    place_L [a, b, c, d] (ℓ := ei 1 + ei 2) (ℓ' := ei b + ei c) (ne_zero_of_bit (i := 1) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h1, h2]),
    place_L [a, b, c, d] (ℓ := ei 0 + ei 3) (ℓ' := ei a + ei d) (ne_zero_of_bit (i := 0) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h0, h3]),
    place_L [a, b, c, d] (ℓ := ei 1 + ei 3) (ℓ' := ei b + ei d) (ne_zero_of_bit (i := 1) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h1, h3]),
    place_L [a, b, c, d] (ℓ := ei 2 + ei 3) (ℓ' := ei c + ei d) (ne_zero_of_bit (i := 2) (by simp [bit_add, bit_ei]))
      (fun s => by simp only [dot_add_left, dot_ei, h2, h3]),
    place_L [a, b, c, d] (ℓ := ei 3) (ℓ' := ei d) (ne_zero_of_bit (i := 3) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h3]),
    place_L [a, b, c, d] (ℓ := ei 2) (ℓ' := ei c) (ne_zero_of_bit (i := 2) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h2]),
    place_L [a, b, c, d] (ℓ := ei 1) (ℓ' := ei b) (ne_zero_of_bit (i := 1) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h1]),
    place_L [a, b, c, d] (ℓ := ei 0) (ℓ' := ei a) (ne_zero_of_bit (i := 0) (by simp [bit_ei]))
      (fun s => by simp only [dot_ei, h0])] at h


/-! ### The diagonal subgroup -/

section Diag

variable {n : ℕ}

/-- The generators of the diagonal subgroup: `ω` and the gadgets of at
most three wires. -/
def Agens (n : ℕ) : Set (Q (n + 1)) :=
  {x | x = qω ∨ ∃ U : Finset (Fin (n + 1)), U.card ≤ 3 ∧ x = PU U}

/-- The diagonal subgroup. -/
noncomputable abbrev A (n : ℕ) : Subgroup (Q (n + 1)) := Subgroup.closure (Agens n)

theorem PU_mem_A {U : Finset (Fin (n + 1))} (hU : U.card ≤ 3) : PU U ∈ A n :=
  Subgroup.subset_closure (Or.inr ⟨U, hU, rfl⟩)

theorem qω_mem_A : (qω : Q (n + 1)) ∈ A n := Subgroup.subset_closure (Or.inl rfl)

theorem Agens_comm (n : ℕ) : ∀ x ∈ Agens n, ∀ y ∈ Agens n, x * y = y * x := by
  rintro x (rfl | ⟨U, -, rfl⟩) y (rfl | ⟨V, -, rfl⟩)
  · rfl
  · exact qω_comm _
  · exact (qω_comm _).symm
  · exact (PU_comm U V).eq

noncomputable instance (n : ℕ) : CommGroup (A n) := Subgroup.closureCommGroupOfComm (Agens_comm n)

/-- Diagonal elements do not move the basis states. -/
theorem A_f {x : Q (n + 1)} (hx : x ∈ A n) : (paQ x).f = id := by
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    rcases hy with rfl | ⟨U, -, rfl⟩
    · rfl
    · rw [paQ_PU]
  | one => rfl
  | mul y z _ _ hy hz => rw [map_mul, PA.mul_f, hy, hz]; rfl
  | inv y hy' hy =>
    funext s
    have := paQ_inv_f' y s
    rw [hy] at this
    exact this

theorem A_ph_mul {x y : Q (n + 1)} (hy : y ∈ A n) (s : State 2 (n + 1)) :
    (paQ (x * y)).ph s = (paQ y).ph s + (paQ x).ph s := by
  rw [map_mul, PA.mul_ph, A_f hy]; rfl

/-! ### The four-wire gadget is a product of smaller ones -/

theorem ind_two {a b : Fin (n + 1)} (hab : a ≠ b) :
    ind {a, b} = ei a.val + ei b.val := by
  rw [ind_insert (by simp [hab]), ← Finset.insert_empty, ind_insert (Finset.notMem_empty _), ind_empty,
    add_zero]

theorem ind_three {a b c : Fin (n + 1)} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    ind {a, b, c} = ei a.val + ei b.val + ei c.val := by
  rw [ind_insert (by simp [hab, hac]), ind_two hbc, add_assoc]

theorem ind_four {a b c d : Fin (n + 1)} (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    ind {a, b, c, d} = ei a.val + ei b.val + ei c.val + ei d.val := by
  rw [ind_insert (by simp [hab, hac, had]), ind_three hbc hbd hcd]; abel

theorem ind_one (a : Fin (n + 1)) : ind {a} = ei a.val := by
  rw [← Finset.insert_empty, ind_insert (Finset.notMem_empty _), ind_empty, add_zero]

theorem PU_two {a b : Fin (n + 1)} (hab : a ≠ b) : PU {a, b} = P (ei a.val + ei b.val) := by
  rw [PU_of_ne (by simp), ind_two hab]

theorem PU_three {a b c : Fin (n + 1)} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    PU {a, b, c} = P (ei a.val + ei b.val + ei c.val) := by
  rw [PU_of_ne (by simp), ind_three hab hac hbc]

theorem PU_one (a : Fin (n + 1)) : PU {a} = P (ei a.val) := by
  rw [PU_of_ne (by simp), ind_one]

theorem card_four {V : Finset (Fin (n + 1))} (hV : V.card = 4) :
    ∃ a b c d, a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d ∧ V = {a, b, c, d} := by
  obtain ⟨a, T, haT, rfl, hT⟩ := Finset.card_eq_succ.1 hV
  obtain ⟨b, c, d, hbc, hbd, hcd, rfl⟩ := Finset.card_eq_three.1 hT
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at haT
  exact ⟨a, b, c, d, haT.1, haT.2.1, haT.2.2, hbc, hbd, hcd, rfl⟩

/-- `R₁₃`: the gadget of four wires lies in the diagonal subgroup. -/
theorem PU_four_mem {V : Finset (Fin (n + 1))} (hV : V.card = 4) : PU V ∈ A n := by
  obtain ⟨a, b, c, d, hab, hac, had, hbc, hbd, hcd, rfl⟩ := card_four hV
  have hv : ∀ {x y : Fin (n + 1)}, x ≠ y → x.val ≠ y.val := fun h e => h (Fin.ext e)
  rw [PU_of_ne (by simp), ind_four hab hac had hbc hbd hcd,
    placed_R13 (hv hab) (hv hac) (hv had) (hv hbc) (hv hbd) (hv hcd) a.isLt b.isLt c.isLt d.isLt]
  have m3 : ∀ {x y z : Fin (n + 1)}, x ≠ y → x ≠ z → y ≠ z →
      P (ei x.val + ei y.val + ei z.val) ∈ A n := fun h1 h2 h3 => by
    rw [← PU_three h1 h2 h3]; exact PU_mem_A (Finset.card_le_three)
  have m2 : ∀ {x y : Fin (n + 1)}, x ≠ y → P (ei x.val + ei y.val) ∈ A n := fun h1 => by
    rw [← PU_two h1]; exact PU_mem_A (le_trans (Finset.card_le_two) (by omega))
  have m1 : ∀ x : Fin (n + 1), P (ei x.val) ∈ A n := fun x => by
    rw [← PU_one]; exact PU_mem_A (by simp)
  refine (A n).mul_mem ((A n).mul_mem ((A n).mul_mem ((A n).mul_mem ((A n).mul_mem
    ((A n).mul_mem ((A n).mul_mem ((A n).mul_mem ((A n).mul_mem ((A n).mul_mem
    ((A n).mul_mem ((A n).mul_mem ((A n).mul_mem (m3 hab hac hbc) (m3 hab had hbd))
    (m3 hac had hcd)) (m3 hbc hbd hcd)) ((A n).pow_mem (m2 hab) _)) ((A n).pow_mem (m2 hac) _))
    ((A n).pow_mem (m2 hbc) _)) ((A n).pow_mem (m2 had) _)) ((A n).pow_mem (m2 hbd) _))
    ((A n).pow_mem (m2 hcd) _)) ((A n).pow_mem (m1 d) _)) ((A n).pow_mem (m1 c) _))
    ((A n).pow_mem (m1 b) _)) ((A n).pow_mem (m1 a) _)

/-! ### Closure of the diagonal subgroup -/

/-- Conjugation by an involution preserves `A` if it does on generators. -/
theorem A_conj_of_gen {g : Q (n + 1)} (hg : g * g = 1)
    (h : ∀ x ∈ Agens n, g * x * g ∈ A n) : ∀ x ∈ A n, g * x * g ∈ A n := by
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem y hy => exact h y hy
  | one => rw [mul_one, hg]; exact (A n).one_mem
  | mul y z _ _ hy hz =>
    have e : g * (y * z) * g = (g * y * g) * (g * z * g) := by
      rw [show (g * y * g) * (g * z * g) = g * y * (g * g) * z * g by group, hg]; group
    rw [e]; exact (A n).mul_mem hy hz
  | inv y _ hy =>
    have hgi : g⁻¹ = g := inv_eq_of_mul_eq_one_left hg
    have e : g * y⁻¹ * g = (g * y * g)⁻¹ := by rw [mul_inv_rev, mul_inv_rev, hgi]; group
    rw [e]; exact (A n).inv_mem hy

theorem ind_comp {U : Finset (Fin (n + 1))} (σ : Equiv.Perm (Fin (n + 1))) :
    ind U ∘ σ = ind (U.map σ.symm.toEmbedding) := by
  funext j
  simp only [Function.comp_apply, ind, Finset.mem_map_equiv, Equiv.symm_symm]

theorem ind_add_ei {U : Finset (Fin (n + 1))} (j : Fin (n + 1)) :
    ind U + ei j.val = ind (if j ∈ U then U.erase j else insert j U) := by
  funext k
  by_cases hk : k = j
  · subst hk; split_ifs with h <;> simp [ind, ei, h] <;> decide
  · have : (k : ℕ) ≠ j := fun e => hk (Fin.ext e)
    split_ifs with h <;> simp [ind, ei, this, hk]

/-- The linear generators preserve `A`. -/
theorem A_conj_lin {g : Q (n + 1)} (hg : g ∈ linGens (n + 1)) :
    ∀ x ∈ A n, g * x * g ∈ A n := by
  refine A_conj_of_gen (linGens_sq hg) (fun x hx => ?_)
  rcases hx with rfl | ⟨U, hU, rfl⟩
  · rw [← qω_comm, mul_assoc, linGens_sq hg, mul_one]; exact qω_mem_A
  by_cases hU0 : U = ∅
  · subst hU0; rw [PU_empty, mul_one, linGens_sq hg]; exact (A n).one_mem
  obtain ⟨i, rfl | rfl⟩ := hg
  · by_cases hi : i + 1 < n + 1
    · rw [qCX_eq_cc hi, PU_of_ne hU0,
        cc_conj_P (by omega) (by omega) (by omega) (ind_ne_zero hU0)]
      by_cases hiU : (⟨i, by omega⟩ : Fin (n + 1)) ∈ U
      · have hb : bit (ind U) i = 1 := by simp [bit, ind, show i < n + 1 by omega, hiU]
        rw [hb, one_smul, show i + 1 = (⟨i + 1, hi⟩ : Fin (n + 1)).val from rfl, ind_add_ei]
        set V := if (⟨i + 1, hi⟩ : Fin (n + 1)) ∈ U then U.erase ⟨i + 1, hi⟩ else insert ⟨i + 1, hi⟩ U
        have hV0 : V ≠ ∅ := by
          simp only [V]; split_ifs with h
          · intro e; have : (⟨i, by omega⟩ : Fin (n + 1)) ∈ U.erase ⟨i + 1, hi⟩ :=
              Finset.mem_erase.2 ⟨by simp [Fin.ext_iff], hiU⟩
            rw [e] at this; simp at this
          · simp
        have hV : V.card ≤ 4 := by
          simp only [V]; split_ifs
          · exact le_trans (Finset.card_erase_le) (by omega)
          · exact le_trans (Finset.card_insert_le _ _) (by omega)
        rw [← PU_of_ne hV0]
        rcases Nat.lt_or_ge V.card 4 with h | h
        · exact PU_mem_A (by omega)
        · exact PU_four_mem (by omega)
      · have hb : bit (ind U) i = 0 := by simp [bit, ind, show i < n + 1 by omega, hiU]
        rw [hb, zero_smul, add_zero, ← PU_of_ne hU0]; exact PU_mem_A hU
    · rw [qCX_out (by omega), one_mul, mul_one]; exact PU_mem_A hU
  · by_cases hi : i + 1 < n + 1
    · rw [PU_of_ne hU0, qSW_conj_P i (ind_ne_zero hU0), ind_comp,
        ← PU_of_ne (by simpa using hU0)]
      exact PU_mem_A (by simpa using hU)
    · rw [qSW_out (by omega), one_mul, mul_one]; exact PU_mem_A hU

/-- `X` gates preserve `A`. -/
theorem A_conj_X (i : ℕ) : ∀ x ∈ A n, qX i * x * qX i ∈ A n := by
  refine A_conj_of_gen (qX_sq i) (fun x hx => ?_)
  rcases hx with rfl | ⟨U, hU, rfl⟩
  · rw [← qω_comm, mul_assoc, qX_sq, mul_one]; exact qω_mem_A
  by_cases hU0 : U = ∅
  · subst hU0; rw [PU_empty, mul_one, qX_sq]; exact (A n).one_mem
  by_cases hi : i < n + 1
  · rw [PU_of_ne hU0, qX_conj_P hi (ind_ne_zero hU0), ← PU_of_ne hU0]
    split_ifs
    · exact (A n).mul_mem ((A n).pow_mem (PU_mem_A hU) _) qω_mem_A
    · exact PU_mem_A hU
  · rw [qX_out (by omega), one_mul, mul_one]; exact PU_mem_A hU

theorem qT_mem_A (i : ℕ) : (qT i : Q (n + 1)) ∈ A n := by
  by_cases hi : i < n + 1
  · rw [← PU_singleton hi]; exact PU_mem_A (by simp)
  · rw [qT_out (by omega)]; exact (A n).one_mem

end Diag

/-! ### The diagonal subgroup, additively -/

section Additive

variable {n : ℕ}

/-- The diagonal subgroup, written additively. -/
abbrev D (n : ℕ) := Additive (A n)

/-- An element of `D` as a class of circuits. -/
def toQ (d : D n) : Q (n + 1) := ((Additive.toMul d : A n) : Q (n + 1))

theorem toQ_add (d e : D n) : toQ (d + e) = toQ d * toQ e := rfl

theorem toQ_mem (d : D n) : toQ d ∈ A n := (Additive.toMul d).2

theorem D_ext {d e : D n} (h : toQ d = toQ e) : d = e := by
  apply Additive.toMul.injective
  exact Subtype.ext h

theorem toQ_zero : toQ (0 : D n) = 1 := rfl

theorem toQ_nsmul (k : ℕ) (d : D n) : toQ (k • d) = toQ d ^ k := rfl

/-- The phase of a diagonal element. -/
noncomputable def Φ : D n →+ (State 2 (n + 1) → ZMod 8) where
  toFun d := (paQ (toQ d)).ph
  map_zero' := by funext s; rw [toQ_zero, map_one]; rfl
  map_add' d e := by
    funext s
    rw [toQ_add, A_ph_mul (toQ_mem e)]
    simp only [Pi.add_apply]
    ring

theorem Φ_add' (d e : D n) (s : State 2 (n + 1)) : Φ (d + e) s = Φ d s + Φ e s := by
  rw [map_add]; rfl

theorem Φ_zsmul (k : ℤ) (d : D n) (s : State 2 (n + 1)) : Φ (k • d) s = k * Φ d s := by
  have := map_zsmul ((Pi.evalAddMonoidHom (fun _ : State 2 (n + 1) => ZMod 8) s).comp Φ) k d
  rw [zsmul_eq_mul] at this
  exact this

theorem Φ_sum {ι : Type*} (M : Finset ι) (f : ι → D n) (s : State 2 (n + 1)) :
    Φ (∑ i ∈ M, f i) s = ∑ i ∈ M, Φ (f i) s :=
  map_sum ((Pi.evalAddMonoidHom (fun _ : State 2 (n + 1) => ZMod 8) s).comp Φ) f M

theorem toQ_eq_of_Φ {d e : D n} (h : Φ d = Φ e) : paQ (toQ d) = paQ (toQ e) := by
  refine PA.ext' (fun s => ?_) (fun s => congrFun h s)
  rw [A_f (toQ_mem d), A_f (toQ_mem e)]

/-- The gadget of at most three wires in `D` (`0` for larger sets). -/
noncomputable def pU (U : Finset (Fin (n + 1))) : D n :=
  if h : U.card ≤ 3 then Additive.ofMul ⟨PU U, PU_mem_A h⟩ else 0

/-- `ω` in `D`. -/
noncomputable def ωD : D n := Additive.ofMul ⟨qω, qω_mem_A⟩

theorem toQ_pU {U : Finset (Fin (n + 1))} (hU : U.card ≤ 3) : toQ (pU U : D n) = PU U := by
  simp [pU, hU, toQ]

theorem pU_empty : (pU ∅ : D n) = 0 := D_ext (by rw [toQ_pU (by simp), PU_empty]; rfl)

theorem Φ_pU {U : Finset (Fin (n + 1))} (hU : U.card ≤ 3) (s : State 2 (n + 1)) :
    Φ (pU U : D n) s = toZ8 (∑ i ∈ U, s i) := by
  show (paQ (toQ (pU U))).ph s = _
  rw [toQ_pU hU, paQ_PU]

theorem Φ_ωD (s : State 2 (n + 1)) : Φ (ωD : D n) s = 1 := rfl

theorem eight_ωD : (8 : ℕ) • (ωD : D n) = 0 := D_ext (by rw [toQ_nsmul]; exact qω_pow_eight)

theorem eight_pU (U : Finset (Fin (n + 1))) : (8 : ℕ) • (pU U : D n) = 0 := by
  by_cases hU : U.card ≤ 3
  · exact D_ext (by rw [toQ_nsmul, toQ_pU hU]; exact PU_pow_eight U)
  · simp [pU, hU]

/-- The monomial gadgets: phase `(-2)^{|S|-1} x_S`. -/
noncomputable def mon (S : Finset (Fin (n + 1))) : D n := mob pU S

theorem Φ_mob (f : Finset (Fin (n + 1)) → D n) (S : Finset (Fin (n + 1))) (s : State 2 (n + 1)) :
    Φ (mob f S) s = mob (fun W => Φ (f W) s) S := by
  simp only [mob, map_sum, map_zsmul, Finset.sum_apply, Pi.smul_apply]

theorem Φ_mon {S : Finset (Fin (n + 1))} (hS : S.card ≤ 3) (hS0 : S ≠ ∅) (s : State 2 (n + 1)) :
    Φ (mon S : D n) s = (-2) ^ (S.card - 1) * ∏ i ∈ S, toZ8 (s i) := by
  rw [mon, Φ_mob, ← phase_mob s S hS0]
  exact mob_congr (fun W hW => Φ_pU (le_trans (Finset.card_le_card hW) hS) s)

theorem eight_mon (S : Finset (Fin (n + 1))) : (8 : ℕ) • (mon S : D n) = 0 := by
  simp only [mon, mob, Finset.smul_sum]
  refine Finset.sum_eq_zero (fun W _ => ?_)
  rw [smul_comm, eight_pU, smul_zero]

/-- Möbius inversion: a gadget is the sum of the monomials below it. -/
theorem pU_eq_sum_mon (U : Finset (Fin (n + 1))) : (pU U : D n) = ∑ S ∈ U.powerset, mon S :=
  (sum_mob pU U).symm

theorem mon_empty : (mon ∅ : D n) = 0 := by rw [mon, mob_empty, pU_empty]

theorem mob_one {α : Type*} [DecidableEq α] {M : Type*} [AddCommGroup M] (f : Finset α → M)
    (a : α) : mob f {a} = f {a} - f ∅ := by
  rw [← Finset.insert_empty, mob_insert _ (Finset.notMem_empty a)]
  simp only [mob_empty]
  abel

theorem mob_two {α : Type*} [DecidableEq α] {M : Type*} [AddCommGroup M] (f : Finset α → M)
    {a b : α} (hab : a ≠ b) : mob f {a, b} = f {a, b} - f {a} - f {b} + f ∅ := by
  rw [mob_insert _ (by simpa using hab), mob_one, mob_one]
  simp only [Finset.insert_empty]
  abel

theorem mob_three {α : Type*} [DecidableEq α] {M : Type*} [AddCommGroup M] (f : Finset α → M)
    {a b c : α} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    mob f {a, b, c} =
      f {a, b, c} - f {a, b} - f {a, c} - f {b, c} + f {a} + f {b} + f {c} - f ∅ := by
  rw [mob_insert _ (by simp [hab, hac]), mob_two _ hbc, mob_two _ hbc]
  simp only [Finset.insert_empty]
  abel

theorem mon_one (a : Fin (n + 1)) : (mon {a} : D n) = pU {a} := by
  rw [mon, mob_one, pU_empty, sub_zero]

theorem mon_two {a b : Fin (n + 1)} (hab : a ≠ b) :
    (mon {a, b} : D n) = pU {a, b} - pU {a} - pU {b} := by
  rw [mon, mob_two _ hab, pU_empty, add_zero]

theorem mon_three {a b c : Fin (n + 1)} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    (mon {a, b, c} : D n) =
      pU {a, b, c} - pU {a, b} - pU {a, c} - pU {b, c} + pU {a} + pU {b} + pU {c} := by
  rw [mon, mob_three _ hab hac hbc, pU_empty, sub_zero]

/-- `R₈`: the monomial of two wires has order dividing `4`. -/
theorem four_mon_two {a b : Fin (n + 1)} (hab : a ≠ b) : (4 : ℕ) • (mon {a, b} : D n) = 0 := by
  have hv : a.val ≠ b.val := fun e => hab (Fin.ext e)
  have h8 := placed_R8 hv a.isLt b.isLt
  rw [← PU_two hab, ← PU_one, ← PU_one] at h8
  have e : (4 : ℕ) • (pU {a, b} : D n) = (4 : ℕ) • pU {b} + (4 : ℕ) • pU {a} := by
    apply D_ext
    rw [toQ_add, toQ_nsmul, toQ_nsmul, toQ_nsmul,
      toQ_pU (U := {a, b}) (le_trans Finset.card_le_two (by omega)),
      toQ_pU (U := {b}) (by simp), toQ_pU (U := {a}) (by simp)]
    exact h8
  rw [mon_two hab, smul_sub, smul_sub, e]
  abel

/-- `R₉`: the monomial of three wires has order dividing `2`. -/
theorem two_mon_three {a b c : Fin (n + 1)} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    (2 : ℕ) • (mon {a, b, c} : D n) = 0 := by
  have hv : ∀ {x y : Fin (n + 1)}, x ≠ y → x.val ≠ y.val := fun h e => h (Fin.ext e)
  have h9 := placed_R9 (hv hab) (hv hac) (hv hbc) a.isLt b.isLt c.isLt
  rw [← PU_three hab hac hbc, ← PU_two hab, ← PU_two hac, ← PU_two hbc, ← PU_one, ← PU_one,
    ← PU_one] at h9
  have c2 : ∀ {x y : Fin (n + 1)}, ({x, y} : Finset (Fin (n + 1))).card ≤ 3 :=
    le_trans Finset.card_le_two (by omega)
  have e : (2 : ℕ) • (pU {a, b, c} : D n) =
      (2 : ℕ) • pU {a, b} + (2 : ℕ) • pU {a, c} + (2 : ℕ) • pU {b, c} + (6 : ℕ) • pU {c} +
        (6 : ℕ) • pU {b} + (6 : ℕ) • pU {a} := by
    apply D_ext
    simp only [toQ_add, toQ_nsmul]
    rw [toQ_pU Finset.card_le_three, toQ_pU c2, toQ_pU c2, toQ_pU c2, toQ_pU (by simp),
      toQ_pU (by simp), toQ_pU (by simp)]
    exact h9
  have e8 : ∀ U : Finset (Fin (n + 1)), (8 : ℕ) • (pU U : D n) = 0 := eight_pU
  rw [mon_three hab hac hbc]
  simp only [smul_add, smul_sub]
  rw [e]
  calc _ = (8 : ℕ) • (pU {a} : D n) + (8 : ℕ) • pU {b} + (8 : ℕ) • pU {c} := by abel
    _ = 0 := by rw [e8, e8, e8]; simp


/-! ### The normal form of diagonal elements and its uniqueness -/

/-- The sets of one to three wires. -/
def Mon (n : ℕ) : Finset (Finset (Fin (n + 1))) :=
  Finset.univ.filter (fun S => 1 ≤ S.card ∧ S.card ≤ 3)

theorem mem_Mon {S : Finset (Fin (n + 1))} : S ∈ Mon n ↔ 1 ≤ S.card ∧ S.card ≤ 3 := by
  simp [Mon]

/-- The normal form `k • ω + ∑ κ_S • m S`. -/
noncomputable def canon (k : ℤ) (κ : Finset (Fin (n + 1)) → ℤ) : D n :=
  k • ωD + ∑ S ∈ Mon n, κ S • mon S

theorem canon_add (k k' : ℤ) (κ κ' : Finset (Fin (n + 1)) → ℤ) :
    canon k κ + canon k' κ' = canon (k + k') (fun S => κ S + κ' S) := by
  simp only [canon, add_smul, Finset.sum_add_distrib]; abel

theorem canon_neg (k : ℤ) (κ : Finset (Fin (n + 1)) → ℤ) :
    -canon k κ = canon (-k) (fun S => -κ S) := by
  simp only [canon, neg_add, neg_smul, Finset.sum_neg_distrib]

theorem pU_canon {U : Finset (Fin (n + 1))} (hU : U.card ≤ 3) :
    (pU U : D n) = canon 0 (fun S => if S ⊆ U then 1 else 0) := by
  rw [pU_eq_sum_mon, canon, zero_smul, zero_add]
  have hpow : U.powerset = insert ∅ ((Mon n).filter (· ⊆ U)) := by
    ext S
    simp only [Finset.mem_powerset, Finset.mem_insert, Finset.mem_filter, mem_Mon]
    constructor
    · intro h
      by_cases hS : S = ∅
      · exact Or.inl hS
      · refine Or.inr ⟨⟨?_, le_trans (Finset.card_le_card h) hU⟩, h⟩
        exact Finset.card_pos.2 (Finset.nonempty_iff_ne_empty.2 hS)
    · rintro (rfl | ⟨-, h⟩)
      · exact Finset.empty_subset _
      · exact h
  have hnot : ∅ ∉ (Mon n).filter (· ⊆ U) := by simp [mem_Mon]
  rw [hpow, Finset.sum_insert hnot, mon_empty, zero_add, Finset.sum_filter]
  refine Finset.sum_congr rfl (fun S _ => ?_)
  split_ifs <;> simp

theorem canon_exists (d : D n) : ∃ k κ, d = canon k κ := by
  suffices h : ∀ x (hx : x ∈ A n), ∃ k κ, (Additive.ofMul (⟨x, hx⟩ : A n) : D n) = canon k κ by
    obtain ⟨k, κ, e⟩ := h (toQ d) (toQ_mem d)
    exact ⟨k, κ, e⟩
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    rcases hy with rfl | ⟨U, hU, rfl⟩
    · refine ⟨1, fun _ => 0, ?_⟩
      simp only [canon, one_smul, zero_smul, Finset.sum_const_zero, add_zero]; rfl
    · refine ⟨0, fun S => if S ⊆ U then 1 else 0, ?_⟩
      rw [← pU_canon hU, pU, dif_pos hU]
      try rfl
  | one =>
    exact ⟨0, fun _ => 0, (by
      rw [canon, zero_smul, zero_add, Finset.sum_eq_zero (fun _ _ => zero_smul _ _)] :
        (0 : D n) = canon 0 (fun _ => 0))⟩
  | mul y z hy hz ihy ihz =>
    obtain ⟨k, κ, e1⟩ := ihy
    obtain ⟨k', κ', e2⟩ := ihz
    refine ⟨k + k', fun S => κ S + κ' S, ?_⟩
    rw [← canon_add, ← e1, ← e2]
    try rfl
  | inv y hy ih =>
    obtain ⟨k, κ, e⟩ := ih
    refine ⟨-k, fun S => -κ S, ?_⟩
    rw [← canon_neg, ← e]
    try rfl

theorem toZ8_ind (V : Finset (Fin (n + 1))) (i : Fin (n + 1)) :
    toZ8 (ind V i) = if i ∈ V then 1 else 0 := by
  by_cases h : i ∈ V <;> simp [ind, h, toZ8]

theorem prod_toZ8_ind (S V : Finset (Fin (n + 1))) :
    ∏ i ∈ S, toZ8 (ind V i) = if S ⊆ V then 1 else 0 := by
  by_cases h : S ⊆ V
  · rw [if_pos h]; exact Finset.prod_eq_one (fun i hi => by rw [toZ8_ind, if_pos (h hi)])
  · rw [if_neg h]
    obtain ⟨i, hi, hiV⟩ := Finset.not_subset.1 h
    exact Finset.prod_eq_zero hi (by rw [toZ8_ind, if_neg hiV])

theorem Φ_canon_ind (k : ℤ) (κ : Finset (Fin (n + 1)) → ℤ) (V : Finset (Fin (n + 1))) :
    Φ (canon k κ) (ind V) =
      k + ∑ S ∈ Mon n, ((κ S : ZMod 8) * (-2) ^ (S.card - 1)) * (if S ⊆ V then 1 else 0) := by
  rw [canon, Φ_add', Φ_zsmul, Φ_ωD, mul_one, Φ_sum]
  congr 1
  refine Finset.sum_congr rfl (fun S hS => ?_)
  rw [Φ_zsmul]
  rw [mem_Mon] at hS
  rw [Φ_mon hS.2 (fun h => by rw [h] at hS; simp at hS), prod_toZ8_ind]
  ring

theorem dvd_of_zmod8 {z : ℤ} {c : ℤ} (h : ((z : ZMod 8)) * (c : ZMod 8) = 0) : (8 : ℤ) ∣ z * c := by
  rw [← Int.cast_mul, ZMod.intCast_zmod_eq_zero_iff_dvd] at h
  exact_mod_cast h

/-- A normal form with zero phase is zero. -/
theorem canon_eq_zero {k : ℤ} {κ : Finset (Fin (n + 1)) → ℤ} (h : Φ (canon k κ) = 0) :
    canon k κ = 0 := by
  have hv : ∀ V, Φ (canon k κ) (ind V) = 0 := fun V => congrFun h _
  have hk : (k : ZMod 8) = 0 := by
    have := hv ∅
    rw [Φ_canon_ind] at this
    rw [Finset.sum_eq_zero (fun S hS => ?_), add_zero] at this
    · exact this
    · rw [mem_Mon] at hS
      have : ¬ S ⊆ ∅ := fun hs => by
        rw [Finset.subset_empty] at hs; rw [hs] at hS; simp at hS
      rw [if_neg this, mul_zero]
  have hκ : ∀ c, ∀ V ∈ Mon n, V.card = c → (κ V : ZMod 8) * (-2) ^ (V.card - 1) = 0 := by
    intro c
    induction c using Nat.strong_induction_on with
    | _ c ih =>
      intro V hV hc
      have := hv V
      rw [Φ_canon_ind, hk, zero_add, Finset.sum_eq_single V] at this
      · rwa [if_pos (Finset.Subset.refl V), mul_one] at this
      · intro S hS hSV
        by_cases hsub : S ⊆ V
        · have hlt : S.card < V.card := Finset.card_lt_card (Finset.ssubset_iff_subset_ne.2 ⟨hsub, hSV⟩)
          rw [ih S.card (by omega) S hS rfl, zero_mul]
        · rw [if_neg hsub, mul_zero]
      · intro h; exact absurd hV h
  -- each term vanishes
  have e1 : k • (ωD : D n) = 0 := by
    obtain ⟨j, rfl⟩ : (8 : ℤ) ∣ k := (ZMod.intCast_zmod_eq_zero_iff_dvd k 8).1 hk
    rw [mul_comm, mul_zsmul, show (8 : ℤ) • (ωD : D n) = (8 : ℕ) • ωD from by norm_cast,
      eight_ωD, zsmul_zero]
  have e2 : ∀ S ∈ Mon n, κ S • (mon S : D n) = 0 := by
    intro S hS
    have h := hκ S.card S hS rfl
    have hS' := (mem_Mon).1 hS
    rcases (show S.card = 1 ∨ S.card = 2 ∨ S.card = 3 by omega) with h1 | h2 | h3
    · rw [h1] at h
      simp only [Nat.sub_self, pow_zero, mul_one] at h
      obtain ⟨j, hj⟩ : (8 : ℤ) ∣ κ S := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 8).1 h
      rw [hj, mul_comm, mul_zsmul, show (8 : ℤ) • (mon S : D n) = (8 : ℕ) • mon S from by norm_cast,
        eight_mon, zsmul_zero]
    · rw [h2] at h
      have hd := dvd_of_zmod8 (z := κ S) (c := -2) (by simpa using h)
      obtain ⟨j, hj⟩ : (4 : ℤ) ∣ κ S := by omega
      obtain ⟨a, b, hab, rfl⟩ := Finset.card_eq_two.1 h2
      rw [hj, mul_comm, mul_zsmul, show (4 : ℤ) • (mon {a, b} : D n) = (4 : ℕ) • mon {a, b} from
        by norm_cast, four_mon_two hab, zsmul_zero]
    · rw [h3] at h
      have hd := dvd_of_zmod8 (z := κ S) (c := 4) (by norm_num at h ⊢; simpa using h)
      obtain ⟨j, hj⟩ : (2 : ℤ) ∣ κ S := by omega
      obtain ⟨a, b, c, hab, hac, hbc, rfl⟩ := Finset.card_eq_three.1 h3
      rw [hj, mul_comm, mul_zsmul, show (2 : ℤ) • (mon {a, b, c} : D n) = (2 : ℕ) • mon {a, b, c}
        from by norm_cast, two_mon_three hab hac hbc, zsmul_zero]
  rw [canon, e1, zero_add]
  exact Finset.sum_eq_zero e2

/-- **Completeness for diagonal circuits**: diagonal elements with the same
phase are equal in the theory. -/
theorem diag_complete {x y : Q (n + 1)} (hx : x ∈ A n) (hy : y ∈ A n) (h : paQ x = paQ y) :
    x = y := by
  set d : D n := Additive.ofMul ⟨x, hx⟩
  set e : D n := Additive.ofMul ⟨y, hy⟩
  obtain ⟨k, κ, hc⟩ := canon_exists (d - e)
  have hΦ : Φ (d - e) = 0 := by
    rw [map_sub]
    show (paQ x).ph - (paQ y).ph = 0
    rw [h, sub_self]
  rw [hc] at hΦ
  have := canon_eq_zero hΦ
  rw [← hc, sub_eq_zero] at this
  have := congrArg toQ this
  exact this

end Additive

