# Products of commuting involutions, and fans of `CNOT`s

`cprod g e = g₀^{e₀} * g₁^{e₁} * ⋯` for a family of pairwise commuting
involutions and exponents in `𝔽₂`.  Such products multiply exponentwise
(`cprod_mul_cprod`), are carried along homomorphisms (`map_cprod`), and
their phase-affine pairs are computed from those of the factors when these
are translations along fixed directions (`paQ_cprod`).

The two fans on `n + 1` wires:

* `fo c`, the fan-out: `CNOT`s from wire `0` to the wires `j + 1` with
  `c j = 1`; it adds `x₀ c` to the upper wires;
* `fi c`, the fan-in: `CNOT`s from the wires `j + 1` with `c j = 1` to wire
  `0`; it adds `c · x̄` to wire `0`.

`Lin n` is the subgroup generated by the `CNOT`s and swaps: its elements
are linear maps with no phase (`lin_pa`).
-/
import QCert.CNOTDihedral.Place

namespace QCert.CNOTDihedral

open Circuit

/-! ### Products of commuting involutions -/

section CProd

variable {G : Type*} [Group G]

/-- `cprod g e = g₀^{e₀} * g₁^{e₁} * ⋯`. -/
def cprod : {k : ℕ} → (Fin k → G) → (Fin k → Fin 2) → G
  | 0, _, _ => 1
  | _ + 1, g, e => g 0 ^ (e 0).val * cprod (fun j => g j.succ) (fun j => e j.succ)

theorem cprod_succ {k : ℕ} (g : Fin (k + 1) → G) (e : Fin (k + 1) → Fin 2) :
    cprod g e = g 0 ^ (e 0).val * cprod (fun j => g j.succ) (fun j => e j.succ) := rfl

theorem cprod_zero_exp' : ∀ {k : ℕ} (g : Fin k → G), cprod g (fun _ => 0) = 1
  | 0, _ => rfl
  | _ + 1, g => by
    rw [cprod_succ]; simp only [Fin.val_zero, pow_zero, one_mul]; exact cprod_zero_exp' _

theorem cprod_zero_exp {k : ℕ} (g : Fin k → G) : cprod g 0 = 1 := cprod_zero_exp' g

theorem cprod_comm {x : G} : ∀ {k : ℕ} {g : Fin k → G}, (∀ j, Commute x (g j)) →
    ∀ e : Fin k → Fin 2, Commute x (cprod g e)
  | 0, _, _, _ => Commute.one_right x
  | _ + 1, g, h, e => by
    rw [cprod_succ]
    exact ((h 0).pow_right _).mul_right (cprod_comm (fun j => h j.succ) _)

theorem pow_fin2_mul {x : G} (hx : x * x = 1) (a b : Fin 2) :
    x ^ a.val * x ^ b.val = x ^ (a + b).val := by
  fin_cases a <;> fin_cases b <;> simp [hx]

theorem cprod_mul_cprod : ∀ {k : ℕ} {g : Fin k → G}, (∀ i j, Commute (g i) (g j)) →
    (∀ j, g j * g j = 1) → ∀ e e' : Fin k → Fin 2, cprod g e * cprod g e' = cprod g (e + e')
  | 0, _, _, _, _, _ => by simp [cprod]
  | _ + 1, g, hc, hs, e, e' => by
    rw [cprod_succ, cprod_succ, cprod_succ]
    have c := cprod_comm (x := g 0 ^ (e' 0).val) (g := fun j => g j.succ)
      (fun j => (hc 0 j.succ).pow_left _) (fun j => e j.succ)
    rw [mul_assoc, ← mul_assoc (cprod _ _), ← c.eq, mul_assoc, ← mul_assoc,
      pow_fin2_mul (hs 0), cprod_mul_cprod (fun i j => hc i.succ j.succ) (fun j => hs j.succ)]
    rfl

theorem cprod_sq {k : ℕ} {g : Fin k → G} (hc : ∀ i j, Commute (g i) (g j))
    (hs : ∀ j, g j * g j = 1) (e : Fin k → Fin 2) : cprod g e * cprod g e = 1 := by
  rw [cprod_mul_cprod hc hs]
  have : e + e = 0 := by
    funext j; rcases fin2_cases (e j) with h | h <;> rw [Pi.add_apply, h, Pi.zero_apply] <;> decide
  rw [this, cprod_zero_exp]

theorem cprod_single : ∀ {k : ℕ} (g : Fin k → G) (i : Fin k), cprod g (Pi.single i 1) = g i
  | 0, _, i => i.elim0
  | k + 1, g, i => by
    rw [cprod_succ]
    refine Fin.cases ?_ (fun i => ?_) i
    · have : (fun j : Fin k => (Pi.single (0 : Fin (k + 1)) (1 : Fin 2) : Fin (k + 1) → Fin 2) j.succ) =
          0 := by
        funext j; simp [Pi.single_apply, Fin.succ_ne_zero]
      rw [this, cprod_zero_exp]; simp
    · have : (fun j : Fin k => (Pi.single i.succ (1 : Fin 2) : Fin (k + 1) → Fin 2) j.succ) =
          Pi.single i 1 := by
        funext j; simp [Pi.single_apply, Fin.succ_inj]
      rw [this, cprod_single]; simp [Pi.single_apply, (Fin.succ_ne_zero i).symm]

theorem map_cprod {H : Type*} [Group H] (φ : G →* H) :
    ∀ {k : ℕ} (g : Fin k → G) (e : Fin k → Fin 2), φ (cprod g e) = cprod (fun j => φ (g j)) e
  | 0, _, _ => map_one φ
  | _ + 1, g, e => by rw [cprod_succ, cprod_succ, map_mul, map_pow, map_cprod]

/-- A product of elements of a set closed under products lies in it. -/
theorem cprod_mem {S : Set G} (h1 : (1 : G) ∈ S) (hmul : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ S) :
    ∀ {k : ℕ} {g : Fin k → G}, (∀ j, g j ∈ S) → ∀ e : Fin k → Fin 2, cprod g e ∈ S
  | 0, _, _, _ => h1
  | _ + 1, g, hg, e => by
    rw [cprod_succ]
    refine hmul _ ?_ _ (cprod_mem h1 hmul (fun j => hg j.succ) _)
    rcases Fin.exists_fin_two.mp ⟨e 0, rfl⟩ with h | h <;> simp [h, h1, hg 0]

/-- Conjugating `x` by commuting involutions that each multiply it by a
correction commuting with everything. -/
theorem cprod_conj_affine {x : G} :
    ∀ {k : ℕ} {g y : Fin k → G}, (∀ i j, Commute (g i) (g j)) → (∀ j, g j * g j = 1) →
      (∀ j, g j * x * g j = x * y j) → (∀ i j, Commute (g i) (y j)) →
      ∀ e : Fin k → Fin 2, cprod g e * x * cprod g e = x * cprod y e
  | 0, _, _, _, _, _, _, _ => by simp [cprod]
  | _ + 1, g, y, hc, hs, hx, hy, e => by
    rw [cprod_succ, cprod_succ]
    have ih := cprod_conj_affine (k := _) (g := fun j => g j.succ) (y := fun j => y j.succ)
      (fun i j => hc i.succ j.succ) (fun j => hs j.succ) (fun j => hx j.succ)
      (fun i j => hy i.succ j.succ) (fun j => e j.succ)
    set C := cprod (fun j => g j.succ) (fun j => e j.succ)
    set D := cprod (fun j => y j.succ) (fun j => e j.succ)
    have cg : Commute (g 0 ^ (e 0).val) C :=
      cprod_comm (fun j => (hc 0 j.succ).pow_left _) _
    have cy : Commute (g 0 ^ (e 0).val) D :=
      cprod_comm (fun j => (hy 0 j.succ).pow_left _) _
    have e1 : g 0 ^ (e 0).val * C = C * g 0 ^ (e 0).val := cg.eq
    have e2 : g 0 ^ (e 0).val * D = D * g 0 ^ (e 0).val := cy.eq
    have hxa : g 0 ^ (e 0).val * x * g 0 ^ (e 0).val = x * y 0 ^ (e 0).val := by
      rcases fin2_cases (e 0) with h | h
      · simp [h]
      · simp only [h, Fin.val_one, pow_one]; exact hx 0
    calc g 0 ^ (e 0).val * C * x * (g 0 ^ (e 0).val * C)
        = g 0 ^ (e 0).val * C * x * (C * g 0 ^ (e 0).val) := by rw [← e1]
      _ = g 0 ^ (e 0).val * (C * x * C) * g 0 ^ (e 0).val := by group
      _ = g 0 ^ (e 0).val * x * (D * g 0 ^ (e 0).val) := by rw [ih]; group
      _ = g 0 ^ (e 0).val * x * (g 0 ^ (e 0).val * D) := by rw [← e2]
      _ = (g 0 ^ (e 0).val * x * g 0 ^ (e 0).val) * D := by group
      _ = x * (y 0 ^ (e 0).val * D) := by rw [hxa]; group

/-- Conjugation by `g`, as a homomorphism. -/
def conjH (g : G) : G →* G where
  toFun x := g * x * g⁻¹
  map_one' := by group
  map_mul' x y := by group

theorem conjH_apply (g x : G) : conjH g x = g * x * g⁻¹ := rfl

end CProd

/-! ### The linear subgroup -/

/-- The generators of linear circuits. -/
def linGens (n : ℕ) : Set (Q n) := {x | ∃ i, x = qCX i ∨ x = qSW i}

/-- Linear circuits: the subgroup generated by the `CNOT`s and the swaps. -/
noncomputable def Lin (n : ℕ) : Subgroup (Q n) := Subgroup.closure (linGens n)

theorem qCX_mem_Lin {n : ℕ} (i : ℕ) : (qCX i : Q n) ∈ Lin n :=
  Subgroup.subset_closure ⟨i, Or.inl rfl⟩

theorem qSW_mem_Lin {n : ℕ} (i : ℕ) : (qSW i : Q n) ∈ Lin n :=
  Subgroup.subset_closure ⟨i, Or.inr rfl⟩

theorem linGens_sq {n : ℕ} {x : Q n} (hx : x ∈ linGens n) : x * x = 1 := by
  obtain ⟨i, rfl | rfl⟩ := hx
  · exact qCX_sq i
  · exact qSW_sq i

theorem linGens_inv {n : ℕ} {x : Q n} (hx : x ∈ linGens n) : x⁻¹ = x :=
  inv_eq_of_mul_eq_one_left (linGens_sq hx)

theorem swp_mem_Lin {n : ℕ} (l : List ℕ) : (swp l : Q n) ∈ Lin n := by
  induction l with
  | nil => exact (Lin n).one_mem
  | cons i l ih => exact (Lin n).mul_mem (qSW_mem_Lin i) ih

theorem cc_mem_Lin {n : ℕ} (a b : ℕ) : (cc a b : Q n) ∈ Lin n :=
  (Lin n).mul_mem ((Lin n).mul_mem ((Lin n).inv_mem (swp_mem_Lin _)) (qCX_mem_Lin 0))
    (swp_mem_Lin _)

theorem sh_mem_Lin {n : ℕ} {h : Q n} (hh : h ∈ Lin n) : sh h ∈ Lin (n + 1) := by
  have : Lin n ≤ (Lin (n + 1)).comap sh := by
    refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨i, rfl | rfl⟩
    · exact qCX_mem_Lin (i + 1)
    · exact qSW_mem_Lin (i + 1)
  exact this hh

theorem cprod_mem_Lin {n k : ℕ} {g : Fin k → Q n} (hg : ∀ j, g j ∈ Lin n) (e : Fin k → Fin 2) :
    cprod g e ∈ Lin n :=
  cprod_mem (S := (Lin n : Set (Q n))) (Lin n).one_mem (fun _ hx _ hy => (Lin n).mul_mem hx hy)
    hg e

/-- A phase-affine pair with no phase and an additive map. -/
def IsLinPA {n : ℕ} (p : PA n) : Prop := p.ph = 0 ∧ ∀ s t, p.f (s + t) = p.f s + p.f t

theorem IsLinPA.mul {n : ℕ} {p q : PA n} (hp : IsLinPA p) (hq : IsLinPA q) : IsLinPA (p * q) :=
  ⟨by funext s; simp [hp.1, hq.1], fun s t => by simp [hp.2, hq.2]⟩

theorem lin_pa {n : ℕ} {a : Q n} (ha : a ∈ Lin n) : IsLinPA (paQ a) := by
  have gen : ∀ x ∈ linGens n, IsLinPA (paQ x) := by
    rintro _ ⟨i, rfl | rfl⟩
    · rw [paQ_qCX]
      have key : ∀ x y a b e : Fin 2, x + y + (a + b) * e = x + a * e + (y + b * e) := by decide
      exact ⟨rfl, fun s t => by
        funext j; simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, bit_add]; exact key _ _ _ _ _⟩
    · rw [paQ_qSW]
      exact ⟨rfl, fun s t => rfl⟩
  induction ha using Subgroup.closure_induction'' with
  | mem x hx => exact gen x hx
  | inv_mem x hx => rw [linGens_inv hx]; exact gen x hx
  | one => exact ⟨rfl, fun s t => rfl⟩
  | mul x y _ _ hx hy => rw [map_mul]; exact hx.mul hy

/-! ### Sums of bits -/

/-- The dot product of two states. -/
def dot {n : ℕ} (r s : State 2 n) : Fin 2 := ∑ j, r j * s j

theorem dot_cons {n : ℕ} (a b : Fin 2) (r s : State 2 n) :
    dot (Fin.cons a r : State 2 (n + 1)) (Fin.cons b s) = a * b + dot r s := by
  simp [dot, Fin.sum_univ_succ]

theorem dot_succ {n : ℕ} (r s : State 2 (n + 1)) : dot r s = r 0 * s 0 + dot (Fin.tail r) (Fin.tail s) := by
  simp [dot, Fin.sum_univ_succ, Fin.tail]

theorem bit_sum {n : ℕ} {ι : Type*} (S : Finset ι) (f : ι → State 2 n) (a : ℕ) :
    bit (∑ i ∈ S, f i) a = ∑ i ∈ S, bit (f i) a := by
  classical
  induction S using Finset.induction_on with
  | empty => simp [bit_zero]
  | insert x S hx ih => rw [Finset.sum_insert hx, Finset.sum_insert hx, bit_add, ih]

/-- The pair of a product of translations `s ↦ s + L s • u` whose
functionals `L` vanish on all the directions `u`. -/
theorem paQ_cprod {n : ℕ} : ∀ {k : ℕ} (g : Fin k → Q n) (w : Fin k → ℕ) (u : Fin k → State 2 n),
    (∀ j, paQ (g j) = ⟨fun s => s + bit s (w j) • u j, 0⟩) →
    (∀ i j, bit (u j) (w i) = 0) → ∀ e : Fin k → Fin 2,
    paQ (cprod g e) = ⟨fun s => s + ∑ j, (e j * bit s (w j)) • u j, 0⟩
  | 0, _, _, _, _, _, _ => by
    refine PA.ext' (fun s => ?_) (fun s => ?_) <;> simp [cprod]
  | _ + 1, g, w, u, hg, hu, e => by
    rw [cprod_succ, map_mul, paQ_cprod (fun j => g j.succ) (fun j => w j.succ)
      (fun j => u j.succ) (fun j => hg j.succ) (fun i j => hu i.succ j.succ)]
    have h0 : paQ (g 0 ^ (e 0).val) = ⟨fun s => s + (e 0 * bit s (w 0)) • u 0, 0⟩ := by
      rcases Fin.exists_fin_two.mp ⟨e 0, rfl⟩ with h | h
      · rw [h]; refine PA.ext' (fun s => ?_) (fun s => ?_) <;> simp
      · simp only [h, Fin.val_one, pow_one]; rw [hg 0]
        refine PA.ext' (fun s => ?_) (fun s => ?_) <;> simp
    rw [h0]
    refine PA.ext' (fun s => ?_) (fun s => ?_)
    · simp only [PA.mul_f, Function.comp_apply, Fin.sum_univ_succ]
      have : bit (s + ∑ j : Fin _, (e j.succ * bit s (w j.succ)) • u j.succ) (w 0) = bit s (w 0) := by
        rw [bit_add, bit_sum]
        simp [bit_smul, hu]
      rw [this]; abel
    · simp

/-! ### The fans -/

/-- The fan-out on `n + 1` wires: `CNOT`s from wire `0` to the wires `j + 1`
with `c j = 1`. -/
noncomputable def fo {n : ℕ} (c : State 2 n) : Q (n + 1) := cprod (fun j : Fin n => cc 0 (j.val + 1)) c

/-- The fan-in on `n + 1` wires: `CNOT`s from the wires `j + 1` with
`c j = 1` to wire `0`. -/
noncomputable def fi {n : ℕ} (c : State 2 n) : Q (n + 1) := cprod (fun j : Fin n => cc (j.val + 1) 0) c

theorem fo_comm {n : ℕ} (i j : Fin n) : Commute (cc 0 (i.val + 1) : Q (n + 1)) (cc 0 (j.val + 1)) := by
  by_cases h : i = j
  · rw [h]
  · exact cc_comm_ctrl (by omega) (by omega) (by simp [Fin.ext_iff] at h; omega) (by omega)
      (by omega) (by omega)

theorem fi_comm {n : ℕ} (i j : Fin n) : Commute (cc (i.val + 1) 0 : Q (n + 1)) (cc (j.val + 1) 0) := by
  by_cases h : i = j
  · rw [h]
  · exact cc_comm_tgt (by simp [Fin.ext_iff] at h; omega) (by omega) (by omega) (by omega)
      (by omega) (by omega)

theorem fo_mul {n : ℕ} (c c' : State 2 n) : (fo c : Q (n + 1)) * fo c' = fo (c + c') :=
  cprod_mul_cprod fo_comm (fun _ => cc_sq _ _) c c'

theorem fi_mul {n : ℕ} (c c' : State 2 n) : (fi c : Q (n + 1)) * fi c' = fi (c + c') :=
  cprod_mul_cprod fi_comm (fun _ => cc_sq _ _) c c'

@[simp] theorem fo_zero {n : ℕ} : (fo 0 : Q (n + 1)) = 1 := cprod_zero_exp _
@[simp] theorem fi_zero {n : ℕ} : (fi 0 : Q (n + 1)) = 1 := cprod_zero_exp _

theorem fo_mem_Lin {n : ℕ} (c : State 2 n) : fo c ∈ Lin (n + 1) :=
  cprod_mem_Lin (fun _ => cc_mem_Lin _ _) c

theorem fi_mem_Lin {n : ℕ} (c : State 2 n) : fi c ∈ Lin (n + 1) :=
  cprod_mem_Lin (fun _ => cc_mem_Lin _ _) c

theorem sum_ei_succ {n : ℕ} (c : State 2 n) :
    ∑ j : Fin n, c j • (ei (j.val + 1) : State 2 (n + 1)) = Fin.cons 0 c := by
  funext k
  refine Fin.cases ?_ (fun k => ?_) k
  · simp [Finset.sum_apply, ei]
  · rw [Finset.sum_apply, Finset.sum_eq_single k]
    · simp [ei]
    · intro j _ hj
      have hne : (k : ℕ) ≠ (j : ℕ) := fun h => hj (Fin.ext h).symm
      simp [ei, hne]
    · simp

theorem paQ_fo {n : ℕ} (c : State 2 n) :
    paQ (fo c : Q (n + 1)) = ⟨fun s => s + bit s 0 • Fin.cons 0 c, 0⟩ := by
  rw [fo, paQ_cprod _ (fun _ => 0) (fun j => ei (j.val + 1))
    (fun j => paQ_cc (by omega) (by omega) (by omega)) (fun i j => by simp [bit_ei])]
  refine PA.ext' (fun s => ?_) (fun s => rfl)
  simp only
  rw [← sum_ei_succ, Finset.smul_sum]
  congr 1
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [smul_smul, mul_comm]

theorem bit_fi_zero {n : ℕ} (c : State 2 n) (s : State 2 (n + 1)) :
    bit ((paQ (fi c : Q (n + 1))).f s) 0 = bit s 0 + dot c (Fin.tail s) := by
  rw [fi, paQ_cprod _ (fun j => j.val + 1) (fun _ => ei 0)
    (fun j => paQ_cc (by omega) (by omega) (by omega)) (fun i j => by simp [bit_ei])]
  simp only
  rw [bit_add, bit_sum]
  congr 1
  simp only [bit_smul, bit_ei, dot, Fin.tail]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  simp [bit, Fin.succ]

end QCert.CNOTDihedral
