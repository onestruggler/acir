    .sem 1 1 [tg .box [1] [(4, true), (0, true), (2, false)]] 3,
    .rw 1 1 true,
    .sem 1 1 [tg .box [3] [(4, true), (2, false), (0, true)]] 1,
    .sem 2 1 [tg .hg [4, 0] [(1, true), (2, false)]] 3,
    .rw 2 0 false,
    .sem 2 1 [tg .hg [3, 0] [(2, false), (1, true)]] 4,
    .sem 3 1 [tg .box [1] [(4, true), (0, true), (2, false)]] 3,
    .rw 3 1 true,
    .sem 3 1 [tg .box [3] [(4, true), (2, false), (0, true)]] 1,
    .sem 3 2 [tg .xz [0] [(3, true), (2, true)], tg .box [3] [(4, true), (2, false), (0, true)]] 1,
    .sem 2 2 [tg .xz [0] [(3, true), (2, true)], tg .hg [3, 0] [(2, false), (1, true)]] 4,
