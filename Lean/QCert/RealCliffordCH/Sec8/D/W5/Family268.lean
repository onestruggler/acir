    .rw 1 0 true,
    .sem 1 1 [tg .hg [4, 0] [(2, false), (1, true)]] 3,
    .sem 2 1 [tg .box [3] [(4, true), (0, true), (2, false)]] 1,
    .rw 2 1 false,
    .sem 2 1 [tg .box [1] [(4, true), (2, false), (0, true)]] 3,
    .sem 3 1 [tg .hg [3, 0] [(1, true), (2, false)]] 4,
    .rw 3 0 true,
    .sem 3 1 [tg .hg [4, 0] [(2, false), (1, true)]] 3,
    .sem 4 1 [tg .box [3] [(4, true), (0, true), (2, false)]] 1,
    .rw 4 1 false,
    .sem 4 1 [tg .box [1] [(4, true), (2, false), (0, true)]] 3,
    .sem 1 4 [tg .zx [0] [(4, true), (2, false), (1, true)]] 3] = true := by
  decide +kernel

theorem t261Base0 (ih : IH 5) : Derivable (theory 5) (wcT 5 L261Base0) (wcT 5 R261Base0) :=
