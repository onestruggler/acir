/-- (344) on four wires, every colour, the colourings differing on wire `3`. -/
theorem core344_4 (ih : IH 4) (a b c : Bool) :
    Comm 4 (mc 4 .hg [0, 1] (SE.ctl 4 [(3, a), (2, b)] false))
      (mc 4 .hg [1, 2] (SE.ctl 4 [(3, !a), (0, c)] false)) := by
  cases a <;> cases b <;> cases c
  · exact tL344b0f0f3 ih
  · exact tL344b0f3 ih
  · exact tL344b1f0f3 ih
  · exact tL344b1f3 ih
  · exact tL344b0f0 ih
  · exact tL344b0 ih
  · exact tL344b1f0 ih
  · exact tL344b1 ih

/-- (344) on four wires, in the form of the interface `D.eq344`. -/
theorem eq344_4 (ih : IH 4) (x y : ℕ → Bool) (hxy : DiffOn 3 4 x y) (c₁ c₂ : Bool) :
    Comm 4 (mc 4 .hg [0, 1] (ctlOr (ctlAt 2 c₁) (colOn 3 4 x)))
      (mc 4 .hg [1, 2] (ctlOr (ctlAt 0 c₂) (colOn 3 4 y))) := by
  have hx : mc 4 .hg [0, 1] (ctlOr (ctlAt 2 c₁) (colOn 3 4 x)) =
      mc 4 .hg [0, 1] (SE.ctl 4 [(3, x 3), (2, c₁)] false) := by
    apply Net.mc_congr
    intro i hi
    interval_cases i <;> simp [colOn, ctlOr, ctlAt, SE.ctl, List.lookup_cons]
  have hy : mc 4 .hg [1, 2] (ctlOr (ctlAt 0 c₂) (colOn 3 4 y)) =
      mc 4 .hg [1, 2] (SE.ctl 4 [(3, y 3), (0, c₂)] false) := by
    apply Net.mc_congr
    intro i hi
    interval_cases i <;> simp [colOn, ctlOr, ctlAt, SE.ctl, List.lookup_cons]
  have h3 : y 3 = !x 3 := by
    obtain ⟨i, hi, hiN, hne⟩ := hxy
    obtain rfl : i = 3 := by omega
    cases h : x 3 <;> cases h' : y 3 <;> simp_all
  rw [hx, hy, h3]
  exact core344_4 ih (x 3) c₁ c₂

