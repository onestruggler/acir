/-- (342) on four wires, every colour, the colourings differing on wire `3`. -/
theorem core342_4 (ih : IH 4) (a b c : Bool) :
    Comm 4 (mc 4 .hg [0, 1] (SE.ctl 4 [(3, a), (2, b)] false))
      (mc 4 .hg [0, 2] (SE.ctl 4 [(3, !a), (1, c)] false)) := by
  cases a <;> cases b <;> cases c
  · exact tL342b00f3 ih
  · exact tL342b01f3 ih
  · exact tL342b10f3 ih
  · exact tL342b11f3 ih
  · exact tL342b00 ih
  · exact tL342b01 ih
  · exact tL342b10 ih
  · exact tL342b11 ih

/-- (342) on four wires, in the form of the interface `D.eq342`. -/
theorem eq342_4 (ih : IH 4) (x y : ℕ → Bool) (hxy : DiffOn 3 4 x y) (c₁ c₂ : Bool) :
    Comm 4 (mc 4 .hg [0, 1] (ctlOr (ctlAt 2 c₁) (colOn 3 4 x)))
      (mc 4 .hg [0, 2] (ctlOr (ctlAt 1 c₂) (colOn 3 4 y))) := by
  have hx : mc 4 .hg [0, 1] (ctlOr (ctlAt 2 c₁) (colOn 3 4 x)) =
      mc 4 .hg [0, 1] (SE.ctl 4 [(3, x 3), (2, c₁)] false) := by
    apply Net.mc_congr
    intro i hi
    interval_cases i <;> simp [colOn, ctlOr, ctlAt, SE.ctl, List.lookup_cons]
  have hy : mc 4 .hg [0, 2] (ctlOr (ctlAt 1 c₂) (colOn 3 4 y)) =
      mc 4 .hg [0, 2] (SE.ctl 4 [(3, y 3), (1, c₂)] false) := by
    apply Net.mc_congr
    intro i hi
    interval_cases i <;> simp [colOn, ctlOr, ctlAt, SE.ctl, List.lookup_cons]
  have h3 : y 3 = !x 3 := by
    obtain ⟨i, hi, hiN, hne⟩ := hxy
    obtain rfl : i = 3 := by omega
    cases h : x 3 <;> cases h' : y 3 <;> simp_all
  rw [hx, hy, h3]
  exact core342_4 ih (x 3) c₁ c₂

