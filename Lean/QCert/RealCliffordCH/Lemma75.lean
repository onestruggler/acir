# Lemma 7.5: the decoding respects the equations of Figure 6

Generated by a search script.  For every equation of Figure 6 (Hadamard-Π's
transcription, `QCert.HadamardPi.Fig6`) at every choice of indices in
`0, …, 3`, the decoded equation is derived in the theory: most directly, by
a run of rewriting steps over the table of auxiliary equations (`auxLib`);
the others by rewriting words over `𝒢₄` with decoded equations already
proved (as Proposition 4.8 and Lemma A.1 of the paper derive Figure 6 from
Figure 7).  (d4) has no instance on four indices.
-/
import QCert.RealCliffordCH.AuxEq

namespace QCert.RealCliffordCH.Two

open Circuit

/-- The decoding of Definition 7.3 as words of letters. -/
def decLt : G4 → List Lt
  | .Z a => match a.val with
    | 0 => [.h, .z, .h, .H, .Z, .H, .C, .h, .z, .h, .H, .Z, .H]
    | 1 => [.H, .Z, .H, .C, .H, .Z, .H]
    | 2 => [.h, .z, .h, .C, .h, .z, .h]
    | _ => [.C]
  | .X a b _ => match a.val, b.val with
    | 0, 1 => [.H, .Z, .H, .h, .C, .h, .H, .Z, .H]
    | 0, 2 => [.h, .z, .h, .S, .h, .C, .h, .S, .h, .z, .h]
    | 0, 3 => [.H, .Z, .H, .h, .z, .h, .S]
    | 1, 2 => [.S]
    | 1, 3 => [.S, .h, .C, .h, .S]
    | _, _ => [.h, .C, .h]
  | .H a b _ => match a.val, b.val with
    | 0, 1 => [.H, .Z, .H, .K, .H, .Z, .H]
    | 0, 2 => [.h, .z, .h, .S, .K, .S, .h, .z, .h]
    | 0, 3 => [.S, .h, .C, .h, .S, .H, .Z, .H, .K, .H, .Z, .H, .S, .h, .C, .h, .S]
    | 1, 2 => [.h, .C, .h, .S, .K, .S, .h, .C, .h]
    | 1, 3 => [.S, .K, .S]
    | _, _ => [.K]


set_option maxRecDepth 8000 in
theorem toC_decLt (g : G4) : toC (decLt g) = dec g := by
  rcases g with ⟨a⟩ | ⟨a, b, hab⟩ | ⟨a, b, hab⟩ <;> fin_cases a <;> (try fin_cases b) <;> rfl

/-- The decoding of a list of generators. -/
def decList (u : List G4) : List Lt := u.flatMap decLt

/-- Two words over `𝒢₄` have decodings equal in the theory. -/
def EG (u v : List G4) : Prop := E (decList u) (decList v)

theorem EG.trans {a b c : List G4} (h : EG a b) (h' : EG b c) : EG a c := E.trans h h'
theorem EG.symm {a b : List G4} (h : EG a b) : EG b a := E.symm h

/-- A decoded equation inside a context. -/
theorem EG.rw {w w' : List G4} (p q : List G4) {a b : List G4} (h : EG a b)
    (hw : p ++ a ++ q = w) (hw' : p ++ b ++ q = w') : EG w w' := by
  subst hw hw'
  unfold EG decList at *
  simp only [List.flatMap_append]
  exact ((E.refl _).append h).append (E.refl _)

theorem decW_toList (w : Word G4) : decW w = toC (decList w.toList) := by
  induction w using FreeMonoid.inductionOn' with
  | one => rfl
  | mul_of g w ih =>
    rw [map_mul, ih, FreeMonoid.toList_mul, FreeMonoid.toList_of]
    simp only [decList, List.singleton_append, List.flatMap_cons, toC_append, toC_decLt]
    rfl

theorem EG.derivable {u v : Word G4} (h : EG u.toList v.toList) :
    Derivable (theory 2) (decW u) (decW v) := by
  rw [decW_toList, decW_toList]; exact E.derivable h

/-- Every generator decodes to an involution (Decoding Equations (a1)–(a3)). -/
theorem inv_g : ∀ g : G4, EG [g, g] []
  | .Z a => by have h := dec_a1 a; rw [decW_toList, decW_toList] at h; exact h
  | .X a b hab => by have h := dec_a2 a b hab; rw [decW_toList, decW_toList] at h; exact h
  | .H a b hab => by have h := dec_a3 a b hab; rw [decW_toList, decW_toList] at h; exact h

