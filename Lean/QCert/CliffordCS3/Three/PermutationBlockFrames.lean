def horizontal_frame : List (Fin 7) := [4, 5, 6, 4, 5]
def horizontal_stabilizer : List (Fin 7) := [4]

theorem horizontal_bound : ∀ d ∈ horizontal_stabilizer, d.val < 5 := by decide

theorem horizontal : Derivable Rel (tokens (horizontal_frame ++ horizontal_stabilizer)) (W.CX12) := by
  have hr : Derivable Rel (W.CX12) (NW [2, 6]) := by
    simpa only [NW, FreeMonoid.ofList_append, map_mul, mul_assoc] using (gate_CX12)
  exact (tokens_eq (horizontal_frame ++ horizontal_stabilizer)).trans
    ((derive [2, 3, 4, 5, 4, 3, 2, 2, 3, 4, 5, 6, 5, 4, 3, 2, 3, 4, 5, 4, 3, 2, 2, 2, 3, 4, 5, 4, 3, 2] [2, 6] [(32, 9768592927038726702458422842644479539905414215307978054613165570926269854102672822264731078487294045034175362404575055491737643559591897767607497558539489283254223007911681793724357187094502099557841945401604797124156989874419596385107973), (9, 57849769928568798587279010534123394420607372598321122216296453)] (by decide +kernel)).trans hr.symm)


