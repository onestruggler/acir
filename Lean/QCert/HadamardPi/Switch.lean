/-- A switch word for every pair of the window and both parities. -/
theorem switch4 (j₁ j₂ : Fin 4) (h : j₁ < j₂) (par : ℤ) (hpar : par = 0 ∨ par = 1) :
    Nonempty (Switch par j₁ j₂ h) := by
  fin_cases j₁ <;> fin_cases j₂ <;> (try exact absurd h (by decide)) <;>
    first
    | (rcases hpar with rfl | rfl; exacts [⟨sw01_0⟩, ⟨sw01_1⟩])
    | (rcases hpar with rfl | rfl; exacts [⟨sw23_0⟩, ⟨sw23_1⟩])
    | (rcases hpar with rfl | rfl; exacts [⟨sw02_0⟩, ⟨sw02_1⟩])
    | (rcases hpar with rfl | rfl; exacts [⟨sw13_0⟩, ⟨sw13_1⟩])
    | (rcases hpar with rfl | rfl; exacts [⟨sw03_0⟩, ⟨sw03_1⟩])
    | (rcases hpar with rfl | rfl; exacts [⟨sw12_0⟩, ⟨sw12_1⟩])

end QCert.HadamardPi
