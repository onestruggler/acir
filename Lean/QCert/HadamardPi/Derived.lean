theorem c20 : Derivable Fig6 (ofList ([hL 0 1, hL 0 2, hL 1 3, hL 0 1, zL 0, zL 1, hL 0 2, hL 1 3] : List (Gen 4)))
    (ofList [hL 0 2, hL 1 3, hL 0 1, zL 0, zL 1, hL 0 2, hL 1 3, hL 0 1]) :=
