# Derivations up to a phase

Toward Theorem 4.4.  `PEq n w v` says that `w` and `v` are derivably equal
up to a power of the scalar `-ω`.  It is a congruence (`PEq.mul`), and the
completeness argument works with it throughout: the scalar commutes with
everything (`negω_comm`), and powers of it are determined by their value
(`negω_pow_derives`), so the phase is recovered at the end
(`derives_of_peq`).

**Projective completeness** (`pcomplete`): with completeness on `n` wires,
two circuits that act alike on the Pauli generators `Xⱼ`, `Zⱼ` are equal up
to a phase.  Conjugation is multiplicative on Pauli data and every Pauli is
a product of the generators and a phase (`PD.Gen.all`), so the circuits act
alike on every Pauli, and by Corollary B.3 their operators differ by a power
of `-ω`.
-/
import QCert.QutritClifford.Locality

namespace QCert.QutritClifford

open Matrix

/-- Derivable equality of `n`-wire circuits under the rules of Figure 1. -/
abbrev Der (n : ℕ) (w v : Circ n) : Prop := Derives (Padded Rule) n w v

/-- Derivable equality up to a power of `-ω`. -/
def PEq (n : ℕ) (w v : Circ n) : Prop := ∃ t : ℕ, Der n w (v * negω ^ t)

namespace PEq

variable {n : ℕ}

theorem of_der {w v : Circ n} (h : Der n w v) : PEq n w v :=
  ⟨0, by rw [pow_zero, mul_one]; exact h⟩

@[refl] theorem refl (w : Circ n) : PEq n w w := of_der (Derivable.refl w)

theorem of_eq {w v : Circ n} (h : w = v) : PEq n w v := h ▸ refl w

theorem negω_absorb (w : Circ n) (t : ℕ) : PEq n (w * negω ^ t) w := ⟨t, Derivable.refl _⟩

theorem trans {u v w : Circ n} (h₁ : PEq n u v) (h₂ : PEq n v w) : PEq n u w := by
  obtain ⟨s, hs⟩ := h₁
  obtain ⟨t, ht⟩ := h₂
  refine ⟨t + s, hs.trans ?_⟩
  rw [pow_add, ← mul_assoc]
  exact ht.mul (Derivable.refl _)

theorem symm {v w : Circ n} (h : PEq n v w) : PEq n w v := by
  obtain ⟨t, ht⟩ := h
  have h1 : Der n (w * negω ^ t * negω ^ (6 - t % 6)) w := by
    rw [mul_assoc, ← pow_add]
    refine ((Derivable.refl w).mul (negω_pow_mod n _)).trans ?_
    have : (t + (6 - t % 6)) % 6 = 0 := by omega
    rw [this, pow_zero, mul_one]
  exact ⟨6 - t % 6, ((ht.mul (Derivable.refl _)).trans h1).symm⟩

theorem mul {w w' v v' : Circ n} (h₁ : PEq n w w') (h₂ : PEq n v v') :
    PEq n (w * v) (w' * v') := by
  obtain ⟨s, hs⟩ := h₁
  obtain ⟨t, ht⟩ := h₂
  refine ⟨s + t, (hs.mul ht).trans ?_⟩
  rw [pow_add, mul_assoc, mul_assoc]
  refine (Derivable.refl w').mul ?_
  have h3 := (negω_pow_comm s v').mul (Derivable.refl (negω ^ t : Circ n))
  simpa only [mul_assoc] using h3
where
  negω_pow_comm (s : ℕ) (v : Circ n) : Der n (negω ^ s * v) (v * negω ^ s) := by
    induction s with
    | zero => rw [pow_zero, one_mul, mul_one]
    | succ s ih =>
      rw [pow_succ, mul_assoc]
      refine ((Derivable.refl _).mul (negω_comm v)).trans ?_
      rw [← mul_assoc, ← mul_assoc]
      exact (ih.mul (Derivable.refl _))

theorem mul_left {w w' : Circ n} (u : Circ n) (h : PEq n w w') : PEq n (u * w) (u * w') :=
  (refl u).mul h

theorem mul_right {w w' : Circ n} (u : Circ n) (h : PEq n w w') : PEq n (w * u) (w' * u) :=
  h.mul (refl u)

theorem negω_left (w : Circ n) : PEq n (negω * w) w := by
  have := negω_absorb w 1
  rw [pow_one] at this
  exact (of_der (negω_comm w)).trans this

theorem pad (m : ℕ) {k : ℕ} {w v : Circ k} (h : PEq k w v) :
    PEq (m + k) (Circuit.pad m w) (Circuit.pad m v) := by
  obtain ⟨t, ht⟩ := h
  refine ⟨t, ?_⟩
  have := derives_pad m ht
  rwa [map_mul, map_pow, show Circuit.pad m (negω : Circ k) = (negω : Circ (m + k)) from rfl]
    at this

theorem shift {w v : Circ n} (h : PEq n w v) : PEq (n + 1) (Circuit.shift w) (Circuit.shift v) := by
  obtain ⟨t, ht⟩ := h
  refine ⟨t, ?_⟩
  have := derives_shift ht
  rw [map_mul, map_pow] at this
  refine this.trans ((Derivable.refl _).mul (derives_pow up_negω t))

end PEq

/-- Equality up to a phase becomes equality when the operators agree. -/
theorem der_of_peq {n : ℕ} {w v : Circ n} (h : PEq n w v) (hs : sem n w = sem n v) :
    Der n w v := by
  obtain ⟨t, ht⟩ := h
  have e := congrArg Subtype.val ((sound ht).symm.trans hs)
  rw [map_mul, Submonoid.coe_mul, sem_negω_pow, mul_smul_comm, mul_one] at e
  have hu := (sem_unitary v).1
  have e2 : (-ωℂ) ^ t • (1 : Op ℂ 3 n) = 1 := by
    have := congrArg (fun A => star (sem n v : Op ℂ 3 n) * A) e
    simp only [mul_smul_comm, hu] at this
    exact this
  have e3 := congrFun (congrFun e2 0) 0
  simp only [smul_apply, one_apply_eq, smul_eq_mul, mul_one] at e3
  have hν := negω_pow_derives n (a := t) (b := 0) (by rw [e3, pow_zero])
  rw [pow_zero] at hν
  have := ht.trans ((Derivable.refl v).mul hν)
  rwa [mul_one] at this

/-! ### Pauli data are generated by `Xⱼ`, `Zⱼ` and phases -/

namespace PD

/-- The Pauli data generated by the `X`s, the `Z`s and phases. -/
inductive Gen {n : ℕ} : PD n → Prop
  | one : Gen PD.one
  | scale (d : Fin 3) {P : PD n} : Gen P → Gen (P.scale d)
  | mul {P Q : PD n} : Gen P → Gen Q → Gen (P.mul Q)
  | x (j : Fin n) : Gen (PD.Xat j)
  | z (j : Fin n) : Gen (PD.Zat j)

variable {n : ℕ}

theorem gen_xs (j : Fin n) : ∀ k : Fin 3, Gen (⟨0, Pi.single j k, 0⟩ : PD n) := by
  intro k
  fin_cases k
  · have : (⟨0, Pi.single j (0 : Fin 3), 0⟩ : PD n) = PD.one := by
      ext <;> simp [PD.one]
    simp only [Fin.zero_eta]; rw [this]; exact Gen.one
  · exact Gen.x j
  · have : (⟨0, Pi.single j (2 : Fin 3), 0⟩ : PD n) = (PD.Xat j).mul (PD.Xat j) := by
      ext i
      · simp [PD.mul, PD.Xat]
      · simp only [PD.mul, PD.Xat, Pi.add_apply]
        by_cases h : i = j
        · subst h; simp
        · simp [Pi.single_eq_of_ne h]
      · simp [PD.mul, PD.Xat]
    simp only [Fin.reduceFinMk]; rw [this]; exact Gen.mul (Gen.x j) (Gen.x j)

theorem gen_zs (j : Fin n) : ∀ k : Fin 3, Gen (⟨0, 0, Pi.single j k⟩ : PD n) := by
  intro k
  fin_cases k
  · have : (⟨0, 0, Pi.single j (0 : Fin 3)⟩ : PD n) = PD.one := by
      ext <;> simp [PD.one]
    simp only [Fin.zero_eta]; rw [this]; exact Gen.one
  · exact Gen.z j
  · have : (⟨0, 0, Pi.single j (2 : Fin 3)⟩ : PD n) = (PD.Zat j).mul (PD.Zat j) := by
      ext i
      · simp [PD.mul, PD.Zat]
      · simp [PD.mul, PD.Zat]
      · simp only [PD.mul, PD.Zat, Pi.add_apply]
        by_cases h : i = j
        · subst h; simp
        · simp [Pi.single_eq_of_ne h]
    simp only [Fin.reduceFinMk]; rw [this]; exact Gen.mul (Gen.z j) (Gen.z j)

/-- The `X` part of `a` on the wires of `S`. -/
def xpart (a : Fin n → Fin 3) (S : Finset (Fin n)) : PD n :=
  ⟨0, fun j => if j ∈ S then a j else 0, 0⟩

/-- The `Z` part of `b` on the wires of `S`. -/
def zpart (b : Fin n → Fin 3) (S : Finset (Fin n)) : PD n :=
  ⟨0, 0, fun j => if j ∈ S then b j else 0⟩

theorem gen_xpart (a : Fin n → Fin 3) (S : Finset (Fin n)) : Gen (xpart a S) := by
  induction S using Finset.induction_on with
  | empty =>
    have : xpart a ∅ = PD.one := by ext <;> simp [xpart, PD.one]
    rw [this]; exact Gen.one
  | insert j S hj ih =>
    have : xpart a (insert j S) = (xpart a S).mul ⟨0, Pi.single j (a j), 0⟩ := by
      ext i
      · simp [xpart, PD.mul]
      · simp only [xpart, PD.mul, Pi.add_apply, Finset.mem_insert]
        by_cases h : i = j
        · subst h; simp [hj]
        · simp [h]
      · simp [xpart, PD.mul]
    rw [this]; exact Gen.mul ih (gen_xs j _)

theorem gen_zpart (b : Fin n → Fin 3) (S : Finset (Fin n)) : Gen (zpart b S) := by
  induction S using Finset.induction_on with
  | empty =>
    have : zpart b ∅ = PD.one := by ext <;> simp [zpart, PD.one]
    rw [this]; exact Gen.one
  | insert j S hj ih =>
    have : zpart b (insert j S) = (zpart b S).mul ⟨0, 0, Pi.single j (b j)⟩ := by
      ext i
      · simp [zpart, PD.mul]
      · simp [zpart, PD.mul]
      · simp only [zpart, PD.mul, Pi.add_apply, Finset.mem_insert]
        by_cases h : i = j
        · subst h; simp [hj]
        · simp [h]
    rw [this]; exact Gen.mul ih (gen_zs j _)

/-- Every Pauli datum is generated by the `X`s, the `Z`s and phases. -/
theorem Gen.all (P : PD n) : Gen P := by
  have : P = ((xpart P.a Finset.univ).mul (zpart P.b Finset.univ)).scale P.c := by
    ext i
    · simp [xpart, zpart, PD.mul, PD.scale]
    · simp [xpart, zpart, PD.mul, PD.scale]
    · simp [xpart, zpart, PD.mul, PD.scale]
  rw [this]
  exact Gen.scale _ (Gen.mul (gen_xpart _ _) (gen_zpart _ _))

end PD

/-- Two circuits acting alike on `Xⱼ` and `Zⱼ` act alike on every Pauli. -/
theorem actC_eq_of_gens {n : ℕ} {w v : Circ n}
    (hx : ∀ j, actC n w (PD.Xat j) = actC n v (PD.Xat j))
    (hz : ∀ j, actC n w (PD.Zat j) = actC n v (PD.Zat j)) : actC n w = actC n v := by
  funext P
  induction PD.Gen.all P with
  | one =>
    rw [show (PD.one : PD n) = PD.sc 0 from rfl, actC_sc, actC_sc]
  | scale d _ ih => rw [actC_scale, actC_scale, ih]
  | mul _ _ ih₁ ih₂ => rw [actC_mulPD, actC_mulPD, ih₁, ih₂]
  | x j => exact hx j
  | z j => exact hz j

/-- The circuits act alike on `Xⱼ` and `Zⱼ`, as a Boolean that evaluates. -/
def sameGens {n : ℕ} (w v : Circ n) : Bool :=
  decide (∀ j, PD.beq (actC n w (PD.Xat j)) (actC n v (PD.Xat j)) = true ∧
    PD.beq (actC n w (PD.Zat j)) (actC n v (PD.Zat j)) = true)

theorem actC_eq_of_sameGens {n : ℕ} {w v : Circ n} (h : sameGens w v = true) :
    actC n w = actC n v := by
  simp only [sameGens, decide_eq_true_eq, PD.beq_iff] at h
  exact actC_eq_of_gens (fun j => (h j).1) (fun j => (h j).2)

/-- **Projective completeness**: with completeness on `n` wires, circuits
acting alike on the Paulis are equal up to a phase. -/
theorem pcomplete {n : ℕ} (hc : Complete n) {w v : Circ n} (h : actC n w = actC n v) :
    PEq n w v := by
  obtain ⟨t, -, ht⟩ := same_action_phase ⟨sem n w, sem_mem_cliffordGroup w⟩
    ⟨sem n v, sem_mem_cliffordGroup v⟩ (by
      rintro P ⟨⟨c, a, b⟩, rfl⟩
      show (sem n w : Op ℂ 3 n) * (PD.op ⟨c, a, b⟩) * star (sem n w : Op ℂ 3 n) =
        (sem n v : Op ℂ 3 n) * (PD.op ⟨c, a, b⟩) * star (sem n v : Op ℂ 3 n)
      rw [sem_conj, sem_conj, h])
  refine ⟨t, hc _ _ (Subtype.ext ?_)⟩
  rw [map_mul, Submonoid.coe_mul, sem_negω_pow, mul_smul_comm, mul_one]
  exact ht

theorem pcomplete_gens {n : ℕ} (hc : Complete n) {w v : Circ n} (h : sameGens w v = true) :
    PEq n w v :=
  pcomplete hc (actC_eq_of_sameGens h)

end QCert.QutritClifford
