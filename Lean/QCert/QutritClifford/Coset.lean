# Coset certificates

Toward Theorem 4.4 on one and two wires.  A certificate lists cosets of a
subgroup `L` generated by "local" letters (`loc`; none on one wire, the
one-wire gates on two), each with a representative word `rep c`
(`rep 0 = []`), the table `del c x` of the action of the letters, and for
every edge `(c, x)` a deduction (`ded`) with an order (`ord`):

* `tree`: `rep (del c x) = rep c ++ [x]`;
* `sub`: `c = 0`, `x` local and `del 0 x = 0`;
* `eq e d side j`: equation `e` (`l = r` up to a local word on the left,
  at every coset or at one) scanned from coset `d`; the edge is the `j`-th
  of side `l` or `r`, every other edge of the scan coming earlier.

`Cert.sound` (by strong induction on the order): every edge holds, i.e.
`rep c ++ [x] = μ ++ rep (del c x)` with `μ` local; hence every word is
`μ ++ rep c` for the coset `c` it reaches from `0` (`Cert.word`).
-/
import QCert.QutritClifford.Local

namespace QCert.QutritClifford

/-- Words of local letters. -/
def LocW (loc : List Lt) (μ : List Lt) : Prop := ∀ x ∈ μ, x ∈ loc

theorem LocW.append {loc : List Lt} {a b : List Lt} (ha : LocW loc a) (hb : LocW loc b) :
    LocW loc (a ++ b) := by
  intro x hx; rcases List.mem_append.1 hx with h | h; exacts [ha x h, hb x h]

theorem LocW.nil (loc : List Lt) : LocW loc [] := fun _ h => nomatch h

theorem LocW.invW {loc : List Lt} : ∀ {a : List Lt}, LocW loc a → LocW loc (invW a)
  | [], _ => LocW.nil loc
  | x :: a, h => by
    refine LocW.append (LocW.invW (fun y hy => h y (List.mem_cons_of_mem _ hy))) ?_
    have hx := h x List.mem_cons_self
    intro y hy; cases x <;> simp [invL] at hy <;> subst hy <;> exact hx

/-- A coset certificate. -/
structure Cert where
  /-- The width. -/
  k : ℕ
  /-- The letters, by index. -/
  letters : List Lt
  /-- The local letters. -/
  loc : List Lt
  /-- The representatives, as stored words. -/
  rep : List ℕ
  /-- The table. -/
  dl : List (List ℕ)
  /-- The order of the edges. -/
  ord : List (List ℕ)
  /-- The deductions `(kind, e, d, side, j)`: kind `0` tree, `1` sub, `2` an equation. -/
  ded : List (List (ℕ × ℕ × ℕ × ℕ × ℕ))
  /-- The equations `(l, r, at)`: at every coset when `at = 0`, at coset
  `at - 1` only otherwise. -/
  eqs : List (ℕ × ℕ × ℕ)

namespace Cert

variable (C : Cert)

def repW (c : ℕ) : List Lt := decW (C.rep.getD c 0)
def del (c i : ℕ) : ℕ := (C.dl.getD c []).getD i 0
def ordOf (c i : ℕ) : ℕ := (C.ord.getD c []).getD i 0
def idx (x : Lt) : ℕ := C.letters.idxOf x
def letter (i : ℕ) : Lt := C.letters.getD i (.H 0)

/-- The coset reached from `d` along a word. -/
def walk : ℕ → List Lt → ℕ
  | d, [] => d
  | d, x :: w => walk (C.del d (C.idx x)) w

/-- Every edge along `w` from `d` is below `o`, except the one at position `skip`. -/
def below (o : ℕ) (skip : ℕ) : ℕ → ℕ → List Lt → Bool
  | _, _, [] => true
  | t, d, x :: w => (t == skip || decide (C.ordOf d (C.idx x) < o)) && below o skip (t + 1) (C.del d (C.idx x)) w

/-- An edge holds. -/
def EdgeV (c i : ℕ) : Prop :=
  ∃ μ, LocW C.loc μ ∧ E C.k (C.repW c ++ [C.letter i]) (μ ++ C.repW (C.del c i))

/-- An equation holds at a coset. -/
def EqV (l r : List Lt) (d : ℕ) : Prop :=
  ∃ μ, LocW C.loc μ ∧ E C.k (C.repW d ++ l) (μ ++ C.repW d ++ r)

/-- The check of the deduction of an edge. -/
def dedOk (c i : ℕ) : Bool :=
  let o := C.ordOf c i
  match (C.ded.getD c []).getD i (0, 0, 0, 0, 0) with
  | (0, _, _, _, _) => C.repW (C.del c i) == C.repW c ++ [C.letter i]
  | (1, _, _, _, _) => c == 0 && C.del 0 i == 0 && C.loc.contains (C.letter i) && C.repW 0 == []
  | (_, e, d, side, j) =>
    match C.eqs[e]? with
    | none => false
    | some (lc, rc, at) =>
      let l := decW lc
      let r := decW rc
      let w := if side == 0 then l else r
      (at == 0 || at == d + 1) && decide (d < C.dl.length) &&
      C.walk d (w.take j) == c && w[j]? == some (C.letter i) &&
      C.walk d l == C.walk d r &&
      C.below o (if side == 0 then j else l.length + 1) 0 d l &&
      C.below o (if side == 0 then r.length + 1 else j) 0 d r

/-- The global conditions of a certificate. -/
structure Ok : Prop where
  /-- Every edge's deduction checks. -/
  ded : ∀ c i, c < C.dl.length → i < C.letters.length → C.dedOk c i = true
  /-- The table stays among the cosets. -/
  dl_lt : ∀ c i, c < C.dl.length → i < C.letters.length → C.del c i < C.dl.length
  /-- The letters fit the width. -/
  fits_letters : ∀ x ∈ C.letters, x.hi < C.k
  /-- The representatives fit. -/
  fits_rep : ∀ c, Fits C.k (C.repW c)
  /-- The equations' words consist of letters. -/
  eqs_letters : ∀ e ∈ C.eqs, ∀ x ∈ decW e.1 ++ decW e.2.1, x ∈ C.letters
  /-- The equations hold. -/
  eqs_valid : ∀ e ∈ C.eqs, ∀ d, (e.2.2 = 0 ∨ e.2.2 = d + 1) → C.EqV (decW e.1) (decW e.2.1) d
  /-- There is a coset `0`. -/
  zero_lt : 0 < C.dl.length
  /-- The letters are distinct. -/
  nodup : C.letters.Nodup
  /-- The local letters are letters. -/
  loc_sub : ∀ x ∈ C.loc, x ∈ C.letters

variable {C}

theorem letter_idx {x : Lt} (hx : x ∈ C.letters) : C.letter (C.idx x) = x := by
  simp [letter, idx, List.getD_eq_getElem?_getD, List.getElem?_idxOf hx]

theorem idx_lt {x : Lt} (hx : x ∈ C.letters) : C.idx x < C.letters.length :=
  List.idxOf_lt_length_iff.2 hx

/-- **Paths**: along a word whose edges hold. -/
theorem path (hC : C.Ok) : ∀ (w : List Lt) (d : ℕ), d < C.dl.length → (∀ x ∈ w, x ∈ C.letters) →
    (∀ t < w.length, ∀ x, w[t]? = some x → C.EdgeV (C.walk d (w.take t)) (C.idx x)) →
    ∃ μ, LocW C.loc μ ∧ E C.k (C.repW d ++ w) (μ ++ C.repW (C.walk d w))
  | [], d, _, _, _ => ⟨[], LocW.nil _, by simp; exact E.refl _⟩
  | x :: w, d, hd, hw, he => by
    obtain ⟨μ1, hμ1, h1⟩ := he 0 (by simp) x rfl
    simp only [List.take_zero, walk] at h1
    have hxl : x ∈ C.letters := hw x List.mem_cons_self
    rw [letter_idx hxl] at h1
    obtain ⟨μ2, hμ2, h2⟩ := path hC w (C.del d (C.idx x)) (hC.dl_lt _ _ hd (idx_lt hxl))
      (fun y hy => hw y (List.mem_cons_of_mem _ hy))
      (fun t ht y hy => by
        have := he (t + 1) (by simp; omega) y (by simpa using hy)
        simpa [walk] using this)
    refine ⟨μ1 ++ μ2, hμ1.append hμ2, ?_⟩
    have e1 : E C.k (C.repW d ++ x :: w) (μ1 ++ C.repW (C.del d (C.idx x)) ++ w) := by
      have := h1.append (E.refl w)
      simpa [List.append_assoc] using this
    refine e1.trans ?_
    have := (E.refl μ1).append h2
    simpa [walk, List.append_assoc] using this

theorem walk_append : ∀ (d : ℕ) (a b : List Lt), C.walk d (a ++ b) = C.walk (C.walk d a) b
  | _, [], _ => rfl
  | d, x :: a, b => walk_append _ a b

theorem walk_lt (hC : C.Ok) : ∀ (d : ℕ) (w : List Lt), d < C.dl.length → (∀ x ∈ w, x ∈ C.letters) →
    C.walk d w < C.dl.length
  | _, [], hd, _ => hd
  | d, x :: w, hd, hw =>
    walk_lt hC _ w (hC.dl_lt _ _ hd (idx_lt (hw x List.mem_cons_self)))
      (fun y hy => hw y (List.mem_cons_of_mem _ hy))

theorem idx_letter (hC : C.Ok) {i : ℕ} (hi : i < C.letters.length) : C.idx (C.letter i) = i := by
  simp only [idx, letter, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.getD_some]
  exact List.idxOf_getElem hC.nodup i hi

theorem below_spec (o skip : ℕ) : ∀ (t0 d : ℕ) (w : List Lt), C.below o skip t0 d w = true →
    ∀ t < w.length, t0 + t ≠ skip → ∀ x, w[t]? = some x →
      C.ordOf (C.walk d (w.take t)) (C.idx x) < o
  | _, _, [], _ => fun t ht => by simp at ht
  | t0, d, y :: w, h => by
    intro t ht hs x hx
    simp only [below, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    cases t with
    | zero =>
      simp at hx; subst hx
      rcases h.1 with h1 | h1
      · exact absurd h1 (by simpa using hs)
      · simpa [walk] using h1
    | succ t =>
      have := below_spec o skip (t0 + 1) _ w h.2 t (by simpa using ht) (by omega) x
        (by simpa using hx)
      simpa [walk] using this

/-- Fits of words of letters. -/
theorem fits_of_letters (hC : C.Ok) {w : List Lt} (hw : ∀ x ∈ w, x ∈ C.letters) : Fits C.k w :=
  fun x hx => hC.fits_letters x (hw x hx)

theorem fits_loc (hC : C.Ok) {μ : List Lt} (hμ : LocW C.loc μ) : Fits C.k μ :=
  fun x hx => hC.fits_letters x (hC.loc_sub x (hμ x hx))

/-- A scan with the unknown edge on the left side. -/
theorem scan (hC : C.Ok) {l r : List Lt} {d j c i : ℕ} (hEq : C.EqV l r d) (hd : d < C.dl.length)
    (hl : ∀ x ∈ l, x ∈ C.letters) (hr : ∀ x ∈ r, x ∈ C.letters) (hi : i < C.letters.length)
    (hj : l[j]? = some (C.letter i)) (hc : C.walk d (l.take j) = c)
    (hend : C.walk d l = C.walk d r)
    (hvl : ∀ t < l.length, t ≠ j → ∀ x, l[t]? = some x → C.EdgeV (C.walk d (l.take t)) (C.idx x))
    (hvr : ∀ t < r.length, ∀ x, r[t]? = some x → C.EdgeV (C.walk d (r.take t)) (C.idx x)) :
    C.EdgeV c i := by
  have hjl : j < l.length := (List.getElem?_eq_some_iff.1 hj).1
  set x := C.letter i
  have hsplit : l = l.take j ++ x :: l.drop (j + 1) := by
    rw [← List.getElem_cons_drop_succ_eq_drop hjl, List.take_append_drop]
    · exact (List.getElem?_eq_some_iff.1 hj).2 ▸ rfl
  -- the cosets
  have hcl : c < C.dl.length := hc ▸ walk_lt hC d _ hd (fun y hy => hl y (List.mem_of_mem_take hy))
  set c' := C.del c i
  have hc' : C.walk d (l.take (j + 1)) = c' := by
    rw [List.take_succ, walk_append, hc, List.getElem?_eq_getElem hjl]
    simp only [Option.toList_some, walk]
    rw [show l[j] = x from by simpa [hjl] using hj, idx_letter hC hi]
  have hl1 : ∀ y ∈ l.take j, y ∈ C.letters := fun y hy => hl y (List.mem_of_mem_take hy)
  have hl2 : ∀ y ∈ l.drop (j + 1), y ∈ C.letters := fun y hy => hl y (List.mem_of_mem_drop hy)
  -- the three paths
  obtain ⟨μ1, hμ1, h1⟩ := path hC (l.take j) d hd hl1 (fun t ht y hy => by
    have htj : t < j := by simp at ht; omega
    have := hvl t (by omega) (by omega) y (by rw [← hy, List.getElem?_take_of_lt htj])
    rwa [List.take_take, min_eq_left (by omega)] at this)
  rw [hc] at h1
  obtain ⟨μ2, hμ2, h2⟩ := path hC (l.drop (j + 1)) c' (hC.dl_lt _ _ hcl hi) hl2 (fun t ht y hy => by
    have := hvl (j + 1 + t) (by simp at ht; omega) (by omega) y (by rw [← hy, List.getElem?_drop])
    rwa [show l.take (j + 1 + t) = l.take (j + 1) ++ (l.drop (j + 1)).take t by
      rw [List.take_add], walk_append, hc'] at this)
  obtain ⟨μ3, hμ3, h3⟩ := path hC r d hd hr hvr
  obtain ⟨μ0, hμ0, h0⟩ := hEq
  have he : C.walk c' (l.drop (j + 1)) = C.walk d r := by
    rw [← hend, ← hc', ← walk_append, List.take_append_drop]
  rw [he] at h2
  -- the chain
  set e := C.repW (C.walk d r)
  have A : E C.k (μ1 ++ (C.repW c ++ [x]) ++ l.drop (j + 1)) (C.repW d ++ l) := by
    have := h1.symm.append (E.refl (x :: l.drop (j + 1)))
    rw [hsplit]; simpa [List.append_assoc] using this
  have B : E C.k (C.repW d ++ l) (μ0 ++ μ3 ++ e) := by
    refine h0.trans ?_
    have := (E.refl μ0).append h3
    simpa [List.append_assoc] using this
  have Cc : E C.k e (invW μ2 ++ (C.repW c' ++ l.drop (j + 1))) := by
    have h4 : E C.k (invW μ2 ++ (C.repW c' ++ l.drop (j + 1))) (invW μ2 ++ (μ2 ++ e)) :=
      (E.refl _).append h2
    have h5 : E C.k (invW μ2 ++ (μ2 ++ e)) e := by
      rw [← List.append_assoc]
      have := (E_cancel' μ2 (fits_loc hC hμ2)).append (E.refl e)
      simpa using this
    exact (h4.trans h5).symm
  have D : E C.k (μ1 ++ (C.repW c ++ [x]) ++ l.drop (j + 1))
      ((μ0 ++ μ3 ++ invW μ2 ++ C.repW c') ++ l.drop (j + 1)) := by
    refine A.trans (B.trans ?_)
    have := (E.refl (μ0 ++ μ3)).append Cc
    simpa [List.append_assoc] using this
  have D2 := E.cancel_right _ (fits_of_letters hC hl2) D
  -- remove μ1 on the left
  have D3 : E C.k (invW μ1 ++ (μ1 ++ (C.repW c ++ [x])))
      (invW μ1 ++ (μ0 ++ μ3 ++ invW μ2 ++ C.repW c')) := (E.refl _).append D2
  have D4 : E C.k (invW μ1 ++ (μ1 ++ (C.repW c ++ [x]))) (C.repW c ++ [x]) := by
    rw [← List.append_assoc]
    have := (E_cancel' μ1 (fits_loc hC hμ1)).append (E.refl (C.repW c ++ [x]))
    simpa using this
  refine ⟨invW μ1 ++ (μ0 ++ μ3 ++ invW μ2), ?_, ?_⟩
  · exact hμ1.invW.append ((hμ0.append hμ3).append hμ2.invW)
  · have := D4.symm.trans D3
    simpa [List.append_assoc] using this

/-- An equation turned round. -/
theorem EqV.swap (hC : C.Ok) {l r : List Lt} {d : ℕ} (h : C.EqV l r d) : C.EqV r l d := by
  obtain ⟨μ, hμ, h⟩ := h
  refine ⟨invW μ, hμ.invW, ?_⟩
  have h1 : E C.k (invW μ ++ (C.repW d ++ l)) (invW μ ++ (μ ++ C.repW d ++ r)) := (E.refl _).append h
  have h2 : E C.k (invW μ ++ (μ ++ C.repW d ++ r)) (C.repW d ++ r) := by
    rw [List.append_assoc, ← List.append_assoc (invW μ)]
    have := (E_cancel' μ (fits_loc hC hμ)).append (E.refl (C.repW d ++ r))
    simpa using this
  have := (h1.trans h2).symm
  simpa [List.append_assoc] using this

/-- **Every edge holds.** -/
theorem edges (hC : C.Ok) : ∀ n c i, c < C.dl.length → i < C.letters.length →
    C.ordOf c i = n → C.EdgeV c i := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro c i hc hi hn
  have hd := hC.ded c i hc hi
  unfold dedOk at hd
  split at hd
  · -- tree
    refine ⟨[], LocW.nil _, ?_⟩
    rw [beq_iff_eq.1 hd]; exact E.refl _
  · -- sub
    simp only [Bool.and_eq_true, beq_iff_eq, List.contains_iff_mem] at hd
    obtain ⟨⟨⟨rfl, h0⟩, hloc⟩, hr0⟩ := hd
    refine ⟨[C.letter i], fun y hy => by simp at hy; subst hy; exact hloc, ?_⟩
    rw [h0, hr0]; exact E.refl _
  · -- an equation
    rename_i e d side j _ _
    split at hd
    · exact nomatch hd
    · rename_i lc rc at he
      simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at hd
      obtain ⟨⟨⟨⟨⟨⟨hat, hdl⟩, hwc⟩, hwj⟩, hend⟩, hbl⟩, hbr⟩ := hd
      have hmem : (lc, rc, at) ∈ C.eqs := List.mem_of_getElem? he
      have hEq := hC.eqs_valid _ hmem d (by rcases hat with h | h <;> simp [h])
      have hletl := fun x hx => hC.eqs_letters _ hmem x (List.mem_append_left _ hx)
      have hletr := fun x hx => hC.eqs_letters _ hmem x (List.mem_append_right _ hx)
      simp only at hEq hletl hletr
      have edgeOf : ∀ (w : List Lt), (∀ x ∈ w, x ∈ C.letters) → ∀ skip,
          C.below (C.ordOf c i) skip 0 d w = true →
          ∀ t < w.length, t ≠ skip → ∀ x, w[t]? = some x → C.EdgeV (C.walk d (w.take t)) (C.idx x) := by
        intro w hw skip hb t ht hts x hx
        have hlt := below_spec (C := C) _ skip 0 d w hb t ht (by omega) x hx
        have hxl : x ∈ C.letters := hw x (List.mem_of_getElem? hx)
        exact ih _ (hn ▸ hlt) _ _ (walk_lt hC d _ hdl (fun y hy => hw y (List.mem_of_mem_take hy)))
          (idx_lt hxl) rfl
      cases side with
      | zero =>
        simp only [ite_true] at hwc hwj hbl hbr
        exact scan hC hEq hdl hletl hletr hi hwj hwc hend
          (fun t ht htj x hx => edgeOf _ hletl j hbl t ht htj x hx)
          (fun t ht x hx => edgeOf _ hletr _ hbr t ht (by omega) x hx)
      | succ s =>
        simp only [show (s + 1 == 0) = false from rfl, Bool.false_eq_true, ite_false] at hwc hwj hbl hbr
        exact scan hC (hEq.swap hC) hdl hletr hletl hi hwj hwc hend.symm
          (fun t ht htj x hx => edgeOf _ hletr j hbr t ht htj x hx)
          (fun t ht x hx => edgeOf _ hletl _ hbl t ht (by omega) x hx)

/-- **Every word reaches a coset**: it is a local word times the
representative. -/
theorem word (hC : C.Ok) (w : List Lt) (hw : ∀ x ∈ w, x ∈ C.letters) (h0 : C.repW 0 = []) :
    ∃ μ, LocW C.loc μ ∧ E C.k w (μ ++ C.repW (C.walk 0 w)) := by
  have := path hC w 0 hC.zero_lt hw (fun t ht x hx => by
    have hxl : x ∈ C.letters := hw x (List.mem_of_getElem? hx)
    exact edges hC _ _ _ (walk_lt hC 0 _ hC.zero_lt (fun y hy => hw y (List.mem_of_mem_take hy)))
      (idx_lt hxl) rfl)
  simpa [h0] using this

end Cert

end QCert.QutritClifford
