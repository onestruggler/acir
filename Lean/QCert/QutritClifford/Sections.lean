# The sections of the stabiliser chain

Toward Theorem 4.4 on three or more wires.  Words in time order (`⨾`):

* `alpha p`, on wire `0`, sends `Z` to `X^a Z^b` up to a phase
  (`p = (a, b) ≠ (0, 0)`; `alpha (0, 1)` is empty);
* `Gam p`, on wires `0, 1`, sends `Z₀` to `X^a Z^b ⊗ Z` (`A ⨾ alpha p` with
  `A = H³ ⨾ CZ ⨾ H` on wire `0`, which sends `Z₀` to `Z₀Z₁`), and to `Z₁`
  for `p = (0, 0)` (the swap `W0`);
* `sigma y`, the section of stage 1, sends `Z₀` to the point `y`: `alpha`
  of its wire-`0` factor if the rest is trivial, and otherwise `Gam` of it
  followed by the section of the rest one wire up;
* `tau y`, the section of stage 2, for `y = (1, i) :: y'`: `Q i = S^{2i}`
  on wire `0` (`X ↦ X Z^i`, fixing `Z`), followed, if `y'` is not trivial,
  by `CZ` and `sigma y'` one wire up.  It sends `X₀` to `y` and fixes `Z₀`
  up to a phase.

The words `k` of the Schreier conditions are lists of tokens (`Tok`,
`kw`): `S`, `X`, `Z` and `CZ` at the bottom, or a single letter.  The
stabiliser of `Z₀` (up to a phase) is generated by the tokens other than
`H` on wire `0` (`Tok.isK1`), and the joint stabiliser of `Z₀` and `X₀`
by `X`, `Z` at the bottom and the letters above wire `0` (`Tok.isK2`).
-/
import QCert.QutritClifford.Points
import QCert.QutritClifford.Facts3Data

namespace QCert.QutritClifford

/-! ### The gadgets -/

/-- `alpha (a, b)` on wire `0`: `Z ↦ X^a Z^b`. -/
def alpha : Fin 3 × Fin 3 → List Lt
  | (0, 2) => [.H 0, .H 0]
  | (1, 0) => [.H 0, .H 0, .H 0]
  | (1, 1) => [.H 0, .H 0, .H 0, .S 0, .S 0]
  | (1, 2) => [.H 0, .H 0, .H 0, .S 0]
  | (2, 0) => [.H 0]
  | (2, 1) => [.H 0, .H 0, .H 0, .S 0, .H 0, .H 0]
  | (2, 2) => [.H 0, .S 0, .H 0]
  | _ => []

/-- `A = H³ ⨾ CZ ⨾ H` on wire `0`: `Z₀ ↦ Z₀Z₁`. -/
def Aw : List Lt := [.H 0, .H 0, .H 0, .C 0, .H 0]

/-- The swap of wires `1, 2` is the swap of wires `0, 1` one wire up (`W0`
and `W1` are the swaps (D6) of `Run.lean`). -/
theorem W1_eq : W1 = W0.map Lt.up := rfl

/-- `Gam (a, b)` on wires `0, 1`: `Z₀ ↦ X^a Z^b ⊗ Z`, and `Z₀ ↦ Z₁` for
`(a, b) = (0, 0)`. -/
def Gam (p : Fin 3 × Fin 3) : List Lt := if p = (0, 0) then W0 else Aw ++ alpha p

/-- **The sections of stage 1**: `sigma y` sends `Z₀` to `y`. -/
def sigma : Pt → List Lt
  | [] => []
  | p :: y => if isZ y then alpha p else Gam p ++ (sigma y).map Lt.up

/-- `Q i = S^{2i}` on wire `0`: `X ↦ X Z^i`. -/
def Qw (i : Fin 3) : List Lt := List.replicate (2 * i.val) (.S 0)

/-- **The sections of stage 2**: for `y = (1, i) :: y'`, `tau y` sends `X₀`
to `y` and fixes `Z₀`. -/
def tau : Pt → List Lt
  | [] => []
  | p :: y => Qw p.2 ++ (if isZ y then [] else .C 0 :: (sigma y).map Lt.up)

/-- `X` on wire `0` (D4). -/
def X0w : List Lt := [.H 0, .S 0, .H 0, .H 0, .S 0, .S 0, .H 0]

/-- `Z` on wire `0` (D5). -/
def Z0w : List Lt := [.H 0, .H 0, .S 0, .S 0, .H 0, .H 0, .S 0]

/-! ### Tokens -/

/-- The word of a token. -/
def Tok.word : Tok → List Lt
  | .S0 => [.S 0]
  | .X0 => X0w
  | .Z0 => Z0w
  | .C0 => [.C 0]
  | .top x => [x]

/-- The word of a list of tokens. -/
def kw (ts : List Tok) : List Lt := ts.flatMap Tok.word

/-- Tokens of the stabiliser of `Z₀`: all but `H` on wire `0`. -/
def Tok.isK1 : Tok → Bool
  | .top x => decide (1 ≤ x.lo)
  | _ => true

/-- Tokens of the stabiliser of `Z₀` and `X₀`: `X`, `Z` at the bottom and the
letters above wire `0`. -/
def Tok.isK2 : Tok → Bool
  | .X0 => true
  | .Z0 => true
  | .top x => decide (1 ≤ x.lo)
  | _ => false

/-- Lists of tokens of the first stabiliser, on `n` wires. -/
def K1 (n : ℕ) (ts : List Tok) : Prop := ∀ t ∈ ts, t.isK1 = true ∧ Fits n t.word

/-- Lists of tokens of the second stabiliser, on `n` wires. -/
def K2 (n : ℕ) (ts : List Tok) : Prop := ∀ t ∈ ts, t.isK2 = true ∧ Fits n t.word

/-- The check of `K1` as a Boolean. -/
def K1b (n : ℕ) (ts : List Tok) : Bool := ts.all fun t => t.isK1 && t.word.all (·.hi < n)

/-- The check of `K2` as a Boolean. -/
def K2b (n : ℕ) (ts : List Tok) : Bool := ts.all fun t => t.isK2 && t.word.all (·.hi < n)

theorem K1_of_b {n : ℕ} {ts : List Tok} (h : K1b n ts = true) : K1 n ts := by
  intro t ht
  have := List.all_eq_true.1 h t ht
  simp only [Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at this
  exact ⟨this.1, this.2⟩

theorem K2_of_b {n : ℕ} {ts : List Tok} (h : K2b n ts = true) : K2 n ts := by
  intro t ht
  have := List.all_eq_true.1 h t ht
  simp only [Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at this
  exact ⟨this.1, this.2⟩

theorem kw_nil : kw [] = [] := rfl

theorem kw_append (a b : List Tok) : kw (a ++ b) = kw a ++ kw b := List.flatMap_append

theorem kw_cons (t : Tok) (ts : List Tok) : kw (t :: ts) = t.word ++ kw ts := rfl

theorem K1.nil (n : ℕ) : K1 n [] := fun _ h => nomatch h
theorem K2.nil (n : ℕ) : K2 n [] := fun _ h => nomatch h

theorem K1.append {n : ℕ} {a b : List Tok} (ha : K1 n a) (hb : K1 n b) : K1 n (a ++ b) := by
  intro t ht; rcases List.mem_append.1 ht with h | h; exacts [ha t h, hb t h]

theorem K2.append {n : ℕ} {a b : List Tok} (ha : K2 n a) (hb : K2 n b) : K2 n (a ++ b) := by
  intro t ht; rcases List.mem_append.1 ht with h | h; exacts [ha t h, hb t h]

theorem K1.mono {n m : ℕ} {a : List Tok} (h : K1 n a) (hnm : n ≤ m) : K1 m a :=
  fun t ht => ⟨(h t ht).1, fits_mono (h t ht).2 hnm⟩

theorem K2.mono {n m : ℕ} {a : List Tok} (h : K2 n a) (hnm : n ≤ m) : K2 m a :=
  fun t ht => ⟨(h t ht).1, fits_mono (h t ht).2 hnm⟩

theorem fits_kw {n : ℕ} {ts : List Tok} (h : ∀ t ∈ ts, Fits n t.word) : Fits n (kw ts) := by
  intro x hx
  obtain ⟨t, ht, hx⟩ := List.mem_flatMap.1 hx
  exact h t ht x hx

theorem K1.fits {n : ℕ} {ts : List Tok} (h : K1 n ts) : Fits n (kw ts) :=
  fits_kw fun t ht => (h t ht).2

theorem K2.fits {n : ℕ} {ts : List Tok} (h : K2 n ts) : Fits n (kw ts) :=
  fits_kw fun t ht => (h t ht).2

/-! ### The one-wire actions -/

/-- The action of `H` or `S` on one wire. -/
def pt1 : Lt → Fin 3 × Fin 3 → Fin 3 × Fin 3
  | .H 0 => h1
  | .S 0 => s1
  | _ => id

/-- The action of a bottom token on the `Z` exponent of `X Z^i`. -/
def snext : Tok → Fin 3 → Fin 3
  | .S0, i => i + 2
  | _, i => i

/-- A point's index: `(a, b) ↦ 3a + b`. -/
def pidx (p : Fin 3 × Fin 3) : ℕ := 3 * p.1.val + p.2.val

/-- An entry of a fact table. -/
def ent (f : List (ℕ × List Tok)) (j : ℕ) : ℕ × List Tok := f.getD j (0, [])

end QCert.QutritClifford
