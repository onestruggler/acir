      DEqn.sym (P := pres) (S := fun _ => True) Sym.invol 1 0,
      DEqn.sym (P := pres) (S := fun _ => True) (Sym.nat2 Gate.CX) 0 0]
      [Step.rw 3 0 true, Step.rw 4 1 true, Step.rw 2 2 true, Step.rw 1 0 false, Step.rw 0 1 false]
