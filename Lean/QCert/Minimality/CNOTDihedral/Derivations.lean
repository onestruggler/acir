# CNOTdihe₂ derives Amy–Chen–Ross's relations (Appendix H)

Every relation of Amy, Chen and Ross's presentation of CNOT-dihedral
circuits (`QCert.CNOTDihedral.Rel`: R₁–R₁₃ and the laws of the symmetry),
read in our gates (`tr`), is derivable from Figure 7 (`rel_derivable`).
The relations removed in Blake's presentation, R₂–R₅, R₈ and R₁₁, are the
derivations of Appendix H (R₄ follows the derivation of `CX²` of
Appendix D); the others are rules of Figure 7 up to commuting gates on
disjoint wires.  The derivations were found by a search over rewrites and
exchanges and are replayed by `derive`.

Generated by `gen/gen_cnot.py` from the derivations `gen/run_all.py` finds
(`python run_all.py && python gen_cnot.py` in `gen/`).
-/
import QCert.Minimality.CNOTDihedral.Syntax
import QCert.Minimality.Transfer
import QCert.CNOTDihedral.Syntax

namespace QCert.Minimality.CNOTDihedral

open Circuit

/-- Amy–Chen–Ross's gates are ours. -/
def trGate : ∀ k, QCert.CNOTDihedral.Gate k → Gate k
  | _, .ω => .ω
  | _, .X => .X
  | _, .T => .T
  | _, .CX => .CX
  | _, .SW => .swap

/-- Amy–Chen–Ross's circuits read in our gates. -/
abbrev tr (n : ℕ) : Circuit QCert.CNOTDihedral.Gate n →* Circuit Gate n := Circuit.rename trGate n

/-- Our gates read as Amy–Chen–Ross's. -/
def unGate : ∀ k, Gate k → QCert.CNOTDihedral.Gate k
  | _, .ω => .ω
  | _, .X => .X
  | _, .T => .T
  | _, .CX => .CX
  | _, .swap => .SW

/-- The theory of Figure 7. -/
abbrev Th : CRel Gate := Padded (pres.Base fun _ => True)

theorem hsc : ∀ c c' : Gate 0, c = c' := by intro c c'; cases c; cases c'; rfl

/-- (CPh) upside down: a reversed CNOT, `T` on its control, a reversed CNOT. -/
def dCPhr : DEqn Th 2 where
  lhs := seq [revCX, T₀, revCX]
  rhs := T₀
  proof := derive hsc
    [DEqn.inst (P := pres) (S := fun _ => True) Ax.CPh trivial 0 0,
    DEqn.sym (P := pres) (S := fun _ => True) Sym.invol 0 0,
    DEqn.sym (P := pres) (S := fun _ => True) (Sym.nat1 Gate.T) 0 0]
    [Step.rw 3 2 true, Step.rw 2 1 false, Step.rw 1 0 false, Step.rw 0 2 false, Step.rw 1 1 false]
    (by decide +kernel)

/-- R₄: `CX² = 1` (as Appendix D, the derivation of (CX²)). -/
def dR4 : DEqn Th 2 where
  lhs := seq [CX, CX]
  rhs := 1
  proof := derive hsc
    [DEqn.inst (P := pres) (S := fun _ => True) Ax.T8 trivial 1 0,
    DEqn.inst (P := pres) (S := fun _ => True) Ax.B trivial 0 0,
    DEqn.sym (P := pres) (S := fun _ => True) Sym.invol 0 0, dCPhr.place 0 0]
    [Step.rw 0 0 true, Step.rw 7 3 true, Step.rw 11 1 false, Step.rw 11 2 true, Step.rw 12 1 false,
    Step.rw 7 3 false, Step.rw 0 0 false]
    (by decide +kernel)

/-- R₁₁. -/
def dR11 : DEqn Th 1 where
  lhs := seq [X, T, X]
  rhs := seq [ω, T, T, T, T, T, T, T]
  proof := derive hsc
    [DEqn.inst (P := pres) (S := fun _ => True) Ax.X2 trivial 0 0,
    DEqn.inst (P := pres) (S := fun _ => True) Ax.TX trivial 0 0]
    [Step.rw 1 1 true, Step.rw 0 0 false]
    (by decide +kernel)

/-- R₂. -/
def dR2 : DEqn Th 2 where
  lhs := seq [CX, X₀, CX]
  rhs := seq [X₀]
  proof := derive hsc
    [DEqn.inst (P := pres) (S := fun _ => True) Ax.X2 trivial 0 1,
    DEqn.inst (P := pres) (S := fun _ => True) Ax.XC trivial 0 0, dR4.place 0 0]
    [Step.rw 0 0 true, Step.rw 3 1 false, Step.rw 1 1 true, Step.rw 2 2 false, Step.swap 1, Step.rw 0 0 false]
    (by decide +kernel)

/-- R₃. -/
def dR3 : DEqn Th 2 where
  lhs := seq [CX, X₁, CX]
  rhs := seq [X₁, X₀]
  proof := derive hsc
    [DEqn.inst (P := pres) (S := fun _ => True) Ax.X2 trivial 0 1,
    DEqn.inst (P := pres) (S := fun _ => True) Ax.XC trivial 0 0, dR2.place 0 0]
    [Step.rw 3 0 true, Step.rw 1 1 true, Step.rw 0 2 false]
    (by decide +kernel)

/-- R₅. -/
def dR5 : DEqn Th 2 where
  lhs := seq [σ]
  rhs := seq [CX, σ, CX, σ, CX]
  proof := derive hsc
    [DEqn.inst (P := pres) (S := fun _ => True) Ax.B trivial 0 0, dR4.place 0 0]
    [Step.rw 0 1 true, Step.rw 1 0 true]
    (by decide +kernel)

/-- The naturality of the swap for `X`, as Amy–Chen–Ross state it. -/
def dnat1X : DEqn Th 2 where
  lhs := seq [X₀, σ]
  rhs := seq [σ, X₁]
  proof := derive hsc
    [DEqn.sym (P := pres) (S := fun _ => True) Sym.invol 0 0,
    DEqn.sym (P := pres) (S := fun _ => True) (Sym.nat1 Gate.X) 0 0]
    [Step.rw 2 0 true, Step.rw 1 1 true, Step.rw 0 0 false]
    (by decide +kernel)

/-- The naturality of the swap for `T`, as Amy–Chen–Ross state it. -/
def dnat1T : DEqn Th 2 where
  lhs := seq [T₀, σ]
  rhs := seq [σ, T₁]
  proof := derive hsc
    [DEqn.sym (P := pres) (S := fun _ => True) Sym.invol 0 0,
    DEqn.sym (P := pres) (S := fun _ => True) (Sym.nat1 Gate.T) 0 0]
    [Step.rw 2 0 true, Step.rw 1 1 true, Step.rw 0 0 false]
    (by decide +kernel)

/-- R₈. -/
def dR8 : DEqn Th 2 where
  lhs := seq [CX, T₀, CX, CX, T₀, CX, CX, T₀, CX, CX, T₀, CX]
  rhs := seq [T₀, T₀, T₀, T₀, T₁, T₁, T₁, T₁]
  proof := derive hsc
    [DEqn.inst (P := pres) (S := fun _ => True) Ax.T8 trivial 1 0,
    DEqn.inst (P := pres) (S := fun _ => True) Ax.ZC trivial 0 0,
    DEqn.inst (P := pres) (S := fun _ => True) Ax.CPh trivial 0 0, dR4.place 0 0]
    [Step.rw 2 3 false, Step.rw 3 3 false, Step.rw 4 3 false, Step.rw 6 0 true, Step.rw 1 1 true,
    Step.rw 1 2 true, Step.rw 0 3 false, Step.rw 3 2 true, Step.rw 5 2 false, Step.rw 1 2 false]
    (by decide +kernel)

/-- Every relation of Amy, Chen and Ross is derivable from Figure 7. -/
theorem rel_derivable : ∀ {k : ℕ} {w v : Circuit QCert.CNOTDihedral.Gate k},
    QCert.CNOTDihedral.Rel k w v → pres.Proves k (tr k w) (tr k v)
  | _, _, _, .R1 =>
    derive hsc [DEqn.inst (P := pres) (S := fun _ => True) Ax.X2 trivial 0 0] [Step.rw 0 0 false]
      (by decide +kernel)
  | _, _, _, .R2 =>
    dR2.proof
  | _, _, _, .R3 =>
    dR3.proof
  | _, _, _, .R4 =>
    dR4.proof
  | _, _, _, .R5 =>
