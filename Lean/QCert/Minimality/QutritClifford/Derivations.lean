/-- The theory of Figure 4. -/
abbrev Th : CRel Gate := Padded (pres.Base fun _ => True)

theorem hsc : ∀ c c' : Gate 0, c = c' := by intro c c'; cases c; cases c'; rfl

/-- Letters of words written out: a gate and the wire it starts on. -/
inductive Lt
  | w | H | S | CX | SW

/-- The generator of `n`-wire circuits for a letter (the scalar for a
letter that does not fit). -/
def Lt.gen : (n : ℕ) → Lt → ℕ → Gen Gate n
  | _, .w, 0 => .gate0 .ω
  | _ + 1, .H, 0 => .gate1 .H
  | _ + 1, .S, 0 => .gate1 .S
  | _ + 2, .CX, 0 => .gate2 .CX
  | _ + 2, .SW, 0 => .gate2 .swap
  | n + 1, g, o + 1 => .up (Lt.gen n g o)
  | _, _, _ => .gate0 .ω

/-- A word written in time order (the first letter applied first). -/
def tw (n : ℕ) (l : List (Lt × ℕ)) : Circuit Gate n :=
  FreeMonoid.ofList (l.reverse.map fun x => x.1.gen n x.2)

/-- `dCZ` upside down (conjugated by the swap). -/
def dCZ_m : DEqn Th 2 where
  lhs := tw 2 [(.H, 1), (.SW, 0), (.CX, 0), (.SW, 0), (.H, 1), (.H, 1), (.H, 1)]
  rhs := tw 2 [(.S, 1), (.S, 0), (.SW, 0), (.CX, 0), (.SW, 0), (.S, 1), (.S, 1), (.SW, 0), (.CX, 0), (.CX, 0), (.SW, 0)]
  proof := derive hsc
    [DEqn.sym (P := pres) (S := fun _ => True) Sym.invol 0 0,
    DEqn.inst (P := pres) (S := fun _ => True) Ax.CZ trivial 0 0,
    DEqn.sym (P := pres) (S := fun _ => True) (Sym.nat1 Gate.H) 0 0,
    DEqn.sym (P := pres) (S := fun _ => True) (Sym.nat1 Gate.S) 0 0]
    [Step.rw 0 0 true, Step.rw 1 2 false, Step.rw 2 2 false, Step.rw 3 2 false, Step.rw 4 0 false,
    Step.rw 5 2 false, Step.rw 1 1 false, Step.rw 7 0 true, Step.rw 8 3 false, Step.rw 9 0 false, Step.rw 6 3 true,
    Step.rw 5 0 true, Step.rw 4 3 true, Step.rw 3 3 true, Step.rw 2 0 true, Step.rw 1 0 true, Step.rw 0 0 false,
    Step.swap 11, Step.rw 2 0 false]
    (by decide +kernel)

