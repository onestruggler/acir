theorem DE_gen : ∀ g : QCert.Gen Gate 3, Derivable (Lift Th 3) (D (e g)) (FreeMonoid.of g)
  | .gate0 .ω => Derivable.refl _
  | .gate1 .H =>
      lo2 (u := tw 2 [(.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0)])
        (u' := tw 2 [(.H, 0)]) (by decide) (by decide)
        (semrow (by decide +kernel))
  | .gate1 .S => Derivable.refl _
  | .gate2 .CS => Derivable.refl _
  | .gate2 .swap =>
      lo2 (u := tw 2 [(.w, 0), (.w, 0), (.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.CS, 0), (.CS, 0), (.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.H, 1), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.CS, 0), (.CS, 0), (.H, 1), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.CS, 0), (.CS, 0), (.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0)])
        (u' := tw 2 [(.SW, 0)]) (by decide) (by decide)
        (semrow (by decide +kernel))
  | .up (.gate0 .ω) => (Derivable.of (Lift.scalar Gate.ω)).symm
  | .up (.gate1 .H) =>
      lo2 (u := tw 2 [(.H, 1), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0)])
        (u' := tw 2 [(.H, 1)]) (by decide) (by decide)
        (semrow (by decide +kernel))
  | .up (.gate1 .S) => Derivable.refl _
  | .up (.gate2 .CS) => Derivable.refl _
  | .up (.gate2 .swap) =>
      hi2s (u := tw 2 [(.w, 0), (.w, 0), (.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.CS, 0), (.CS, 0), (.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.H, 1), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.CS, 0), (.CS, 0), (.H, 1), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.CS, 0), (.CS, 0), (.H, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0)])
        (u' := tw 2 [(.SW, 0)]) (by decide) (by decide)
        (semrow (by decide +kernel))
  | .up (.up (.gate0 .ω)) => scalar_up2 (n := 1) Gate.ω
  | .up (.up (.gate1 .H)) =>
      hi2s (u := tw 2 [(.H, 1), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0), (.w, 0)])
        (u' := tw 2 [(.H, 1)]) (by decide) (by decide)
        (semrow (by decide +kernel))
  | .up (.up (.gate1 .S)) => Derivable.refl _
  | .up (.up (.up (.gate0 .ω))) => scalar_up3 (n := 0) Gate.ω

end QCert.Minimality.CliffordCS.W3
