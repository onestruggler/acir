/-- The scalar commutes with the decoding of every generator. -/
theorem w_comm_dB (y : QCert.BianSelingerUn.Gen 4) :
    Derivable BRel (DB (wl * FreeMonoid.of (some y))) (DB (FreeMonoid.of (some y) * wl)) := by
  have h := w_comm (Qof y ++ atomOf y :: (Qof y).reverse)
  have e : FreeMonoid.ofList (Qof y ++ atomOf y :: (Qof y).reverse) = dB (some y) := by
    simp only [dB, conj, FreeMonoid.ofList_append, FreeMonoid.ofList_cons, mul_assoc]
  rw [e] at h
  simpa only [DB, map_mul, FreeMonoid.lift_eval_of] using h

/-- The refinement's `w w = gi`, decoded. -/
theorem std_sq : Derivable BRel (FreeMonoid.ofList [w, w])
    (DBs [.i 0, .i 1, .i 2, .i 3]) :=
  derivable_of_runSteps rules _ _
    [(0, 22, false), (4, 20, false), (3, 14, false), (2, 20, false), (1, 14, false),
    (4, 28, false)]
    (by decide +kernel)

/-- Every relation of Bian and Selinger's presentation in dimension `4`,
refined by the new scalar, decodes to a derivable equation of blocks. -/
theorem rel_dec : ∀ {a b : FreeMonoid (Option (QCert.BianSelingerUn.Gen 4))},
    RRel (QCert.BianSelingerUn.Rel 4) (UN.gi 4) a b → Derivable BRel (DB a) (DB b) := by
  intro a b r
  cases r with
  | src r =>
    cases r with
    | r1 j => exact fam_r1 j
    | r2 j k hjk => exact fam_r2 j k hjk
    | r3 j k hjk => exact fam_r3 j k hjk
    | r4 j k hjk => exact fam_r4 j k hjk
    | r5 j k l hkl hjk hjl => exact fam_r5 j k l hkl hjk hjl
    | r6 j k l hkl hjk hjl => exact fam_r6 j k l hkl hjk hjl
    | r7 j k l m hjk hlm hjl hjm hkl hkm => exact fam_r7 j k l m hjk hlm hjl hjm hkl hkm
    | r8 j k l m hjk hlm hjl hjm hkl hkm => exact fam_r8 j k l m hjk hlm hjl hjm hkl hkm
    | r9 j k l m hjk hlm hjl hjm hkl hkm => exact fam_r9 j k l m hjk hlm hjl hjm hkl hkm
    | r10 j k hjk => exact fam_r10 j k hjk
    | r11 j k l hjk hkl => exact fam_r11 j k l hjk hkl
    | r12 j k l hjk hkl => exact fam_r12 j k l hjk hkl
    | r13 j k l hjk hkl => exact fam_r13 j k l hjk hkl
    | r14 j k l hjk hkl => exact fam_r14 j k l hjk hkl
    | r15 j k hjk => exact fam_r15 j k hjk
    | r16 j k hjk => exact fam_r16 j k hjk
    | r17 j k hjk => exact fam_r17 j k hjk
    | r18 j k hjk => exact fam_r18 j k hjk
    | r19 j k l m hjk hlm hjl hkm hkl => exact fam_r19 j k l m hjk hlm hjl hkm hkl
  | comm y => exact w_comm_dB y
  | sq => exact derivable_congr (by decide) (by decide) std_sq

/-- The decoding of the encoding of `H0`, as blocks. -/
theorem de_H0 : Derivable BRel (FreeMonoid.ofList [w, x1, ck, x1, ck])
    (FreeMonoid.ofList [h0]) :=
  derivable_of_runSteps rules _ _
    [(1, 12, true), (0, 11, true)]
    (by decide +kernel)

/-- The decoding of the encoding of `H1`, as blocks. -/
theorem de_H1 : Derivable BRel (FreeMonoid.ofList [w, t1, x1, ck, x1, t1, t1, ck, t1])
    (FreeMonoid.ofList [h1]) :=
  derivable_of_runSteps rules _ _
    [(5, 1, true), (2, 12, true), (1, 30, false), (2, 30, false), (3, 30, false), (4, 30, false),
    (5, 30, false), (6, 30, false), (7, 30, false), (0, 11, true), (0, 26, true)]
    (by decide +kernel)

/-- The decoding of the encoding of `S0`, as blocks. -/
theorem de_S0 : Derivable BRel (FreeMonoid.ofList [x1, cs, x1, cs])
