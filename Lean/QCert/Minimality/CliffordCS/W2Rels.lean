/-- The decoding of `X_[1,2]`, the encoding of the swap. -/
theorem de_swap : Derivable BRel (FreeMonoid.ofList [t2, t1, t2, t1, t2])
    (FreeMonoid.ofList [t1]) :=
  perm_complete (by decide) (by decide) (by decide)

