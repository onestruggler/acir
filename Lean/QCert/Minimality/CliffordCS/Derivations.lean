/-- The decoding of every refined relation in dimension `2` is derivable on
one wire. -/
theorem W1.rel_derivable : ∀ {a b : FreeMonoid (Option (QCert.BianSelingerUn.Gen 2))},
    RRel (QCert.BianSelingerUn.Rel 2) (UN.gi 2) a b → Derivable (Lift Th 1) (W1.D a) (W1.D b) := by
  intro a b r
  cases r with
    | src r => exact W1.src_derivable r
    | comm y =>
      cases y with
      | X j k h =>
        fin_cases j <;> fin_cases k
        · exfalso; revert h; decide
        · exact
            derive hsc
            []
            [.slide 0 4]
            (by revert h; decide +kernel)
        · exfalso; revert h; decide
        · exfalso; revert h; decide
      | K j k h =>
        fin_cases j <;> fin_cases k
        · exfalso; revert h; decide
        · exact
            derive hsc
            [DEqn.inst (P := pres) (S := fun _ => True) Ax.ω8 trivial 1 0]
            [.rw 0 0 false, .rw 0 0 true, .rw 0 0 false, .rw 0 0 true, .swap 7]
            (by revert h; decide +kernel)
        · exfalso; revert h; decide
        · exfalso; revert h; decide
      | i j =>
        fin_cases j
        · exact
            derive hsc
            []
            [.slide 2 5]
            (by decide +kernel)
        · exact
            derive hsc
            []
            [.swap 0]
            (by decide +kernel)
    | sq  =>
      · exact
          derive hsc
          [DEqn.inst (P := pres) (S := fun _ => True) Ax.S4 trivial 0 0]
          [.rw 2 0 true, .rw 2 0 false, .rw 2 0 true]
          (by decide +kernel)

/-- Decoding the encoding of a generator on one wire derives it. -/
theorem W1.DE_gen : ∀ g : Gen Gate 1, Derivable (Lift Th 1) (W1.D (W1.e g)) (FreeMonoid.of g)
  | .gate0 .ω => Derivable.refl _
  | .gate1 .H =>
      derive hsc
      [DEqn.inst (P := pres) (S := fun _ => True) Ax.ω8 trivial 1 0]
      [.rw 0 0 false, .rw 0 0 true, .rw 0 0 false]
      (by decide +kernel)
  | .gate1 .S => Derivable.refl _
  | .up (.gate0 .ω) =>
      derive hsc
      [DEqn.scal (Base := pres.Base fun _ => True) Gate.ω 0 0]
      [.rw 0 0 true]
      (by decide +kernel)

/-- The decoding of every relation of Bian and Selinger's presentation in
dimension `1` is derivable with no wire: only `i_[0]⁴ = ε` has instances. -/
theorem W0.src_derivable : ∀ {a b : Word (QCert.BianSelingerUn.Gen 1)},
    QCert.BianSelingerUn.Rel 1 a b → Derivable (Lift Th 0) (W0.D (ιw a)) (W0.D (ιw b)) := by
  intro a b r
  cases r with
    | r1 j =>
      fin_cases j
      · exact
          derive hsc
          [DEqn.inst (P := pres) (S := fun _ => True) Ax.ω8 trivial 0 0]
          [.rw 0 0 false, .rw 0 0 true, .rw 0 0 false]
          (by decide +kernel)
    | r2 j k hjk => exfalso; revert hjk; revert j k; decide
    | r3 j k hjk => exfalso; revert hjk; revert j k; decide
    | r4 j k hjk => exfalso; revert hjk; revert j k; decide
    | r10 j k hjk => exfalso; revert hjk; revert j k; decide
    | r15 j k hjk => exfalso; revert hjk; revert j k; decide
    | r16 j k hjk => exfalso; revert hjk; revert j k; decide
    | r17 j k hjk => exfalso; revert hjk; revert j k; decide
    | r18 j k hjk => exfalso; revert hjk; revert j k; decide
    | r5 j k l hkl hjk hjl => exfalso; revert hkl hjk hjl; revert j k l; decide
    | r6 j k l hkl hjk hjl => exfalso; revert hkl hjk hjl; revert j k l; decide
    | r7 j k l m hjk hlm hjl hjm hkl hkm => exfalso; fin_cases j <;> fin_cases k <;> fin_cases l <;> fin_cases m <;> simp_all
    | r8 j k l m hjk hlm hjl hjm hkl hkm => exfalso; fin_cases j <;> fin_cases k <;> fin_cases l <;> fin_cases m <;> simp_all
    | r9 j k l m hjk hlm hjl hjm hkl hkm => exfalso; fin_cases j <;> fin_cases k <;> fin_cases l <;> fin_cases m <;> simp_all
    | r11 j k l hjk hkl => exfalso; revert hjk hkl; revert j k l; decide
    | r12 j k l hjk hkl => exfalso; revert hjk hkl; revert j k l; decide
    | r13 j k l hjk hkl => exfalso; revert hjk hkl; revert j k l; decide
    | r14 j k l hjk hkl => exfalso; revert hjk hkl; revert j k l; decide
    | r19 j k l m hjk hlm hjl hkm hkl => exfalso; fin_cases j <;> fin_cases k <;> fin_cases l <;> fin_cases m <;> simp_all

/-- The decoding of every refined relation in dimension `1` is derivable with
no wire. -/
theorem W0.rel_derivable : ∀ {a b : FreeMonoid (Option (QCert.BianSelingerUn.Gen 1))},
    RRel (QCert.BianSelingerUn.Rel 1) (UN.gi 1) a b → Derivable (Lift Th 0) (W0.D a) (W0.D b) := by
  intro a b r
  cases r with
    | src r => exact W0.src_derivable r
    | comm y =>
      cases y with
        | X j k h => exfalso; revert h; revert j k; decide
        | K j k h => exfalso; revert h; revert j k; decide
        | i j => exact Derivable.refl _
    | sq => exact Derivable.refl _

/-- Decoding the encoding of the scalar derives it. -/
theorem W0.DE_gen : ∀ g : Gen Gate 0, Derivable (Lift Th 0) (W0.D (W0.e g)) (FreeMonoid.of g)
  | .gate0 .ω => Derivable.refl _


