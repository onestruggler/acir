# Amy, Ross, Wesley (2024), after the Agda `CCX+H-3qubit-Tietze`: permutations

Translation of `Permutation.agda`, generated by `gen/generate_permutation.py`.
The circuits `adjacent k` of Section 5.6, `X_[k,k+1]`, satisfy the Coxeter
relations of `S₈` (`cox`: each relation one certificate of `PermProofs`), so
two Coxeter words with the same permutation of the basis states are equal
circuits (`permutation_complete`).

**Deviation.**  The Agda reads Coxeter words as circuits of the repository's
presentation of `S₈` (`decode`) and transfers that presentation's
completeness along the Coxeter relations (`axiom-decode`, `decode-cong`).  The
Lean library has no presentation of `S₈`; Coxeter words are the lists of
`CoxeterFrames` (the translation of the Agda's shared
`Symmetric/CoxeterFrames`, in `QCert.ToffoliHadamardRS`), whose completeness
takes the Coxeter relations as its hypothesis.
-/
import QCert.ToffoliHadamardTietze.PermProofs.B021
import QCert.ToffoliHadamardTietze.PermProofs.B022
import QCert.ToffoliHadamardTietze.PermProofs.B023
import QCert.ToffoliHadamardTietze.PermProofs.B024
import QCert.ToffoliHadamardTietze.PermProofs.B025
import QCert.ToffoliHadamardTietze.PermProofs.B026
import QCert.ToffoliHadamardRS.CoxeterFrames
import Mathlib.Tactic.IntervalCases

namespace QCert.ToffoliHadamardTietze
open QCert.ToffoliHadamardRS.CoxeterFrames

/-- `X_[k,k+1]`, the circuits of Section 5.6; `ε` from `k = 7` on. -/
def adjacent : ℕ → Word Gen
  | 0 => t01
  | 1 => t12
  | 2 => t23
  | 3 => t34
  | 4 => t45
  | 5 => t56
  | 6 => t67
  | _ => 1

theorem involution : ∀ k, adjacent k * adjacent k ≈ 1
  | 0 => by_assoc_and PermProofs.invol0.proved rfl rfl
  | 1 => by_assoc_and PermProofs.invol1.proved rfl rfl
  | 2 => by_assoc_and PermProofs.invol2.proved rfl rfl
  | 3 => by_assoc_and PermProofs.invol3.proved rfl rfl
  | 4 => by_assoc_and PermProofs.invol4.proved rfl rfl
  | 5 => by_assoc_and PermProofs.invol5.proved rfl rfl
  | 6 => by_assoc_and PermProofs.invol6.proved rfl rfl
  | _ + 7 => by_assoc_and (@refl 1) rfl rfl

theorem braid : ∀ k, k ≤ 5 →
    adjacent k * adjacent (k + 1) * adjacent k ≈ adjacent (k + 1) * adjacent k * adjacent (k + 1)
  | 0, _ => by_assoc_and PermProofs.braid0.proved rfl rfl
  | 1, _ => by_assoc_and PermProofs.braid1.proved rfl rfl
  | 2, _ => by_assoc_and PermProofs.braid2.proved rfl rfl
  | 3, _ => by_assoc_and PermProofs.braid3.proved rfl rfl
  | 4, _ => by_assoc_and PermProofs.braid4.proved rfl rfl
  | 5, _ => by_assoc_and PermProofs.braid5.proved rfl rfl
  | _ + 6, h => absurd h (by omega)

theorem apart (i j : ℕ) (h₁ : 2 + i ≤ j) (h₂ : j ≤ 6) :
    adjacent i * adjacent j ≈ adjacent j * adjacent i := by
  have : i ≤ 4 := by omega
  interval_cases i <;> interval_cases j <;> try omega
  · exact by_assoc_and PermProofs.comm02.proved rfl rfl
  · exact by_assoc_and PermProofs.comm03.proved rfl rfl
  · exact by_assoc_and PermProofs.comm04.proved rfl rfl
  · exact by_assoc_and PermProofs.comm05.proved rfl rfl
  · exact by_assoc_and PermProofs.comm06.proved rfl rfl
  · exact by_assoc_and PermProofs.comm13.proved rfl rfl
  · exact by_assoc_and PermProofs.comm14.proved rfl rfl
  · exact by_assoc_and PermProofs.comm15.proved rfl rfl
  · exact by_assoc_and PermProofs.comm16.proved rfl rfl
  · exact by_assoc_and PermProofs.comm24.proved rfl rfl
  · exact by_assoc_and PermProofs.comm25.proved rfl rfl
  · exact by_assoc_and PermProofs.comm26.proved rfl rfl
  · exact by_assoc_and PermProofs.comm35.proved rfl rfl
  · exact by_assoc_and PermProofs.comm36.proved rfl rfl
  · exact by_assoc_and PermProofs.comm46.proved rfl rfl

/-- The Coxeter relations for the circuits `adjacent k`. -/
theorem cox : Coxeter adjacent Rel where
  order i _ := involution i
  braid i h := braid i h
  far i j h₁ h₂ := apart i j h₁ h₂

/-- Two Coxeter words of `S₈` with the same permutation are equal circuits. -/
theorem permutation_complete {p q : CW} (hp : Valid 7 p) (hq : Valid 7 q)
    (e : ∀ x, x < 8 → act p x = act q x) : Pc adjacent p ≈ Pc adjacent q :=
  Pc_complete cox hp hq e

end QCert.ToffoliHadamardTietze
