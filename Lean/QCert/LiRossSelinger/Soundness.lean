# Li, Ross, Selinger (2021): soundness (Theorem 4.3)

Each relation of Table 1 holds in `Oₙ(ℤ[1/2])` at every choice of its
indices: moved to its own indices it is an identity of at most `8 × 8`
rational matrices, which the kernel decides (`Local.lean`).  The cases
are generated by `gen/mk_sound.py` (scratch).
-/
import QCert.LiRossSelinger.Local
import QCert.LiRossSelinger.Units

namespace QCert.LiRossSelinger

open Matrix QCert.ListMat

set_option linter.unusedSimpArgs false

variable {n : ℕ}

theorem vec_inj {m : ℕ} (f : Fin m → Fin n) (h : (List.ofFn f).Nodup) : Function.Injective f :=
  List.nodup_ofFn.1 h

/-- The matrix of the value of a word. -/
theorem sem_word (u : Word (Gen n)) :
    (((FreeMonoid.lift (sem n) u : O_ZHalf n) : Matrix.unitaryGroup (Fin n) ℝ) :
      Matrix (Fin n) (Fin n) ℝ) = (u.toList.map genMat).prod := by
  induction u using FreeMonoid.inductionOn' with
  | one => rfl
  | mul_of g u ih =>
    rw [map_mul, Subgroup.coe_mul, Submonoid.coe_mul, ih, FreeMonoid.lift_eval_of,
      FreeMonoid.toList_mul, FreeMonoid.toList_of, List.singleton_append, List.map_cons,
      List.prod_cons]
    rfl

theorem sem_eq_of_loc {m : ℕ} (f : Fin m → Fin n) (hf : Function.Injective f)
    {u v : Word (Gen n)} (lu lv : List Loc) (hu : u.toList.map genMat = lu.map (Loc.glob f))
    (hv : v.toList.map genMat = lv.map (Loc.glob f))
    (h : ListMat.prod m (lu.map (Loc.mat m)) = ListMat.prod m (lv.map (Loc.mat m))) :
    FreeMonoid.lift (sem n) u = FreeMonoid.lift (sem n) v := by
  apply Subtype.ext; apply Subtype.ext
  rw [sem_word, sem_word]
  exact prod_eq_of_loc f hf lu lv hu hv h

set_option maxHeartbeats 1000000 in
/-- Theorem 4.3: the relations of Table 1 are sound. -/
theorem sound : ∀ ⦃u v : Word (Gen n)⦄, Table1 n u v →
    FreeMonoid.lift (sem n) u = FreeMonoid.lift (sem n) v := by
  intro u v h
  cases h with
  | r1a a b hab =>
    exact sem_eq_of_loc ![a, b] (vec_inj _ (by simp [Fin.ext_iff]; simp only [Fin.lt_def] at *; omega)) [.x 0 1, .x 0 1] []
      (by simp only [N, X, K, FreeMonoid.toList_mul, FreeMonoid.toList_of, FreeMonoid.toList_one, List.singleton_append, List.cons_append, List.nil_append, List.append_nil, List.map_cons, List.map_nil, List.cons.injEq, and_true]; exact ⟨genMat_x_loc _ 0 1 (by decide) (by decide) (by decide) _ _ _ rfl rfl, genMat_x_loc _ 0 1 (by decide) (by decide) (by decide) _ _ _ rfl rfl⟩)
      (rfl)
      (by decide +kernel)
  | r1b a =>
    exact sem_eq_of_loc ![a] (fun i j _ => Subsingleton.elim i j) [.neg 0, .neg 0] []
      (by simp only [N, X, K, FreeMonoid.toList_mul, FreeMonoid.toList_of, FreeMonoid.toList_one, List.singleton_append, List.cons_append, List.nil_append, List.append_nil, List.map_cons, List.map_nil, List.cons.injEq, and_true]; exact ⟨genMat_neg_loc _ 0 (by decide) _ rfl, genMat_neg_loc _ 0 (by decide) _ rfl⟩)
      (rfl)
