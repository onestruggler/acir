      (by simp only [N, X, K, FreeMonoid.toList_mul, FreeMonoid.toList_of, FreeMonoid.toList_one, List.singleton_append, List.cons_append, List.nil_append, List.append_nil, List.map_cons, List.map_nil, List.cons.injEq, and_true]; exact ⟨genMat_x_loc _ 2 3 (by decide) (by decide) (by decide) _ _ _ rfl rfl, genMat_x_loc _ 0 1 (by decide) (by decide) (by decide) _ _ _ rfl rfl⟩)
