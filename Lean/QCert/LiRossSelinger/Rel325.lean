/-- `K_[0,1,2,3]` on four indices. -/
def K4 : Gen 4 := Gen.k 0 1 2 3 (by decide) (by decide) (by decide)

/-- The signs `(−1)_[0]^{t₀} ⋯ (−1)_[3]^{t₃}` on four indices. -/
