# One qudit, modulo the Paulis

The single-qudit relations that the rest uses, derived from (C1)–(C4) and
the definition (T1) of the multiplier, in the group `Gh p g 1` of
one-qudit circuits modulo the rules and the Paulis (where `X`, `Z` and the
scalars are trivial, so that `M_a = S^{1/a} H S^a H S^{1/a} H`):

* `M_a M_b = M_{ab}` and `M_1 = 1` (from (C3), every `a ≠ 0` being a power
  of `g`);
* `M_a S M_a⁻¹ = S^{1/a²}` (from (C4));
* `H² = M_{-1}` (C2), and `H M_a H⁻¹ = M_a⁻¹` (from the definition of
  `M_a` at `a` and `-a`).

From these, `H` and `S` permute the cosets of the boxes `A`
(`lf1`, the single-qudit box relations of Figure 15), so the stabiliser of
`Z` is generated by `S` (`zstab_zero`), and one-qudit circuits are complete
modulo the Paulis (`faith_one`).
-/
import QCert.QuditClifford.Stab

namespace QCert.QuditClifford

variable {p : ℕ} [hp : Fact p.Prime] {g : ZMod p} [OddGen p g]

theorem pad_zero_one (c : Circ 1) : Circuit.pad 0 c = c := by
  induction c using FreeMonoid.inductionOn' with
  | one => rfl
  | mul_of y c ih =>
    rw [map_mul, ih]
    congr 1
    rcases y with c | c | _ | _ | y
    · rfl
    · rfl
    · rcases y with c | _ | _ | _ | _; rfl

theorem qh_rule1 {w v : Circ 1} (h : Rule p g 1 w v) : qh p g 1 w = qh p g 1 v := by
  have := qh_rule (g := g) 0 h
  rwa [pad_zero_one, pad_zero_one] at this

theorem qh1_X : qh p g 1 (X p) = 1 := by
  apply qh_eq_one_of_mem
  refine Subgroup.subset_normalClosure (Or.inr ⟨0, Or.inl ?_⟩)
  show mk p g 1 (X p) = mk p g 1 (Circuit.pad 0 (X p))
  rw [pad_zero_one]

theorem qh1_Z : qh p g 1 (Z p) = 1 := by
  apply qh_eq_one_of_mem
  refine Subgroup.subset_normalClosure (Or.inr ⟨0, Or.inr ?_⟩)
  show mk p g 1 (Z p) = mk p g 1 (Circuit.pad 0 (Z p))
  rw [pad_zero_one]

theorem qh_neg1 {n : ℕ} : qh p g n (neg1 p) = 1 := by rw [neg1, map_pow, qh_negω, one_pow]

theorem qh_ω {n : ℕ} : qh p g n (ω p) = 1 := by rw [ω, map_pow, qh_negω, one_pow]

/-! ### Powers of order `p` indexed by `ℤ_p` -/

section Pow

variable {G : Type*} [Group G]

theorem pow_val_add {x : G} (hx : x ^ p = 1) (a b : ZMod p) :
    x ^ (a + b).val = x ^ a.val * x ^ b.val := by
  rw [← pow_add, ZMod.val_add]
  conv_rhs => rw [← Nat.mod_add_div (a.val + b.val) p, pow_add, pow_mul, hx, one_pow, mul_one]

theorem pow_val_natCast {x : G} (hx : x ^ p = 1) (k : ℕ) : x ^ (k : ZMod p).val = x ^ k := by
  rw [ZMod.val_natCast]
  conv_rhs => rw [← Nat.mod_add_div k p, pow_add, pow_mul, hx, one_pow, mul_one]

theorem pow_val_mul {x : G} (hx : x ^ p = 1) (a b : ZMod p) :
    x ^ (a * b).val = (x ^ a.val) ^ b.val := by
  rw [← pow_mul, ← pow_val_natCast hx (a.val * b.val)]
  congr 2
  push_cast [ZMod.natCast_zmod_val]
  rfl

theorem pow_val_one {x : G} (hx : x ^ p = 1) : x ^ (1 : ZMod p).val = x := by
  rw [show (1 : ZMod p) = ((1 : ℕ) : ZMod p) by simp, pow_val_natCast hx, pow_one]

theorem pow_val_zero (x : G) : x ^ (0 : ZMod p).val = 1 := by simp

theorem pow_val_neg {x : G} (hx : x ^ p = 1) (a : ZMod p) : x ^ (-a).val = (x ^ a.val)⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, ← pow_val_add hx, neg_add_cancel, pow_val_zero]

end Pow

/-! ### The generators -/

variable (p g) in
/-- `H` modulo the rules and the Paulis. -/
noncomputable abbrev Hq : Gh p g 1 := qh p g 1 H

variable (p g) in
/-- `S^c`, `c ∈ ℤ_p`. -/
noncomputable def Sq (c : ZMod p) : Gh p g 1 := qh p g 1 S ^ c.val

variable (p g) in
/-- The multiplier `M_a`. -/
noncomputable def Mq (a : ZMod p) : Gh p g 1 := qh p g 1 (M p a)

theorem S_pow_p : qh p g 1 S ^ p = 1 := by
  rw [← map_pow, qh_rule1 Rule.C1, map_one]

theorem Sq_add (a b : ZMod p) : Sq p g (a + b) = Sq p g a * Sq p g b := pow_val_add S_pow_p a b

theorem Sq_zero : Sq p g 0 = 1 := pow_val_zero _

theorem Sq_neg (a : ZMod p) : Sq p g (-a) = (Sq p g a)⁻¹ := pow_val_neg S_pow_p a

theorem Sq_one : Sq p g 1 = qh p g 1 S := pow_val_one S_pow_p

theorem Sq_pow (a : ZMod p) (k : ℕ) : Sq p g a ^ k = Sq p g (a * k) := by
  induction k with
  | zero => simp [Sq_zero]
  | succ k ih => rw [pow_succ, ih, ← Sq_add]; push_cast; ring_nf

/-- Modulo the Paulis, `M_a = S^{1/a} H S^a H S^{1/a} H`. -/
theorem Mq_eq (a : ZMod p) :
    Mq p g a = Sq p g a⁻¹ * Hq p g * Sq p g a * Hq p g * Sq p g a⁻¹ * Hq p g := by
  simp only [Mq, M, seq_def, map_mul, map_pow, qh1_X, qh1_Z, qh_neg1, qh_ω, one_pow, one_mul, Sq,
    mul_assoc]

/-- (C2) modulo the Paulis: `H² = M_{-1}`. -/
theorem Hq_sq : Hq p g ^ 2 = Mq p g (-1) := by
  have := qh_rule1 (g := g) Rule.C2
  simpa [seq_def, map_pow, qh_neg1, Mq] using this

theorem Mq_g_pow (k : ZMod p) : Mq p g g ^ k.val = Mq p g (g ^ k.val) := by
  have := qh_rule1 (g := g) (Rule.C3 k)
  simpa [map_pow, Mq] using this

theorem Mq_one : Mq p g 1 = 1 := by
  have := Mq_g_pow (g := g) 0
  simpa using this.symm

theorem Mq_g_pow_card : Mq p g g ^ (p - 1) = 1 := by
  have hlt : p - 1 < p := Nat.sub_lt (Fact.out : p.Prime).pos one_pos
  have := Mq_g_pow (g := g) ((p - 1 : ℕ) : ZMod p)
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt hlt, ZMod.pow_card_sub_one_eq_one (OddGen.ne_zero p g),
    Mq_one] at this
  exact this

theorem Mq_g_pow_nat (i : ℕ) : Mq p g (g ^ i) = Mq p g g ^ i := by
  have hp1 : 0 < p - 1 := by have := (Fact.out : p.Prime).two_le; omega
  rw [← Nat.mod_add_div i (p - 1), pow_add, pow_mul, pow_add, pow_mul, Mq_g_pow_card, one_pow,
    mul_one, ZMod.pow_card_sub_one_eq_one (OddGen.ne_zero p g), one_pow, mul_one]
  have hlt : i % (p - 1) < p := by have := Nat.mod_lt i hp1; omega
  have := Mq_g_pow (g := g) ((i % (p - 1) : ℕ) : ZMod p)
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt hlt] at this
  exact this.symm

theorem exists_log {a : ZMod p} (ha : a ≠ 0) : ∃ i : ℕ, g ^ i = a := OddGen.hg a ha

theorem Mq_mul {a b : ZMod p} (ha : a ≠ 0) (hb : b ≠ 0) : Mq p g a * Mq p g b = Mq p g (a * b) := by
  obtain ⟨i, rfl⟩ := exists_log (g := g) ha
  obtain ⟨j, rfl⟩ := exists_log (g := g) hb
  rw [Mq_g_pow_nat, Mq_g_pow_nat, ← pow_add, ← pow_add, Mq_g_pow_nat]

theorem Mq_inv {a : ZMod p} (ha : a ≠ 0) : (Mq p g a)⁻¹ = Mq p g a⁻¹ := by
  rw [inv_eq_iff_mul_eq_one, Mq_mul ha (inv_ne_zero ha), mul_inv_cancel₀ ha, Mq_one]

/-- (C4) modulo the Paulis: `M_g S M_g⁻¹ = S^{1/g²}`. -/
theorem Mq_g_conj_S : Mq p g g * qh p g 1 S * (Mq p g g)⁻¹ = Sq p g (g ^ 2)⁻¹ := by
  have := qh_rule1 (g := g) Rule.C4
  simp only [seq_def, map_mul, map_pow, qh1_Z, one_pow, one_mul] at this
  show qh p g 1 (M p g) * qh p g 1 S * (qh p g 1 (M p g))⁻¹ = qh p g 1 S ^ ((g ^ 2)⁻¹).val
  rw [this, mul_inv_cancel_right]

theorem Mq_g_conj_Sq (c : ZMod p) : Mq p g g * Sq p g c * (Mq p g g)⁻¹ = Sq p g (c * (g ^ 2)⁻¹) := by
  rw [Sq, ← conj_pow, Mq_g_conj_S, Sq, ← pow_val_mul S_pow_p, mul_comm]; rfl

theorem Mq_conj_Sq {a : ZMod p} (ha : a ≠ 0) (c : ZMod p) :
    Mq p g a * Sq p g c * (Mq p g a)⁻¹ = Sq p g (c * (a ^ 2)⁻¹) := by
  obtain ⟨i, rfl⟩ := exists_log (g := g) ha
  clear ha
  rw [Mq_g_pow_nat]
  induction i generalizing c with
  | zero => simp
  | succ i ih =>
    have e : Mq p g g ^ (i + 1) * Sq p g c * (Mq p g g ^ (i + 1))⁻¹ =
        Mq p g g ^ i * (Mq p g g * Sq p g c * (Mq p g g)⁻¹) * (Mq p g g ^ i)⁻¹ := by group
    rw [e, Mq_g_conj_Sq, ih]
    congr 1
    have hg := OddGen.ne_zero p g
    field_simp
    ring

theorem Mq_neg_one_conj_Sq (c : ZMod p) : Mq p g (-1) * Sq p g c * (Mq p g (-1))⁻¹ = Sq p g c := by
  rw [Mq_conj_Sq (neg_ne_zero.2 one_ne_zero)]; simp

theorem Hq_pow_four : Hq p g ^ 4 = 1 := by
  rw [show 4 = 2 * 2 from rfl, pow_mul, Hq_sq, sq, Mq_mul (neg_ne_zero.2 one_ne_zero)
    (neg_ne_zero.2 one_ne_zero), neg_one_mul, neg_neg, Mq_one]

theorem Hq_inv : (Hq p g)⁻¹ = Hq p g ^ 3 := by
  rw [inv_eq_iff_mul_eq_one, ← pow_succ', Hq_pow_four]

theorem Hq_inv' : (Hq p g)⁻¹ = Hq p g * Mq p g (-1) := by
  rw [Hq_inv, ← Hq_sq, ← pow_succ']

theorem Mq_neg_one_comm_H : Mq p g (-1) * Hq p g = Hq p g * Mq p g (-1) := by
  rw [← Hq_sq, ← pow_succ, ← pow_succ']

theorem Mq_neg_one_comm_Sq (c : ZMod p) : Mq p g (-1) * Sq p g c = Sq p g c * Mq p g (-1) := by
  have := Mq_neg_one_conj_Sq (g := g) c
  rw [mul_inv_eq_iff_eq_mul] at this
  exact this

theorem conj_aux {G : Type*} [Group G] {A B H M : G} (hA : A * (H * H) * A⁻¹ = H * H)
    (h4 : H * H * (H * H) = 1) (e1 : M = A * H * B * H * A * H)
    (hm : M = H * H * A⁻¹ * H * B⁻¹ * H * A⁻¹ * H) : H * M * H⁻¹ * M = 1 := by
  calc H * M * H⁻¹ * M
      = H * (A * H * B * H * A * H) * H⁻¹ * (H * H * A⁻¹ * H * B⁻¹ * H * A⁻¹ * H) := by
        rw [← e1, ← hm]
    _ = H * A * H * B * H * (A * (H * H) * A⁻¹) * H * B⁻¹ * H * A⁻¹ * H := by group
    _ = H * A * H * B * (H * H * (H * H)) * B⁻¹ * H * A⁻¹ * H := by rw [hA]; group
    _ = H * (A * (H * H) * A⁻¹) * H := by rw [h4]; group
    _ = H * H * (H * H) := by rw [hA]; group
    _ = 1 := h4

/-- `H M_a H⁻¹ = M_a⁻¹`: with `A = S^{1/a}`, `B = S^a`, `M_a = A H B H A H` and
`M_a = M_{-1} M_{-a} = H² A⁻¹ H B⁻¹ H A⁻¹ H`, and `H²` commutes with `S`. -/
theorem Hq_conj_Mq {a : ZMod p} (ha : a ≠ 0) : Hq p g * Mq p g a * (Hq p g)⁻¹ = (Mq p g a)⁻¹ := by
  have hA : Sq p g a⁻¹ * (Hq p g * Hq p g) * (Sq p g a⁻¹)⁻¹ = Hq p g * Hq p g := by
    rw [← sq, Hq_sq, mul_inv_eq_iff_eq_mul, Mq_neg_one_comm_Sq]
  have h4 : Hq p g * Hq p g * (Hq p g * Hq p g) = 1 := by
    rw [← Hq_pow_four (p := p) (g := g)]; simp only [pow_succ, pow_zero, one_mul, mul_assoc]
  have hm : Mq p g a = Hq p g * Hq p g * (Sq p g a⁻¹)⁻¹ * Hq p g * (Sq p g a)⁻¹ * Hq p g *
      (Sq p g a⁻¹)⁻¹ * Hq p g := by
    have h := Mq_mul (g := g) (neg_ne_zero.2 one_ne_zero) (neg_ne_zero.2 ha)
    rw [neg_one_mul, neg_neg] at h
    rw [← h, ← Hq_sq, sq, Mq_eq (-a), inv_neg, Sq_neg, Sq_neg]
    simp only [mul_assoc]
  apply eq_inv_of_mul_eq_one_left
  exact conj_aux hA h4 (Mq_eq a) hm

end QCert.QuditClifford
