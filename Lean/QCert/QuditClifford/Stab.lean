# The stabiliser chain

On `m + 1` wires, modulo the rules and the Paulis:

* `J m`, generated by the circuits on wires `1, …, m`, `S` on wire 0 and
  `CZ` on wires 0, 1: it fixes `Z` on wire 0 (stage 1, `ZStab m` says it is
  the whole stabiliser);
* `Kst m`, the circuits on wires `1, …, m`: within `J m` it is the
  stabiliser of `X` on wire 0 (stage 2, `XStab m`).

`Faith m`: an element acting trivially on Paulis is trivial (symplectic
completeness on `m` wires).  `Faith (m + 1)` follows from `ZStab m`,
`XStab m` and `Faith m` (`faith_succ`).

The sections for the two stages are `s₁h` (the classes of `s₁circ`) and
`s₂h`, `S^β` on wire 0 after `c P`, where `c P` conjugates `CZ` by the
section for `P` moved up one wire: it sends `X` on wire 0 to `X ⊗ P`.
-/
import QCert.QuditClifford.Sections
import QCert.QuditClifford.Schreier

namespace QCert.QuditClifford

variable {p : ℕ} [hp : Fact p.Prime] {g : ZMod p} [OddGen p g]

variable (p g) in
/-- `S` on wire 0. -/
noncomputable def S0h (m : ℕ) : Gh p g (m + 1) := qh p g (m + 1) (Circuit.g1 Gate.S)

variable (p g) in
/-- `H` on wire 0. -/
noncomputable def H0h (m : ℕ) : Gh p g (m + 1) := qh p g (m + 1) (Circuit.g1 Gate.H)

variable (p g) in
/-- `CZ` on wires 0, 1. -/
noncomputable def CZh (m : ℕ) : Gh p g (m + 2) := qh p g (m + 2) (Circuit.g2 Gate.CZ)

variable (p g) in
/-- The generators of the stabiliser of `Z` on wire 0. -/
def Jgen : (m : ℕ) → Set (Gh p g (m + 1))
  | 0 => Set.range (ιh 0) ∪ {S0h p g 0}
  | m + 1 => Set.range (ιh (m + 1)) ∪ {S0h p g (m + 1), CZh p g m}

variable (p g) in
/-- The stabiliser of `Z` on wire 0. -/
noncomputable def J (m : ℕ) : Subgroup (Gh p g (m + 1)) := Subgroup.closure (Jgen p g m)

variable (p g) in
/-- The circuits on the wires above wire 0. -/
noncomputable def Kst (m : ℕ) : Subgroup (Gh p g (m + 1)) := (ιh m).range

variable (p g) in
/-- Stage 1: the stabiliser of `Z` on wire 0 is `J m`. -/
def ZStab (m : ℕ) : Prop := ∀ x : Gh p g (m + 1), σh (m + 1) x (eZ p m) = eZ p m → x ∈ J p g m

variable (p g) in
/-- Stage 2: within `J m`, the stabiliser of `X` on wire 0 is `Kst m`. -/
def XStab (m : ℕ) : Prop := ∀ x ∈ J p g m, σh (m + 1) x (eX p m) = eX p m → x ∈ Kst p g m

variable (p g) in
/-- Symplectic completeness on `m` wires. -/
def Faith (m : ℕ) : Prop := ∀ x : Gh p g m, σh m x = 1 → x = 1

/-! ### Generation -/

theorem closure_gens (n : ℕ) :
    Subgroup.closure (Set.range fun y : Gen Gate n => qh p g n (FreeMonoid.of y)) = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  refine Gh.induction_on (P := fun x => x ∈ Subgroup.closure _) x (Subgroup.one_mem _) ?_
  intro y x hx
  exact Subgroup.mul_mem _ (Subgroup.subset_closure ⟨y, rfl⟩) hx

/-! ### The action is linear and invertible -/

theorem σGen_zero : {n : ℕ} → (x : Gen Gate n) → σGen p x 0 = 0
  | _, .gate0 _ => rfl
  | _, .gate1 c => by cases c <;> simp [σGen, act1]
  | _, .gate2 .CZ => by
    funext i; simp only [σGen, Function.update_apply]; split_ifs <;> simp
  | _, .gate3 c => nomatch c
  | _, .up x => by
    simp only [σGen]
    rw [show Fin.tail (0 : V p (_ + 1)) = 0 from rfl, σGen_zero x]
    exact Fin.cons_self_tail 0

theorem σh_zero {n : ℕ} (x : Gh p g n) : σh n x 0 = 0 := by
  refine Gh.induction_on (P := fun x => σh n x 0 = 0) x rfl ?_
  intro y x hx
  rw [map_mul, Function.End.mul_def, Function.comp_apply, hx, σh_qh, σC_of, σGen_zero]

theorem σh_inv_apply {n : ℕ} (x : Gh p g n) (v : V p n) : σh n x⁻¹ (σh n x v) = v := by
  rw [← Function.comp_apply (f := σh n x⁻¹), ← Function.End.mul_def, ← map_mul, inv_mul_cancel,
    map_one]; rfl

theorem σh_ne_zero {n : ℕ} (x : Gh p g n) {v : V p n} (hv : v ≠ 0) : σh n x v ≠ 0 := by
  intro h
  apply hv
  rw [← σh_inv_apply x v, h, σh_zero]

theorem eZ_ne_zero (m : ℕ) : eZ p m ≠ 0 := fun h => by
  have := congrFun h 0
  simp [eZ] at this

/-! ### Faithfulness from the two stages -/

theorem Gh_zero_trivial (x : Gh p g 0) : x = 1 := by
  refine Gh.induction_on (P := fun x => x = 1) x rfl ?_
  intro y x hx
  rcases y with c | _ | _ | _ | _
  rw [hx, mul_one]; exact qh_gate0 c

theorem faith_zero : Faith p g 0 := fun x _ => Gh_zero_trivial x

theorem faith_succ {m : ℕ} (hZ : ZStab p g m) (hX : XStab p g m) (hF : Faith p g m) :
    Faith p g (m + 1) := by
  intro x hx
  have h1 : x ∈ J p g m := hZ x (by rw [hx]; rfl)
  obtain ⟨y, rfl⟩ := hX x h1 (by rw [hx]; rfl)
  have hy : σh m y = 1 := by
    funext u
    have := congrFun hx (Fin.cons (0, 0) u)
    rw [σh_ιh] at this
    have := congrArg Fin.tail this
    simpa using this
  rw [hF y hy, map_one]

/-! ### The sections -/

variable (p g) in
/-- The section for `Z` on wire 0. -/
noncomputable def s₁h (m : ℕ) (u : V p (m + 1)) : Gh p g (m + 1) := qh p g (m + 1) (s₁circ p m u)

theorem σh_s₁h (m : ℕ) {u : V p (m + 1)} (hu : u ≠ 0) : σh (m + 1) (s₁h p g m u) (eZ p m) = u :=
  σC_s₁circ p m hu

variable (p g) in
/-- `CZ` on wires 0, 1 conjugated by the section for `P` moved up one wire. -/
noncomputable def cP (m : ℕ) (P : V p (m + 1)) : Gh p g (m + 2) :=
  if P = 0 then 1 else ιh (m + 1) (s₁h p g m P) * CZh p g m * (ιh (m + 1) (s₁h p g m P))⁻¹

variable (p g) in
/-- The section for `X` on wire 0, within the stabiliser of `Z` on wire 0. -/
noncomputable def s₂h : (m : ℕ) → V p (m + 1) → Gh p g (m + 1)
  | 0, v => S0h p g 0 ^ (v 0).2.val
  | m + 1, v => S0h p g (m + 1) ^ (v 0).2.val * cP p g m (Fin.tail v)

end QCert.QuditClifford
