# Completeness on one qudit, modulo the Paulis

`lf1`, the single-qudit box relations (Figure 15) in the form used here:
`H` and `S` send the coset of a box `A_u` to the coset of `A_{u'}`, `u'` the
image of `u`, the cosets being those of the stabiliser of `Z`, generated by
`S`.  By Schreier's lemma that is the whole stabiliser (`zstab_zero`);
within it, the stabiliser of `X` is trivial (`xstab_zero`), so the action
on Paulis is faithful (`faith_one`).
-/
import QCert.QuditClifford.OneQudit

namespace QCert.QuditClifford

variable {p : ℕ} [hp : Fact p.Prime] {g : ZMod p} [OddGen p g]

theorem Acirc_eq (u : ZMod p × ZMod p) :
    qh p g 1 (Acirc p u) =
      if u.1 = 0 then Mq p g u.2⁻¹ else Sq p g (u.2 / u.1) * Hq p g ^ 3 * Mq p g u.1⁻¹ := by
  unfold Acirc
  split_ifs <;> simp [Mq, Sq, map_mul, map_pow]

theorem S0h_zero : S0h p g 0 = Sq p g 1 := Sq_one.symm

theorem S0h_mem_J0 : S0h p g 0 ∈ J p g 0 :=
  Subgroup.subset_closure (Set.mem_union_right _ (Set.mem_singleton _))

theorem Sq_mem_J0 (c : ZMod p) : Sq p g c ∈ J p g 0 := by
  rw [show Sq p g c = S0h p g 0 ^ c.val by rw [S0h_zero, Sq_one]; rfl]
  exact Subgroup.pow_mem _ S0h_mem_J0 _

/-- `H S^k H = S^{-1/k} M_k H⁻¹ S^{-1/k}`: the definition of `M_k`. -/
theorem HSH {k : ZMod p} :
    Hq p g * Sq p g k * Hq p g = Sq p g (-k⁻¹) * Mq p g k * (Hq p g)⁻¹ * Sq p g (-k⁻¹) := by
  rw [Mq_eq, Sq_neg]; group

theorem Hq_pow_three_inv : (Hq p g ^ 3)⁻¹ = Hq p g := by
  rw [← Hq_inv, inv_inv]

theorem Hq_mul_Mq {a : ZMod p} (ha : a ≠ 0) : Hq p g * Mq p g a = (Mq p g a)⁻¹ * Hq p g := by
  rw [← Hq_conj_Mq ha]; group

theorem Sq_comm_Hsq (c : ZMod p) : Sq p g c * Hq p g ^ 2 = Hq p g ^ 2 * Sq p g c := by
  rw [Hq_sq, Mq_neg_one_comm_Sq]

/-- The single-qudit box relations, modulo the stabiliser of `Z`. -/
theorem lf1 (y : Gate 1) {u : ZMod p × ZMod p} (hu : u ≠ 0) :
    (qh p g 1 (Acirc p (act1 p y u)))⁻¹ * qh p g 1 (Circuit.g1 y) * qh p g 1 (Acirc p u) ∈ J p g 0 := by
  obtain ⟨α, β⟩ := u
  have hn1 : (-1 : ZMod p) ≠ 0 := neg_ne_zero.2 one_ne_zero
  cases y with
  | S =>
    show (qh p g 1 (Acirc p (α, α + β)))⁻¹ * qh p g 1 S * qh p g 1 (Acirc p (α, β)) ∈ J p g 0
    rw [← Sq_one, Acirc_eq, Acirc_eq]
    by_cases hα : α = 0
    · subst hα
      have hβ : β ≠ 0 := fun h => hu (by rw [h]; rfl)
      simp only [zero_add, if_true]
      rw [Mq_inv (inv_ne_zero hβ), inv_inv, ← Mq_inv hβ, Mq_conj_Sq hβ]
      exact Sq_mem_J0 _
    · simp only [hα, if_false]
      have e : Sq p g 1 * Sq p g (β / α) = Sq p g ((α + β) / α) := by
        rw [← Sq_add]; congr 1; field_simp
      have : (Sq p g ((α + β) / α) * Hq p g ^ 3 * Mq p g α⁻¹)⁻¹ * Sq p g 1 *
          (Sq p g (β / α) * Hq p g ^ 3 * Mq p g α⁻¹) = 1 := by
        rw [← e]; group
      rw [this]; exact Subgroup.one_mem _
  | H =>
    show (qh p g 1 (Acirc p (-β, α)))⁻¹ * Hq p g * qh p g 1 (Acirc p (α, β)) ∈ J p g 0
    rw [Acirc_eq, Acirc_eq]
    by_cases hα : α = 0
    · subst hα
      have hβ : β ≠ 0 := fun h => hu (by rw [h]; rfl)
      simp only [neg_eq_zero, hβ, if_false, if_true, zero_div, Sq_zero, one_mul]
      have : (Hq p g ^ 3 * Mq p g (-β)⁻¹)⁻¹ * Hq p g * Mq p g β⁻¹ =
          (Mq p g (-β)⁻¹)⁻¹ * (Hq p g ^ 2)⁻¹ * Mq p g β⁻¹ := by group
      rw [this, Hq_sq, Mq_inv (inv_ne_zero (neg_ne_zero.2 hβ)), Mq_inv hn1, inv_inv,
        Mq_mul (neg_ne_zero.2 hβ) (inv_ne_zero hn1), Mq_mul (by simpa using hβ) (inv_ne_zero hβ)]
      rw [show -β * (-1)⁻¹ * β⁻¹ = 1 by field_simp, Mq_one]
      exact Subgroup.one_mem _
    · by_cases hβ : β = 0
      · subst hβ
        simp only [neg_zero, if_true, hα, if_false, zero_div, Sq_zero, one_mul]
        have : (Mq p g α⁻¹)⁻¹ * Hq p g * (Hq p g ^ 3 * Mq p g α⁻¹) =
            (Mq p g α⁻¹)⁻¹ * Hq p g ^ 4 * Mq p g α⁻¹ := by group
        rw [this, Hq_pow_four, mul_one, inv_mul_cancel]
        exact Subgroup.one_mem _
      · simp only [neg_eq_zero, hβ, hα, if_false]
        set k := β / α with hk
        have hk0 : k ≠ 0 := div_ne_zero hβ hα
        set c := α / -β with hc
        have hck : c = -k⁻¹ := by rw [hc, hk]; field_simp
        have e1 : (Sq p g c * Hq p g ^ 3 * Mq p g (-β)⁻¹)⁻¹ * Hq p g * (Sq p g k * Hq p g ^ 3 *
            Mq p g α⁻¹) = (Mq p g (-β)⁻¹)⁻¹ * (Hq p g ^ 3)⁻¹ * (Sq p g c)⁻¹ *
            (Hq p g * Sq p g k * Hq p g) * Hq p g ^ 2 * Mq p g α⁻¹ := by group
        rw [e1, HSH, ← hck]
        have e2 : (Mq p g (-β)⁻¹)⁻¹ * (Hq p g ^ 3)⁻¹ * (Sq p g c)⁻¹ *
            (Sq p g c * Mq p g k * (Hq p g)⁻¹ * Sq p g c) * Hq p g ^ 2 * Mq p g α⁻¹ =
            (Mq p g (-β)⁻¹)⁻¹ * (Hq p g ^ 3)⁻¹ * Mq p g k * (Hq p g)⁻¹ * (Sq p g c * Hq p g ^ 2) *
            Mq p g α⁻¹ := by group
        rw [e2, Sq_comm_Hsq, Hq_pow_three_inv]
        have e3 : (Mq p g (-β)⁻¹)⁻¹ * Hq p g * Mq p g k * (Hq p g)⁻¹ * (Hq p g ^ 2 * Sq p g c) *
            Mq p g α⁻¹ = (Mq p g (-β)⁻¹)⁻¹ * (Hq p g * Mq p g k) * Hq p g * Sq p g c * Mq p g α⁻¹ := by
          group
        rw [e3, Hq_mul_Mq hk0]
        have e4 : (Mq p g (-β)⁻¹)⁻¹ * ((Mq p g k)⁻¹ * Hq p g) * Hq p g * Sq p g c * Mq p g α⁻¹ =
            (Mq p g (-β)⁻¹)⁻¹ * (Mq p g k)⁻¹ * (Hq p g * Hq p g) * Sq p g c * Mq p g α⁻¹ := by group
        rw [e4, ← sq, Hq_sq, Mq_inv (inv_ne_zero (neg_ne_zero.2 hβ)), Mq_inv hk0, inv_inv,
          Mq_mul (neg_ne_zero.2 hβ) (inv_ne_zero hk0),
          Mq_mul (mul_ne_zero (neg_ne_zero.2 hβ) (inv_ne_zero hk0)) hn1,
          show -β * k⁻¹ * -1 = α by rw [hk]; field_simp, ← Mq_inv hα, Mq_conj_Sq hα]
        exact Sq_mem_J0 _

/-! ### The stabiliser of `Z` on one wire -/

theorem eq_zero_of_V1 {u : V p 1} (h : u 0 = 0) : u = 0 := V1_ext p h

theorem zstab_zero : ZStab p g 0 := by
  intro x hx
  refine schreier (σh 1) (eZ p 0) (K := J p g 0)
    (S := Set.range fun y : Gen Gate 1 => qh p g 1 (FreeMonoid.of y)) (s₁h p g 0) ?_ ?_ x
    (by rw [closure_gens]; trivial) hx
  · show qh p g 1 (Acirc p (0, 1)) ∈ J p g 0
    rw [Acirc_eq]
    simp only [if_true, inv_one, Mq_one]
    exact Subgroup.one_mem _
  · rintro _ ⟨y, rfl⟩ h _
    dsimp only
    set u := σh 1 h (eZ p 0) with hu
    have hu0 : u 0 ≠ 0 := fun h0 => σh_ne_zero h (eZ_ne_zero (p := p) 0) (eq_zero_of_V1 h0)
    rw [map_mul, Function.End.mul_def, Function.comp_apply, ← hu, σh_qh, σC_of]
    rcases y with c | c | _ | _ | y
    · rw [qh_gate0, one_mul]; simp [σGen]
    · show (qh p g 1 (Acirc p (Function.update u 0 (act1 p c (u 0)) 0)))⁻¹ *
        (qh p g 1 (Circuit.g1 c) * qh p g 1 (Acirc p (u 0))) ∈ J p g 0
      rw [Function.update_self, ← mul_assoc]
      exact lf1 c hu0
    · rcases y with c | _ | _ | _ | _
      have h1 : qh p g 1 (FreeMonoid.of (Gen.gate0 c).up) = 1 := by
        rw [qh_up, qh_gate0, map_one]
      rw [h1, one_mul]
      have h2 : σGen p (Gen.gate0 c).up u = u := by
        simp only [σGen]; exact Fin.cons_self_tail u
      rw [h2, inv_mul_cancel]; exact Subgroup.one_mem _

/-! ### The stabiliser of `X` within it -/

theorem J_fst {m : ℕ} {h : Gh p g (m + 1)} (hh : h ∈ J p g m) (v : V p (m + 1)) :
    (σh (m + 1) h v 0).1 = (v 0).1 := by
  induction hh using Subgroup.closure_induction generalizing v with
  | mem x hx =>
    cases m with
    | zero =>
      rcases hx with ⟨z, rfl⟩ | hx
      · rw [σh_ιh]; rfl
      · rw [Set.mem_singleton_iff] at hx; subst hx
        simp [S0h, σh_qh, σC_of, σGen, act1]
    | succ m =>
      rcases hx with ⟨z, rfl⟩ | hx | hx
      · rw [σh_ιh]; rfl
      · obtain rfl : x = S0h p g (m + 1) := hx
        simp [S0h, σh_qh, σC_of, σGen, act1]
      · obtain rfl : x = CZh p g m := hx
        simp [CZh, σh_qh, σC_of, σGen]
  | one => rfl
  | mul x y _ _ hx hy => rw [map_mul, Function.End.mul_def, Function.comp_apply, hx, hy]
  | inv x _ hx => rw [← hx (σh (m + 1) x⁻¹ v), ← Function.comp_apply (f := σh (m + 1) x),
      ← Function.End.mul_def, ← map_mul, mul_inv_cancel, map_one]; rfl

theorem xstab_zero : XStab p g 0 := by
  intro x hx hfix
  refine schreier (σh 1) (eX p 0) (K := Kst p g 0) (S := Jgen p g 0) (s₂h p g 0) ?_ ?_ x hx hfix
  · show S0h p g 0 ^ (0 : ZMod p).val ∈ Kst p g 0
    rw [pow_val_zero]; exact Subgroup.one_mem _
  · intro y hy h hh
    rcases hy with ⟨z, rfl⟩ | hy
    · rw [Gh_zero_trivial z, map_one, one_mul, one_mul, inv_mul_cancel]; exact Subgroup.one_mem _
    · rw [Set.mem_singleton_iff] at hy; subst hy
      set u := σh 1 h (eX p 0) with hu
      have h1 : (u 0).1 = 1 := by rw [hu, J_fst hh]; rfl
      rw [map_mul, Function.End.mul_def, Function.comp_apply, ← hu]
      show (S0h p g 0 ^ (σGen p (Gen.gate1 (n := 0) Gate.S) u 0).2.val)⁻¹ *
        (S0h p g 0 * S0h p g 0 ^ (u 0).2.val) ∈ Kst p g 0
      simp only [σGen, act1, Function.update_self, h1]
      have e : ∀ c : ZMod p, S0h p g 0 ^ c.val = Sq p g c := fun c => by
        rw [S0h_zero, Sq_one]; rfl
      rw [e, e, S0h_zero, ← Sq_add]
      convert Subgroup.one_mem (Kst p g 0) using 1
      exact inv_mul_eq_one.mpr (congrArg (Sq p g) (by ring))

/-- One-qudit circuits are complete modulo the Paulis. -/
theorem faith_one : Faith p g 1 := faith_succ zstab_zero xstab_zero faith_zero

end QCert.QuditClifford
