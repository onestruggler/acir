# Small facts about derivations

General lemmas about `Derivable`, used by the Bian–Selinger developments:
powers, transport along a word map that sends axioms to derivable
equations, and sub-presentations through an injective homomorphism.
-/
import QCert.Presentation

namespace QCert

universe u v w

variable {X : Type u} {Γ : WRel X}

theorem Derivable.pow {a b : Word X} (h : Derivable Γ a b) (n : ℕ) :
    Derivable Γ (a ^ n) (b ^ n) := by
  induction n with
  | zero => simpa using Derivable.refl 1
  | succ n ih => rw [pow_succ, pow_succ]; exact ih.mul h

theorem Derivable.mul_left {a b : Word X} (c : Word X) (h : Derivable Γ a b) :
    Derivable Γ (c * a) (c * b) := (Derivable.refl c).mul h

theorem Derivable.mul_right {a b : Word X} (c : Word X) (h : Derivable Γ a b) :
    Derivable Γ (a * c) (b * c) := h.mul (Derivable.refl c)

theorem Derivable.of_eq {a b : Word X} (h : a = b) : Derivable Γ a b := h ▸ Derivable.refl a

theorem Derivable.mono {Δ : WRel X} (hΓΔ : ∀ a b, Γ a b → Derivable Δ a b) {a b : Word X}
    (h : Derivable Γ a b) : Derivable Δ a b := by
  have : conGen Γ ≤ conGen Δ := Con.conGen_le fun a b hab => hΓΔ a b hab
  exact this h

/-- A monoid homomorphism of words that sends every axiom of `Γ` to a
derivable equation of `Δ` sends derivations to derivations. -/
theorem Derivable.map {Y : Type v} {Δ : WRel Y} (φ : Word X →* Word Y)
    (hφ : ∀ a b, Γ a b → Derivable Δ (φ a) (φ b)) {a b : Word X} (h : Derivable Γ a b) :
    Derivable Δ (φ a) (φ b) := by
  have : conGen Γ ≤ (conGen Δ).comap φ (map_mul φ) :=
    Con.conGen_le fun a b hab => hφ a b hab
  exact this h

/-- A sub-presentation read through an injective group homomorphism: the
relations present the subgroup generated by `semG` exactly when they
present the one generated by `semH = φ ∘ semG`. -/
theorem isSubPresentationOf_iff_of_injective {G : Type v} {H : Type w} [Group G] [Group H]
    {semG : X → G} (φ : G →* H) (hφ : Function.Injective φ) {semH : X → H}
    (hsem : ∀ x, φ (semG x) = semH x) :
    IsSubPresentationOf Γ semG ↔ IsSubPresentationOf Γ semH := by
  have hlift : ∀ w : Word X, φ (FreeMonoid.lift semG w) = FreeMonoid.lift semH w := by
    intro w
    induction w using FreeMonoid.inductionOn' with
    | one => simp
    | mul_of x w ih => simp [ih, hsem]
  have heq : ∀ w v : Word X,
      FreeMonoid.lift semG w = FreeMonoid.lift semG v ↔
        FreeMonoid.lift semH w = FreeMonoid.lift semH v := fun w v => by
    rw [← hlift, ← hlift]; exact hφ.eq_iff.symm
  constructor
  · intro P
    exact ⟨P.grouplike, fun w v h => (heq w v).1 (P.sound h),
      fun w v h => P.complete ((heq w v).2 h)⟩
  · intro P
    exact ⟨P.grouplike, fun w v h => (heq w v).2 (P.sound h),
      fun w v h => P.complete ((heq w v).1 h)⟩

end QCert
