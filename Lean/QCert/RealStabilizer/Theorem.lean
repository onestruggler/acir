# Real stabilizer circuits: the presentation

Makary, Ross and Selinger, *Generators and relations for real stabilizer
operators*: the reduced relations R1–R16 of Figure 1 (Definition 5.6), with
the structural rules, present the `n`-qubit real Clifford group, the
subgroup of the orthogonal group `O(2ⁿ)` generated by `-1`, `H`, `Z` and
`CZ` on adjacent qubits, for every `n` (Propositions 4.15 and 5.7).
-/
import QCert.RealStabilizer.Soundness
import QCert.RealStabilizer.Push
import QCert.RealStabilizer.Unique

namespace QCert.RealStabilizer

open Circuit

/-- Every generator has a left inverse modulo the theory. -/
theorem grouplike (n : ℕ) : Grouplike (Theory n) := by
  intro x
  induction x with
  | @gate0 k c =>
    cases c
    exact ⟨FreeMonoid.of (Gen.gate0 Gate.neg), Eqv.rule k Rel.R1⟩
  | @gate1 k c =>
    cases c
    · exact ⟨FreeMonoid.of (Gen.gate1 Gate.H), Eqv.rule k Rel.R3⟩
    · exact ⟨FreeMonoid.of (Gen.gate1 Gate.Z), Eqv.rule k Rel.R2⟩
  | @gate2 k c =>
    cases c
    exact ⟨FreeMonoid.of (Gen.gate2 Gate.CZ), Eqv.rule k Rel.R5⟩
  | gate3 c => exact nomatch c
  | up g ih =>
    obtain ⟨u, hu⟩ := ih
    refine ⟨Circuit.shift u, ?_⟩
    have := Eqv.shift hu
    simpa [map_mul] using this

/-- Proposition 5.7 (with Lemma 5.4): every circuit is equal, by the relations
R1–R16, to a normal circuit: the circuit, followed by the normal form of the
identity, is rewritten with the typed relations of Appendix B (all derived
from R1–R16 in `Relations1`), `Push`. -/
theorem exists_normal (n : ℕ) (w : Circ n) : ∃ N : NF n, Eqv n w N.circ :=
  exists_normal' w

/-- Proposition 4.15: distinct normal circuits denote distinct operators
(`Unique`). -/
theorem normal_unique {n : ℕ} (N N' : NF n) (h : S.sem n N.circ = S.sem n N'.circ) :
    N = N' :=
  normal_unique' N N' h

/-- Completeness: circuits with the same matrix are equal by the relations. -/
theorem complete (n : ℕ) {w w' : Circ n} (h : S.sem n w = S.sem n w') : Eqv n w w' := by
  obtain ⟨N, hN⟩ := exists_normal n w
  obtain ⟨N', hN'⟩ := exists_normal n w'
  have e : S.sem n w = S.sem n N.circ := derivable_sound (theory_sound n) hN
  have e' : S.sem n w' = S.sem n N'.circ := derivable_sound (theory_sound n) hN'
  have : N = N' := normal_unique N N' (by rw [← e, ← e', h])
  subst this
  exact hN.trans hN'.symm

/-- **The presentation** (Propositions 4.15 and 5.7): on every number of
wires, the reduced relations of Figure 1 present the group generated by the
real stabilizer gates, as orthogonal matrices. -/
theorem presentation (n : ℕ) : IsSubPresentationOf (Theory n) (S.gen (n := n)) where
  grouplike := grouplike n
  sound := fun w v h => theory_sound n w v h
  complete := fun _ _ h => complete n h

end QCert.RealStabilizer
