# Real stabilizer circuits: the push tables

The typed relations of Appendix B (`rel1`–`rel139`, `Relations*.lean`) as
tables: a dirty gate immediately before one or two boxes of a normal form
equals boxes followed by dirty gates, which are allowed where they stand
(the labels of Definition 5.3, `okB`, `okD`), and the boxes keep the type of
the wire above them.  Everything is in the relation's own frame (wire `0`
at the bottom); `Push` moves it into place.  Generated by `gen/tables.py`.
-/
import QCert.RealStabilizer.Dirty
import QCert.RealStabilizer.Relations1

namespace QCert.RealStabilizer

set_option maxRecDepth 8000

/-- `Z` at the wire of `A_i`: relations 1–3. -/
theorem tAZ : ∀ i : Fin 3, ∃ (i' : Fin 3) (out : List Dg),
    Holds 1 ([.Z 0] ++ bA (i.val + 1) 0) (bA (i'.val + 1) 0 ++ dw out) ∧
      tA i' = tA i ∧ OkL (okB (tA i') 0) 1 out
  | 0 => ⟨0, [.Z 0], rel1, by decide⟩
  | 1 => ⟨1, [.X 0], rel2, by decide⟩
  | 2 => ⟨2, [.Z 0], rel3, by decide⟩

/-- `H` at the wire of `A_i`: relations 4–6. -/
theorem tAH : ∀ i : Fin 3, ∃ (i' : Fin 3) (out : List Dg),
    Holds 1 ([.H 0] ++ bA (i.val + 1) 0) (bA (i'.val + 1) 0 ++ dw out) ∧
      tA i' = tA i ∧ OkL (okB (tA i') 0) 1 out
  | 0 => ⟨1, [], rel4, by decide⟩
  | 1 => ⟨0, [], rel5, by decide⟩
  | 2 => ⟨2, [.H 0], rel6, by decide⟩

/-- `CZ` with `A_i` on its upper wire: relations 7–9.  Either `A_i` stays,
or the ladder grows down by one wire (`A_{i'}` below a `B` gate). -/
theorem tACZ : ∀ i : Fin 3,
    (∃ (i' : Fin 3) (out : List Dg),
      Holds 2 ([.CZ 0] ++ bA (i.val + 1) 1) (bA (i'.val + 1) 1 ++ dw out) ∧
        tA i' = tA i ∧ OkL (okB (tA i') 1) 2 out) ∨
    (∃ (i' : Fin 3) (j : Fin 4) (out : List Dg),
      Holds 2 ([.CZ 0] ++ bA (i.val + 1) 1)
        (bA (i'.val + 1) 0 ++ bB (bIdx (tA i') j) 0 ++ dw out) ∧
        tB (tA i') j = tA i ∧ OkL (okB (tB (tA i') j) 1) 2 out)
  | 0 => Or.inl ⟨0, [.CZ 0], rel7, by decide⟩
  | 1 => Or.inr ⟨0, 1, [.CZ 0, .H 0], rel8, by decide⟩
  | 2 => Or.inr ⟨0, 3, [.H 1, .CXZ 0, .H 0, .Z 1], rel9, by decide⟩

/-- `CZ` on the wires of `A_i B`, before both: relations 10–21.  Either the
two boxes stay, or the ladder shrinks by one wire (`A_{i'}` on the upper
wire). -/
theorem tAB : ∀ (i : Fin 3) (j : Fin 4),
    (∃ (i' : Fin 3) (j' : Fin 4) (out : List Dg),
      Holds 2 ([.CZ 0] ++ bA (i.val + 1) 0 ++ bB (bIdx (tA i) j) 0)
        (bA (i'.val + 1) 0 ++ bB (bIdx (tA i') j') 0 ++ dw out) ∧
        tB (tA i') j' = tB (tA i) j ∧ OkL (okB (tB (tA i') j') 1) 2 out) ∨
    (∃ (i' : Fin 3) (out : List Dg),
      Holds 2 ([.CZ 0] ++ bA (i.val + 1) 0 ++ bB (bIdx (tA i) j) 0)
        (bA (i'.val + 1) 1 ++ dw out) ∧ tA i' = tB (tA i) j ∧ OkL (okB (tA i') 1) 2 out)
  | 0, 0 => Or.inl ⟨0, 0, [.H 0, .CZ 0, .H 0], rel10, by decide⟩
  | 0, 1 => Or.inr ⟨1, [.H 0, .CZ 0], rel12, by decide⟩
  | 0, 2 => Or.inl ⟨0, 2, [.H 0, .CZ 0, .H 0, .H 0, .Z 0, .H 0], rel14, by decide⟩
  | 0, 3 => Or.inr ⟨2, [.H 0, .CXZ 0, .Z 1, .H 1], rel16, by decide⟩
  | 1, 0 => Or.inl ⟨1, 2, [], rel11, by decide⟩
  | 1, 1 => Or.inl ⟨2, 3, [.CZ 0, .H 0, .CZ 0, .X 1, .Z 0], rel13, by decide⟩
  | 1, 2 => Or.inl ⟨1, 0, [], rel15, by decide⟩
  | 1, 3 => Or.inl ⟨2, 1, [.CXZ 0, .H 0, .CXZ 0, .Z 1, .H 0, .Z 0, .H 0], rel17, by decide⟩
  | 2, 0 => Or.inl ⟨2, 2, [.H 0, .CXZ 0, .H 0], rel18, by decide⟩
  | 2, 1 => Or.inl ⟨1, 3, [.H 0, .CXZ 0, .H 0, .H 1], rel19, by decide⟩
  | 2, 2 => Or.inl ⟨2, 0, [.H 0, .CXZ 0, .H 0, .H 0, .Z 0, .H 0], rel20, by decide⟩
  | 2, 3 => Or.inl ⟨1, 1, [.CZ 0, .H 0, .CZ 0, .X 1, .Z 0], rel21, by decide⟩

