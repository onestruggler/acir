%% ---------------------------------------------------------------------
%% Packages

\RequirePackage{mathtools}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
%% This file lives in pldi/; the style file agda-style.sty, the figures
%% and the bibliography are in ../planqc/.
\def\input@path{{../planqc/}}
\RequirePackage{agda-style}
%% Agda's own style file, for the code blocks that `agda --latex'
%% generated for the qudit Clifford formalization (qudit/agda/).
\RequirePackage{agda}
\renewcommand{\AgdaCodeStyle}{\footnotesize}
\setlength{\mathindent}{1em}
%% Characters of those code blocks that agda-style.sty does not declare.
\DeclareUnicodeCharacter{02E2}{\textsuperscript{s}}
\DeclareUnicodeCharacter{1D47}{\textsuperscript{b}}
\DeclareUnicodeCharacter{1D48}{\textsuperscript{d}}
\DeclareUnicodeCharacter{1D49}{\textsuperscript{e}}
\DeclareUnicodeCharacter{1D56}{\textsuperscript{p}}
\DeclareUnicodeCharacter{1D5B}{\textsuperscript{v}}
\DeclareUnicodeCharacter{1DA0}{\textsuperscript{f}}
\DeclareUnicodeCharacter{1D62}{\textsubscript{i}}
\DeclareUnicodeCharacter{208B}{\textsubscript{-}}
\DeclareUnicodeCharacter{2190}{\ensuremath{\leftarrow}}
\DeclareUnicodeCharacter{2193}{\ensuremath{\downarrow}}
\DeclareUnicodeCharacter{21E3}{\ensuremath{\downarrow}}
\DeclareUnicodeCharacter{224B}{\ensuremath{\approx\!\!\approx}}
\DeclareUnicodeCharacter{00B1}{\ensuremath{\pm}}
\RequirePackage{subcaption}
\RequirePackage{placeins}
\RequirePackage{cleveref}

%% ---------------------------------------------------------------------
%% Figures

%% TikZiT figures. A subset of tikzit.sty (the layer stack, the blank
%% node style and \tikzfig), which would load enumitem, which clashes
%% with acmart. proofs.tikzstyles has the styles of ../planqc/figures/*.tikz.
\RequirePackage{tikz}
\usetikzlibrary{backgrounds,arrows,shapes,shapes.geometric,shapes.misc}
\pgfdeclarelayer{edgelayer}
\pgfdeclarelayer{nodelayer}
\pgfsetlayers{background,edgelayer,nodelayer,main}
\tikzset{tikzit fill/.initial=0,tikzit draw/.initial=0,tikzit shape/.initial=0,tikzit category/.initial=0}
\tikzstyle{none}=[inner sep=0mm]
\tikzstyle{tikzfig}=[baseline=-0.25em,scale=0.7]
\newcommand{\tikzfig}[1]{{\tikzstyle{every picture}=[tikzfig]\input{#1.tikz}}}
\input{../planqc/proofs.tikzstyles}
%% The circuits of the qudit Clifford formalization (qudit/figures/),
%% with their own styles, scaled by a fixed factor so that gate boxes
%% stay proportionate across a grid of circuits.
\usetikzlibrary{arrows.meta}
\definecolor{normGreen}{RGB}{214, 243, 221}
\definecolor{normRed}{RGB}{249, 196, 196}
\definecolor{normYellow}{RGB}{253,246,208}
\definecolor{zxgreen}{RGB}{216,248,216}
\definecolor{zxred}{RGB}{221,165,165}
\definecolor{zxhad}{RGB}{255,255,0}
\definecolor{zxpaulibox}{RGB}{138,159,198}
\input{qudit/circuits.tikzstyles}
\tikzstyle{qtikzfig}=[baseline=-0.25em,scale=0.38]
\newcommand{\ufig}[2][1]{$\vcenter{\hbox{\scalebox{#1}{{\tikzstyle{every picture}=[qtikzfig]\input{qudit/figures/#2.tikz}}}}}$}
%% The comparison of the Agda and Lean formalizations (figures/compare.tex,
%% generated by compare/mkfig.py). Agda blue and Lean orange are the first
%% two slots of a colour-blind-safe categorical palette; Agda's bar is above
%% Lean's and the markers differ, so the figure also reads in greyscale.
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots}
\usetikzlibrary{patterns,calc}
\definecolor{cmpAgda}{HTML}{2A78D6}
\definecolor{cmpLean}{HTML}{EB6834}
\colorlet{cmpAxis}{black!55}
\colorlet{cmpGrid}{black!12}
\tikzset{cmpLink/.style={black!30, line width=0.7pt}}

%% ---------------------------------------------------------------------
%% Citations and environments

\citestyle{acmnumeric}
%% Table 1 keeps author-year citations: ``Greylyn [2014]''.
\newcommand{\tabcite}[1]{\citeauthor{#1}~[\citeyear{#1}]}
%% A remark, in the style of acmart's definitions (defined after acmart's
%% own theorem environments, so that it can share their counter).
\AtEndPreamble{\theoremstyle{acmdefinition}\newtheorem{remark}[theorem]{Remark}}
%% Named ``Bian, Li et al.'' (authors in alphabetical order), as a link.
\defcitealias{bian2026qupit}{Bian, Li et al.}
\newcommand{\quditcite}{\citetalias{bian2026qupit}~\cite{bian2026qupit}}

%% ---------------------------------------------------------------------
%% Macros

\newcommand{\rewrites}[1]{\overset{#1^{*}}{\longleftrightarrow}}
%% Inline Agda identifiers, in a sans-serif face.
\newcommand{\aid}[1]{\mbox{\textsf{\small #1}}}
%% A numbered, referenceable line of quoted Agda: end the line of an
%% agdacode block with escapechar=@ in @\agdatag{label}@.
\newcounter{agdastmt}
\crefname{agdastmt}{statement}{statements}
\Crefname{agdastmt}{Statement}{Statements}
\creflabelformat{agdastmt}{(#2#1#3)}
\newcommand{\agdatag}[1]{\hfill\normalfont\normalsize
  \refstepcounter{agdastmt}(\theagdastmt)\label{#1}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\D}{\mathbb{D}}
%% Notation of the qudit Clifford formalization (\Cref{sec:qudit}).
\newcommand{\Zp}{\ensuremath{\mathbb{Z}_p}}
\newcommand{\Sp}[1][n]{\ensuremath{\mathrm{Sp}(2#1,\mathbb{Z}_p)}}
\newcommand{\Pauli}[1][n]{\ensuremath{\mathcal{P}_{#1}}}
\newcommand{\Cliff}[1][n]{\ensuremath{\mathcal{C}_{#1}}}
\newcommand{\PCliff}[1][n]{\ensuremath{\overline{\mathcal{C}}_{#1}}}
\newcommand{\PPauli}[1][n]{\ensuremath{\overline{\mathcal{P}}_{#1}}}
\newcommand{\ket}[1]{\ensuremath{|#1\rangle}}
\newcommand{\sem}[1]{\ensuremath{[\![#1]\!]}}
\newcommand{\ML}{\ensuremath{\mathit{ML}}}

%% ---------------------------------------------------------------------
%% Page layout

%% Disable line-height rounding, which otherwise enlarges the text area
%% at 10pt. The top and bottom margins are smaller than acmsmall's
%% (58pt and 44pt), so that Figure 1 fits on the first page after the
%% paragraph that introduces it. The text area is about 5.478in by
%% 8.658in, where acmsmall's is 5.478in by 7.884in.
\geometry{heightrounded=false,top=30pt,bottom=16pt}

\endinput
