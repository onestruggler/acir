%% ---------------------------------------------------------------------
%% Citations and environments

\citestyle{acmnumeric}
%% Table 1 keeps author-year citations: ``Greylyn [2014]''.
\newcommand{\tabcite}[1]{\citeauthor{#1}~[\citeyear{#1}]}
%% A remark, in the style of acmart's definitions (defined after acmart's
%% own theorem environments, so that it can share their counter).
\AtEndPreamble{\theoremstyle{acmdefinition}\newtheorem{remark}[theorem]{Remark}}
%% acmart's proposition, lemma and corollary share the counter of its
%% theorem, as the remark above does, so cleveref would name a reference
%% to any of them ``Theorem''. Each environment says what it is.
\AtBeginEnvironment{proposition}{\crefalias{theorem}{proposition}}
\AtBeginEnvironment{lemma}{\crefalias{theorem}{lemma}}
\AtBeginEnvironment{corollary}{\crefalias{theorem}{corollary}}
\AtBeginEnvironment{remark}{\crefalias{theorem}{remark}}
%% Keep a theorem that holds a list on one page: no page break between
%% its lines, before the list or between the items. Say \keeptogether at
%% the start of the theorem.
\newcommand{\keeptogether}{\interlinepenalty\@M\@beginparpenalty\@M\@itempenalty\@M}
%% Named ``Bian, Li et al.'' (authors in alphabetical order), as a link.
\defcitealias{bian2026qupit}{Bian, Li et al.}
\newcommand{\quditcite}{\citetalias{bian2026qupit}~\cite{bian2026qupit}}

%% ---------------------------------------------------------------------
%% Macros

\newcommand{\rewrites}[1]{\overset{#1^{*}}{\longleftrightarrow}}
%% Inline Agda identifiers, in a sans-serif face.
\newcommand{\aid}[1]{\mbox{\textsf{\small #1}}}
%% Operator and relation variants for math mode, so that $c \aidop{•} c'$
%% is set like c • c' rather than c•c'.
\newcommand{\aidop}[1]{\ifmmode\mathbin{\aid{#1}}\else\aid{#1}\fi}
\newcommand{\aidrel}[1]{\ifmmode\mathrel{\aid{#1}}\else\aid{#1}\fi}
%% A numbered, referenceable line of quoted Agda: end the line of an
%% agdacode block with escapechar=@ in @\agdatag{label}@.
\newcounter{agdastmt}
\crefname{agdastmt}{statement}{statements}
\Crefname{agdastmt}{Statement}{Statements}
\creflabelformat{agdastmt}{(#2#1#3)}
\newcommand{\agdatag}[1]{\hfill\normalfont\normalsize
  \refstepcounter{agdastmt}(\theagdastmt)\label{#1}}
%% The rules of the theory T of four-bit reversible circuits
%% (\Cref{sec:xcxccx}).
\newcommand{\xrule}[1]{\textup{(T#1)}}
%% Gates, upright, in text or in math. \H, \S and \Z are taken (LaTeX's
%% accent and section sign, and the integers below), so the gates H, S
%% and Z are \Hg, \Sg and \Zg. In text, write \T{} before a space.
\newcommand{\X}{\ensuremath{\mathrm{X}}}
\newcommand{\CX}{\ensuremath{\mathrm{CX}}}
\newcommand{\CCX}{\ensuremath{\mathrm{CCX}}}
\newcommand{\Hg}{\ensuremath{\mathrm{H}}}
\newcommand{\Sg}{\ensuremath{\mathrm{S}}}
\newcommand{\Zg}{\ensuremath{\mathrm{Z}}}
\newcommand{\T}{\ensuremath{\mathrm{T}}}
\newcommand{\F}{\ensuremath{\mathrm{F}}}
\newcommand{\K}{\ensuremath{\mathrm{K}}}
\newcommand{\CZ}{\ensuremath{\mathrm{CZ}}}
\newcommand{\CS}{\ensuremath{\mathrm{CS}}}
\newcommand{\CH}{\ensuremath{\mathrm{CH}}}
\newcommand{\CCZ}{\ensuremath{\mathrm{CCZ}}}
%% An equals sign between two circuit drawings, with the same space
%% on both sides whatever spaces the drawings leave around it.
\newcommand{\xeq}{\unskip\enspace$=$\enspace\ignorespaces}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\D}{\mathbb{D}}
%% Notation of the qudit Clifford formalization (\Cref{sec:qudit}).
\newcommand{\Zp}{\ensuremath{\mathbb{Z}_p}}
\newcommand{\Sp}[1][n]{\ensuremath{\mathrm{Sp}(2#1,\mathbb{Z}_p)}}
\newcommand{\Pauli}[1][n]{\ensuremath{\mathcal{P}_{#1}}}
\newcommand{\Cliff}[1][n]{\ensuremath{\mathcal{C}_{#1}}}
\newcommand{\PCliff}[1][n]{\ensuremath{\overline{\mathcal{C}}_{#1}}}
\newcommand{\PPauli}[1][n]{\ensuremath{\overline{\mathcal{P}}_{#1}}}
\newcommand{\ket}[1]{\ensuremath{|#1\rangle}}
\newcommand{\sem}[1]{\ensuremath{[\![#1]\!]}}
\newcommand{\ML}{\ensuremath{\mathit{ML}}}

