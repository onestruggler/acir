\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=overview box] (symplectic) at (0, 0) {Symplectic group $\Sp$\\unique normal forms};
		\node [style=overview box] (pauli) at (7.15, 0) {Pauli phase space $V$\\presentation over $\X,\Zg$};
		\node [style=overview box] (projective) at (0, -2.25) {Projective model\\$V\rtimes\Sp$};
		\node [style=overview box] (projrules) at (7.15, -2.25) {Source rules\\modulo scalar phases};
		\node [style=overview box] (exact) at (0, -4.5) {Exact model\\including scalar phases};
		\node [style=overview box] (exactrules) at (7.15, -4.5) {Source rules\\with scalar phases};
		\node [style=overview label, text width=3.7cm] (label1) at (3.58, -1.1) {verified semidirect-product\\theorem};
		\node [style=overview label, anchor=west, text width=3.1cm] (label2) at (0.18, -3.375) {scalar extension\\and direct product};
		\node [style=none] (w1) at (4.823, -0.551) {};
		\node [style=none] (w2) at (2.327, -1.699) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=overview arrow] (symplectic) to (projective);
		\draw [style=overview arrow] (w1.center) to (w2.center);
		\draw [style=overview arrow] (projective) to node [style=overview label, above=2pt, text width=1.95cm] {verified\\translations} (projrules);
		\draw [style=overview arrow] (projective) to (exact);
		\draw [style=overview arrow] (exact) to node [style=overview label, above=2pt, text width=1.95cm] {verified\\translations} (exactrules);
	\end{pgfonlayer}
\end{tikzpicture}
