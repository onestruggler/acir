\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=frag family] (integral) at (0, 0) {Integral~\cite{amy2020numbertheoretic}\\$\{\X,\CX,\CCX,\Hg\otimes \Hg\}$ \nodepart{two}$O_n(\D)$~\cite{li2021on} \nodepart{three}$\{(-1)_{[a]},\X_{[a,b]},$\\ $\phantom{\{}(\Hg\otimes \Hg)_{[a,b,c,d]}\}$};
		\node [style=frag family] (th) at (4.6, 3.3) {Toffoli--Hadamard~\cite{amy2020numbertheoretic}\\$\{\Hg,\Zg,\CZ,\CCZ\}$ \nodepart{two}$\left\{\begin{array}{@{}l@{}} \left(1/\sqrt{2}^{q}\right)\,M\in O_n(\mathbb R):\\[-1pt] M\in\Z^{n\times n},\ q\in\mathbb N \end{array}\right\}$\\[-1pt] \cite{li2021on} \nodepart{three}$\{(-1)_{[a]},(\Hg\otimes \Hg)_{[a,b,c,d]},$\\ $\phantom{\{}I_{n/2}\otimes \Hg\}$};
		\node [style=frag family] (gaussian) at (9.2, 0) {Gaussian~\cite{amy2020numbertheoretic}\\$\{\omega \Hg,\Sg,\CZ,\CCZ\}$ \nodepart{two}$U_n(\D[i])$~\cite{bian2021un} \nodepart{three}$\{i_{[a]},(\omega \Hg)_{[a,b]}\}$};
		\node [style=frag family] (imaginary) at (0, 7.8) {Imaginary~\cite{amy2020numbertheoretic}\\$\{\F,\Zg,\CZ,\CCZ\}$ \nodepart{two}$U_n(\D[i\sqrt2])$ \nodepart{three}$\{(-1)_{[a]},\F_{[a,b]}\}$};
		\node [style=frag family] (real) at (4.6, 7.8) {Real~\cite{amy2020numbertheoretic}\\$\{\Hg,\Zg,\CZ,\CCZ,\CH\}$ \nodepart{two}$O_n(\D[\sqrt2])$~\cite{fang2026hadamard} \nodepart{three}$\{(-1)_{[a]},\Hg_{[a,b]}\}$};
		\node [style=frag family] (supergaussian) at (9.2, 7.8) {Super-Gaussian~\cite{amy2020numbertheoretic}\\$\{\Hg,\Sg,\CZ,\CCZ\}$ \nodepart{two}$\left\{\begin{array}{@{}l@{}} \left(1/\sqrt{2}^{q}\right)\,M\in U_n(\mathbb C):\\[-1pt] M\in\Z[i]^{n\times n},\ q\in\mathbb N \end{array}\right\}$ \nodepart{three}$\{i_{[a]},(\omega \Hg)_{[a,b]},\omega I_n\}$};
		\node [style=frag family] (ct) at (4.6, 11.9) {Clifford+\T~\cite{giles2013exact}\\$\{\Hg,\T,\CZ\}$ \nodepart{two}$U_n(\D[\omega])$ \nodepart{three}$\{\omega_{[a]},\Hg_{[a,b]}\}$};
		\node [style=frag finite] (rcliff) at (13.9, 0) {Real Clifford~\cite{makary2021real}\\$\{\Hg,\Zg,\CZ\}$};
		\node [style=frag finite] (cliff) at (13.9, 3.3) {Clifford~\cite{selinger2015clifford}\\$\{\Hg,\Sg,\CZ\}$};
		\node [style=frag finite] (dihedral) at (13.9, 11.9) {CNOT-dihedral~\cite{amy2018cnotdihedral}\\$\{\X,\T,\CX\}$};
		\node [style=frag shared] (rch) at (0, 3.3) {Real Clifford+\CH~\cite{clement2026realcliffordch}\\ $\{\Hg,\Zg,\CZ,\CH\}$};
		\node [style=frag shared] (cs) at (13.9, 6.5) {Clifford+\CS~\cite{bian2023cliffordcs3}\\ $\{\omega \Hg,\Sg,\CS\}$};
		\node [style=frag shared] (csomega) at (13.9, 9.2) {Clifford+\CS+$\omega$~\cite{glaudell2021optimal}\\ $\{\Hg,\Sg,\CS\}$};
		\node [style=frag legend] (legend) at (0, 11.9) {\begin{tabular}{@{}ll@{}} \colorbox{fragmentMint}{\rule{0pt}{1ex}\hspace{1.5ex}} & Circuit gate sets\\ \colorbox{fragmentRose}{\rule{0pt}{1ex}\hspace{1.5ex}} & Gate sets sharing a group\\ \colorbox{fragmentBlue}{\rule{0pt}{1ex}\hspace{1.5ex}} & Matrix groups\\ \colorbox{fragmentLavender}{\rule{0pt}{1ex}\hspace{1.5ex}} & Multi-level generators\\ \colorbox{fragmentIvory}{\rule{0pt}{1ex}\hspace{1.5ex}} & Finite circuit groups \end{tabular}};
		\node [style=none] (w1) at (-2.5, 0) {};
		\node [style=none] (w2) at (-2.5, 7.8) {};
		\node [style=none] (w3) at (12.8, 1.9) {};
		\node [style=none] (w4) at (7.4, 1.9) {};
		\node [style=none] (w5) at (11.7, 0) {};
		\node [style=none] (w6) at (11.7, 6.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=frag arrow] (integral) to (th);
		\draw [style=frag path start] (integral) to (w1.center);
		\draw [style=frag path] (w1.center) to (w2.center);
		\draw [style=frag path end] (w2.center) to (imaginary);
		\draw [style=frag arrow] (integral) to (gaussian);
		\draw [style=frag arrow] (rcliff) to (cliff);
		\draw [style=frag arrow] (th) to (real);
		\draw [style=frag arrow] (th) to (supergaussian);
		\draw [style=frag arrow] (gaussian) to (supergaussian);
		\draw [style=frag arrow] (cliff) to (supergaussian);
		\draw [style=frag underlay start] (rcliff) to (w3.center);
		\draw [style=frag underlay] (w3.center) to (w4.center);
		\draw [style=frag underlay end] (w4.center) to (th);
		\draw [style=frag path start] (rcliff) to (w3.center);
		\draw [style=frag path] (w3.center) to (w4.center);
		\draw [style=frag path end] (w4.center) to (th);
		\draw [style=frag arrow] (rch) to (real);
		\draw [style=frag underlay start] (gaussian) to (w5.center);
		\draw [style=frag underlay] (w5.center) to (w6.center);
		\draw [style=frag underlay end] (w6.center) to (cs);
		\draw [style=frag path start] (gaussian) to (w5.center);
		\draw [style=frag path] (w5.center) to (w6.center);
		\draw [style=frag path end] (w6.center) to (cs);
		\draw [style=frag arrow] (supergaussian) to (csomega);
		\draw [style=frag arrow] (cs) to (csomega);
		\draw [style=frag arrow] (csomega) to (ct);
		\draw [style=frag arrow] (imaginary) to (ct);
		\draw [style=frag arrow] (real) to (ct);
		\draw [style=frag arrow] (supergaussian) to (ct);
		\draw [style=frag arrow] (dihedral) to (ct);
	\end{pgfonlayer}
\end{tikzpicture}
