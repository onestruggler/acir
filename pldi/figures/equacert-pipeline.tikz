% Section 1 overview. All artwork is native TikZ and remains editable.
\begingroup
\definecolor{pipelineBlue}{HTML}{205886}
% Cool emerald and mint for human validation.
\definecolor{pipelineGreen}{HTML}{32866B}
\definecolor{pipelineGreenText}{HTML}{23674F}
\definecolor{pipelineMint}{HTML}{EFF9F3}
\definecolor{pipelineMintAccent}{HTML}{BCE5CE}
\definecolor{pipelineYellow}{HTML}{D6BA2B}
\definecolor{pipelineYellowAccent}{HTML}{F3D34A}
\definecolor{pipelineInk}{HTML}{233447}
\begin{tikzpicture}[
  x=1cm,y=1cm,
  line cap=round,line join=round,
  pipe arrow/.style={-{Stealth[length=1.6mm,width=1.5mm]},
    draw=pipelineInk,line width=.85pt},
  alignment arrow/.style={{Stealth[length=1.9mm,width=1.7mm]}-{Stealth[length=1.9mm,width=1.7mm]},
    draw=pipelineGreen,line width=1.3pt},
  pipe title/.style={font=\sffamily\bfseries\fontsize{8}{9.4}\selectfont,
    align=center,text=pipelineInk,text width=2.05cm,inner sep=0pt},
  pipe detail/.style={font=\sffamily\fontsize{7.2}{8.5}\selectfont,
    align=center,text=pipelineInk,text width=2.05cm,inner sep=0pt,anchor=north},
  icon/.style={draw=pipelineBlue,line width=1.15pt},
  icon line/.style={draw=pipelineBlue,line width=.8pt}
]
% The human comparison is the dominant panel, not a minor pipeline step.
\fill[rounded corners=2.5mm,pipelineBlue!4]
  (6.87,-1.83) rectangle (13.53,1.84);
\path[rounded corners=2.5mm,draw=pipelineGreen,
  fill=pipelineMint,line width=.8pt]
  (-.10,-1.83) rectangle (6.68,1.84);
\node[font=\sffamily\bfseries\fontsize{8.6}{10}\selectfont,
  text=pipelineGreenText,inner sep=0pt] at (3.29,1.55)
  {1. Human check: theorem alignment};
\node[font=\sffamily\fontsize{7.5}{9}\selectfont,
  text=pipelineBlue,inner sep=0pt] at (10.20,1.55)
  {LLM proof construction and machine checking};

\node[pipe title] at (.95,1.01) {Paper's\\result};
\node[pipe title,font=\sffamily\bfseries\fontsize{8.8}{10}\selectfont]
  at (5.55,1.01) {EquaCert\\main theorem};
\node[pipe title] at (7.85,1.01) {2. Formalize\\the proof};
\node[pipe title] at (10.15,1.01) {3. Proof\\checking};
\node[pipe title] at (12.45,1.01) {Faithful\\formalization};

% Source paper, with a circuit and equation.
\begin{scope}[shift={(.95,0)},
  icon/.append style={draw=pipelineGreen},
  icon line/.append style={draw=pipelineGreen}]
  \path[icon,fill=white] (-.35,-.43) -- (.35,-.43) -- (.35,.22)
    -- (.13,.44) -- (-.35,.44) -- cycle;
  \draw[icon line] (.13,.44) -- (.13,.22) -- (.35,.22);
  \draw[icon line] (-.23,.13) -- (.21,.13);
  \draw[icon line] (-.23,-.04) -- (.21,-.04);
  \path[icon line,fill=pipelineMintAccent] (-.09,-.13) rectangle (.09,.04);
  \draw[icon line] (-.23,-.25) -- (.21,-.25);
  \fill[pipelineBlue] (0,-.25) circle (.025);
\end{scope}

% The main theorem is the interface humans compare with the paper.
\begin{scope}[shift={(5.55,0)},
  icon/.append style={draw=pipelineGreen},
  icon line/.append style={draw=pipelineGreen}]
  \path[icon,fill=white,rounded corners=.7mm] (-.39,-.43) rectangle (.39,.38);
  \path[icon line,fill=pipelineMintAccent,rounded corners=.5mm]
    (-.17,.28) rectangle (.17,.45);
  \foreach \b in {.13,-.06,-.25} {
    \draw[icon line] (-.26,\b) -- (-.22,\b-.04) -- (-.14,\b+.05);
    \draw[icon line] (-.04,\b) -- (.25,\b);
  }
\end{scope}

% Proof construction by coding agents.
\begin{scope}[shift={(7.85,0)}]
  \path[icon,fill=white,rounded corners=.7mm] (-.48,-.36) rectangle (.48,.36);
  \draw[icon line] (-.48,.18) -- (.48,.18);
  \foreach \a in {-.35,-.25,-.15} \fill[pipelineBlue] (\a,.27) circle (.02);
  \draw[icon] (-.20,.05) -- (-.31,-.06) -- (-.20,-.17);
  \draw[icon] (.20,.05) -- (.31,-.06) -- (.20,-.17);
  \draw[draw=pipelineYellow,line width=1.25pt] (.06,.06) -- (-.06,-.19);
\end{scope}

% Proof-assistant check.
\begin{scope}[shift={(10.15,0)}]
  \path[icon,fill=white] (0,.46) -- (.39,.29) -- (.34,-.14)
    .. controls (.29,-.31) and (.13,-.41) .. (0,-.48)
    .. controls (-.13,-.41) and (-.29,-.31) .. (-.34,-.14)
    -- (-.39,.29) -- cycle;
  \draw[draw=pipelineYellow,line width=2pt]
    (-.18,-.01) -- (-.04,-.15) -- (.22,.14);
\end{scope}

% Verified theorem.
\begin{scope}[shift={(12.45,0)}]
  \path[icon,fill=white,rounded corners=.6mm] (-.37,-.40) rectangle (.37,.42);
  \node[font=\bfseries\fontsize{14}{14}\selectfont,text=pipelineBlue,
    inner sep=0pt] at (0,.17) {$\vdash$};
  \draw[icon line] (-.22,-.04) -- (.22,-.04);
  \draw[icon line] (-.22,-.18) -- (.10,-.18);
  \path[draw=pipelineBlue,line width=.9pt,fill=pipelineYellowAccent]
    (.26,-.33) circle (.17);
  \draw[icon line] (.18,-.33) -- (.24,-.39) -- (.35,-.27);
\end{scope}

% Humans compare meaning; the proof assistant checks the proof term.
\draw[alignment arrow] (1.63,0) -- (4.87,0);
\node[font=\sffamily\bfseries\fontsize{8}{9.4}\selectfont,
  text=pipelineGreenText,align=center,inner sep=0pt]
  at (3.25,.25) {Same mathematical};
\node[font=\sffamily\bfseries\fontsize{8}{9.4}\selectfont,
  text=pipelineGreenText,align=center,inner sep=0pt]
  at (3.25,-.25) {statement?};
\foreach \a/\b in {6.17/7.23,8.47/9.53,10.77/11.83}
  \draw[pipe arrow] (\a,0) -- (\b,0);

\node[pipe detail] at (.95,-.62) {Claim stated\\in the paper};
\node[pipe detail] at (5.55,-.62) {Theorem stated\\in Lean / Agda};
\node[pipe detail] at (7.85,-.62) {LLM guided by the\\paper's argument};
\node[pipe detail,text width=2.2cm] at (10.15,-.62) {Lean / Agda checks\\the formal proof};
\node[pipe detail] at (12.45,-.62) {Aligned claim +\\checked proof};

\node[font=\sffamily\fontsize{7.2}{8.5}\selectfont,
  text=pipelineInk,align=center,inner sep=0pt,text width=6.2cm]
  at (3.29,-1.43) {\textbf{Only manual audit: theorem and definitions}};
\node[font=\sffamily\fontsize{7.5}{9}\selectfont,
  text=pipelineBlue,align=center,inner sep=0pt] at (10.20,-1.43)
  {Generated proofs need no manual audit};

\end{tikzpicture}
\endgroup
