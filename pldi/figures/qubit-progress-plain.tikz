\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=status family] (integral) at (0, 0) {Integral~\cite{amy2024toffoli}\\ $k\le2:\ {-}\quad k=3:\ \pchecked^{\ast}$\\ $k\ge4:\ \popen$ \nodepart{two}$O_n(\D)\quad\pchecked$~\cite{li2021on}};
		\node [style=status family] (th) at (4.05, 2.9) {Toffoli--Hadamard~\cite{amy2024toffoli}\\ $k\le2:\ \pchecked\quad k=3:\ \pchecked^{\ast}$\\ $k\ge4:\ \popen$ \nodepart{two}$L_n\quad\pchecked$~\cite{li2021on}\\ $n\ \text{even}$};
		\node [style=status family] (gaussian) at (8.1, 0) {Gaussian\\ $k\le3:\ {-}\quad k\ge4:\ \popen$ \nodepart{two}$U_n(\D[i])\quad\pchecked$~\cite{bian2021un}};
		\node [style=status family] (imaginary) at (0, 6.8) {Imaginary\\ ${-}$ \nodepart{two}$U_n(\D[i\sqrt2])\quad{-}$};
		\node [style=status family] (real) at (4.05, 6.8) {Real\\ $k\le2:\ \pchecked\quad k=3:\ \popen$\\ $k\ge4:\ {-}$ \nodepart{two}$O_n(\D[\sqrt2])\quad\pchecked^{\ast}$\\ \cite{fang2026hadamard,clement2019thesis}};
		\node [style=status family] (supergaussian) at (8.1, 6.8) {Super-Gaussian\\ $k\le2:\ \pchecked\quad k=3:\ {-}$\\ $k\ge4:\ \popen$ \nodepart{two}$\langle\omega I_n\rangle\,U_n(\D[i])\quad{-}$};
		\node [style=status family] (ct) at (4.05, 10.5) {Clifford+\T~\cite{bian2023cliffordt2,blake2026simpler}\\ $k\le2:\ \pchecked\quad k\ge3:\ \popen$ \nodepart{two}$U_n(\D[\omega])$~\cite{greylyn2014}\\ $n\le4:\ \pchecked\quad n\ge5:\ \popen$};
		\node [style=status finite] (rcliff) at (12.2, 0) {Real Clifford~\cite{makary2021real}\\$\pchecked$};
		\node [style=status finite] (cliff) at (12.2, 2.9) {Clifford~\cite{selinger2015clifford}\\$\pchecked$};
		\node [style=status finite] (dihedral) at (12.2, 10.5) {CNOT-dihedral~\cite{amy2018cnotdihedral}\\$\pchecked$};
		\node [style=status shared] (rch) at (0, 2.9) {Real Clifford+\CH~\cite{clement2026realcliffordch}\\$\pchecked$};
		\node [style=status shared] (cs) at (12.2, 5.6) {Clifford+\CS~\cite{bian2023cliffordcs3,glaudell2021optimal}\\ $k\le2:\ \pdone\quad k=3:\ \pchecked$\\ $k\ge4:\ \popen$};
		\node [style=status shared] (csomega) at (12.2, 8.1) {Clifford+\CS+$\omega$~\cite{blake2026simpler}\\ $k\le3:\ \pchecked\quad k\ge4:\ \popen$};
		\node [style=status legend] (legend) at (0, 10.7) {\begin{tabular}{@{}cl@{}} $\pdone$ & Complete relations\\ $\pchecked$ & Checked in EquaCert\\ $\popen$ & Open\\ $-$ & Not treated\\ $\ast$ & Source repaired (\S\ref{sec:findings}) \end{tabular}\\[3pt] Unqualified: all widths.\\ \colorbox{fragmentMint}{\rule{0pt}{1ex}\hspace{1ex}} Circuits ($k$ qubits)\\ \colorbox{fragmentRose}{\rule{0pt}{1ex}\hspace{1ex}} Circuits sharing a group\\ \colorbox{fragmentBlue}{\rule{0pt}{1ex}\hspace{1ex}} Matrices (dimension $n$)\\ \colorbox{fragmentIvory}{\rule{0pt}{1ex}\hspace{1ex}} Finite circuit groups};
		\node [style=none] (w1) at (-2.15, 0) {};
		\node [style=none] (w2) at (-2.15, 6.8) {};
		\node [style=none] (w3) at (11.0, 1.65) {};
