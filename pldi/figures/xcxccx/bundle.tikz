\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-2.25, 0) {};
		\node [style=none] (1) at (-1.25, 0) {};
		\node [style=none] (2) at (-1.85, -0.15) {};
		\node [style=none] (3) at (-1.65, 0.15) {};
		\node [style=none] (4) at (-0.75, 0) {$=$};
		\node [style=none] (5) at (-0.25, 0.75) {};
		\node [style=none] (6) at (0.75, 0.75) {};
		\node [style=none] (7) at (-0.25, 0.25) {};
		\node [style=none] (8) at (0.75, 0.25) {};
		\node [style=none] (9) at (0.25, -0.1) {$\vdots$};
		\node [style=none] (10) at (-0.25, -0.75) {};
		\node [style=none] (11) at (0.75, -0.75) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=rev wire] (0.center) to (1.center);
		\draw [style=rev wire] (2.center) to (3.center);
		\draw [style=rev wire] (5.center) to (6.center);
		\draw [style=rev wire] (7.center) to (8.center);
		\draw [style=rev wire] (10.center) to (11.center);
