	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (4) at (-3.5, 1.25) {};
		\node [style=none] (8) at (-3.5, 4.25) {};
		\node [style=none] (9) at (-2, 1.25) {};
		\node [style=none] (13) at (-2, 4.25) {};
		\node [style=none] (42) at (2, 1.25) {};
		\node [style=none] (43) at (2, 4.25) {};
		\node [style=none] (44) at (3.5, 1.25) {};
		\node [style=none] (48) at (3.5, 4.25) {};
		\node [style=boitecircuit] (53) at (0, 2.75) {$C$};
		\node [style=msdiagrammevide] (54) at (0, -3.75) {};
		\node [style=dot] (55) at (-2.75, 2) {};
		\node [style=dot] (56) at (-2.75, 3.5) {};
		\node [style=dot] (57) at (-2.75, 2.75) {};
