% Adapted from swapswap-xxs.tikz in Figure 1 of Clement,
% A Complete Equational Theory for Real-Clifford+CH Quantum Circuits
% (arXiv:2602.06644v1), supplied in local/clement-real-cli-ch.zip.
\begin{tikzpicture}[scale=0.4]
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (0, -1) {};
		\node [style=none] (1) at (0, 1) {};
		\node [style=none] (2) at (-2.5, -1) {};
		\node [style=none] (3) at (2.5, -1) {};
		\node [style=none] (4) at (2.5, -1) {};
		\node [style=none] (5) at (-2.5, 1) {};
		\node [style=none] (6) at (2.5, 1) {};
		\node [style=none] (7) at (-3.5, 1) {};
		\node [style=none] (8) at (3.5, 1) {};
		\node [style=none] (9) at (3.5, -1) {};
		\node [style=none] (10) at (-3.5, -1) {};
		\node [style=none] (11) at (-2.5, 1) {};
		\node [style=none] (12) at (0, 1) {};
		\node [style=none] (13) at (0, -1) {};
		\node [style=none] (14) at (-2.5, -1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=new, in=0, out=180, looseness=0.75] (3.center) to (1.center);
		\draw [style=new, in=0, out=180, looseness=0.75] (6.center) to (0.center);
		\draw [style=new] (7.center) to (5.center);
		\draw [style=new] (10.center) to (2.center);
		\draw [style=new] (6.center) to (8.center);
		\draw [style=new] (4.center) to (9.center);
		\draw [style=new, in=0, out=180, looseness=0.75] (13.center) to (11.center);
		\draw [style=new, in=0, out=180, looseness=0.75] (12.center) to (14.center);
	\end{pgfonlayer}
\end{tikzpicture}
