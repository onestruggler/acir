%% agda-style.sty — listings setup for quoting Agda code under pdflatex.
%%
%% Strategy: all Agda snippets go through the `listings' package with a
%% `literate' table translating every Unicode character that occurs in
%% quoted code into a LaTeX rendition.  This keeps the paper buildable
%% with plain pdflatex; lualatex also works and then renders running
%% text Unicode natively.
%%
%% DISCIPLINE: every non-ASCII character appearing inside an lstlisting
%% must have an entry in the literate table below.  The QA pass checks
%% this mechanically.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{agda-style}[2026/07/09 Agda listings for the paper]

\RequirePackage{listings}
%% acmart's newtxmath usually provides the AMS symbols; only fall back
%% to amssymb when it does not (avoids the known acmart/amssymb clash).
\ifdefined\rtimes\else\RequirePackage{amssymb}\fi

\lstdefinelanguage{Agda}{
  sensitive=true,
  morekeywords={abstract,constructor,data,do,field,hiding,import,in,
    infix,infixl,infixr,instance,let,module,mutual,open,pattern,
    postulate,primitive,private,public,record,renaming,rewrite,
    syntax,using,variable,where,with},
  morecomment=[l]{--},
  morecomment=[n]{\{-}{-\}},
  morestring=[b]",
}

\lstset{
  language=Agda,
  basicstyle=\small\ttfamily,
  keywordstyle=\bfseries,
  commentstyle=\itshape\color[gray]{0.35},
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  xleftmargin=1.5em,
  breaklines=false,
  literate=
  % --- subscript digits and signs -----------------------------------
    {₀}{{\textsubscript{0}}}1 {₁}{{\textsubscript{1}}}1
    {₂}{{\textsubscript{2}}}1 {₃}{{\textsubscript{3}}}1
    {₄}{{\textsubscript{4}}}1 {₅}{{\textsubscript{5}}}1
    {₆}{{\textsubscript{6}}}1 {₇}{{\textsubscript{7}}}1
    {₈}{{\textsubscript{8}}}1 {₉}{{\textsubscript{9}}}1
    {₊}{{\textsubscript{+}}}1
  % --- subscript letters --------------------------------------------
    {ₗ}{{\textsubscript{l}}}1 {ᵣ}{{\textsubscript{r}}}1
    {ₚ}{{\textsubscript{p}}}1 {ₙ}{{\textsubscript{n}}}1
    {ₖ}{{\textsubscript{k}}}1 {ₛ}{{\textsubscript{s}}}1
  % --- superscripts -------------------------------------------------
    {ʷ}{{\textsuperscript{w}}}1 {ᵗ}{{\textsuperscript{t}}}1
    {ʰ}{{\textsuperscript{h}}}1 {ⁿ}{{\textsuperscript{n}}}1
    {ᵏ}{{\textsuperscript{k}}}1 {ˡ}{{\textsuperscript{l}}}1
    {ᵐ}{{\textsuperscript{m}}}1 {ʳ}{{\textsuperscript{r}}}1
    {ᶜ}{{\textsuperscript{c}}}1
    {⁻¹}{{\textsuperscript{-1}}}2 {⁻}{{\textsuperscript{-}}}1
    {¹}{{\textsuperscript{1}}}1 {²}{{\textsuperscript{2}}}1
    {′}{{\ensuremath{'}}}1
  % --- greek and letterlike -----------------------------------------
    {Γ}{{\ensuremath{\Gamma}}}1 {Δ}{{\ensuremath{\Delta}}}1
    {ε}{{\ensuremath{\varepsilon}}}1 {λ}{{\ensuremath{\lambda}}}1
    {σ}{{\ensuremath{\sigma}}}1 {φ}{{\ensuremath{\varphi}}}1
    {π}{{\ensuremath{\pi}}}1 {ℓ}{{\ensuremath{\ell}}}1
    {ω}{{\ensuremath{\omega}}}1 {ζ}{{\ensuremath{\zeta}}}1
    {Λ}{{\ensuremath{\Lambda}}}1
    {ℕ}{{\ensuremath{\mathbb{N}}}}1 {ℤ}{{\ensuremath{\mathbb{Z}}}}1
  % --- brackets ------------------------------------------------------
    {⟦}{{\ensuremath{[\![}}}1 {⟧}{{\ensuremath{]\!]}}}1
    {⟨}{{\ensuremath{\langle}}}1 {⟩}{{\ensuremath{\rangle}}}1
    {⌊}{{\ensuremath{\lfloor}}}1 {⌋}{{\ensuremath{\rfloor}}}1
  % --- relations -----------------------------------------------------
    {≈}{{\ensuremath{\approx}}}1 {≡}{{\ensuremath{\equiv}}}1
    {≢}{{\ensuremath{\not\equiv}}}1 {≗}{{\ensuremath{\stackrel{\scriptscriptstyle\circ}{=}}}}1
    {≟}{{\ensuremath{\stackrel{\scriptscriptstyle ?}{=}}}}1
    {≤}{{\ensuremath{\le}}}1 {≥}{{\ensuremath{\ge}}}1
    {≠}{{\ensuremath{\neq}}}1 {≅}{{\ensuremath{\cong}}}1
    {≃}{{\ensuremath{\simeq}}}1 {∼}{{\ensuremath{\sim}}}1
    {∈}{{\ensuremath{\in}}}1 {∉}{{\ensuremath{\notin}}}1
    {⊆}{{\ensuremath{\subseteq}}}1 {∣}{{\ensuremath{\mid}}}1
  % --- operators ------------------------------------------------------
    {•}{{\ensuremath{\bullet}}}1 {∙}{{\ensuremath{\cdot}}}1
    {∘}{{\ensuremath{\circ}}}1 {×}{{\ensuremath{\times}}}1
    {⊎}{{\ensuremath{\uplus}}}1 {⊕}{{\ensuremath{\oplus}}}1
    {⊗}{{\ensuremath{\otimes}}}1 {⋊}{{\ensuremath{\rtimes}}}1
    {≀}{{\ensuremath{\wr}}}1 {∷}{{\ensuremath{\mathbin{::}}}}1
    {⋄}{{\ensuremath{\diamond}}}1 {⋆}{{\ensuremath{\star}}}1
    {∸}{{\ensuremath{\mathbin{\dot{-}}}}}1
    {⊔}{{\ensuremath{\sqcup}}}1 {∪}{{\ensuremath{\cup}}}1
    {∩}{{\ensuremath{\cap}}}1 {∧}{{\ensuremath{\wedge}}}1
    {∨}{{\ensuremath{\vee}}}1 {¬}{{\ensuremath{\neg}}}1
    {∁}{{\ensuremath{\complement}}}1
  % --- arrows ---------------------------------------------------------
    {→}{{\ensuremath{\to}}}1 {⟶}{{\ensuremath{\longrightarrow}}}1
    {↑}{{\ensuremath{\uparrow}}}1 {↥}{{\ensuremath{\Uparrow}}}1
    {↦}{{\ensuremath{\mapsto}}}1 {↪}{{\ensuremath{\hookrightarrow}}}1
    {⋯}{{\ensuremath{\cdots}}}1 {⇒}{{\ensuremath{\Rightarrow}}}1
    {⇔}{{\ensuremath{\Leftrightarrow}}}1 {↔}{{\ensuremath{\leftrightarrow}}}1
  % --- logic / misc ---------------------------------------------------
    {∀}{{\ensuremath{\forall}}}1 {∃}{{\ensuremath{\exists}}}1
    {⊤}{{\ensuremath{\top}}}1 {⊥}{{\ensuremath{\bot}}}1
    {∎}{{\ensuremath{\rule[0.2ex]{0.9ex}{0.9ex}}}}1
    {□}{{\ensuremath{\Box}}}1
    {Σ}{{\ensuremath{\Sigma}}}1 {Π}{{\ensuremath{\Pi}}}1
    {∃!}{{\ensuremath{\exists!}}}2
}

%% Display environment for Agda code blocks.
\lstnewenvironment{agdacode}[1][]{\lstset{language=Agda,#1}}{}

