/-
# The monoid congruence generated by a word relation

Translation of `Presentation/Base.agda` and `Presentation/Core.agda`.

The Agda's `_≈_` of `Presentation.Base Γ` is an inductive relation with
constructors `refl`, `sym`, `trans`, `cong`, `assoc`, `left-unit`,
`right-unit` and `axiom`: the least congruence for `_•_` containing `Γ`.
Words being Mathlib's free monoid here (`EquaCert.Word`), the monoid laws
are equations of words, and the congruence is Mathlib's `conGen Γ`;
`Derivable Γ w v` is the Agda's `w ≈ v`.  The constructors are theorems of
the same names (`Derivable.refl`, `.sym`, `.trans`, `.cong`, `.ax` (`axiom`), and
`.assoc`, `.left_unit`, `.right_unit`, which are `refl` up to the monoid
laws), as are the combinators `cleft`, `cright`, `refl'` and `reversed`.
-/
import EquaCert.Word.Base
import Mathlib.GroupTheory.Congruence.Basic

namespace EquaCert

universe u

variable {X : Type u}

/-- `Derivable Γ w v`: `w` and `v` are equal in the theory with axioms `Γ`,
the monoid congruence that `Γ` generates (the Agda's `w ≈ v` in
`Presentation.Base Γ`). -/
def Derivable (Γ : WRel X) (w v : Word X) : Prop := conGen Γ w v

namespace Derivable

variable {Γ : WRel X} {w v u w' v' : Word X}

/-- The Agda's `axiom` (`axiom` is a keyword of Lean). -/
theorem ax (h : Γ w v) : Derivable Γ w v := ConGen.Rel.of _ _ h

/-- `axiom`, under Mathlib's name. -/
theorem of (h : Γ w v) : Derivable Γ w v := ConGen.Rel.of _ _ h

@[refl] theorem refl (w : Word X) : Derivable Γ w w := (conGen Γ).refl w

/-- The Agda's `refl`, with the word implicit. -/
theorem rfl' : Derivable Γ w w := (conGen Γ).refl w

@[symm] theorem sym (h : Derivable Γ w v) : Derivable Γ v w := (conGen Γ).symm h

@[trans] theorem trans (h : Derivable Γ w v) (h' : Derivable Γ v u) : Derivable Γ w u :=
  (conGen Γ).trans h h'

/-- `sym`, under Mathlib's name. -/
theorem symm (h : Derivable Γ w v) : Derivable Γ v w := (conGen Γ).symm h

/-- The Agda's `cong`. -/
theorem cong (h : Derivable Γ w w') (h' : Derivable Γ v v') :
    Derivable Γ (w * v) (w' * v') := (conGen Γ).mul h h'

/-- `cong`, under Mathlib's name. -/
theorem mul (h : Derivable Γ w w') (h' : Derivable Γ v v') :
    Derivable Γ (w * v) (w' * v') := (conGen Γ).mul h h'

theorem assoc : Derivable Γ (w * v * u) (w * (v * u)) := by
  rw [mul_assoc]

theorem left_unit : Derivable Γ (1 * w) w := by rw [one_mul]

theorem right_unit : Derivable Γ (w * 1) w := by rw [mul_one]

/-- The Agda's `refl'`: equal words are derivably equal. -/
theorem refl' (h : w = v) : Derivable Γ w v := h ▸ refl _

/-- The Agda's `_reversed`. -/
theorem reversed (h : Derivable Γ w v) : Derivable Γ v w := sym h

/-- The Agda's `cleft_`. -/
theorem cleft (h : Derivable Γ w v) : Derivable Γ (w * u) (v * u) := cong h (refl _)

/-- The Agda's `cright_`. -/
theorem cright (h : Derivable Γ w v) : Derivable Γ (u * w) (u * v) := cong (refl _) h

theorem of_eq_left (e : w = w') (h : Derivable Γ w' v) : Derivable Γ w v := e ▸ h

theorem of_eq_right (e : v = v') (h : Derivable Γ w v') : Derivable Γ w v := e ▸ h

/-- Induction on derivations: a relation that contains the axioms and is a
congruence contains the derivable equations. -/
theorem rec_on {P : Word X → Word X → Prop} (d : Derivable Γ w v)
    (ax : ∀ {a b}, Γ a b → P a b) (rfl_ : ∀ a, P a a) (sym_ : ∀ {a b}, P a b → P b a)
    (trans_ : ∀ {a b c}, P a b → P b c → P a c)
    (cong_ : ∀ {a b c d}, P a b → P c d → P (a * c) (b * d)) : P w v := by
  let c : Con (Word X) :=
    { r := P
      iseqv := ⟨rfl_, sym_, trans_⟩
      mul' := cong_ }
  have : conGen Γ ≤ c := Con.conGen_le fun _ _ r => ax r
  exact this d

/-- A monoid homomorphism carrying the axioms of `Γ` to consequences of `Δ`
carries every consequence of `Γ` to one of `Δ`. -/
theorem map {Y : Type u} {Δ : WRel Y} (f : Word X →* Word Y)
    (wd : ∀ {a b : Word X}, Γ a b → Derivable Δ (f a) (f b)) (d : Derivable Γ w v) :
    Derivable Δ (f w) (f v) :=
  d.rec_on (P := fun a b => Derivable Δ (f a) (f b)) wd (fun _ => refl _)
    (fun h => sym h) (fun h h' => trans h h')
    (fun h h' => by simp only [map_mul]; exact cong h h')

/-- A derivation from fewer axioms is a derivation from more. -/
theorem mono {Δ : WRel X} (sub : ∀ {a b : Word X}, Γ a b → Derivable Δ a b)
    (d : Derivable Γ w v) : Derivable Δ w v := by
  simpa using map (MonoidHom.id _) (fun h => by simpa using sub h) d

end Derivable

/-- The Agda's `word-setoid` (`Presentation.Core`): words modulo the
congruence. -/
def wordSetoid (Γ : WRel X) : Setoid (Word X) := (conGen Γ).toSetoid

/-- Two words are derivably equal exactly when their classes in the
quotient monoid are equal. -/
theorem derivable_iff_mk (Γ : WRel X) {w v : Word X} :
    Derivable Γ w v ↔ ((w : (conGen Γ).Quotient) = (v : (conGen Γ).Quotient)) :=
  (Con.eq _).symm

end EquaCert
