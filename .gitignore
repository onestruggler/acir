*.agdai
*~
MAlonzo/**
_build/

# Emacs lock files and auto-save files
.\#*
\#*\#

# LaTeX auxiliary files in any directory (keep PDFs such as qcert.pdf)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex
*.synctex.gz
*.synctex(busy)
*.synctex.gz(busy)
*.toc
*.lof
*.lot
*.loa
*.lol
*.nav
*.snm
*.vrb
*.ptb
*.idx
*.ilg
*.ind
*.xdv
*.dvi

# PDFs generated only for local paper builds
paper/*.pdf
planqc/*.pdf

# Haskell / GHC build artifacts (Cir2Tikz tool)
*.hi
*.o
*.dyn_hi
*.dyn_o
*.p_hi
*.p_o
*.prof
*.hp
*.exe
# Compiler and LaTeX droppings from Cir2Tikz/build.sh
Cir2Tikz/build/

# cabal / stack
dist/
dist-newstyle/
.stack-work/
*.cabal.project.local

# Local reference material (papers, supplements, notes) -- never tracked
local/

# qpl26slides build artifacts.  Tracked under latex/: agda.sty,
# circuits.tikzstyles, figures/, selinger-clifford.pdf, talk.pdf.
qpl26slides/latex/qpl26slides/
qpl26slides/latex/preview/
qpl26slides/latex/*.aux
qpl26slides/latex/*.fdb_latexmk
qpl26slides/latex/*.fls
qpl26slides/latex/*.log
qpl26slides/latex/*.nav
qpl26slides/latex/*.out
qpl26slides/latex/*.snm
qpl26slides/latex/*.toc
qpl26slides/latex/*.vrb
qpl26slides/latex/*.ptb

# Python bytecode (generator scripts)
__pycache__/

# Chromium crash-handler log that a desktop tool writes into the working directory
debug.log

# vqupit paper build artifacts (the rendered literate sections under
# vqupit/latex/vqupit/sections/ are tracked; the agda.sty copy Agda drops
# next to them is not)
vqupit/*.aux
vqupit/*.bbl
vqupit/*.blg
vqupit/*.fdb_latexmk
vqupit/*.fls
vqupit/*.log
vqupit/*.out
vqupit/*.ptb
vqupit/comment.cut
vqupit/latex/agda.sty
vqupit/png/
