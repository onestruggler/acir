------------------------------------------------------------------------
-- Presentations of groups
--
-- PROPs: the swap as structure
--
-- A PRO is a strict monoidal category whose objects are the natural
-- numbers, with addition as the tensor product on objects; a PROP is a
-- PRO with a symmetry.  PROPs, "product and permutation categories",
-- are Mac Lane's (1965, §24): the symmetric groups act on the objects,
-- and the interchange τ(m,m′) of two blocks of wires is natural — his
-- axiom (4), τ(n,n′) ∘ (f ⊗ f′) = (f′ ⊗ f) ∘ τ(m,m′).  Lack (2004,
-- §§2.1, 2.4) defines both, and recasts a PROP as a PRO under the PRO
-- of permutations; Leinster (2004, §2.3) traces the names to Adams and
-- Mac Lane and to Boardman and Vogt.  For quantum circuits, Clément
-- (2026, §2.1) takes circuits to be the PROP generated by the gates,
-- quotiented by the axioms of his Figure 1, and observes (Remark 1)
-- that without the two axioms on the swap — (f), its naturality, and
-- (g), σ ∘ σ = id — the quotient is a PRO, and that (f) need only be
-- assumed for the generators (his Figure 2).
--
-- Circuit.Base presents a PRO.  A circuit on n wires is a morphism
-- n → n of the PRO freely generated by the gates: _↑ and _↓ᵏ_ tensor it
-- with an identity below and above, comm₁, comm₂ and comm₃ are the
-- interchange law, and ω↑=ω identifies a scalar, a morphism 0 → 0, with
-- its tensor by identities.  Wires do not cross: a gate acts on
-- adjacent wires.
--
-- This module makes it a PROP.  One two-wire gate of the family,
-- Ex-gate, is designated the swap σ, and _Sym,_===_ states the rules
-- that make σ a symmetry, in the shape of Clément's Remark 1: σ is an
-- involution (σ-inv, his (g)), and it is natural in every generator
-- (σ-nat₁, σ-nat₂ and σ-nat₃, his (f) at a generator).  They depend on
-- the gates and the swap alone, so a model checks them once for every
-- relation it is a model of; Lift-To-Prop adds them to a gate-specific
-- relation.  A k-wire gate followed by σ[ k ], the cycle that carries
-- wire k down past the bottom k wires, is σ[ k ] followed by the gate
-- one wire up: σ[ k ] is Mac Lane's τ(k,1), and σ-nat_k his axiom (4)
-- at f a generator and f′ the identity on one wire.  These are the
-- rules that make a PRO a PROP (Blake 2026, Definition 2), and two
-- consequences show why they are enough:
--
-- * σ-nat₂ at the swap itself is the Yang–Baxter equation, and the
--   swap under σ σ = ε and Yang–Baxter presents the PRO of permutations
--   (Lafont 2003, §2.1, Theorem 1; Examples.Groups.Symmetric is its
--   circuit form, Sₙ presented by the swaps);
-- * naturality at a generator gives naturality at a circuit: nat₀ …
--   nat₄ below, for a circuit on the bottom k ≤ 4 wires, and nat₁⁻,
--   nat₂⁻ and nat₃⁻ for the inverse cycles σ⁻[ k ];
-- * so an equation between k-wire circuits holds on the bottom k wires
--   of every wider circuit (pad): a relation need only state its rules
--   on their own wires, cong↑ moving them up and the symmetry down.
--
-- A 0-ary gate needs no rule: ω↑=ω and comm₂ carry a scalar past any
-- swap (ω-σ[_]).
--
-- Words read in diagram order, w • v being w followed by v.  Reversing
-- a word turns σ[ k ] into σ⁻[ k ], and σ-nat_k into the instance of
-- nat_k⁻ at the gate, so the rules hold read either way.
--
-- Examples.Independence.Prop adds the swap as a gate of its own, beside
-- the fragment's; here it is one of the family's gates, as SWAP is in
-- CNOT+Dihedral.  Clément's swap is not a gate but a word over H and CZ
-- (his Equation (8)), so Real-Clifford+CH states his (f1)–(f4) and (g)
-- as axioms of its own, (f1)–(f4) in the form of nat₁⁻ … nat₃⁻: a gate
-- one wire up followed by σ⁻[ k ] is σ⁻[ k ] followed by the gate at
-- the bottom.
--
-- Usage: open Circuit.Prop Gate Ex-gate in place of Circuit.Base Gate,
-- state the family's relation _SRel,_===_ with no swap rule in it, and
-- open Lift-To-Prop _SRel,_===_.  Its _VRel,_===_ is Circuit.Base's
-- Lift-Relation over _Prop,_===_, the swap rules (σrel) together with
-- _SRel,_===_ (srel): an instance r of the family's relation is
-- srel (srel r), and a swap rule s is srel (σrel s) — sym-rule s as an
-- equation.
--
-- References
--
--   S. Mac Lane.  Categorical algebra.  Bull. Amer. Math. Soc. 71(1),
--   40–106, 1965.  Chapter V, §24.
--
--   S. Lack.  Composing PROPs.  Theory Appl. Categ. 13(9), 147–163,
--   2004.  §§2.1, 2.4.
--
--   T. Leinster.  Higher Operads, Higher Categories.  Cambridge
--   University Press, 2004.  arXiv:math/0305049.  §2.3.
--
--   Y. Lafont.  Towards an algebraic theory of Boolean circuits.
--   J. Pure Appl. Algebra 184, 257–310, 2003.  §2.1.
--
--   A. Clément.  A complete equational theory for Real-Clifford+CH
--   quantum circuits.  arXiv:2602.06644, 2026.  §2.1: Definition 2.2,
--   Remark 1, Figures 1 and 2.
--
--   C. Blake.  Simpler presentations for many fragments of quantum
--   circuits.  FSCD 2026, LIPIcs 378, 6:1–6:20.  arXiv:2602.09874.
--   Definitions 1 and 2.
------------------------------------------------------------------------

{-# OPTIONS --cubical-compatible --safe #-}

open import Data.Nat using (ℕ)

module Circuit.Prop (Gate : ℕ → Set) (Ex-gate : Gate 2) where

open import Data.Nat using (zero ; suc ; _+_ ; _≤_ ; z≤n ; s≤s)
open import Relation.Binary.PropositionalEquality as Eq using (_≡_)

open import Notations
open import Word.Base using (Word ; wmap ; [_]ʷ ; ε ; _•_)
import Presentation.Base as PB
import Presentation.Properties as PP
import Relation.Binary.Reasoning.Setoid as SR

open import Circuit.Base Gate public

private
  variable
    k m n : ℕ
    w v : Circuit n

------------------------------------------------------------------------
-- The swap, and the cycles built from it

-- The swap of wires 0 and 1.
σ : Circuit (₂₊ n)
σ = [ gate₂ Ex-gate ]ʷ

-- σ[ k ] carries wire k down to wire 0, and wires 0 … k − 1 up one, by
-- swapping it down a wire at a time: Mac Lane's τ(k,1).
σ[_] : (k : ℕ) → Circuit (₁₊ k + n)
σ[ 0 ]    = ε
σ[ 1 ]    = σ
σ[ ₂₊ k ] = σ[ ₁₊ k ] ↑ • σ

-- σ⁻[ k ], the same swaps in the other order, carries wire 0 up to
-- wire k: τ(1,k), the inverse of σ[ k ].
σ⁻[_] : (k : ℕ) → Circuit (₁₊ k + n)
σ⁻[ 0 ]    = ε
σ⁻[ 1 ]    = σ
σ⁻[ ₂₊ k ] = σ • σ⁻[ ₁₊ k ] ↑

------------------------------------------------------------------------
-- The swap rules

infix 4 _Sym,_===_
data _Sym,_===_ : (n : ℕ) → CRel n where

  -- The swap is an involution (Clément's (g)).
  σ-inv  : (₂₊ n) Sym, σ • σ === ε

  -- ... natural in every generator (his (f) at a generator): a k-wire
  -- gate followed by σ[ k ] is σ[ k ] followed by the gate one wire
  -- up.  At the swap itself, σ-nat₂ is the Yang–Baxter equation.
  σ-nat₁ : (h : Gate 1) → (₂₊ n) Sym,
           [ gate₁ h ]ʷ • σ[ 1 ] === σ[ 1 ] • [ gate₁ h ]ʷ ↑
  σ-nat₂ : (h : Gate 2) → (₃₊ n) Sym,
           [ gate₂ h ]ʷ • σ[ 2 ] === σ[ 2 ] • [ gate₂ h ]ʷ ↑
  σ-nat₃ : (h : Gate 3) → (₄₊ n) Sym,
           [ gate₃ h ]ʷ • σ[ 3 ] === σ[ 3 ] • [ gate₃ h ]ʷ ↑

------------------------------------------------------------------------
-- A family's relation, with the swap rules and the structural rules

module Lift-To-Prop (_SRel,_===_ : (n : ℕ) → CRel n) where

  infix 4 _Prop,_===_
  data _Prop,_===_ : (n : ℕ) → CRel n where
    σrel : n Sym, w === v → n Prop, w === v
    srel : n SRel, w === v → n Prop, w === v

  -- The structural rules of the PRO on top: cong↑, comm₁, comm₂, comm₃
  -- and ω↑=ω.  Its srel embeds _Prop,_===_; Agda tells the two srels
  -- apart by type.
  open Lift-Relation _Prop,_===_ public

  -- The congruence generated, at each width.
  infix 4 _⊢_≈_
  _⊢_≈_ : (n : ℕ) → Circuit n → Circuit n → Set
  n ⊢ w ≈ v = PB._≈_ (n VRel,_===_) w v

  open PB using (refl ; sym ; trans ; cong ; assoc ; left-unit ; right-unit
                ; axiom)

  -- A swap rule, as an equation.
  sym-rule : n Sym, w === v → n ⊢ w ≈ v
  sym-rule s = axiom (srel (σrel s))

  private
    module Reasoning (n : ℕ) = SR (PP.word-setoid (n VRel,_===_))

  ----------------------------------------------------------------------
  -- The swap

  σ-invol : (₂₊ n) ⊢ σ • σ ≈ ε
  σ-invol = sym-rule σ-inv

  yang-baxter : (₃₊ n) ⊢ σ • σ ↑ • σ ≈ σ ↑ • σ • σ ↑
  yang-baxter = trans (sym-rule (σ-nat₂ Ex-gate)) assoc

  ----------------------------------------------------------------------
  -- Scalars

  -- A scalar written at any depth is the scalar (ω↑=ω, shifted).
  ω-up : (h : Gate 0) (d : ℕ) →
         (d + m) ⊢ [ gate₀ {m} h ↥ᵏ d ]ʷ ≈ [ gate₀ h ]ʷ
  ω-up h zero    = refl
  ω-up h (suc d) =
    trans (lemma-cong↑ _ _ (ω-up h d)) (axiom (ω↑=ω h))

  -- A scalar passes a swap: shifted up out of its way, it is comm₂.
  ω-σ : (h : Gate 0) → (₂₊ n) ⊢ [ gate₀ h ]ʷ • σ ≈ σ • [ gate₀ h ]ʷ
  ω-σ h =
    trans (cong (sym (ω-up h 2)) refl)
    (trans (axiom (comm₂ Ex-gate (gate₀ h)))
           (cong refl (ω-up h 2)))

  -- ... and so every cycle.
  ω-σ[_] : (k : ℕ) (h : Gate 0) →
           (₁₊ k + n) ⊢ [ gate₀ h ]ʷ • σ[ k ] ≈ σ[ k ] • [ gate₀ h ]ʷ
  ω-σ[ 0 ]    h = trans right-unit (sym left-unit)
  ω-σ[ 1 ]    h = ω-σ h
  ω-σ[_] {n} (₂₊ k) h = begin
    [ gate₀ h ]ʷ • σ[ ₁₊ k ] ↑ • σ
      ≈⟨ sym assoc ⟩
    ([ gate₀ h ]ʷ • σ[ ₁₊ k ] ↑) • σ
      ≈⟨ cong (cong (sym (ω-up h 1)) refl) refl ⟩
    ([ gate₀ h ]ʷ • σ[ ₁₊ k ]) ↑ • σ
      ≈⟨ cong (lemma-cong↑ _ _ (ω-σ[ ₁₊ k ] h)) refl ⟩
    (σ[ ₁₊ k ] • [ gate₀ h ]ʷ) ↑ • σ
      ≈⟨ assoc ⟩
    σ[ ₁₊ k ] ↑ • [ gate₀ h ]ʷ ↑ • σ
      ≈⟨ cong refl (cong (ω-up h 1) refl) ⟩
    σ[ ₁₊ k ] ↑ • [ gate₀ h ]ʷ • σ
      ≈⟨ cong refl (ω-σ h) ⟩
    σ[ ₁₊ k ] ↑ • σ • [ gate₀ h ]ʷ
      ≈⟨ sym assoc ⟩
    σ[ ₂₊ k ] • [ gate₀ h ]ʷ ∎
    where open Reasoning (₁₊ (₂₊ k) + n)

  ----------------------------------------------------------------------
  -- Naturality at a letter
  --
  -- Every generator of Gen k, on the bottom k wires of a wider
  -- circuit, slides past σ[ k ] and comes out one wire up.  A scalar
  -- passes by ω-σ[_]; a gate on the bottom k wires is its rule σ-nat_k;
  -- a gate on fewer passes the part of the cycle above it by the comm
  -- rules and then meets its own rule; and a shifted generator is the
  -- same statement one size down, shifted, followed by one more swap,
  -- which it passes by comm₂ (σ-shift).

  private
    -- What slides past σ[ ₁₊ k ] slides one wire up past σ[ ₂₊ k ].
    σ-shift : (c : Circuit (₁₊ m)) (a : Gen (₁₊ m)) (b : Gen m) →
              (₁₊ m) ⊢ [ a ]ʷ • c ≈ c • [ b ]ʷ ↑ →
              (₂₊ m) ⊢ [ a ]ʷ ↑ • c ↑ • σ ≈ (c ↑ • σ) • [ b ]ʷ ↑ ↑
    σ-shift {m} c a b p = begin
      [ a ]ʷ ↑ • c ↑ • σ          ≈⟨ sym assoc ⟩
      ([ a ]ʷ • c) ↑ • σ          ≈⟨ cong (lemma-cong↑ _ _ p) refl ⟩
      (c • [ b ]ʷ ↑) ↑ • σ        ≈⟨ assoc ⟩
      c ↑ • [ b ]ʷ ↑ ↑ • σ        ≈⟨ cong refl (axiom (comm₂ Ex-gate b)) ⟩
      c ↑ • σ • [ b ]ʷ ↑ ↑        ≈⟨ sym assoc ⟩
      (c ↑ • σ) • [ b ]ʷ ↑ ↑      ∎
      where open Reasoning (₂₊ m)

    -- A one-wire gate passes any cycle: it commutes with the shifted
    -- part and meets σ-nat₁ at the last swap.
    gate₁-σ : (c : Circuit (₁₊ m)) (h : Gate 1) →
              (₂₊ m) ⊢ [ gate₁ h ]ʷ • c ↑ • σ ≈ (c ↑ • σ) • [ gate₁ h ]ʷ ↑
    gate₁-σ {m} c h = begin
      [ gate₁ h ]ʷ • c ↑ • σ      ≈⟨ sym assoc ⟩
      ([ gate₁ h ]ʷ • c ↑) • σ    ≈⟨ cong (sym (comm-gate₁-w↑ h c)) refl ⟩
      (c ↑ • [ gate₁ h ]ʷ) • σ    ≈⟨ assoc ⟩
      c ↑ • [ gate₁ h ]ʷ • σ      ≈⟨ cong refl (sym-rule (σ-nat₁ h)) ⟩
      c ↑ • σ • [ gate₁ h ]ʷ ↑    ≈⟨ sym assoc ⟩
      (c ↑ • σ) • [ gate₁ h ]ʷ ↑  ∎
      where open Reasoning (₂₊ m)

    -- A scalar comes out one wire up because it is the same there.
    gate₀-σ : (k : ℕ) (h : Gate 0) →
              (₁₊ k + n) ⊢ [ gate₀ h ]ʷ • σ[ k ] ≈ σ[ k ] • [ gate₀ h ]ʷ ↑
    gate₀-σ k h = trans (ω-σ[ k ] h) (cong refl (sym (ω-up h 1)))

  natg₁ : (x : Gen 1) →
          (₂₊ n) ⊢ [ x ↧ᵏ ₁₊ n ]ʷ • σ[ 1 ] ≈ σ[ 1 ] • [ x ↧ᵏ n ]ʷ ↑
  natg₁ (gate₀ h)   = gate₀-σ 1 h
  natg₁ (gate₁ h)   = sym-rule (σ-nat₁ h)
  natg₁ (gate₀ h ↥) =
    trans (cong (ω-up h 1) refl)
    (trans (ω-σ h) (cong refl (sym (ω-up h 2))))

  natg₂ : (x : Gen 2) →
          (₃₊ n) ⊢ [ x ↧ᵏ ₁₊ n ]ʷ • σ[ 2 ] ≈ σ[ 2 ] • [ x ↧ᵏ n ]ʷ ↑
  natg₂ (gate₀ h) = gate₀-σ 2 h
  natg₂ (gate₁ h) = gate₁-σ σ[ 1 ] h
  natg₂ (gate₂ h) = sym-rule (σ-nat₂ h)
  natg₂ (x ↥)     = σ-shift σ[ 1 ] _ _ (natg₁ x)

  natg₃ : (x : Gen 3) →
          (₄₊ n) ⊢ [ x ↧ᵏ ₁₊ n ]ʷ • σ[ 3 ] ≈ σ[ 3 ] • [ x ↧ᵏ n ]ʷ ↑
  natg₃ (gate₀ h) = gate₀-σ 3 h
  natg₃ (gate₁ h) = gate₁-σ σ[ 2 ] h
  -- A two-wire gate commutes with the top swap of σ[ 3 ] and meets
  -- σ-nat₂ at the other two.
  natg₃ {n} (gate₂ h) = begin
    [ gate₂ h ]ʷ • (σ ↑ ↑ • σ ↑) • σ
      ≈⟨ cong refl assoc ⟩
    [ gate₂ h ]ʷ • σ ↑ ↑ • σ ↑ • σ
      ≈⟨ sym assoc ⟩
    ([ gate₂ h ]ʷ • σ ↑ ↑) • σ ↑ • σ
      ≈⟨ cong (sym (axiom (comm₂ h (gate₂ Ex-gate)))) refl ⟩
    (σ ↑ ↑ • [ gate₂ h ]ʷ) • σ ↑ • σ
      ≈⟨ assoc ⟩
    σ ↑ ↑ • [ gate₂ h ]ʷ • σ ↑ • σ
      ≈⟨ cong refl (sym-rule (σ-nat₂ h)) ⟩
    σ ↑ ↑ • (σ ↑ • σ) • [ gate₂ h ]ʷ ↑
      ≈⟨ sym assoc ⟩
    (σ ↑ ↑ • σ ↑ • σ) • [ gate₂ h ]ʷ ↑
      ≈⟨ cong (sym assoc) refl ⟩
    ((σ ↑ ↑ • σ ↑) • σ) • [ gate₂ h ]ʷ ↑ ∎
    where open Reasoning (₄₊ n)
  natg₃ (gate₃ h) = sym-rule (σ-nat₃ h)
  natg₃ (x ↥)     = σ-shift σ[ 2 ] _ _ (natg₂ x)

  ----------------------------------------------------------------------
  -- Naturality at a circuit
  --
  -- A circuit on the bottom k wires (one of Circuit k, widened by
  -- _↓ᵏ_) followed by σ[ k ] is σ[ k ] followed by the circuit one wire
  -- up.  This is Clément's (f), recovered from the rules at the
  -- generators, for the widths a generator has.

  private
    -- A word slides past c when each of its letters does.
    slide : (c : Circuit (₁₊ m)) (f : Gen k → Gen (₁₊ m))
            (g : Gen k → Gen m) →
            (∀ x → (₁₊ m) ⊢ [ f x ]ʷ • c ≈ c • [ g x ]ʷ ↑) →
            ∀ w → (₁₊ m) ⊢ wmap f w • c ≈ c • (wmap g w) ↑
    slide c f g p [ x ]ʷ  = p x
    slide c f g p ε       = trans left-unit (sym right-unit)
    slide c f g p (u • t) =
      trans assoc
      (trans (cong refl (slide c f g p t))
      (trans (sym assoc)
      (trans (cong (slide c f g p u) refl)
             assoc)))

  nat₁ : (w : Circuit 1) →
         (₂₊ n) ⊢ (w ↓ᵏ ₁₊ n) • σ[ 1 ] ≈ σ[ 1 ] • (w ↓ᵏ n) ↑
  nat₁ {n} = slide σ[ 1 ] (_↧ᵏ ₁₊ n) (_↧ᵏ n) natg₁

  nat₂ : (w : Circuit 2) →
         (₃₊ n) ⊢ (w ↓ᵏ ₁₊ n) • σ[ 2 ] ≈ σ[ 2 ] • (w ↓ᵏ n) ↑
  nat₂ {n} = slide σ[ 2 ] (_↧ᵏ ₁₊ n) (_↧ᵏ n) natg₂

  nat₃ : (w : Circuit 3) →
         (₄₊ n) ⊢ (w ↓ᵏ ₁₊ n) • σ[ 3 ] ≈ σ[ 3 ] • (w ↓ᵏ n) ↑
  nat₃ {n} = slide σ[ 3 ] (_↧ᵏ ₁₊ n) (_↧ᵏ n) natg₃

  ----------------------------------------------------------------------
  -- The inverse cycles

  σσ⁻ : (k : ℕ) → (₁₊ k + n) ⊢ σ[ k ] • σ⁻[ k ] ≈ ε
  σσ⁻ 0          = left-unit
  σσ⁻ 1          = σ-invol
  σσ⁻ {n} (₂₊ k) = begin
    (σ[ ₁₊ k ] ↑ • σ) • σ • σ⁻[ ₁₊ k ] ↑
      ≈⟨ assoc ⟩
    σ[ ₁₊ k ] ↑ • σ • σ • σ⁻[ ₁₊ k ] ↑
      ≈⟨ cong refl (sym assoc) ⟩
    σ[ ₁₊ k ] ↑ • (σ • σ) • σ⁻[ ₁₊ k ] ↑
      ≈⟨ cong refl (trans (cong σ-invol refl) left-unit) ⟩
    σ[ ₁₊ k ] ↑ • σ⁻[ ₁₊ k ] ↑
      ≈⟨ lemma-cong↑ _ _ (σσ⁻ (₁₊ k)) ⟩
    ε ∎
    where open Reasoning (₁₊ (₂₊ k) + n)

  σ⁻σ : (k : ℕ) → (₁₊ k + n) ⊢ σ⁻[ k ] • σ[ k ] ≈ ε
  σ⁻σ 0          = left-unit
  σ⁻σ 1          = σ-invol
  σ⁻σ {n} (₂₊ k) = begin
    (σ • σ⁻[ ₁₊ k ] ↑) • σ[ ₁₊ k ] ↑ • σ
      ≈⟨ assoc ⟩
    σ • σ⁻[ ₁₊ k ] ↑ • σ[ ₁₊ k ] ↑ • σ
      ≈⟨ cong refl (sym assoc) ⟩
    σ • (σ⁻[ ₁₊ k ] ↑ • σ[ ₁₊ k ] ↑) • σ
      ≈⟨ cong refl (cong (lemma-cong↑ _ _ (σ⁻σ (₁₊ k))) refl) ⟩
    σ • ε • σ
      ≈⟨ cong refl left-unit ⟩
    σ • σ
      ≈⟨ σ-invol ⟩
    ε ∎
    where open Reasoning (₁₊ (₂₊ k) + n)

  private
    -- An equation W • c ≈ c • W′ turns round along an inverse of c.
    turn : {W W′ c c⁻ : Circuit n} →
           n ⊢ c⁻ • c ≈ ε → n ⊢ c • c⁻ ≈ ε →
           n ⊢ W • c ≈ c • W′ → n ⊢ c⁻ • W ≈ W′ • c⁻
    turn {n} {W} {W′} {c} {c⁻} c⁻c cc⁻ p = begin
      c⁻ • W                 ≈⟨ sym right-unit ⟩
      (c⁻ • W) • ε           ≈⟨ cong refl (sym cc⁻) ⟩
      (c⁻ • W) • c • c⁻      ≈⟨ assoc ⟩
      c⁻ • W • c • c⁻        ≈⟨ cong refl (sym assoc) ⟩
      c⁻ • (W • c) • c⁻      ≈⟨ cong refl (cong p refl) ⟩
      c⁻ • (c • W′) • c⁻     ≈⟨ cong refl assoc ⟩
      c⁻ • c • W′ • c⁻       ≈⟨ sym assoc ⟩
      (c⁻ • c) • W′ • c⁻     ≈⟨ cong c⁻c refl ⟩
      ε • W′ • c⁻            ≈⟨ left-unit ⟩
      W′ • c⁻                ∎
      where open Reasoning n

  -- σ⁻[ k ], which carries wire 0 up to wire k, followed by a circuit
  -- on the bottom k wires is the circuit one wire up followed by
  -- σ⁻[ k ].  With its sides exchanged, this is the form in which
  -- Real-Clifford+CH states Clément's (f1)–(f4).
  nat₁⁻ : (w : Circuit 1) →
          (₂₊ n) ⊢ σ⁻[ 1 ] • (w ↓ᵏ ₁₊ n) ≈ (w ↓ᵏ n) ↑ • σ⁻[ 1 ]
  nat₁⁻ w = turn (σ⁻σ 1) (σσ⁻ 1) (nat₁ w)

  nat₂⁻ : (w : Circuit 2) →
          (₃₊ n) ⊢ σ⁻[ 2 ] • (w ↓ᵏ ₁₊ n) ≈ (w ↓ᵏ n) ↑ • σ⁻[ 2 ]
  nat₂⁻ w = turn (σ⁻σ 2) (σσ⁻ 2) (nat₂ w)

  nat₃⁻ : (w : Circuit 3) →
          (₄₊ n) ⊢ σ⁻[ 3 ] • (w ↓ᵏ ₁₊ n) ≈ (w ↓ᵏ n) ↑ • σ⁻[ 3 ]
  nat₃⁻ w = turn (σ⁻σ 3) (σσ⁻ 3) (nat₃ w)

  ----------------------------------------------------------------------
  -- Naturality on none and on four wires
  --
  -- On no wires a circuit is a word of scalars, and σ[ 0 ] = ε; on four
  -- (the widest rule of the fragments of Examples.Independence) a gate
  -- passes the top swaps of σ[ 4 ] by the comm rules and meets its own
  -- rule at the rest, as on three.

  natg₀ : (x : Gen 0) →
          (₁₊ n) ⊢ [ x ↧ᵏ ₁₊ n ]ʷ • σ[ 0 ] ≈ σ[ 0 ] • [ x ↧ᵏ n ]ʷ ↑
  natg₀ (gate₀ h) = gate₀-σ 0 h

  natg₄ : (x : Gen 4) →
          (₁₊ (₄₊ n)) ⊢ [ x ↧ᵏ ₁₊ n ]ʷ • σ[ 4 ] ≈ σ[ 4 ] • [ x ↧ᵏ n ]ʷ ↑
  natg₄ (gate₀ h) = gate₀-σ 4 h
  natg₄ (gate₁ h) = gate₁-σ σ[ 3 ] h
  natg₄ {n} (gate₂ h) = begin
    [ gate₂ h ]ʷ • σ[ 4 ]                    ≈⟨ by-assoc Eq.refl ⟩
    ([ gate₂ h ]ʷ • σ[ 2 ] ↑ ↑) • σ[ 2 ]     ≈⟨ cong (sym (comm-gate₂-w↑↑ h σ[ 2 ])) refl ⟩
    (σ[ 2 ] ↑ ↑ • [ gate₂ h ]ʷ) • σ[ 2 ]     ≈⟨ assoc ⟩
    σ[ 2 ] ↑ ↑ • [ gate₂ h ]ʷ • σ[ 2 ]       ≈⟨ cong refl (sym-rule (σ-nat₂ h)) ⟩
    σ[ 2 ] ↑ ↑ • σ[ 2 ] • [ gate₂ h ]ʷ ↑     ≈⟨ by-assoc Eq.refl ⟩
    σ[ 4 ] • [ gate₂ h ]ʷ ↑                  ∎
    where open Reasoning (₁₊ (₄₊ n))
          open PP ((₁₊ (₄₊ n)) VRel,_===_) using (by-assoc)
  natg₄ {n} (gate₃ h) = begin
    [ gate₃ h ]ʷ • σ[ 4 ]                    ≈⟨ by-assoc Eq.refl ⟩
    ([ gate₃ h ]ʷ • σ ↑ ↑ ↑) • σ[ 3 ]        ≈⟨ cong (sym (axiom (comm₃ h (gate₂ Ex-gate)))) refl ⟩
    (σ ↑ ↑ ↑ • [ gate₃ h ]ʷ) • σ[ 3 ]        ≈⟨ assoc ⟩
    σ ↑ ↑ ↑ • [ gate₃ h ]ʷ • σ[ 3 ]          ≈⟨ cong refl (sym-rule (σ-nat₃ h)) ⟩
    σ ↑ ↑ ↑ • σ[ 3 ] • [ gate₃ h ]ʷ ↑        ≈⟨ by-assoc Eq.refl ⟩
    σ[ 4 ] • [ gate₃ h ]ʷ ↑                  ∎
    where open Reasoning (₁₊ (₄₊ n))
          open PP ((₁₊ (₄₊ n)) VRel,_===_) using (by-assoc)
  natg₄ (x ↥) = σ-shift σ[ 3 ] _ _ (natg₃ x)

  nat₀ : (w : Circuit 0) →
         (₁₊ n) ⊢ (w ↓ᵏ ₁₊ n) • σ[ 0 ] ≈ σ[ 0 ] • (w ↓ᵏ n) ↑
  nat₀ {n} = slide σ[ 0 ] (_↧ᵏ ₁₊ n) (_↧ᵏ n) natg₀

  nat₄ : (w : Circuit 4) →
         (₁₊ (₄₊ n)) ⊢ (w ↓ᵏ ₁₊ n) • σ[ 4 ] ≈ σ[ 4 ] • (w ↓ᵏ n) ↑
  nat₄ {n} = slide σ[ 4 ] (_↧ᵏ ₁₊ n) (_↧ᵏ n) natg₄

  ----------------------------------------------------------------------
  -- An equation on the bottom wires of a wider circuit
  --
  -- A circuit on the bottom k wires of a wider one is the circuit one
  -- wire up, conjugated by σ[ k ] (nat_k), so an equation between
  -- k-wire circuits, moved up by cong↑ and conjugated back, holds on
  -- the bottom k wires of every wider circuit.  It is stated for each
  -- k ≤ 4: σ[ k ] lives on ₁₊ k + n wires and the widened circuit on
  -- k + ₁₊ n, which agree only at a numeral k.

  private
    -- Widening by no wires changes nothing, at each numeral width.
    ↧0₀ : (x : Gen 0) → x ↧ᵏ 0 ≡ x
    ↧0₀ (gate₀ h) = Eq.refl

    ↧0₁ : (x : Gen 1) → x ↧ᵏ 0 ≡ x
    ↧0₁ (gate₀ h) = Eq.refl
    ↧0₁ (gate₁ h) = Eq.refl
    ↧0₁ (x ↥)     = Eq.cong _↥ (↧0₀ x)

    ↧0₂ : (x : Gen 2) → x ↧ᵏ 0 ≡ x
    ↧0₂ (gate₀ h) = Eq.refl
    ↧0₂ (gate₁ h) = Eq.refl
    ↧0₂ (gate₂ h) = Eq.refl
    ↧0₂ (x ↥)     = Eq.cong _↥ (↧0₁ x)

    ↧0₃ : (x : Gen 3) → x ↧ᵏ 0 ≡ x
    ↧0₃ (gate₀ h) = Eq.refl
    ↧0₃ (gate₁ h) = Eq.refl
    ↧0₃ (gate₂ h) = Eq.refl
    ↧0₃ (gate₃ h) = Eq.refl
    ↧0₃ (x ↥)     = Eq.cong _↥ (↧0₂ x)

    ↧0₄ : (x : Gen 4) → x ↧ᵏ 0 ≡ x
    ↧0₄ (gate₀ h) = Eq.refl
    ↧0₄ (gate₁ h) = Eq.refl
    ↧0₄ (gate₂ h) = Eq.refl
    ↧0₄ (gate₃ h) = Eq.refl
    ↧0₄ (x ↥)     = Eq.cong _↥ (↧0₃ x)

    wmap-id : {X : Set} {f : X → X} → (∀ x → f x ≡ x) → (u : Word X) → wmap f u ≡ u
    wmap-id p [ x ]ʷ  = Eq.cong [_]ʷ (p x)
    wmap-id p ε       = Eq.refl
    wmap-id p (u • t) = Eq.cong₂ _•_ (wmap-id p u) (wmap-id p t)

    -- a ≈ b from a and b each passing c to a′ and b′, a′ ≈ b′, and a
    -- right inverse of c.
    conj-back : {a b a′ b′ c c⁻ : Circuit n} →
                n ⊢ a • c ≈ c • a′ → n ⊢ b • c ≈ c • b′ →
                n ⊢ c • c⁻ ≈ ε → n ⊢ a′ ≈ b′ → n ⊢ a ≈ b
    conj-back {n} {a} {b} {a′} {b′} {c} {c⁻} pa pb cc⁻ e = begin
      a              ≈⟨ sym right-unit ⟩
      a • ε          ≈⟨ cong refl (sym cc⁻) ⟩
      a • c • c⁻     ≈⟨ sym assoc ⟩
      (a • c) • c⁻   ≈⟨ cong pa refl ⟩
      (c • a′) • c⁻  ≈⟨ cong (cong refl e) refl ⟩
      (c • b′) • c⁻  ≈⟨ cong (sym pb) refl ⟩
      (b • c) • c⁻   ≈⟨ assoc ⟩
      b • c • c⁻     ≈⟨ cong refl cc⁻ ⟩
      b • ε          ≈⟨ right-unit ⟩
      b              ∎
      where open Reasoning n

  pad₀ : {w v : Circuit 0} → 0 ⊢ w ≈ v → (n : ℕ) → n ⊢ w ↓ᵏ n ≈ v ↓ᵏ n
  pad₀ {w} {v} p zero    =
    Eq.subst₂ (0 ⊢_≈_) (Eq.sym (wmap-id ↧0₀ w)) (Eq.sym (wmap-id ↧0₀ v)) p
  pad₀ {w} {v} p (suc n) =
    conj-back (nat₀ w) (nat₀ v) (σσ⁻ 0) (lemma-cong↑ _ _ (pad₀ p n))

  pad₁ : {w v : Circuit 1} → 1 ⊢ w ≈ v → (n : ℕ) → (₁₊ n) ⊢ w ↓ᵏ n ≈ v ↓ᵏ n
  pad₁ {w} {v} p zero    =
    Eq.subst₂ (1 ⊢_≈_) (Eq.sym (wmap-id ↧0₁ w)) (Eq.sym (wmap-id ↧0₁ v)) p
  pad₁ {w} {v} p (suc n) =
    conj-back (nat₁ w) (nat₁ v) (σσ⁻ 1) (lemma-cong↑ _ _ (pad₁ p n))

  pad₂ : {w v : Circuit 2} → 2 ⊢ w ≈ v → (n : ℕ) → (₂₊ n) ⊢ w ↓ᵏ n ≈ v ↓ᵏ n
  pad₂ {w} {v} p zero    =
    Eq.subst₂ (2 ⊢_≈_) (Eq.sym (wmap-id ↧0₂ w)) (Eq.sym (wmap-id ↧0₂ v)) p
  pad₂ {w} {v} p (suc n) =
    conj-back (nat₂ w) (nat₂ v) (σσ⁻ 2) (lemma-cong↑ _ _ (pad₂ p n))

  pad₃ : {w v : Circuit 3} → 3 ⊢ w ≈ v → (n : ℕ) → (₃₊ n) ⊢ w ↓ᵏ n ≈ v ↓ᵏ n
  pad₃ {w} {v} p zero    =
    Eq.subst₂ (3 ⊢_≈_) (Eq.sym (wmap-id ↧0₃ w)) (Eq.sym (wmap-id ↧0₃ v)) p
  pad₃ {w} {v} p (suc n) =
    conj-back (nat₃ w) (nat₃ v) (σσ⁻ 3) (lemma-cong↑ _ _ (pad₃ p n))

  pad₄ : {w v : Circuit 4} → 4 ⊢ w ≈ v → (n : ℕ) → (₄₊ n) ⊢ w ↓ᵏ n ≈ v ↓ᵏ n
  pad₄ {w} {v} p zero    =
    Eq.subst₂ (4 ⊢_≈_) (Eq.sym (wmap-id ↧0₄ w)) (Eq.sym (wmap-id ↧0₄ v)) p
  pad₄ {w} {v} p (suc n) =
    conj-back (nat₄ w) (nat₄ v) (σσ⁻ 4) (lemma-cong↑ _ _ (pad₄ p n))

  -- All five at once.
  pad : {w v : Circuit k} → k ≤ 4 → k ⊢ w ≈ v → (n : ℕ) → (k + n) ⊢ w ↓ᵏ n ≈ v ↓ᵏ n
  pad z≤n                                 = pad₀
  pad (s≤s z≤n)                           = pad₁
  pad (s≤s (s≤s z≤n))                     = pad₂
  pad (s≤s (s≤s (s≤s z≤n)))               = pad₃
  pad (s≤s (s≤s (s≤s (s≤s z≤n))))         = pad₄
